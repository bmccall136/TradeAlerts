<script>
(function(){
  function mmParseSellHours(v){
    return String(v||'').split(',').map(x=>x.trim()).filter(Boolean).map(x=>parseInt(x,10)).filter(x=>Number.isFinite(x) && x>=0 && x<=23);
  }
  function mmJoinSellHours(arr){
    return Array.isArray(arr) ? arr.join(',') : '';
  }
  window.MM_SELL_HOUR_BLOCK_UI_V1 = true;

  document.addEventListener('DOMContentLoaded', function(){
    var el = document.querySelector('[name="avoid_sell_hours"], #avoid_sell_hours');
    if (!el) return;

    try{
      if (window.loadSettingsIntoForm && !window.__mm_sell_hour_load_wrap__) {
        window.__mm_sell_hour_load_wrap__ = true;
        var _oldLoad = window.loadSettingsIntoForm;
        window.loadSettingsIntoForm = function(data){
          var r = _oldLoad.apply(this, arguments);
          try{
            var v = (data && (data.avoid_sell_hours ?? (data.sell_guard && data.sell_guard.avoid_sell_hours))) || [];
            el.value = mmJoinSellHours(v);
          }catch(_){}
          return r;
        };
      }
    }catch(_){}

    try{
      if (window.collectFormSettings && !window.__mm_sell_hour_collect_wrap__) {
        window.__mm_sell_hour_collect_wrap__ = true;
        var _oldCollect = window.collectFormSettings;
        window.collectFormSettings = function(){
          var out = _oldCollect.apply(this, arguments) || {};
          try{
            out.sell_guard = out.sell_guard || {};
            out.sell_guard.avoid_sell_hours = mmParseSellHours(el.value);
          }catch(_){}
          return out;
        };
      }
    }catch(_){}
  });
})();
</script>

