{% extends "layout.html" %}
{% block content %}
<style>
  .mm-card { background:#0f1118; border:1px solid #222531; border-radius:10px; }
  .mm-muted { opacity:.82; color:#cfd6e4; }
  .mm-stickybar {
    position: sticky; top: 10px; z-index: 50;
    background: rgba(15,17,24,.95);
    border: 1px solid #222531;
    border-radius: 10px;
    padding: 10px 12px;
    backdrop-filter: blur(6px);
  }
  .mm-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .mm-section-title { font-size:18px; font-weight:800; margin-bottom:6px; color:#e9edf6; }
  .mm-subtitle { margin-top:0; margin-bottom:10px; color:#b8c0cf; }
  .mm-divider { height:1px; background:#222531; margin: 14px 0; }

  #settings-page{
    max-width:1100px;
    margin-left:auto;
    margin-right:auto;
    color:#e8e8e8;
  }

  #settings-page h2{
    color:#ffffff;
    font-weight:800;
    margin:0;
  }

  #settings-page .text-muted,
  #settings-page .small,
  #settings-page .form-text{
    color:#aeb7c7 !important;
  }

  #settings-page code{
    color:#ff4fd8;
    background:transparent;
  }

  #settings-page .card{
    background:#0f1118;
    border:1px solid #222531;
    border-radius:10px;
    color:#e8e8e8;
  }

  #settings-page .card-header{
    background:#0b0d14;
    border-bottom:1px solid #222531;
    color:#f0f3f9;
    font-weight:700;
  }

  #settings-page .card-body{
    background:transparent;
    color:#e8e8e8;
  }

  #settings-page .badge.bg-secondary{
    background:#2a3040 !important;
    color:#dfe6f2 !important;
    border:1px solid #394155;
  }

  #settings-page .form-label,
  #settings-page .form-check-label{
    color:#d7dbe6;
    font-weight:700;
  }

  #settings-page .form-control,
  #settings-page .form-select{
    background:#0b0d14;
    border:1px solid #262a38;
    border-radius:8px;
    color:#e8e8e8;
    box-shadow:none;
  }

  #settings-page .form-control:focus,
  #settings-page .form-select:focus{
    background:#0b0d14;
    color:#fff;
    border-color:#f5d400;
    box-shadow:0 0 0 2px rgba(245,212,0,.18);
  }

  #settings-page .form-control::placeholder{
    color:#7f8899;
  }

  #settings-page input[type="checkbox"]{
    accent-color:#f5d400;
  }

  #settings-page .form-check-input{
    background-color:#0b0d14;
    border-color:#3a4153;
  }

  #settings-page .form-check-input:checked{
    background-color:#f5d400;
    border-color:#f5d400;
  }

  #settings-page .btn-outline-light{
    color:#e8e8e8;
    border-color:#394155;
    background:#0b0d14;
  }

  #settings-page .btn-outline-light:hover{
    background:#171b25;
    border-color:#59627a;
    color:#fff;
  }

  #settings-page .btn-primary{
    background:#f5d400;
    border-color:#f5d400;
    color:#111;
    font-weight:700;
  }

  #settings-page .btn-primary:hover{
    background:#ffdf33;
    border-color:#ffdf33;
    color:#000;
  }

  #settings-page hr{
    border-color:#222531;
    opacity:1;
  }

  #mm-error.alert-danger{
    background:#3a1114;
    color:#ffd7db;
    border:1px solid #6a2229;
  }

  #mm-regime-exit-overlay-card .table{
    margin-bottom:0;
  }

  #mm-regime-exit-overlay-card.table-responsive,
  #mm-regime-exit-overlay-card .table-responsive{
    border-radius:8px;
  }

  #mm-regime-exit-overlay-card .table-dark{
    --bs-table-bg:#0b0d14;
    --bs-table-striped-bg:#121622;
    --bs-table-color:#e8e8e8;
    --bs-table-border-color:#262a38;
  }

  #mm-regime-exit-overlay-card .table-dark input.form-control{
    background:#0f1118;
    color:#e8e8e8;
    border:1px solid #262a38;
  }
</style>

<style>
/* MM_SELL_TABS_CSS_V1 */
#settings-page .btn-group .btn-dark{
  background:#1d2230;
  border-color:#2d3447;
  color:#e8e8e8;
}
#settings-page .btn-group .btn-dark:hover{
  background:#252b3b;
  border-color:#3a4258;
  color:#fff;
}
#settings-page .btn-group .btn-warning{
  background:#f5d400;
  border-color:#f5d400;
  color:#111;
  font-weight:700;
}
#settings-page .btn-group .btn-warning:hover{
  background:#ffdf33;
  border-color:#ffdf33;
  color:#000;
}
</style>

<div id="settings-page" class="container-fluid">
<div style="margin:18px 0 10px 0;">
  <div style="font-size:22px;font-weight:800;">Settings</div>
</div>

<div class="mm-stickybar mb-3">
  <div class="mm-row">
    <div>
      <div id="mm-status" class="small mm-muted"></div>
      <div id="mm-error" class="alert alert-danger py-2 px-3 d-none mt-2 mb-0"></div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <div class="btn-group" role="group" aria-label="settings tabs">
        <a class="btn btn-sm btn-dark" href="/settings/buy">BUY</a>
        <a class="btn btn-sm btn-warning" href="/settings/sell">SELL</a>
      </div>
      <select id="mm-profile" class="form-select form-select-sm" style="width:130px;">
        <option value="day">DAY</option>
        <option value="swing">SWING</option>
      </select>
      <button class="btn btn-sm btn-outline-light" id="mm-reload"><i class="bi bi-arrow-clockwise"></i> Reload</button>
      <button class="btn btn-sm btn-primary" id="mm-save"><i class="bi bi-save2"></i> Save</button>
    </div>
  </div>
</div>
  <!-- SELL GUARD -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-shield-check"></i> Sell Guard</div>
      <span class="badge bg-secondary">Core exits</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Mode</label>
          <input class="form-control" data-path="sell_guard.mode" readonly>
          <div class="form-text">Mode is informational; profile drives which JSON file is edited.</div>
        </div>

        <div class="col-md-4">
          <label class="form-label">Loop interval (sec)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.interval_sec">
        </div>

        <div class="col-md-4">
          <label class="form-label">Throttle (ms)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.throttle_ms">
        </div>

        <div class="col-md-4">
          <label class="form-label">Sell window start (ET)</label>
          <input class="form-control" data-path="sell_guard.sell_window_start_et" placeholder="09:31">
        </div>

        <div class="col-md-4">
          <label class="form-label">Sell window end (ET)</label>
          <input class="form-control" data-path="sell_guard.sell_window_end_et" placeholder="15:58">
        </div>

        <!-- MM_HOUR_BLOCK_SELL_FIELD_V1_START -->
        <div class="col-md-4">
          <label class="form-label">Avoid sell hours (ET)</label>
          <input class="form-control" id="avoidSellHours" placeholder="12,13">
          <div class="form-text">Comma-separated hours like 12,13 for 12:00–1:59 PM ET.</div>
        </div>
        <!-- MM_HOUR_BLOCK_SELL_FIELD_V1_END -->

        <div class="col-md-4">
          <label class="form-label">Max place attempts</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.max_place_attempts">
        </div>

        <div class="col-md-4">
          <label class="form-label">Min hold (minutes)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.min_hold_minutes">
        </div>

        <div class="col-md-4">
          <label class="form-label">Max hold (minutes)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.max_hold_minutes">
        </div>

        <div class="col-md-4">
          <label class="form-label">Min hold (days)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.min_hold_days">
        </div>

        <div class="col-12">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.use_extended_hours" id="sx_ext">
            <label class="form-check-label" for="sx_ext">Use extended hours</label>
          </div>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.avoid_daytrades" id="sx_pdt">
            <label class="form-check-label" for="sx_pdt">Avoid day trades (PDT-safe)</label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TARGET / STOPS / TRAILING -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-graph-up-arrow"></i> Profit / Stops / Trailing</div>
      <span class="badge bg-secondary">Primary exit mechanics</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Target gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.target_gain_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Target (bps)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.target_bps">
        </div>

        <div class="col-md-4">
          <label class="form-label">Base stop (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.base_stop_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Stop (bps)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.stop_bps">
        </div>

        <div class="col-md-4">
          <div class="form-check form-switch mt-4">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.enable_trailing" id="sx_trail">
            <label class="form-check-label" for="sx_trail">Enable trailing</label>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label">Trailing (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.trailing_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Trail arm gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.trail_arm_gain_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Trail backoff (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.trail_backoff_pct">
        </div>

        <div class="col-12"><hr class="my-2"></div>

        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.enable_timeout_exits" id="sx_timeout">
            <label class="form-check-label" for="sx_timeout">Enable timeout exits</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Timeout exit (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.timeout_exit_pct">
        </div>
      </div>
    </div>
  </div>

  <!-- PROTECT / INTRADAY STOPS -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-life-preserver"></i> Protect (post-entry safety)</div>
      <span class="badge bg-secondary">After N minutes</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Protect after (mins)</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.sell_protect_after_mins">
        </div>
        <div class="col-md-4">
          <label class="form-label">Protect min gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.protect_min_gain_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Protect trail arm (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.protect_trail_arm_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Protect trail (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.protect_trail_pct">
        </div>

        <div class="col-12"><hr class="my-2"></div>

        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.allow_intraday_stop" id="sx_idstop">
            <label class="form-check-label" for="sx_idstop">Allow intraday stop</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Intraday stop (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.intraday_stop_pct">
        </div>

        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="sell_guard.allow_intraday_stoploss" id="sx_idsl">
            <label class="form-check-label" for="sx_idsl">Allow intraday stoploss</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Intraday stoploss (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.intraday_stoploss_pct">
        </div>
      </div>
    </div>
  </div>

  <!-- ARM RULES -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-lightning-charge"></i> Arm Rules</div>
      <span class="badge bg-secondary">Escalation after time/gain</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">After minutes</label>
          <input type="number" step="1" class="form-control" data-path="sell_guard.arm_rules.after_minutes">
        </div>
        <div class="col-md-4">
          <label class="form-label">If gain &lt; (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.arm_rules.if_gain_lt_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">If gain ≥ (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.arm_rules.if_gain_gte_pct">
        </div>

        <div class="col-md-4">
          <label class="form-label">Arm hard stop (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.arm_rules.arm_hard_stop_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Arm trailing (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="sell_guard.arm_rules.arm_trailing_pct">
        </div>
      </div>
    </div>
  </div>

  <!-- STALE RELIEF -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-hourglass-split"></i> Stale Relief Exit</div>
      <span class="badge bg-secondary">Bag cleanup</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" data-path="stale_relief_exit.enabled" id="sr_on">
            <label class="form-check-label" for="sr_on">Enabled</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Min hold (days)</label>
          <input type="number" step="1" class="form-control" data-path="stale_relief_exit.min_hold_days">
        </div>
        <div class="col-md-4">
          <label class="form-label">Relief gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="stale_relief_exit.relief_gain_pct">
        </div>

        <div class="col-md-4">
          <label class="form-label">Runner max gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="stale_relief_exit.runner_max_gain_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Regime conf max</label>
          <input type="number" step="1" class="form-control" data-path="stale_relief_exit.regime_conf_max">
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch mt-4">
            <input class="form-check-input" type="checkbox" data-path="stale_relief_exit.require_non_trend_regime" id="sr_nt">
            <label class="form-check-label" for="sr_nt">Require non-TREND regime</label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-cpu"></i> AI (Exit Advisor)</div>
      <span class="badge bg-secondary">Exits</span>
    </div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.enabled" id="ai_on">
            <label class="form-check-label" for="ai_on">Enabled</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.use_exits" id="ai_ex">
            <label class="form-check-label" for="ai_ex">Use for exits</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.use_entries" id="ai_en">
            <label class="form-check-label" for="ai_en">Use for entries (SELL file)</label>
          </div>
        </div>
        <div class="col-12">
          <div class="form-text">Note: Exit overlay multipliers are persisted in BUY live settings files (source of truth), but edited here for convenience.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- REGIME EXIT OVERLAY -->
  <div class="card mb-4" id="mm-regime-exit-overlay-card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-speedometer2"></i> Regime Exit Overlay</div>
      <span class="badge bg-secondary">Multipliers</span>
    </div>
    <div class="card-body">
      <div class="text-muted small mb-2">These multiply Sell Guard behavior by market regime.</div>
      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle">
          <thead>
            <tr>
              <th style="width:120px;">Regime</th>
              <th>Stop mult</th>
              <th>Target mult</th>
              <th>Time mult</th>
            </tr>
          </thead>
          <tbody>
            {% for r in ["TREND","CHOP","DEAD","UNKNOWN"] %}
            <tr>
              <td class="fw-semibold">{{ r }}</td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.stop_mult"></td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.target_mult"></td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.time_mult"></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="small text-muted">Tip: To “let winners run” in TREND, raise target_mult and time_mult while keeping stop_mult reasonable.</div>
    </div>
  </div>


  <!-- MM_TRADE_OUTCOME_CARD_V1_START -->
  <div class="card mb-4" id="mm-trade-outcome-card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-bar-chart-steps"></i> Trade Outcome Overlay</div>
      <span class="badge bg-secondary">Recent exits</span>
    </div>
    <div class="card-body">
      <div class="small text-muted mb-2">
        Recent closed exits with best-available exit-rule context from the DB.
      </div>
      <div id="mm-too-note" class="small mb-2" style="color:#f5d400;"></div>
      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle mb-0">
          <thead>
            <tr>
              <th style="width:170px;">Time (ET)</th>
              <th style="width:90px;">Symbol</th>
              <th style="width:130px;">Exit rule</th>
              <th style="width:90px;">Regime</th>
              <th style="width:90px;">Mode</th>
              <th style="width:90px;">P/L %</th>
              <th>Event</th>
            </tr>
          </thead>
          <tbody id="mm-too-body">
            <tr><td colspan="7" class="text-muted">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- MM_TRADE_OUTCOME_CARD_V1_END -->

</div>

<script>
(function(){
  const GROUP = "sell";

  function qs(id){ return document.getElementById(id); }
  function showError(msg){
    const el = qs("mm-error");
    el.textContent = msg || "";
    el.classList.toggle("d-none", !msg);
  }
  function setStatus(msg){
    qs("mm-status").textContent = msg || "";
  }


  // MM_TRADE_OUTCOME_JS_V1
  function mmEsc(s){
    return String(s == null ? "" : s)
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#39;");
  }

  function mmTooClass(reason){
    const r = String(reason||"").toLowerCase();
    if(r.includes("target")) return "style=\"color:#52d273;font-weight:700;\"";
    if(r.includes("trail")) return "style=\"color:#6cb8ff;font-weight:700;\"";
    if(r.includes("stop")) return "style=\"color:#ff7a7a;font-weight:700;\"";
    if(r.includes("timeout")) return "style=\"color:#ffbe5c;font-weight:700;\"";
    if(r.includes("stale")) return "style=\"color:#d78cff;font-weight:700;\"";
    if(r.includes("protect")) return "style=\"color:#7ce2d1;font-weight:700;\"";
    if(r.includes("ai")) return "style=\"color:#73d5ff;font-weight:700;\"";
    return "";
  }

  async function fetchTradeOutcomes(){
    const body = qs("mm-too-body");
    const note = qs("mm-too-note");
    if(!body) return;
    body.innerHTML = '<tr><td colspan="7" class="text-muted">Loading…</td></tr>';
    if(note) note.textContent = "";
    try{
      const res = await fetch(`/api/settings/trade_outcomes?limit=20&v=${Date.now()}`, {cache:"no-store"});
      const txt = await res.text();
      let j = null;
      try{ j = JSON.parse(txt); } catch(e){ j = null; }
      if(!res.ok || !j || !j.ok){
        throw new Error((j && j.error) ? j.error : (`HTTP ${res.status}`));
      }
      const rows = Array.isArray(j.rows) ? j.rows : [];
      if(note){
        note.textContent = rows.length
          ? 'Color key: target green, trailing blue, stop red, timeout orange, stale purple, protect teal, AI cyan.'
          : 'No recent closed exits found.';
      }
      if(!rows.length){
        body.innerHTML = '<tr><td colspan="7" class="text-muted">No recent closed exits found.</td></tr>';
        return;
      }
      body.innerHTML = rows.map(r => `
        <tr>
          <td>${mmEsc(r.time_et || "")}</td>
          <td><strong>${mmEsc(r.symbol || "")}</strong></td>
          <td ${mmTooClass(r.exit_reason)}>${mmEsc(r.exit_reason || "")}</td>
          <td>${mmEsc(r.regime || "")}</td>
          <td>${mmEsc(r.mode || "")}</td>
          <td>${mmEsc(r.pnl_pct || "")}</td>
          <td>${mmEsc(r.event || "")}</td>
        </tr>
      `).join("");
    }catch(err){
      if(note) note.textContent = "Trade outcomes unavailable.";
      body.innerHTML = `<tr><td colspan="7" class="text-danger">${mmEsc(err.message || String(err))}</td></tr>`;
    }
  }


  function getPath(obj, path){
    if(!obj) return undefined;
    const parts = (path||"").split(".");
    let cur = obj;
    for(const p of parts){
      if(cur == null) return undefined;
      cur = cur[p];
    }
    return cur;
  }
  function setPath(obj, path, val){
    const parts = (path||"").split(".");
    let cur = obj;
    for(let i=0;i<parts.length;i++){
      const p = parts[i];
      if(i === parts.length-1){
        cur[p] = val;
      } else {
        if(typeof cur[p] !== "object" || cur[p] === null) cur[p] = {};
        cur = cur[p];
      }
    }
  }


  // MM_HOUR_BLOCK_SELL_JS_V1
  function mmHoursToCsv(arr){
    if (!Array.isArray(arr)) return "";
    return arr
      .map(v => Number(v))
      .filter(v => Number.isFinite(v) && v >= 0 && v <= 23)
      .join(",");
  }

  function mmCsvToHours(s){
    return String(s || "")
      .split(",")
      .map(x => x.trim())
      .filter(Boolean)
      .map(x => Number(x))
      .filter(v => Number.isFinite(v) && v >= 0 && v <= 23);
  }

  function profile(){
    return (qs("mm-profile").value || "day").toLowerCase();
  }

  async function apiLoad(){
    showError("");
    setStatus("Loading…");
    const url = `/api/settings/load?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile())}`;
    const res = await fetch(url, {cache:"no-store"});
    const ct = (res.headers.get("content-type")||"").toLowerCase();
    const bodyText = await res.text();
    if(!res.ok){
      throw new Error(`HTTP ${res.status} ${res.statusText}: ${bodyText.slice(0,400)}`);
    }
    let j = null;
    try{
      j = ct.includes("application/json") ? JSON.parse(bodyText) : JSON.parse(bodyText);
    }catch(e){
      throw new Error("Non-JSON response from /api/settings/load");
    }
    if(!j.ok) throw new Error(j.error || "Load failed");
    window.__MM_DATA__ = j.data || {};
    hydrateForm();
    setStatus(`Editing: SELL / ${j.profile.toUpperCase()}`);
  }

  function parseInputValue(el){
    const path = el.getAttribute("data-path") || "";
    const raw = (el.type === "checkbox") ? el.checked : el.value;

    // numbers
    if(el.type === "number"){
      if(raw === "" || raw === null || raw === undefined) return 0;
      const n = Number(raw);
      return Number.isFinite(n) ? n : 0;
    }
    // booleans
    if(el.type === "checkbox") return !!raw;

    // strings default
    return String(raw ?? "");
  }

  function hydrateForm(){
    const data = window.__MM_DATA__ || {};
    const inputs = document.querySelectorAll("[data-path]");
    inputs.forEach(el => {
      const path = el.getAttribute("data-path");
      const v = getPath(data, path);
      if(el.type === "checkbox"){
        el.checked = !!v;
      } else {
        el.value = (v === undefined || v === null) ? "" : v;
      }
    });

    try {
      const el = document.getElementById("avoidSellHours");
      if (el) el.value = mmHoursToCsv(getPath(data, "sell_guard.avoid_sell_hours") || []);
    } catch(e) {}
  }

  function collectForm(){
    const base = window.__MM_DATA__ || {};
    const data = JSON.parse(JSON.stringify(base)); // clone
    const inputs = document.querySelectorAll("[data-path]");
    inputs.forEach(el => {
      const path = el.getAttribute("data-path");
      const v = parseInputValue(el);
      setPath(data, path, v);
    });

    try {
      const el = document.getElementById("avoidSellHours");
      if (el) setPath(data, "sell_guard.avoid_sell_hours", mmCsvToHours(el.value));
    } catch(e) {}

    return data;
  }

  async function apiSave(){
    showError("");
    setStatus("Saving…");
    const data = collectForm();
    const url = `/api/settings/save?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile())}`;
    const res = await fetch(url, {
      method: "POST",
      headers: {"content-type":"application/json"},
      body: JSON.stringify(data)
    });
    const bodyText = await res.text();
    if(!res.ok){
      throw new Error(`HTTP ${res.status} ${res.statusText}: ${bodyText.slice(0,400)}`);
    }
    let j = null;
    try{ j = JSON.parse(bodyText); } catch(e){ j = {ok:false, error:"Non-JSON save response"}; }
    if(!j.ok) throw new Error(j.error || "Save failed");
    setStatus(`Editing: SELL / ${profile().toUpperCase()}`);
    // reload so persisted overlay comes back in
    await apiLoad();
  }

  qs("mm-reload").addEventListener("click", (e)=>{ e.preventDefault(); apiLoad().catch(err=>{ showError(err.message||String(err)); setStatus(""); });});
  qs("mm-save").addEventListener("click", (e)=>{ e.preventDefault(); apiSave().catch(err=>{ showError(err.message||String(err)); setStatus(""); });});

  document.addEventListener("DOMContentLoaded", ()=>{
    apiLoad().catch(err=>{ showError(err.message||String(err)); setStatus(""); });
    try{ fetchTradeOutcomes(); }catch(e){}
  });
})();
</script>

