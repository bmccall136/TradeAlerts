{# analytics_regime_layout.html (clean, stable) #}
{% extends "layout.html" %}

{# Optional: pages can override analytics_tape to render tape at true top slot in layout.html #}
{% block analytics_tape %}{% endblock %}

{% block content %}
{# === MM_REGIME_LAYOUT_CLEAN_V1_START === #}
<div class="mm-ax-page">
  <div class="mm-ax-container">
    {% block analytics_body %}
      {# If a page extends this layout but doesn?t define analytics_body,
         it can just put everything in its own {% block content %} instead. #}
    {% endblock %}
  </div>
</div>

<style>
  /* Scoped to this layout only */
  .mm-ax-page{
    width:100%;
    display:block;
  }
  .mm-ax-container{
    width:100%;
    max-width:1400px;
    margin:0 auto;
    padding:16px;
  }
</style>
{# === MM_REGIME_LAYOUT_CLEAN_V1_END === #}
{% endblock %}
