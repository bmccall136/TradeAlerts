﻿{% extends "layout.html" %}

{% block analytics_tape %}
  <div id="mm-ax-tape-wrap" style="margin:0 14px 10px 14px;">
    <div id="mm-ax-tape-inner"></div>
  </div>
{% endblock %}


<!-- MM_REGIME_LAYOUT_NAV_AND_CENTER_V1_START -->
<style>
  .mm-ax-container{
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 16px 24px 16px;
  }
  .mm-ax-navbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin: 10px auto 14px auto;
    max-width: 1180px;
    padding: 0 16px;
  }
  .mm-ax-navbar .mm-ax-left,
  .mm-ax-navbar .mm-ax-right{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
  }
</style>

<div class="mm-ax-navbar">
  <div class="mm-ax-left">
    <a class="btn btn-sm btn-outline-info" href="/analytics" title="Daily Analytics">Daily</a>
    <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
    <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>
    <a class="btn btn-sm btn-outline-info" href="/analytics/buy_regime">Buy Regime</a>
    <a class="btn btn-sm btn-outline-info" href="/analytics/sell_regime">Sell Regime</a>
  </div>

  <div class="mm-ax-right">
    {# Regime pages use bucket buttons (not date picker) #}
    <a class="btn btn-sm btn-warning" href="?bucket=today">Today</a>
    <a class="btn btn-sm btn-warning" href="?bucket=7d">7D</a>
    <a class="btn btn-sm btn-warning" href="?bucket=30d">30D</a>
    <a class="btn btn-sm btn-warning" href="?bucket=all">ALL</a>
  </div>
</div>
<!-- MM_REGIME_LAYOUT_NAV_AND_CENTER_V1_END -->

{% block content %}
<div class="mm-ax-container">
<div class="container-fluid py-3">

  <div class="d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-2">
      <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
      <div>
        <div class="h4 mb-0">{% block analytics_title %}Regime Analytics
</div>
{% endblock %}</div>
        <div class="text-secondary small">{% block analytics_subtitle %}Today{% endblock %}</div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
      <a class="btn btn-sm btn-outline-info" href="/analytics">Daily</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy_regime">Buy Regime</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell_regime">Sell Regime</a>

      {# Regime pages have buckets instead of date controls #}
      <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-warning" href="?bucket=today">Today</a>
        <a class="btn btn-sm btn-outline-warning" href="?bucket=7d">7D</a>
        <a class="btn btn-sm btn-outline-warning" href="?bucket=30d">30D</a>
        <a class="btn btn-sm btn-outline-warning" href="?bucket=all">All</a>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <div style="width:100%; max-width:1180px;">
      {% block analytics_body %}{% endblock %}
    </div>
  </div>

</div>
{% endblock %}
