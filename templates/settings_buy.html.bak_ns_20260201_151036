{% extends "layout.html" %}
{% block content %}
<div class="settings-page" data-group="buy">
  <div class="settings-header">
    <div class="settings-title">? Settings ? BUY</div>
    <div class="settings-profile">
      <label>Profile</label>
      <select id="profileSel">
        <option value="day">DAY</option>
        <option value="swing">SWING</option>
      </select>
    </div>
  </div>

  <!-- SECTION 1: Signal Scoreboard (always visible) -->
  <div class="card">
    <div class="card-h">Signal Scoreboard</div>
    <div class="card-sub">Counts increment even if disabled. Toggles affect eligibility only.</div>

    <div class="row">
      <label>Bucket</label>
      <select id="bucketSel">
        <option value="today" selected>TODAY</option>
        <option value="7d">7D</option>
        <option value="30d">30D</option>
        <option value="all">ALL</option>
      </select>
      <div class="hint" id="bucketHint"></div>
    </div>

    <div id="scoreboard" class="mono"></div>
  </div>

  <!-- SECTION 2: Required Signals Gate -->
  <div class="card">
    <div class="card-h">Required Signals Gate</div>
    <div class="card-sub">Minimum number of ON signals that must fire before we consider a trade.</div>

    <div id="requiredList" class="mono"></div>

    <div class="row">
      <label>Minimum required</label>
      <select id="minReqSel"></select>
    </div>
  </div>

  <!-- SECTION 3: Settings (boring by design) -->
  <div class="card">
    <div class="card-h">Settings</div>
    <div class="card-sub">Grouped. No raw JSON.</div>

    <div id="settingsGroups"></div>

    <div class="actions">
      <button id="saveBtn" class="btn-primary">Save</button>
      <span id="saveMsg" class="hint"></span>
    </div>
  </div>
</div>

<style>
  .settings-page { max-width: 1100px; margin: 0 auto; padding: 16px; }
  .settings-header { display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px; }
  .settings-title { font-size: 1.2rem; font-weight: 700; }
  .settings-profile label { margin-right: 8px; opacity:.85; }
  .card { background:#131522; border:1px solid #22253a; border-radius: 10px; padding: 14px; margin-bottom: 12px; }
  .card-h { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
  .card-sub { opacity: .85; margin-bottom: 10px; }
  .row { display:flex; align-items:center; gap: 10px; margin: 8px 0; }
  label { min-width: 150px; opacity:.9; }
  select, input[type="number"], input[type="text"] {
    background:#0d0f1a; color:#eaeaea; border:1px solid #2a2f4a; border-radius: 8px;
    padding: 6px 10px; outline:none;
  }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono"; }
  .sb-row { display:flex; justify-content:space-between; gap: 12px; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
  .sb-left { display:flex; gap: 10px; align-items:center; }
  .pill { padding: 2px 8px; border-radius: 999px; font-size: .85rem; border: 1px solid #2a2f4a; }
  .pill.on { color:#0f0; }
  .pill.off { color:#f55; }
  .fires { color: #ffe900; }
  .hint { opacity:.8; }
  .group { border-top: 1px solid rgba(255,255,255,.08); padding-top: 10px; margin-top: 10px; }
  .group h4 { margin: 0 0 8px 0; font-size: 1rem; }
  .kv { display:grid; grid-template-columns: 260px 1fr; gap: 10px; align-items:center; margin: 6px 0; }
  .actions { display:flex; align-items:center; gap: 12px; margin-top: 12px; }
  .btn-primary { background:#ffe900; color:#111; border:none; border-radius: 8px; padding: 8px 14px; font-weight:700; cursor:pointer; }
</style>

<script>
(function(){
  const group = document.querySelector(".settings-page").dataset.group; // buy
  const profileSel = document.getElementById("profileSel");
  const bucketSel = document.getElementById("bucketSel");
  const bucketHint = document.getElementById("bucketHint");
  const scoreboardEl = document.getElementById("scoreboard");
  const requiredListEl = document.getElementById("requiredList");
  const minReqSel = document.getElementById("minReqSel");
  const settingsGroupsEl = document.getElementById("settingsGroups");
  const saveBtn = document.getElementById("saveBtn");
  const saveMsg = document.getElementById("saveMsg");

  const INDICATORS = [
    { key: "MACD",  onKeys: ["enable_macd","macd_enabled","use_macd","has_macd"] },
    { key: "RSI",   onKeys: ["enable_rsi","rsi_enabled","use_rsi","has_rsi"] },
    { key: "VWAP",  onKeys: ["enable_vwap","vwap_enabled","use_vwap","has_vwap"] },
    { key: "BB",    onKeys: ["enable_bb","bb_enabled","bollinger_enabled","use_bb","has_bb"] },
    { key: "ADX",   onKeys: ["enable_adx","adx_enabled","use_adx","has_adx"] },
    { key: "VOL",   onKeys: ["enable_vol","vol_enabled","volume_enabled","use_vol","has_vol","enable_volume"] },
  ];

  let currentSettings = null;

  function qs(){
    const profile = profileSel.value;
    return `group=${encodeURIComponent(group)}&profile=${encodeURIComponent(profile)}`;
  }

  async function loadSettings(){
    saveMsg.textContent = "";
    const r = await fetch(`/api/settings/load?${qs()}`);
    const j = await r.json();
    currentSettings = j && j.data ? j.data : (j || {});
  }

  function getOnState(ind){
    for (const k of ind.onKeys){
      if (k in currentSettings) return !!currentSettings[k];
    }
    return false;
  }

  function setOnState(ind, val){
    for (const k of ind.onKeys){
      if (k in currentSettings){
        currentSettings[k] = !!val;
        return;
      }
    }
    // prefer a canonical key if none existed
    currentSettings[`enable_${ind.key.toLowerCase()}`] = !!val;
  }

  async function loadScoreboard(){
    const bucket = bucketSel.value;
    const r = await fetch(`/api/settings/scoreboard?bucket=${encodeURIComponent(bucket)}`);
    const j = await r.json();
    const counts = (j && j.counts) ? j.counts : {};
    const total = (j && j.total) ? j.total : 0;

    bucketHint.textContent = `Total fires: ${total}`;

    scoreboardEl.innerHTML = "";
    INDICATORS.forEach(ind => {
      const on = getOnState(ind);
      const c = counts[ind.key] || 0;
      const row = document.createElement("div");
      row.className = "sb-row";
      row.innerHTML = `
        <div class="sb-left">
          <div style="width:70px">${ind.key}</div>
          <span class="pill ${on ? "on":"off"}">${on ? "ON":"OFF"}</span>
          <label style="display:flex;align-items:center;gap:8px; cursor:pointer;">
            <input type="checkbox" ${on ? "checked":""} data-ind="${ind.key}" />
            <span style="opacity:.9">eligible</span>
          </label>
        </div>
        <div class="fires">fires: ${c}</div>
      `;
      scoreboardEl.appendChild(row);
    });

    // wire toggles
    scoreboardEl.querySelectorAll("input[type=checkbox][data-ind]").forEach(cb => {
      cb.addEventListener("change", (e) => {
        const key = e.target.getAttribute("data-ind");
        const ind = INDICATORS.find(x => x.key === key);
        if (!ind) return;
        setOnState(ind, e.target.checked);
        // re-render scoreboard + required gate only (no API call needed)
        renderRequiredGate();
        loadScoreboard(); // re-render pills
      });
    });
  }

  function renderRequiredGate(){
    // enabled indicators only
    const enabled = INDICATORS.filter(ind => getOnState(ind));
    requiredListEl.innerHTML = enabled.length
      ? enabled.map(ind => `[\u2713] ${ind.key}`).join("<br>")
      : "<span class='hint'>No indicators enabled.</span>";

    // min required dropdown: 1..N (default 1)
    const n = Math.max(1, enabled.length);
    const cur = (currentSettings.required_signals_min ?? currentSettings.min_required_signals ?? 1) | 0;
    minReqSel.innerHTML = "";
    for (let i=1; i<=n; i++){
      const opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = String(i);
      if (i === Math.min(Math.max(cur,1), n)) opt.selected = true;
      minReqSel.appendChild(opt);
    }
    // store on change
    minReqSel.onchange = () => {
      currentSettings.required_signals_min = parseInt(minReqSel.value, 10) || 1;
    };

    if (!("required_signals_min" in currentSettings) && ("min_required_signals" in currentSettings)){
      // normalize legacy key to our canonical one (kept only in memory until save)
      currentSettings.required_signals_min = currentSettings.min_required_signals;
    }
    if (!("required_signals_min" in currentSettings)){
      currentSettings.required_signals_min = 1;
    }
  }

  function buildGroups(){
    // Render only keys that exist (no placeholders).
    // Grouping is heuristic by key prefix.
    const keys = Object.keys(currentSettings || {});
    const groups = [
      { title: "Indicator Parameters", match: k => /^(rsi_|macd_|bb_|bollinger|vwap_)/i.test(k) && !/enable_|enabled|use_/i.test(k) },
      { title: "Risk / Trade Controls", match: k => /(max_per_trade|single_entry|pyramids|risk|exposure|budget|qty)/i.test(k) },
      { title: "Timing", match: k => /(sell_after|days|poll|interval|sleep|cooldown|timeout)/i.test(k) },
    ];

    function renderKV(k){
      const v = currentSettings[k];
      const id = "k_" + k.replace(/[^a-z0-9_]/gi, "_");

      if (typeof v === "boolean"){
        return `
          <div class="kv">
            <div>${k}</div>
            <label style="display:flex;gap:8px;align-items:center;">
              <input type="checkbox" id="${id}" ${v ? "checked":""}/>
              <span>${v ? "ON":"OFF"}</span>
            </label>
          </div>`;
      }

      if (typeof v === "number"){
        return `
          <div class="kv">
            <div>${k}</div>
            <input type="number" id="${id}" value="${v}" step="1"/>
          </div>`;
      }

      // string / other
      return `
        <div class="kv">
          <div>${k}</div>
          <input type="text" id="${id}" value="${String(v ?? "")}"/>
        </div>`;
    }

    settingsGroupsEl.innerHTML = "";
    for (const g of groups){
      const gKeys = keys.filter(k => g.match(k));
      if (!gKeys.length) continue;

      const wrap = document.createElement("div");
      wrap.className = "group";
      wrap.innerHTML = `<h4>${g.title}</h4>` + gKeys.map(renderKV).join("");
      settingsGroupsEl.appendChild(wrap);
    }

    // wire inputs back into currentSettings
    for (const k of keys){
      const id = "k_" + k.replace(/[^a-z0-9_]/gi, "_");
      const el = document.getElementById(id);
      if (!el) continue;

      if (el.type === "checkbox"){
        el.onchange = () => { currentSettings[k] = !!el.checked; };
      } else if (el.type === "number"){
        el.onchange = () => {
          const n = parseFloat(el.value);
          currentSettings[k] = isNaN(n) ? currentSettings[k] : n;
        };
      } else {
        el.onchange = () => { currentSettings[k] = el.value; };
      }
    }
  }

  async function save(){
    saveMsg.textContent = "Saving...";
    const r = await fetch(`/api/settings/save?${qs()}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(currentSettings || {})
    });
    const j = await r.json().catch(() => ({}));
    saveMsg.textContent = (j && j.ok) ? "Saved ?" : ("Save failed ?");
    setTimeout(() => { saveMsg.textContent = ""; }, 2500);
  }

  async function refreshAll(){
    await loadSettings();
    renderRequiredGate();
    await loadScoreboard();
    buildGroups();
  }

  profileSel.onchange = refreshAll;
  bucketSel.onchange = loadScoreboard;
  saveBtn.onclick = save;

  refreshAll();
})();
</script>
{% endblock %}
