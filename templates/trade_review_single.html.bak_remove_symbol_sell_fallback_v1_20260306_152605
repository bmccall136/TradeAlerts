<script>
(function(){
  function q(name){
    try{ return (new URLSearchParams(window.location.search||"")).get(name) || ""; }
    catch(e){ return ""; }
  }
  function esc(s){
    return String(s||"").replace(/[&<>"']/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c];
    });
  }
  function money(x){
    try{
      if(x==null || x==="") return "";
      var n = Number(x);
      if(!isFinite(n)) return "";
      return n.toFixed(2);
    }catch(e){ return ""; }
  }

  function renderList(rows){
    if(!rows || !rows.length) return "";
    return rows.map(function(r){
      var t = esc(r.time_et || "");
      var p = (r.price!=null) ? ("$" + money(r.price)) : "";
      var s = esc(r.signals_pretty || "");
      return "<div class='mm-trv-row'><div class='mm-trv-line1'><span class='mm-trv-time'>" + t +
             "</span><span class='mm-trv-price'>" + p + "</span></div><div class='mm-trv-sig'>" + s + "</div></div>";
    }).join("");
  }

  function clearNoTriggersText(root){
    if(!root) return;
    Array.from(root.querySelectorAll(".tr-empty")).forEach(function(el){ el.style.display="none"; });
    Array.from(root.querySelectorAll("*")).forEach(function(el){
      if(el.childElementCount !== 0) return;
      var t = (el.textContent||"").trim();
      if(/^No (buy|sell) triggers found\.?$/i.test(t)) el.textContent = "";
      if(/^No triggers found\.?$/i.test(t)) el.textContent = "";
    });
  }

  function mountIntoBlocks(buyRows, sellRows){
    var blocks = Array.from(document.querySelectorAll(".tr-triggers-block"));
    if(blocks.length >= 1){
      var buyBox = document.getElementById("mm-trv-buy-box");
      if(!buyBox){
        buyBox = document.createElement("div");
        buyBox.id = "mm-trv-buy-box";
        blocks[0].prepend(buyBox);
      }
      buyBox.innerHTML = renderList(buyRows) || "<div class='mm-muted'>No triggers found.</div>";
      if(buyRows && buyRows.length) clearNoTriggersText(blocks[0]);
    }
    if(blocks.length >= 2){
      var sellBox = document.getElementById("mm-trv-sell-box");
      if(!sellBox){
        sellBox = document.createElement("div");
        sellBox.id = "mm-trv-sell-box";
        blocks[1].prepend(sellBox);
      }
      sellBox.innerHTML = renderList(sellRows) || "<div class='mm-muted'>No triggers found.</div>";
      if(sellRows && sellRows.length) clearNoTriggersText(blocks[1]);
    }
  }

  function setMeta(meta){
    try{
      var title = document.querySelector(".tr-title");
      if(title && meta && meta.symbol){
        title.textContent = "Trade Review — " + String(meta.symbol || "").toUpperCase();
      }

      var sub = document.querySelector(".tr-sub");
      if(!sub || !meta) return;

      var buyPx  = meta.anchor_buy_price;
      var sellPx = meta.anchor_sell_price;
      var qty    = meta.anchor_qty;

      try{
        if((sellPx == null || Number(sellPx||0) === 0) && meta.anchor_sell_price != null){
          sellPx = meta.anchor_sell_price;
        }
      }catch(e){}

      Array.from(sub.querySelectorAll("span")).forEach(function(sp){
        var t = (sp.textContent||"").trim();
        if(/^Buy:\s*@/i.test(t) && buyPx!=null)  sp.textContent = "Buy:  @ " + money(buyPx);
        if(/^Sell:\s*@/i.test(t) && sellPx!=null) sp.textContent = "Sell:  @ " + money(sellPx);
        if(/^Qty:\s*/i.test(t) && qty!=null) sp.textContent = "Qty: " + qty;
      });

      if(buyPx!=null && sellPx!=null){
        var pnl = Number(sellPx) - Number(buyPx);
        var pct = (Number(buyPx) !== 0) ? (pnl / Number(buyPx) * 100.0) : 0;
        var pnlSpan = Array.from(sub.querySelectorAll("span")).find(function(sp){
          return /^P&L:/i.test((sp.textContent||"").trim());
        });
        if(pnlSpan){
          pnlSpan.textContent = "P&L: " + pnl.toFixed(2) + " (" + pct.toFixed(2) + "%)";
        }
      }

      // If we *can* canonicalize to /trade_review/trade/<id>, do it (no reload)
      try{
        if(meta.anchor_trade_id){
          var tid = String(meta.anchor_trade_id);
          if(tid && !/\/trade_review\/trade\/\d+/i.test(window.location.pathname||"")){
            window.history.replaceState({}, "", "/trade_review/trade/" + encodeURIComponent(tid));
          }
        }
      }catch(_e){}
    }catch(e){}
  }

  function buildApiUrl(){
    var path = String(window.location.pathname||"");
    var m = path.match(/\/trade_review\/trade\/(\d+)/i);
    if(m && m[1]){
      return "/api/trade_review?trade_id=" + encodeURIComponent(m[1]);
    }

    var sym = q("symbol");
    var ts  = q("ts");
    if(!sym) return "";
    var url = "/api/trade_review?symbol=" + encodeURIComponent(sym);
    if(ts) url += "&ts=" + encodeURIComponent(ts);
    return url;
  }

  function run(){
    var url = buildApiUrl();
    if(!url) return;

    fetch(url, {cache:"no-store"})
      .then(function(res){ return res.ok ? res.json() : Promise.reject("HTTP " + res.status); })
      .then(function(j){
        const _meta = j.meta || {};
        const _tradeId = String((_meta.anchor_trade_id != null ? _meta.anchor_trade_id : "")).trim();
        const _symbol  = String((_meta.symbol || "")).trim().toUpperCase();

        let _sellRows = Array.isArray(j.sell_triggers) ? j.sell_triggers.slice() : [];
        if(!_sellRows.length){
          const _sells = Array.isArray(j.sells) ? j.sells : [];
          let _match = null;

          if(_tradeId){
            _match = _sells.find(function(r){
              return String((r && r.trade_id != null ? r.trade_id : "")).trim() === _tradeId;
            }) || null;
          }
          if(!_match && _symbol){
            _match = _sells.find(function(r){
              return String((r && r.symbol || "")).trim().toUpperCase() === _symbol;
            }) || null;
          }

          if(_match){
            _sellRows = [{
              time_et: _match.time_et || "",
              price: _match.price,
              signals_pretty: (_match.reason || _match.source || "SELL from DB")
            }];

            if(!_meta.anchor_sell_time_et && _match.time_et){
              _meta.anchor_sell_time_et = _match.time_et;
            }
            if((_meta.anchor_sell_price == null || Number(_meta.anchor_sell_price || 0) === 0) && _match.price != null){
              _meta.anchor_sell_price = _match.price;
            }
          }
        }

        mountIntoBlocks(j.buy_triggers || [], _sellRows);
        setMeta(_meta);
      })
      .catch(function(err){
        console.log("MM_TRV_SINGLE_HYDRATE_SYMBOL_TS_V2_TRADEID fetch failed:", err);
      });
  }

  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", run);
  else run();
})();
</script>
