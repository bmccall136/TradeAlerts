{% extends "layout.html" %}
{% block content %}

<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-4" style="min-height:54px; position:relative;">

    <!-- Left: (now empty to match layout spacing; you can remove entirely if desired) -->
    <div></div>

    <!-- Center: title (no badge) -->
    <h2 class="text-warning mb-0 position-absolute start-50 translate-middle-x" style="width:fit-content;">
      Live Dashboard
    </h2>

    <!-- Right: Account type + E*TRADE status block (keep as you have it) -->
    <div class="d-flex flex-column align-items-end" style="gap:6px; min-width: 220px;">
      <div class="fw-bold" style="white-space: nowrap;">
        Account type: {{ account.get('account_type_display') or account.get('account_type') or 'Cash' }}
      </div>
      <div class="status-block" style="background:#000;color:#ffd600;padding:8px;border-radius:6px;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <div>E*TRADE API</div>
          <div style="color:#39d353;">●</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== Live KPIs (2 columns) ===== -->
<div class="kpi-grid">
  <!-- Cash -->
  <div class="kpi-card">
    <div class="kpi-title">Cash</div>

    <div class="kv">
      <span class="label">Buying Power</span>
      <span id="bp">${{ '{:,.2f}'.format((account or {}).get('buying_power') or 0.0) }}</span>
    </div>

    <div class="kv">
      <span class="label">Settled Cash</span>
      <span id="sc">${{ '{:,.2f}'.format((account or {}).get('settled_cash') or 0.0) }}</span>
    </div>

    {% if (account or {}).get('equity_value') is not none %}
    <div class="kv">
      <span class="label">Equity Value</span>
      <span id="eq">${{ '{:,.2f}'.format((account or {}).get('equity_value') or 0.0) }}</span>
    </div>
    {% endif %}

    {% if (account or {}).get('account_id') %}
    <div class="kv muted">
      <span class="label">Account</span>
      <span>****{{ (account or {}).get('account_id')[-4:] }}</span>
    </div>
    {% endif %}
  </div>

	<div class="kpi-card">
	  <div class="kpi-title">P&L</div>

	  <div class="kv">
		<span class="label">Total (Cash + Positions)</span>
		</span>
		<span id="utotal" class="num"></span>
	  </div>

	  <div class="kv">
		<span class="label">Positions Value</span>
		<span id="posval" class="num"></span>
	  </div>
	  <div class="kv">
	  <span class="label">Unrealized P&L</span>
	  <span id="upnl" class="num"></span>
	</div>
	  <div class="kv">
		<span class="label">Unrealized P&L %</span>
		<span id="upct" class="num"></span>
	  </div>

	  <div class="kv">
		<span class="label">Realized P&L</span>
		<span id="rpnl" class="num"></span>
	  </div>

	  <div class="kv">
		<span class="label">Realized P&L %</span>
		<span id="rpct" class="num"></span>
	  </div>
	</div>
   </div>

<!-- ========================
</span>
<!-- Holdings (same table classes/order as Sim) -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="text-white mb-0">Holdings</h3>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Symbol</th><th>Last Price</th><th>Change</th><th>Change %</th>
        <th>Qty</th><th>Price Paid</th><th>Day Gain/Loss</th>
        <th>Total Gain/Loss</th><th>Value</th>
      </tr>
    </thead>
	<tbody id="holdings-body">
	  {# existing server-rendered rows are fine; JS will replace #}
	  {% for h in holdings or [] %}
	  <tr>
		<td>{{ h.symbol }}</td>
		<td>${{ '%.2f'|format(h.last_price or 0) }}</td>
		<td>$0.00</td>
		<td>0.00%</td>
		<td>{{ h.qty }}</td>
		<td>${{ '%.2f'|format(h.price_paid or 0) }}</td>
		<td>$0.00</td>
		<td>${{ '%.2f'|format((h.last_price - h.price_paid) * h.qty if h.qty else 0) }}</td>
		<td>${{ '%.2f'|format(h.value or (h.last_price*h.qty)) }}</td>
	  </tr>
	  {% else %}
	  <tr><td colspan="9" class="text-center">No holdings.</td></tr>
	  {% endfor %}
	</tbody>
  </table>
</div>

<!-- Recent Trades (match Sim "Trade History") -->
<h3 class="text-white mt-5 mb-3">Recent Trades</h3>
<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Time</th><th>Symbol</th><th>Action</th>
        <th>Qty</th><th>Price</th><th>P/L</th>
      </tr>
    </thead>
	<tbody id="trades-body">
	  {% for t in trades or [] %}
	  <tr>
		<td>{{ t.time }}</td>
		<td>{{ t.symbol }}</td>
		<td>{{ t.action }}</td>
		<td>{{ t.qty }}</td>
		<td>${{ '%.2f'|format(t.price or 0) }}</td>
		<td>${{ '%.2f'|format(t.pl or 0) }}</td>
	  </tr>
	  {% else %}
	  <tr><td colspan="6" class="text-center">No trades yet</td></tr>
	  {% endfor %}
	</tbody>
  </table>
</div>

<script>
(function () {
  const $ = id => document.getElementById(id);
  const money = n => '$' + Number(n ?? 0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
  const pct   = n => Number(n ?? 0).toFixed(2) + '%';

  function setMoney(id, val, colorize=false){
    const el = $(id); if (!el) return;
    el.textContent = money(val);
    if (colorize) colorizeNum(el, Number(val));
  }
  function setPct(id, val, colorize=false){
    const el = $(id); if (!el) return;
    el.textContent = pct(val);
    if (colorize) colorizeNum(el, Number(val));
  }
  function colorizeNum(el, v){
    el.classList.remove('pn-pos','pn-neg','pn-flat');
    el.classList.add(v>0 ? 'pn-pos' : v<0 ? 'pn-neg' : 'pn-flat');
  }

  async function refresh(){
    try{
      const r = await fetch('/live/status',{cache:'no-store'});
      if (!r.ok) return;
      const { account={}, metrics={}, holdings=[], trades=[] } = await r.json();

      // cash to include: prefer settled cash, else buying power
      const cash = Number(account.settled_cash ?? account.buying_power ?? 0) || 0;
      const posVal = Number(metrics.positions_value ?? 0) || 0;

      // KPIs
      setMoney('utotal', posVal + cash, false);   // neutral
      setMoney('posval', posVal, false);          // neutral
      setPct  ('upct',   metrics.unrealized_pnl_pct, true);
      setMoney('rpnl',   metrics.realized_pnl, true);
      setPct  ('rpct',   metrics.realized_pnl_pct, true);

      // holdings table (unchanged from your current)
      const hBody = $('holdings-body');
      if (hBody){
        hBody.innerHTML = '';
        if (!holdings.length){
          hBody.innerHTML = `<tr><td colspan="9" class="text-center">No holdings.</td></tr>`;
        }else{
          for (const h of holdings){
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${h.symbol ?? ''}</td>
              <td>${money(h.last_price)}</td>
              <td>${money(h.change)}</td>
              <td>${(h.change_pct!=null)? Number(h.change_pct).toFixed(2)+'%':'—'}</td>
              <td>${h.qty ?? 0}</td>
              <td>${money(h.price_paid)}</td>
              <td>${money(h.day_gain)}</td>
              <td>${money(h.total_gain)}</td>
              <td>${money(h.value)}</td>`;
            hBody.appendChild(tr);
          }
        }
      }

      // trades table (unchanged from your current)
      const tBody = $('trades-body');
      if (tBody){
        tBody.innerHTML = '';
        if (!trades.length){
          tBody.innerHTML = `<tr><td colspan="6" class="text-center">No trades yet</td></tr>`;
        }else{
          for (const t of trades){
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${t.time ?? ''}</td>
              <td>${t.symbol ?? ''}</td>
              <td>${t.action ?? ''}</td>
              <td>${t.qty ?? 0}</td>
              <td>${money(t.price)}</td>
              <td>${money(t.pl)}</td>`;
            tBody.appendChild(tr);
          }
        }
      }
    }catch(e){
      console.warn('live/status refresh failed:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refresh);
  } else {
    refresh();
  }
  setInterval(()=>{ if (document.visibilityState==='visible') refresh(); }, 10000);
})();
</script>
{% endblock %}
