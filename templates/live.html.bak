{% extends "layout.html" %}
{% block content %}
<style>
  /* Realized P&L rows: label | amount | percent  */
  .kpi-realized .rline{
    display: grid;
    grid-template-columns: 60px minmax(80px, 1fr) 56px; /* tweak widths if you like */
    column-gap: 12px;
    align-items: baseline;
  }
  /* right-align numbers and keep monospaced digits for clean columns */
  .kpi-realized .rline span:nth-child(2),
  .kpi-realized .rline span:nth-child(3){
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* tiny nudge so the amount sits “two spaces” to the right of label */
  .kpi-realized .rline span:nth-child(2){ padding-left: 8px; }

  /* slightly dim labels if you want */
  .kpi-realized .rline span:first-child{ opacity: .85; }

  /* compact a bit on narrow screens */
  @media (max-width: 576px){
    .kpi-realized .rline{
      grid-template-columns: 52px minmax(72px, 1fr) 52px;
      column-gap: 8px;
    }
  }
</style>
<style>
  /* Realized P&L aligned columns */
  .kpi-realized .rline{
    display:flex;
    align-items:baseline;
    gap:.5rem;
  }
  .kpi-realized .lbl{
    min-width:60px;        /* “Week/Month/All” column */
  }
  .kpi-realized .amt{
    margin-left:auto;      /* pushes numbers to a shared column */
    width:80px;            /* fixed width keeps $ aligned across rows */
    text-align:right;
  }
  .kpi-realized .pct{
    width:56px;            /* shared width for % column */
    text-align:right;
    color:#b8b8b8;
  }
  /* Align value & % columns; keep labels flexible */
  .kpi-realized .rline{
  display:grid;
  grid-template-columns: 1fr max-content max-content;
  gap: .5rem 1rem;
  align-items: baseline;
  }
  .kpi-realized .rline > :nth-child(2),
  .kpi-realized .rline > :nth-child(3){
  text-align: right;
  font-variant-numeric: tabular-nums;
  }
  .kpi-realized .rline > :nth-child(2){ min-width: 5.5rem; } /* $ amount column */
  .kpi-realized .rline > :nth-child(3){ min-width: 3.5rem; } /* % column */
</style>
<style>
  .since-start-blurb{
    font-size: 0.95rem;        /* was tiny; nudge up */
    line-height: 1.3;
    opacity: .9;
    text-align: center;
    margin-top: .35rem;
  }
  .since-start-credit{
    font-size: 0.9rem;
    opacity: .8;
    text-align: center;
  }
  /* On wider screens, make it a bit larger */
  @media (min-width: 992px){
    .since-start-blurb{ font-size: 1.05rem; }
    .since-start-credit{ font-size: 1rem; }
  }
</style>
<style>
  /* --- spacing / padding on the KPI cards --- */
  .kpi-card { padding: 18px 20px; }

  /* top blurb spacing */
  .top-blurb { margin-top: 6px; margin-bottom: 12px; opacity: .95; }

  /* subtle alignment for the realized rows (keeps columns neat) */
  .kpi-realized .rline{
    display:grid;
    grid-template-columns: 1fr max-content max-content;
    gap: .5rem 1rem;
    align-items: baseline;
  }
  .kpi-realized .rline > :nth-child(2),
  .kpi-realized .rline > :nth-child(3){
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .kpi-realized .rline > :nth-child(2){ min-width: 5.5rem; } /* $ column */
  .kpi-realized .rline > :nth-child(3){ min-width: 3.5rem; } /* % column */

  /* --- color tokens --- */
  :root{
    --pos: #2fd27f;
    --neg: #ff6b6b;
    --zero: #b8b8b8;
    --muted: #a0a0a0;
  }
  /* classes used by signClass() in your JS */
  .text-pos { color: var(--pos) !important; }
  .text-neg { color: var(--neg) !important; }
  .text-zero{ color: var(--zero) !important; }

  /* PDT counter chip hues (you already toggle .neg in JS when >=3) */
  #dt_pdt5.neg { color: #ff9b2f; }
  #dt_pdt5.pos { color: var(--pos); }

  /* make the “Built by…” line a hair brighter if you want */
  .built-by { color: #ddd; }
</style>
<style>
  /* subtle breathing room above the header row */
  .kpi-row { margin-top: .75rem; }

  /* reused text colors */
  .text-pos { color:#1db954 !important; }  /* green */
  .text-neg { color:#ff5555 !important; }  /* red   */
  .text-zero{ color:#b8b8b8 !important; }  /* gray  */

  /* realized rows align + spacing */
  .kpi-realized .rline{
    display:grid;
    grid-template-columns: 1fr max-content max-content;
    gap:.25rem 1rem;
    align-items:baseline;
    padding: 2px 0;               /* tiny vertical padding */
  }
  .kpi-realized .rline > :nth-child(2),
  .kpi-realized .rline > :nth-child(3){
    text-align:right;
    font-variant-numeric: tabular-nums;
    min-width: 5.5rem;            /* $ column */
  }
  .kpi-realized .rline > :nth-child(3){ min-width: 3.75rem; } /* % column */
</style>
<style>
  .since-blurb{ font-size:.95rem; letter-spacing:.2px; color:#d9d9d9; }
  .since-blurb b{ color:#fff; }
  .built-by{ font-size:.9rem; color:#aab0b6; }
</style>
<style>
  .kpi-realized .rline{ padding: 2px 0; }           /* tiny vertical rhythm */
  .text-pos{ color:#2ecc71 !important; }            /* you already use these */
  .text-neg{ color:#ff6b6b !important; }
  .text-zero{ color:#b8b8b8 !important; }
</style>
<style>
  /* Centered hero blurb under the title */
  .hero-blurb{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;                 /* space between the two lines */
    text-align:center;
    padding:10px 0 22px;     /* top/bottom breathing room */
    margin: 0 auto;          /* keep it centered across wide screens */
    max-width: 1100px;       /* stops it from feeling too “wide” on 4k */
    line-height: 1.15;
  }
  .hero-blurb .since { opacity:.92; }
  .hero-blurb .by    { opacity:.80; font-size: 0.95rem; }
  .hero-blurb .since { font-size:1.05rem; }
  .hero-blurb .by    { font-size:1.0rem; }

</style>

<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-4" style="min-height:54px; position:relative;">

    <!-- Left: (now empty to match layout spacing; you can remove entirely if desired) -->
    <div>
<div class="kv">
</div>
	</div>

    <!-- Center: title (no badge) -->
<!-- Stats Blurb + Built-by (centered, two lines) -->
<div class="hero-blurb">
  <div class="since">
    Started with <b id="about-start-cash">$392.67</b> on <b id="about-start-date">2025-08-22</b>.
    This app has since made <b id="about-since-pnl">$34.01</b> at <b id="about-since-pct">8.66%</b>.
  </div>
  <div class="by">Built by <b>Ben McCall &amp; Max</b></div>
</div>

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TradeAlerts – Live</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root{
      --bg:#0b0b0d; --panel:#1b1d21; --muted:#a9a9a9;
      --txt:#f2f2f2; --hi:#ffeb3b;
      --pos:#3bd67a; --neg:#ff5c5c;
      --grid:#2a2d33;
    }
    html,body{background:var(--bg); color:var(--txt); font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,"Helvetica Neue",Arial,"Noto Sans",sans-serif;}
    a, .link { color: var(--hi); text-decoration: none; }
    .topbar{padding:10px 14px; border-bottom:1px solid #15161a; position:sticky; top:0; z-index:5; background:rgba(11,11,13,.92); backdrop-filter: blur(3px);}
    .brand{font-weight:700; letter-spacing:.5px;}
    .rocket{filter:drop-shadow(0 0 6px rgba(255,235,59,.4))}
    .dot{width:8px; height:8px; border-radius:50%; display:inline-block; margin-left:8px; background: #27d857; box-shadow:0 0 10px #27d857; vertical-align:middle;}
    .panel{background:var(--panel); border-radius:10px; padding:16px; box-shadow:0 2px 10px rgba(0,0,0,.25)}
    .kpi{min-height:92px;}
    .muted{color:var(--muted)}
    .table{--bs-table-bg:transparent; --bs-table-color:var(--txt);}
    .table th, .table td{border-color:#2a2d33 !important;}
    .th { color:#ffd84b; font-weight:600; letter-spacing:.25px; }
    .text-pos{color:var(--pos) !important;}
    .text-neg{color:var(--neg) !important;}
    .mono{font-variant-numeric: tabular-nums; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;}
    /* Reliable center for the headline blurb */
    .headline-wrap{position:relative; min-height:56px;}
    .headline{
      position:absolute; left:50%; transform:translateX(-50%);
      top:0; text-align:center; white-space:nowrap;
      font-size:.95rem; letter-spacing:.2px; color:#d9d9d9;
      right:auto !important;
    }
    /* skinny separators inside left/right KPI */
    .grid-mini{display:grid; grid-template-columns:1fr auto; gap:.25rem .75rem;}
  </style>
</head>
<body>
  <!-- top nav -->
  <div class="topbar d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
      <div class="brand">
        <span class="rocket">🚀</span>
        <span>TradeAlerts</span>
        <span class="rocket">🚀</span>
      </div>
      <div class="d-flex align-items-center gap-3 small">
        <a href="/simulation" class="link">Simulation</a>
        <a href="/backtest" class="link">Backtest</a>
        <span class="fw-bold">Live</span>
      </div>
    </div>
    <div class="small">
      <span class="me-2">E*TRADE API</span><span class="dot" id="api-dot"></span>
    </div>
  </div>

  <!-- centered headline -->
  <div class="container-fluid pt-2 headline-wrap">
    <div class="headline">
      <span id="about-line-1">
        Started with <b class="mono" id="about-start-cash">$—</b> on <b id="about-start-date">—</b>.
        This app has since made <b class="mono" id="about-since-pnl">$—</b> at <b id="about-since-pct">—</b>.
      </span>
      <div class="small">Built by Ben McCall &amp; Max</div>
    </div>
  </div>

  <!-- KPI tiles -->
  <div class="container-fluid mt-3">
    <div class="row g-3">
      <!-- LEFT: Value -->
      <div class="col-12 col-lg-4">
        <div class="panel kpi h-100">
          <div class="text-uppercase small mb-1">Value</div>
          <div class="fs-2 fw-bold mono" id="kpi-value">—</div>
          <div class="grid-mini mt-2 small">
            <div>Buying Power</div><div class="mono text-end" id="kpi-bp">—</div>
            <div>Value (BP + Positions)</div><div class="mono text-end" id="kpi-bpplus">—</div>
            <div>Account</div><div class="mono text-end" id="kpi-acct">—</div>
          </div>
        </div>
      </div>
      <!-- CENTER: Unrealized P&L -->
      <div class="col-12 col-lg-4">
        <div class="panel kpi h-100 text-center">
          <div class="text-uppercase small mb-1">P&amp;L (Unrealized)</div>
          <div class="fs-2 fw-bold mono" id="kpi-upl">—</div>
          <div class="small mono" id="kpi-upl-pct">—</div>
          <div class="small mono text-muted mt-1" id="kpi-posval">—</div>
        </div>
      </div>
      <!-- RIGHT: Realized buckets -->
      <div class="col-12 col-lg-4">
        <div class="panel kpi h-100">
          <div class="d-flex justify-content-between">
            <div class="text-uppercase small">Realized P&amp;L</div>
            <div class="small">D / W / LW / M / All</div>
          </div>
          <div class="mt-2 small">
            <div class="d-flex justify-content-between"><span>Day</span>  <span class="mono" id="rb-day">$0.00</span>  <span class="mono" id="rb-day-pct"   ></span></div>
            <div class="d-flex justify-content-between"><span>Week</span> <span class="mono" id="rb-week">$0.00</span> <span class="mono" id="rb-week-pct"  ></span></div>
            <div class="d-flex justify-content-between"><span>Last Week</span><span class="mono" id="rb-lw">$0.00</span> <span class="mono" id="rb-lw-pct"   ></span></div>
            <div class="d-flex justify-content-between"><span>Month</span><span class="mono" id="rb-month">$0.00</span><span class="mono" id="rb-month-pct" ></span></div>
            <div class="d-flex justify-content-between"><span>All</span>  <span class="mono" id="rb-all">$0.00</span>  <span class="mono" id="rb-all-pct"   ></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Holdings -->
  <div class="container-fluid mt-4">
    <div class="th mb-2">Holdings</div>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr class="th">
            <th>Symbol</th>
            <th>Opened (ET)</th>
            <th class="text-end">Last Price</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Price Paid</th>
            <th class="text-end">Day P&amp;L</th>
            <th class="text-end">Day P&amp;L %</th>
            <th class="text-end">Total P&amp;L</th>
            <th class="text-end">Total P&amp;L %</th>
            <th class="text-end">Value</th>
          </tr>
        </thead>
        <tbody id="holdings-body"></tbody>
      </table>
    </div>
  </div>

  <!-- Recent Trades -->
  <div class="container-fluid mt-4 mb-5">
    <div class="th mb-2">Recent Trades</div>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr class="th">
            <th>Time (ET)</th>
            <th>Symbol</th>
            <th>Side</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Price</th>
            <th class="text-end">Price Paid</th>
            <th class="text-end">P&amp;L</th>
            <th class="text-end">P&amp;L %</th>
          </tr>
        </thead>
        <tbody id="trades-body"></tbody>
      </table>
    </div>
  </div>

  <script>
    // ---------- helpers ----------
    const $ = sel => document.querySelector(sel);
    const fmtMoney = v => {
      const n = Number(v);
      if (!isFinite(n)) return '—';
      return n < 0 ? `-$${Math.abs(n).toFixed(2)}` : `$${n.toFixed(2)}`;
    };
    const fmtPct = v => {
      const n = Number(v);
      if (!isFinite(n)) return '—';
      return (n >= 0 ? '+' : '') + n.toFixed(2) + '%';
    };
    const paint = (el, val) => {
      const n = Number(val);
      el.classList.remove('text-pos','text-neg');
      if (isFinite(n)) el.classList.add(n > 0 ? 'text-pos' : (n < 0 ? 'text-neg' : ''));
    };

    // ---------- renderers ----------
    function renderHoldings(rows){
      const tb = $('#holdings-body');
      tb.innerHTML = '';
      (rows||[]).forEach(r=>{
        const tr = document.createElement('tr');

        const td = (txt, cls='')=>{
          const el = document.createElement('td');
          el.className = cls;
          el.textContent = txt;
          return el;
        };

        tr.append(
          td(r.symbol || ''),
          td(r.opened_et || r.open_time || ''),
          td((r.last_price!=null? r.last_price.toFixed(2):'—'), 'text-end mono'),
          td((r.qty!=null? r.qty:'—'), 'text-end mono'),
          td((r.price_paid!=null? r.price_paid.toFixed(2):'—'), 'text-end mono'),

          td((r.day_pl!=null? fmtMoney(r.day_pl):'—'), 'text-end mono'),
          td((r.day_pl_pct!=null? fmtPct(r.day_pl_pct):'—'), 'text-end mono'),
          td((r.total_pl!=null? fmtMoney(r.total_pl):'—'), 'text-end mono'),
          td((r.total_pl_pct!=null? fmtPct(r.total_pl_pct):'—'), 'text-end mono'),
          td((r.value!=null? fmtMoney(r.value):'—'), 'text-end mono'),
        );

        // paint the P/L cells
        paint(tr.children[5], r.day_pl);
        paint(tr.children[6], r.day_pl_pct);
        paint(tr.children[7], r.total_pl);
        paint(tr.children[8], r.total_pl_pct);

        tb.appendChild(tr);
      });
    }

    function renderTrades(rows){
      const tb = $('#trades-body');
      tb.innerHTML = '';
      (rows||[]).forEach(r=>{
        const tr = document.createElement('tr');
        const td = (txt, cls='')=>{
          const el = document.createElement('td');
          el.className = cls;
          el.textContent = txt;
          return el;
        };
        tr.append(
          td(r.time || ''),
          td(r.symbol || ''),
          td((r.action || '').toUpperCase()),
          td((r.qty!=null? r.qty:'—'), 'text-end mono'),
          td((r.price!=null? r.price.toFixed(2):'—'), 'text-end mono'),
          td((r.price_paid!=null? r.price_paid.toFixed(2):'—'), 'text-end mono'),
          td((r.pl!=null? fmtMoney(r.pl):'—'), 'text-end mono'),
          td((r.pl_pct!=null? fmtPct(r.pl_pct):'—'), 'text-end mono'),
        );
        paint(tr.children[6], r.pl);
        paint(tr.children[7], r.pl_pct);
        tb.appendChild(tr);
      });
    }

    // ---------- main refresh ----------
    async function refresh(){
      try{
        const res = await fetch('/live/status?debug=0', {cache:'no-store'});
        const j = await res.json();

        // API dot
        $('#api-dot').style.background = j.etrade_ok ? '#27d857' : '#d82727';
        $('#api-dot').style.boxShadow = j.etrade_ok ? '0 0 10px #27d857' : '0 0 10px #d82727';

        // headline/about
        if (j.about){
          $('#about-start-cash').textContent = fmtMoney(j.about.start_cash ?? '—');
          $('#about-start-date').textContent = j.about.start_date ?? '—';
          $('#about-since-pnl').textContent  = fmtMoney(j.about.since_pnl ?? '—');
          $('#about-since-pct').textContent  = fmtPct(j.about.since_pct ?? '—');
          paint($('#about-since-pnl'), j.about.since_pnl);
          paint($('#about-since-pct'), j.about.since_pct);
        }

        // left tile (Value)
        const acct = j.account || {};
        const metrics = j.metrics || {};
        const bp      = acct.buying_power ?? 0;
        const posVal  = metrics.positions_value ?? 0;
        $('#kpi-value').textContent = (posVal ? fmtMoney(posVal) : '—');
        $('#kpi-bp').textContent    = fmtMoney(bp);
        $('#kpi-bpplus').textContent= fmtMoney(bp + (posVal||0));
        $('#kpi-acct').textContent  = (acct.account_key || acct.account_id || '—').toString().slice(-4);

        // center tile (Unrealized)
        const upl = metrics.unrealized_pnl ?? 0;
        const upct= metrics.unrealized_pnl_pct ?? 0;
        $('#kpi-upl').textContent    = fmtMoney(upl);
        $('#kpi-upl-pct').textContent= fmtPct(upct);
        $('#kpi-posval').textContent = 'Positions Value ' + fmtMoney(posVal||0);
        paint($('#kpi-upl'), upl);
        paint($('#kpi-upl-pct'), upct);

        // realized buckets tile
        const rb = (metrics.realized_buckets || j.kpis?.realized) || {};
        const setRB = (idV, idP, rec) => {
          const v = rec?.pnl ?? 0, p = rec?.pct ?? 0;
          $(idV).textContent = fmtMoney(v);
          $(idP).textContent = fmtPct(p);
          paint($(idV), v); paint($(idP), p);
        };
        setRB('#rb-day',   '#rb-day-pct',   rb.day   || j.kpis?.day);
        setRB('#rb-week',  '#rb-week-pct',  rb.week  || j.kpis?.week);
        setRB('#rb-lw',    '#rb-lw-pct',    rb.last_week || rb.lastWeek);
        setRB('#rb-month', '#rb-month-pct', rb.month);
        setRB('#rb-all',   '#rb-all-pct',   rb.all);

        // tables
        renderHoldings(j.holdings || []);
        renderTrades(j.trades || []);
      }catch(e){
        console.error('refresh failed', e);
      }
    }

    refresh();
    setInterval(refresh, 30000);
  </script>
</body>
</html>
{% endblock %}