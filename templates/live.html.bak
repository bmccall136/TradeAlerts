{% extends "layout.html" %}
{% block content %}

<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-4" style="min-height:54px; position:relative;">

    <!-- Left: (now empty to match layout spacing; you can remove entirely if desired) -->
    <div></div>

    <!-- Center: title (no badge) -->
    <h2 class="text-warning mb-0 position-absolute start-50 translate-middle-x" style="width:fit-content;">
      Live Dashboard
    </h2>

    <!-- Right: Account type + E*TRADE status block (keep as you have it) -->
    <div class="d-flex flex-column align-items-end" style="gap:6px; min-width: 220px;">
      <div class="fw-bold" style="white-space: nowrap;">
        Account type: {{ account.get('account_type_display') or account.get('account_type') or 'Cash' }}
      </div>
      <div class="status-block" style="background:#000;color:#ffd600;padding:8px;border-radius:6px;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <div>E*TRADE API</div>
          <div style="color:#39d353;">●</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Summary (styled like Sim's summary block) -->
<!-- KPIs -->
<div class="kpi-grid">
  <!-- Left = Cash -->
  <div class="kpi-card">
    <div class="kpi-title">Cash</div>
    <div class="kv"><span class="label">Buying Power</span><span id="bp">$0.00</span></div>
    <div class="kv"><span class="label">Settled Cash</span><span id="sc">$0.00</span></div>
    {% if account.get('equity_value') is not none %}
      <div class="kv"><span class="label">Equity Value</span><span id="eq">$0.00</span></div>
    {% endif %}
    {% if account.get('account_id') %}
      <div class="kv muted"><span class="label">Account</span><span>****{{ account['account_id'][-4:] }}</span></div>
    {% endif %}
  </div>

  <!-- Right = P&L -->
  <div class="kpi-card">
    <div class="kpi-title">P&L</div>
    <div class="kv"><span class="label">Unrealized P&L</span><span id="upnl">$0.00</span></div>
    <div class="kv"><span class="label">Unrealized P&L %</span><span id="upct">0.00%</span></div>
    <div class="kv"><span class="label">Realized P&L</span><span id="rpnl">$0.00</span></div>
    <div class="kv"><span class="label">Realized P&L %</span><span id="rpct">0.00%</span></div>
  </div>
</div>

<!-- Holdings (same table classes/order as Sim) -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="text-white mb-0">Holdings</h3>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Symbol</th><th>Last Price</th><th>Change</th><th>Change %</th>
        <th>Qty</th><th>Price Paid</th><th>Day Gain/Loss</th>
        <th>Total Gain/Loss</th><th>Value</th>
      </tr>
    </thead>
	<tbody id="holdings-body">
	  {# existing server-rendered rows are fine; JS will replace #}
	  {% for h in holdings or [] %}
	  <tr>
		<td>{{ h.symbol }}</td>
		<td>${{ '%.2f'|format(h.last_price or 0) }}</td>
		<td>$0.00</td>
		<td>0.00%</td>
		<td>{{ h.qty }}</td>
		<td>${{ '%.2f'|format(h.price_paid or 0) }}</td>
		<td>$0.00</td>
		<td>${{ '%.2f'|format((h.last_price - h.price_paid) * h.qty if h.qty else 0) }}</td>
		<td>${{ '%.2f'|format(h.value or (h.last_price*h.qty)) }}</td>
	  </tr>
	  {% else %}
	  <tr><td colspan="9" class="text-center">No holdings.</td></tr>
	  {% endfor %}
	</tbody>
  </table>
</div>

<!-- Recent Trades (match Sim "Trade History") -->
<h3 class="text-white mt-5 mb-3">Recent Trades</h3>
<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Time</th><th>Symbol</th><th>Action</th>
        <th>Qty</th><th>Price</th><th>P/L</th>
      </tr>
    </thead>
	<tbody id="trades-body">
	  {% for t in trades or [] %}
	  <tr>
		<td>{{ t.time }}</td>
		<td>{{ t.symbol }}</td>
		<td>{{ t.action }}</td>
		<td>{{ t.qty }}</td>
		<td>${{ '%.2f'|format(t.price or 0) }}</td>
		<td>${{ '%.2f'|format(t.pl or 0) }}</td>
	  </tr>
	  {% else %}
	  <tr><td colspan="6" class="text-center">No trades yet</td></tr>
	  {% endfor %}
	</tbody>
  </table>
</div>

{% endblock %}
<script>
(function () {
  const fmt = v => '$' + Number(v || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});

  async function refreshLive() {
    try {
      const res = await fetch('/live/status', {cache: 'no-store'});
      if (!res.ok) return;
      const data = await res.json();

      const acct = data.account || {};
      const el = id => document.getElementById(id);

      if (el('bp')) el('bp').textContent = fmt(acct.buying_power);
      if (el('sc')) el('sc').textContent = fmt(acct.settled_cash);
      if (el('eq') && acct.equity_value !== undefined) el('eq').textContent = fmt(acct.equity_value);

      // holdings
      const hBody = el('holdings-body');
      if (hBody) {
        hBody.innerHTML = '';
        const rows = data.holdings || [];
        if (rows.length === 0) {
          hBody.innerHTML = `<tr><td colspan="9" class="text-center">No holdings.</td></tr>`;
        } else {
          for (const h of rows) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${h.symbol ?? ''}</td>
              <td>${fmt(h.last_price)}</td>
              <td>$0.00</td>
              <td>0.00%</td>
              <td>${h.qty ?? 0}</td>
              <td>${fmt(h.price_paid)}</td>
              <td>${fmt(h.day_gain)}</td>
              <td>${fmt(h.total_gain)}</td>
              <td>${fmt(h.value)}</td>
            `;
            hBody.appendChild(tr);
          }
        }
      }

      // trades (optional; empty list right now)
      const tBody = el('trades-body');
      if (tBody) {
        tBody.innerHTML = '';
        const trs = data.trades || [];
        if (trs.length === 0) {
          tBody.innerHTML = `<tr><td colspan="6" class="text-center">No trades yet</td></tr>`;
        } else {
          for (const t of trs) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${t.time ?? ''}</td>
              <td>${t.symbol ?? ''}</td>
              <td>${t.action ?? ''}</td>
              <td>${t.qty ?? 0}</td>
              <td>${fmt(t.price)}</td>
              <td>${fmt(t.pl)}</td>
            `;
            tBody.appendChild(tr);
          }
        }
      }
    } catch (e) {
      // silent; page still shows last good values
    }
  }

  // first paint + every 30s; only when tab is visible
  refreshLive();
  setInterval(() => {
    if (document.visibilityState === 'visible') refreshLive();
  }, 30000);
})();
</script>
<script>
function money(n){ return '$' + Number(n ?? 0).toFixed(2); }
function pct(n){ return Number(n ?? 0).toFixed(2) + '%'; }

async function refresh() {
  try {
    const r = await fetch('/live/status');
    const { account, metrics } = await r.json();

    // existing fields
    const bp = document.getElementById('bp');
    const sc = document.getElementById('sc');
    const eq = document.getElementById('eq');
    if (bp) bp.textContent = money(account?.buying_power ?? 0);
    if (sc) sc.textContent = money(account?.settled_cash ?? 0);
    if (eq) eq.textContent = money(account?.equity_value ?? 0);

    // new P&L fields
    document.getElementById('upnl').textContent = money(metrics.unrealized_pnl);
    document.getElementById('upct').textContent = pct(metrics.unrealized_pnl_pct);
    document.getElementById('rpnl').textContent = money(metrics.realized_pnl);
    document.getElementById('rpct').textContent = pct(metrics.realized_pnl_pct);
  } catch (e) {
    console.warn('live/status refresh failed:', e);
  }
}
refresh();
setInterval(refresh, 10000);
</script>
