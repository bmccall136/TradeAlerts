{% extends "layout.html" %}
{% block content %}

<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-4" style="min-height:54px; position:relative;">

    <!-- Left: (now empty to match layout spacing; you can remove entirely if desired) -->
    <div></div>

    <!-- Center: title (no badge) -->
    <h2 class="text-warning mb-0 position-absolute start-50 translate-middle-x" style="width:fit-content;">
      Live Dashboard
    </h2>

    <!-- Right: Account type + E*TRADE status block (keep as you have it) -->
    <div class="d-flex flex-column align-items-end" style="gap:6px; min-width: 220px;">
      <div class="fw-bold" style="white-space: nowrap;">
        Account type: {{ account.get('account_type_display') or account.get('account_type') or 'Cash' }}
      </div>
      <div class="status-block" style="background:#000;color:#ffd600;padding:8px;border-radius:6px;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <div>E*TRADE API</div>
          <div style="color:#39d353;">●</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== Live KPIs (2 columns) ===== -->
<div class="kpi-grid">
  <!-- Cash -->
  <div class="kpi-card">
    <div class="kpi-title">Cash</div>

    <div class="kv">
      <span class="label">Buying Power</span>
      <span id="bp">${{ '{:,.2f}'.format((account or {}).get('buying_power') or 0.0) }}</span>
    </div>

    <div class="kv">
      <span class="label">Settled Cash</span>
      <span id="sc">${{ '{:,.2f}'.format((account or {}).get('settled_cash') or 0.0) }}</span>
    </div>

    {% if (account or {}).get('equity_value') is not none %}
    <div class="kv">
      <span class="label">Equity Value</span>
      <span id="eq">${{ '{:,.2f}'.format((account or {}).get('equity_value') or 0.0) }}</span>
    </div>
    {% endif %}

    {% if (account or {}).get('account_id') %}
    <div class="kv muted">
      <span class="label">Account</span>
      <span>****{{ (account or {}).get('account_id')[-4:] }}</span>
    </div>
    {% endif %}
  </div>

	<div class="kpi-card">
	  <div class="kpi-title">P&L</div>

	<div class="kv">
	  <span class="label">Total (Cash + Positions)</span>
	  <span id="utotal" class="num"></span>
	</div>

	  <div class="kv">
		<span class="label">Positions Value</span>
		<span id="posval" class="num"></span>
	  </div>
	  <div class="kv">
	  <span class="label">Unrealized P&L</span>
	  <span id="upnl" class="num"></span>
	</div>
	  <div class="kv">
		<span class="label">Unrealized P&L %</span>
		<span id="upct" class="num"></span>
	  </div>

	<div class="kv">
	  <span class="label">Realized P&L</span>
	  <span id="rpnl" class="num"></span>
	</div>
	<div class="kv">
	  <span class="label">Realized P&L %</span>
	  <span id="rpct" class="num"></span>
	</div>
	</div>
   </div>

<!-- ========================== -->
<!-- Holdings (same table classes/order as Sim) -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="text-white mb-0">Holdings</h3>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Symbol</th>
        <th>Last Price</th>
        <th>Qty</th>
        <th>Price Paid</th>
        <th>Day P&L</th>
        <th>Day P&L %</th>
        <th>Total P&L</th>
        <th>Total P&L %</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody id="holdings-body">
      {% for h in holdings or [] %}
      <tr>
        <td>{{ h.symbol }}</td>
        <td>${{ '%.2f'|format(h.last_price or 0) }}</td>
        <td>{{ h.qty }}</td>
        <td>${{ '%.2f'|format(h.price_paid or 0) }}</td>
        <td>${{ '%.2f'|format(h.day_pl or 0) }}</td>
        <td>{{ '%.2f'|format(h.day_pl_pct or 0) }}%</td>
        <td>${{ '%.2f'|format(h.total_pl or 0) }}</td>
        <td>{{ '%.2f'|format(h.total_pl_pct or 0) }}%</td>
        <td>${{ '%.2f'|format(h.value or ((h.last_price or 0) * (h.qty or 0))) }}</td>
      </tr>
      {% else %}
      <tr><td colspan="9" class="text-center">No holdings.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<h3 class="section-title">Recent Trades</h3>
<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Time</th><th>Symbol</th><th>Side</th><th>Qty</th><th>Price</th><th>Price Paid</th><th>P&L</th><th>P&L %</th>

      </tr>
    </thead>
    <tbody id="trades-body"></tbody>
  </table>
</div>
<script>
(() => {
  // ---------- helpers ----------
  function firstPositive(values){
    for (const v of values){
      const n = Number(v);
      if (Number.isFinite(n) && n > 0) return n;
    }
    return null;
  }

  function set(sel, val){
    const el = document.querySelector(sel);
    if (el) el.textContent = (val ?? '—');
  }

  function money(x){
    x = parseFloat(x);
    return Number.isFinite(x) ? `$${x.toFixed(2)}` : '$0.00';
  }

  function pct(x){
    x = parseFloat(x);
    return Number.isFinite(x) ? `${x.toFixed(2)}%` : '0.00%';
  }

  function paintStatus(ok){
    const dot = document.querySelector('.status-block > div > div:last-child');
    if (dot) dot.style.color = ok ? '#39d353' : '#f05454';
  }

  function colorize(el, num){
    if (!el) return;
    el.classList.remove('pos','neg');
    if (typeof num === 'number' && !isNaN(num)) {
      if (num > 0) el.classList.add('pos');
      else if (num < 0) el.classList.add('neg');
    }
  }

  function paintSign(sel, num){
    const el = document.querySelector(sel);
    if (!el) return;
    el.classList.remove('pos','neg');
    const n = parseFloat(num);
    if (isFinite(n)) {
      if (n > 0) el.classList.add('pos');
      else if (n < 0) el.classList.add('neg');
    }
  }

async function refreshLive() {
  try {
    const r = await fetch('/live/status?days=7');
    const d = await r.json();

    paintStatus(!!d && d.ok !== false);

    const m = d.metrics || {};
    const a = d.account || {};

    // Buying Power (sticky)
    let bp = firstPositive([
      a && a.buying_power,
      a && a.available_funds,
      a && a.accountBalance && a.accountBalance.marginBuyingPower,
      a && a.cash_balance,
      a && a.cash,
      a && a.settled_cash
    ]);
    if (bp == null) {
      const last = Number(localStorage.getItem('bp_last') || '');
      if (Number.isFinite(last) && last > 0) bp = last;
    } else {
      localStorage.setItem('bp_last', String(bp));
    }
    set('#bp', money(bp ?? 0));

    // KPIs
    set('#sc',     money(a.settled_cash));
    set('#utotal', money(m.total_value));
    set('#posval', money(m.positions_value));
    set('#upnl',   money(m.unrealized_pnl));
    set('#upct',   pct(m.unrealized_pnl_pct));
    set('#rpnl',   money(m.realized_pnl));
    set('#rpct',   pct(m.realized_pnl_pct));
    paintSign('#upnl', m.unrealized_pnl);
    paintSign('#upct', m.unrealized_pnl_pct);
    paintSign('#rpnl', m.realized_pnl);
    paintSign('#rpct', m.realized_pnl_pct);

    // -------- NEW: build a last-price fallback map from recent trades --------
    const lastFromTrades = {};
    for (const t of (d.trades || [])) {
      const sym = (t.symbol || '').toUpperCase();
      const px  = Number(t.price);
      if (!sym) continue;
      // keep the most recent price we see for each symbol
      if (Number.isFinite(px)) lastFromTrades[sym] = px;
    }

    renderHoldings(d.holdings || [], lastFromTrades);
    renderTrades(d.trades || []);
  } catch (e) {
    paintStatus(false);
    console.error('refreshLive failed:', e);
  }
}

// rows renderer now accepts a fallback map
function renderHoldings(rows, lastFromTrades = {}) {
  const tb = document.querySelector('#holdings-body');
  if (!tb) return;
  tb.innerHTML = '';
  if (!rows.length){
    tb.innerHTML = `<tr><td class="muted" colspan="9">No holdings.</td></tr>`;
    return;
  }

  for (const h of rows){
    // numeric copies for coloring/calcs
    const dpln = (h.day_pl != null)       ? Number(h.day_pl)       : null;
    const dppn = (h.day_pl_pct != null)   ? Number(h.day_pl_pct)   : null;
    const tpln = (h.total_pl != null)     ? Number(h.total_pl)     : null;
    const tppn = (h.total_pl_pct != null) ? Number(h.total_pl_pct) : null;

    const sym  = (h.symbol || '').toUpperCase();
    const qty  = h.qty ?? 0;

    // -------- NEW: Last price fallback chain ----------
    // 1) server-provided last_price; 2) most recent trade price; 3) price_paid
    const lastNum =
      (h.last_price != null ? Number(h.last_price) : NaN);
    const tradeNum = Number(lastFromTrades[sym]);
    const paidNum  = (h.price_paid != null ? Number(h.price_paid) : NaN);

    let lastChosen = Number.isFinite(lastNum)  ? lastNum
                   : Number.isFinite(tradeNum) ? tradeNum
                   : Number.isFinite(paidNum)  ? paidNum
                   : null;

    const lastTxt = (lastChosen == null) ? '—' : money(lastChosen);
    const paidTxt = (h.price_paid != null) ? money(h.price_paid) : '—';

    // Value fallback if server didn't send one
    let value = h.value;
    if (value == null && lastChosen != null && Number.isFinite(qty)) {
      value = lastChosen * qty;
    }
    const valueTxt = (value == null) ? '—' : money(value);

    const dpl  = (dpln != null) ? money(dpln) : '—';
    const dpp  = (dppn != null) ? pct(dppn)   : '—';
    const tpl  = (tpln != null) ? money(tpln) : '—';
    const tpp  = (tppn != null) ? pct(tppn)   : '—';

    tb.insertAdjacentHTML('beforeend', `
      <tr>
        <td>${sym}</td>
        <td>${lastTxt}</td>
        <td>${qty}</td>
        <td>${paidTxt}</td>
        <td class="day-pl">${dpl}</td>
        <td class="day-pl-pct">${dpp}</td>
        <td class="tot-pl">${tpl}</td>
        <td class="tot-pl-pct">${tpp}</td>
        <td>${valueTxt}</td>
      </tr>`);

    const row = tb.lastElementChild;
    colorize(row.querySelector('.day-pl'),     dpln);
    colorize(row.querySelector('.day-pl-pct'), dppn);
    colorize(row.querySelector('.tot-pl'),     tpln);
    colorize(row.querySelector('.tot-pl-pct'), tppn);
  }
}

// renderTrades stays the same as your working version …
// (leave your existing renderTrades implementation)

document.addEventListener('DOMContentLoaded', () => {
  refreshLive().catch(console.error);
  setInterval(refreshLive, 30000);
});

})();
</script>
{% endblock %}
