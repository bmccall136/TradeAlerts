</div>

<div class="table-responsive">
  <table class="table table-dark table-striped align-middle holdings-table">
    <colgroup>
      <col style="width:90px;">    <!-- Symbol -->
      <col style="width:260px;">   <!-- Name -->
      <col style="width:180px;">   <!-- Opened -->
      <col style="width:130px;">   <!-- Last Price -->
      <col style="width:70px;">    <!-- Qty -->
      <col style="width:120px;">   <!-- Price Paid -->
      <col style="width:110px;">   <!-- Day P&L -->
      <col style="width:110px;">   <!-- Day % -->
      <col style="width:110px;">   <!-- Total P&L -->
      <col style="width:110px;">   <!-- Total % -->
