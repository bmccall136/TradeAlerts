  </div>

  <!-- REALIZED P&L -->
  <div class="col-md-4">
    <div class="kpi-tile">
      <div class="kpi-label mb-2">Realized P&amp;L</div>
      <div class="kpi-sub mb-1">
        <strong>Day</strong>:
        <span id="kpi-r-day">$0.00</span>
        (<span id="kpi-r-day-pct">0.00%</span>)
      </div>
      <div class="kpi-sub mb-1">
        <strong>Week</strong>:
        <span id="kpi-r-week">$0.00</span>
        (<span id="kpi-r-week-pct">0.00%</span>)
      </div>
      <div class="kpi-sub mb-1">
        <strong>Month</strong>:
        <span id="kpi-r-month">$0.00</span>
        (<span id="kpi-r-month-pct">0.00%</span>)
      </div>
      <div><strong>Year</strong>: <span id="kpi-r-year">$0.00</span> (<span id="kpi-r-year-pct">0.00%</span>)</div>
    </div>
  </div>
</div>

<!-- Holdings -->
<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
