{% extends "layout.html" %}
{% block content %}

<style>
  body { background-color:#000; color:#f5f5f5; }

  .kpi-tile{
    background:#111;
    border-radius:0.75rem;
    padding:1.25rem 1.5rem;
    margin-bottom:1.5rem;
    border:1px solid #333;
    box-shadow:0 0 18px rgba(0,0,0,0.7);
  }
  .kpi-label{
    font-size:0.9rem;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:#aaa;
  }
  .kpi-main{ font-size:1.7rem; font-weight:600; }
  .kpi-sub{ font-size:0.95rem; color:#ccc; }

  .table-dark{
    --bs-table-bg:#121212;
    --bs-table-striped-bg:#181818;
    --bs-table-striped-color:#f5f5f5;
    --bs-table-border-color:#333;
  }
  .table-dark thead.table-light{
    --bs-table-bg:#1f1f1f;
    --bs-table-color:#f5f5f5;
  }
  .table-dark tbody tr:hover{ background-color:#222; }

  .dot{ display:inline-block; width:11px; height:11px; border-radius:50%; margin-left:0.4rem; }
  .dot-green{ background-color:#2ecc71; }
  .dot-red{ background-color:#e74c3c; }

  .nav-link.active{ color:#ffc107 !important; }

  .form-check-label, .text-muted{ color:#e8e8e8 !important; }

  .btn-news{
    padding:2px 6px;
    font-size:0.75rem;
    border-radius:3px;
    border:1px solid #ffeb3b;
    background-color:#111;
    color:#ffeb3b;
    text-decoration:none;
  }
  .btn-news:hover{
    background-color:#ffeb3b;
    color:#000;
    text-decoration:none;
  }

  .hold-name{
    max-width:260px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  /* ---- Fix: column squeeze so Opened and Last Price don't run together ---- */
  .holdings-table{
    table-layout:fixed;
    width:100%;
  }
  .holdings-table th,
  .holdings-table td{
    padding:0.55rem 0.75rem;
    vertical-align:middle;
  }
  .hold-opened, .hold-last{
    white-space:nowrap;
  }
</style>

<!-- Top status row -->
<div class="d-flex justify-content-between align-items-center mb-2">
  <div></div>
  <div class="text-center">
    <div class="mb-2">
      <span class="me-2 text-muted">E*TRADE API</span>
      <span id="etrade-dot" class="dot dot-red"></span>
    </div>
    <span id="acct-badge" class="badge bg-secondary"></span>
  </div>
</div>

<!-- KPI Row -->
<div class="row">
  <!-- VALUE tile -->
  <div class="col-md-4">
    <div class="kpi-tile">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="kpi-label">Value</div>
      </div>
      <div class="kpi-main" id="kpi-cash">$0.00</div>
      <div class="kpi-sub">
        <div>Buying Power: <span id="kpi-bp">$0.00</span></div>
        <div>Positions Value: <span id="kpi-posval">$0.00</span></div>
      </div>
    </div>
  </div>

  <!-- UNREALIZED P&L -->
  <div class="col-md-4">
    <div class="kpi-tile">
      <div class="kpi-label mb-2">Current Holdings</div>
      <div class="kpi-label mb-2">P&amp;L (Unrealized)</div>

      <div class="kpi-sub mb-1">
        <strong>Today</strong>:
        <span id="kpi-pnl-day">$0.00</span>
