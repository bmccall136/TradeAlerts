<script>
// --- $$Machine: fix Holdings "Opened (ET)" column (backend sends UTC epoch seconds) ---
(function mmFixOpenedET(){
  function fmtOpenedET(x) {
    try {
      if (x === null || x === undefined) return "";
      const s = String(x).trim();
      if (!/^\d+(\.\d+)?$/.test(s)) return s;  // already formatted
      const n = Number(s);
      if (!isFinite(n) || n <= 0) return s;
      const d = new Date(n * 1000); // epoch seconds -> ms
      return new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit",
        hour12: true
      }).format(d);
    } catch (e) { return String(x ?? ""); }
  }

  function run(){
    // find the Holdings table by locating the header "Opened (ET)"
    const tables = Array.from(document.querySelectorAll("table"));
    for (const t of tables) {
      const ths = Array.from(t.querySelectorAll("thead th"));
      if (!ths.length) continue;
      let openedIdx = -1;
      ths.forEach((th,i)=>{
        const label = (th.textContent || "").toLowerCase();
        if (label.includes("opened") && label.includes("et")) openedIdx = i;
      });
      if (openedIdx < 0) continue;

      const rows = Array.from(t.querySelectorAll("tbody tr"));
      for (const tr of rows) {
        const tds = tr.querySelectorAll("td");
        if (!tds || tds.length <= openedIdx) continue;
        const td = tds[openedIdx];
        const raw = (td.textContent || "").trim();
        const out = fmtOpenedET(raw);
        if (out && out !== raw) td.textContent = out;
      }
      // only patch the first matching table
      break;
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
})();
</script>

