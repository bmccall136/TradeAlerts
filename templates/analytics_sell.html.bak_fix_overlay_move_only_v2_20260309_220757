      </div>
    </div>
  </div>

  <!-- STALE RELIEF -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-hourglass-split"></i> Stale Relief Exit</div>
      <span class="badge bg-secondary">Bag cleanup</span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" data-path="stale_relief_exit.enabled" id="sr_on">
            <label class="form-check-label" for="sr_on">Enabled</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Min hold (days)</label>
          <input type="number" step="1" class="form-control" data-path="stale_relief_exit.min_hold_days">
        </div>
        <div class="col-md-4">
          <label class="form-label">Relief gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="stale_relief_exit.relief_gain_pct">
        </div>

        <div class="col-md-4">
          <label class="form-label">Runner max gain (%)</label>
          <input type="number" step="0.01" class="form-control" data-path="stale_relief_exit.runner_max_gain_pct">
        </div>
        <div class="col-md-4">
          <label class="form-label">Regime conf max</label>
          <input type="number" step="1" class="form-control" data-path="stale_relief_exit.regime_conf_max">
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch mt-4">
            <input class="form-check-input" type="checkbox" data-path="stale_relief_exit.require_non_trend_regime" id="sr_nt">
            <label class="form-check-label" for="sr_nt">Require non-TREND regime</label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI -->
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-cpu"></i> AI (Exit Advisor)</div>
      <span class="badge bg-secondary">Exits</span>
    </div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.enabled" id="ai_on">
            <label class="form-check-label" for="ai_on">Enabled</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.use_exits" id="ai_ex">
            <label class="form-check-label" for="ai_ex">Use for exits</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" data-path="ai.use_entries" id="ai_en">
            <label class="form-check-label" for="ai_en">Use for entries (SELL file)</label>
          </div>
        </div>
        <div class="col-12">
          <div class="form-text">Note: Exit overlay multipliers are persisted in BUY live settings files (source of truth), but edited here for convenience.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- REGIME EXIT OVERLAY -->
  <div class="card mb-4" id="mm-regime-exit-overlay-card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-speedometer2"></i> Regime Exit Overlay</div>
      <span class="badge bg-secondary">Multipliers</span>
    </div>
    <div class="card-body">
      <div class="text-muted small mb-2">These multiply Sell Guard behavior by market regime.</div>
      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle">
          <thead>
            <tr>
              <th style="width:120px;">Regime</th>
              <th>Stop mult</th>
              <th>Target mult</th>
              <th>Time mult</th>
            </tr>
          </thead>
          <tbody>
            {% for r in ["TREND","CHOP","DEAD","UNKNOWN"] %}
            <tr>
              <td class="fw-semibold">{{ r }}</td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.stop_mult"></td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.target_mult"></td>
              <td><input type="number" step="0.01" class="form-control form-control-sm" data-path="regime_exit_overlay.{{ r }}.time_mult"></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="small text-muted">Tip: To “let winners run” in TREND, raise target_mult and time_mult while keeping stop_mult reasonable.</div>
    </div>
  </div>


  <!-- MM_TRADE_OUTCOME_CARD_V1_START -->
  <div class="card mb-4" id="mm-trade-outcome-card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-bar-chart-steps"></i> Trade Outcome Overlay</div>
      <span class="badge bg-secondary">Recent exits</span>
    </div>
    <div class="card-body">
      <div class="small text-muted mb-2">
        Recent closed exits with best-available exit-rule context from the DB.
      </div>
      <div id="mm-too-note" class="small mb-2" style="color:#f5d400;"></div>
      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle mb-0">
          <thead>
            <tr>
              <th style="width:170px;">Time (ET)</th>
              <th style="width:90px;">Symbol</th>
              <th style="width:130px;">Exit rule</th>
              <th style="width:90px;">Regime</th>
              <th style="width:90px;">Mode</th>
              <th style="width:90px;">P/L %</th>
              <th>Event</th>
            </tr>
          </thead>
          <tbody id="mm-too-body">
            <tr><td colspan="7" class="text-muted">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
</div>
<!-- MM_MOVE_TRADE_OUTCOME_OVERLAY_TO_SELL_ANALYTICS_V1_END -->


    <div class="mm-muted" style="font-size:12px;">Bucket: <span id="mm-sell-heatmap-bucket-label"></span></div>
  </div>

  <style>
    #mm-sell-heatmap-card .mm-heat-wrap{overflow:auto;margin-top:10px;}
    #mm-sell-heatmap-card .mm-heat{
      width:100%;
      border-collapse:separate;
      border-spacing:6px;
      min-width:760px;
    }
    #mm-sell-heatmap-card .mm-heat th{
      font-size:12px;
      opacity:.8;
      padding:4px 6px;
      text-align:center;
      white-space:nowrap;
    }
    #mm-sell-heatmap-card .mm-heat td{
      padding:8px 10px;
      border-radius:10px;
      text-align:center;
      font-weight:700;
      border:1px solid rgba(255,255,255,.06);
      min-width:62px;
    }
    #mm-sell-heatmap-card .mm-heat td.mm-rowlabel{
      text-align:left;
      min-width:160px;
      background:rgba(255,255,255,.04);
      font-weight:800;
      white-space:nowrap;
    }
    #mm-sell-heatmap-card .mm-heat td.mm-zero{
      opacity:.38;
      background:rgba(255,255,255,.03);
    }
  </style>

  <div class="mm-heat-wrap">
    <table class="mm-heat" id="mm-sell-heatmap-table">
      <thead id="mm-sell-heatmap-head"></thead>
      <tbody id="mm-sell-heatmap-body">
        <tr><td class="mm-muted">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>
<!-- MM_SELL_HEATMAP_CARD_V1_END -->

