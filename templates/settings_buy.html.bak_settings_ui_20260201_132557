
<style>/* mm-controls-only */
#ax-form{width:100% !important; max-width:100% !important;}
.mm-sec{margin:14px 0; padding:10px 10px 6px 10px; border:1px solid rgba(255,233,0,0.20); border-radius:10px;}
.mm-sec-title{font-weight:700; margin:0 0 10px 0; color:#ffe900;}
.mm-reqfilters{display:flex; flex-wrap:wrap; gap:12px;}
.mm-check{display:flex; align-items:center; gap:8px; cursor:pointer;}
</style>
﻿<style id="ax-hide-raw-json">
  #ax-raw-wrap, #settings-raw-wrap, #raw-json, #settings-raw, #ax-raw { display:none !important; }
  .raw-json { display:none !important; }
</style>
{% extends "layout.html" %}
{% block content %}
<div class="ax-settings">
  <h1>BUY Settings</h1>

  <div id="settings-group-toggle" class="mm-settings-toggle">
    <a class="mm-toggle-btn" href="/settings/buy"  data-kind="buy">BUY Settings</a>
    <a class="mm-toggle-btn" href="/settings/sell" data-kind="sell">SELL Settings</a>
  </div>

  <div id="mm-settings-toolbar" class="mm-settings-toolbar" data-group="buy">
    <div class="mm-settings-left">
      <label class="mm-settings-label">Profile</label>
      <select id="mm-settings-profile" class="mm-settings-select">
        <option value="day">DAY</option>
        <option value="swing">SWING</option>
      </select>
      <span id="mm-settings-status" class="mm-settings-status"></span>
    </div>

    <div class="mm-settings-right">
      <button id="mm-settings-save" class="mm-settings-save" type="button">Save</button>
    </div>
  </div>



  <input type="hidden" id="ax-kind" value="buy"/>

  <div class="ax-topbar">
    <label>Mode:</label>
    <select id="ax-mode" class="ax-select">
      <option value="DAY">DAY</option>
      <option value="SWING">SWING</option>
    </select>

    <label>JSON:</label>
    <select id="ax-file" class="ax-select"></select>

    <div class="ax-spacer"></div>

    <button id="ax-reload" class="ax-btn">Reload</button> 
    <button id="ax-save" class="ax-btn">Save</button>
  </div>

  <div id="ax-msg" class="ax-msg"></div>

  <div class="ax-grid">
    
      <div class="ax-note" style="margin-top:10px;">
        Complex fields (lists/objects) are edited in Raw JSON.
      </div>
</div>
    </div>

    <div class="ax-card">
      <h3>Raw JSON</h3>
      
    </div>
  </div>
</div>

<link rel="stylesheet" href="/static/css/settings.css">
<script src="/static/js/settings.js"></script>

<script>
  // Set default mode based on server-side live_mode.txt (rendered via a tiny ping to /api/settings/load)
  // The JS loader will call /api/settings/load which returns the resolved mode and updates the dropdown indirectly.
</script>
{% endblock %}


