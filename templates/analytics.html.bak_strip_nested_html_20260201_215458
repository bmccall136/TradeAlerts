{% extends "layout.html" %}

{% block content %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Daily Analytics</title>

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%92%B0%3C/text%3E%3C/svg%3E">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="/static/style.css" rel="stylesheet"/>
</head>

<body class="bg-dark text-light">
  <div class="container-fluid py-3">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <div class="d-flex align-items-center gap-2">
        <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
        <div>
          <div class="h4 mb-0">Daily Analytics</div>
          <div class="text-secondary small" id="ax-date">Loading?</div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-3">
        <a class="btn btn-sm btn-outline-warning" id="ax-yesterday" href="#">Yesterday</a>
        <a class="btn btn-sm btn-outline-secondary" href="/live">Live</a>
      </div>
    </div>

    <div id="ax-errors" class="mb-3"></div>

    <div class="row g-3">
      <div class="col-12 col-xxl-6">
        <div class="card bg-black border-secondary">
          <div class="card-header d-flex align-items-center justify-content-between">
            <div class="fw-bold text-success">BUYS</div>
            <div class="small text-secondary" id="ax-buy-count"></div>
          </div>
          <div class="card-body">
            <div id="ax-buy-col" class="text-secondary small">loading?</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xxl-6">
        <div class="card bg-black border-secondary">
          <div class="card-header d-flex align-items-center justify-content-between">
            <div class="fw-bold text-danger">SELLS</div>
            <div class="small text-secondary" id="ax-sell-count"></div>
          </div>
          <div class="card-body">
            <div id="ax-sell-col" class="text-secondary small">loading?</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-3 small text-secondary" id="ax-files"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/static/js/analytics.js?v="></script>
</body>
</html>
{% endblock %}
