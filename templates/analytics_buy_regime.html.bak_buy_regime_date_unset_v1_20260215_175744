/* MM_AX_TOOLBAR_DATE_WIRING_V1 */
(function(){
  const $ = (id)=>document.getElementById(id);
  const dateEl = $("ax-date");
  const labEl  = $("ax-date-label");
  const goBtn  = $("ax-go");
  const yBtn   = $("ax-yesterday");

  function setLabelFromDate(d){
    if(!labEl) return;
    if(!d) { labEl.textContent = "Today"; return; }
    labEl.textContent = d;
  }

  function todayYMD(){
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth()+1).padStart(2,'0');
    const d = String(now.getDate()).padStart(2,'0');
    return `${y}-${m}-${d}`;
  }

  // Default date picker to today (for consistent UI even if page doesn't use date param)
  try{
    if(dateEl && !dateEl.value) dateEl.value = todayYMD();
  }catch(e){}

  function navToDate(d){
    // Buy Regime is bucket-based; date picker is present for consistent toolbar only.
    // Still update label so it doesn't look "broken".
    setLabelFromDate(d);
  }

  if(goBtn && dateEl){
    goBtn.addEventListener("click", ()=>navToDate((dateEl.value||"").trim()));
  }
  if(yBtn){
    yBtn.addEventListener("click", ()=>{
      const t = new Date();
      t.setDate(t.getDate()-1);
      const y = t.getFullYear();
      const m = String(t.getMonth()+1).padStart(2,'0');
      const d = String(t.getDate()).padStart(2,'0');
      const ymd = `${y}-${m}-${d}`;
      if(dateEl) dateEl.value = ymd;
      navToDate(ymd);
    });
  }

  // Label should read "Today" unless user interacts
  setLabelFromDate("");
})();
</script>

<script>
/* MM_ANALYTICS_TAPE_SCRIPT_CLEAN_V1 */
(function(){
  const el = document.getElementById("mm-ax-tape");
  const ticksEl = document.getElementById("mm-ax-ticks");
  const linesEl = document.getElementById("mm-ax-ticklines");
  const metaEl = document.getElementById("mm-ax-tape-meta");
  const dbgEl  = document.getElementById("mm-ax-tape-debug");
  if (!el || !ticksEl || !linesEl) return;

  function dbg(msg){
    try{
      if(!dbgEl) return;
      const u = new URL(window.location.href);
      const on = (u.searchParams.get("tape_debug") || "").trim() === "1";
      dbgEl.textContent = on ? msg : "";
    }catch(e){}
  }

  function colorFor(reg){
    reg = (reg||"").toUpperCase();
    if (reg === "TREND") return "rgba(0, 200, 120, .95)";
    if (reg === "CHOP")  return "rgba(240, 200, 0, .95)";
    if (reg === "DEAD")  return "rgba(220, 60, 60, .95)";
    return "rgba(160,160,160,.35)";
  }

  function buildBins(openTs, closeTs){
    const bins = [];
    const start = openTs - (openTs % 300);
    const end   = closeTs - (closeTs % 300);
    for (let t = start; t <= end; t += 300) bins.push(t);
    return bins;
  }

  function carryForward(points, bins){
    const map = new Map();
    (points||[]).forEach(p => {
      const t = (p.ts_utc||0);
      const bt = t - (t % 300);
      map.set(bt, { regime: p.regime, conf: p.conf });
    });

    let last = null;
    const segs = [];
    for (const b of bins){
      if (map.has(b)) last = map.get(b);
      segs.push({ ts:b, regime: last?.regime || "UNKNOWN", conf: (last?.conf ?? null) });
    }
    return segs;
  }

  function render(segs, openTs, closeTs){
    el.innerHTML = "";
    ticksEl.innerHTML = "";
    linesEl.innerHTML = "";
    if (metaEl) metaEl.textContent = "";

    const total = segs.length || 1;
    const pct = (i)=> (i/total)*100;

    // tape segments
    segs.forEach((s, i)=>{
      const div = document.createElement("div");
      div.style.display = "inline-block";
      div.style.height = "100%";
      div.style.width = (100/total) + "%";
      div.style.background = colorFor(s.regime);
      el.appendChild(div);
    });

    // ticks at 9:30, 10:30, 12:00, 14:00, 16:00 (if within window)
    const marks = [
      {h:9, m:30, label:"9:30"},
      {h:10, m:30, label:"10:30"},
      {h:12, m:0, label:"12"},
      {h:14, m:0, label:"2"},
      {h:16, m:0, label:"4"},
    ];

    function mkTs(h,m){
      // build based on openTs date (ET window already provided by server)
      const d = new Date(openTs*1000);
      d.setHours(h, m, 0, 0);
      return Math.floor(d.getTime()/1000);
    }

    marks.forEach(mark=>{
      const t = mkTs(mark.h, mark.m);
      if (t < openTs || t > closeTs) return;
      const pos = ((t - openTs) / (closeTs - openTs)) * 100;

      const lab = document.createElement("div");
      lab.textContent = mark.label;
      lab.style.position="absolute";
      lab.style.left = `calc(${pos}% - 10px)`;
      lab.style.top = "0";
      ticksEl.appendChild(lab);

      const line = document.createElement("div");
      line.style.position="absolute";
      line.style.left = `${pos}%`;
      line.style.top="0";
      line.style.bottom="0";
      line.style.width="1px";
      line.style.background="rgba(255,255,255,.10)";
      linesEl.appendChild(line);
    });

    // meta: simple progress = % of segments not UNKNOWN
    const known = segs.filter(s => (s.regime||"").toUpperCase() !== "UNKNOWN").length;
    const prog = Math.round((known / total) * 100);
    if (metaEl) metaEl.textContent = `progress: ${prog}%`;
  }

  async function load(){
    try{
      const r = await fetch("/api/market_regime_timeline", {cache:"no-store"});
      if(!r.ok){
        dbg("timeline http " + r.status);
        return;
      }
      const j = await r.json();
      const points = (j.points && Array.isArray(j.points)) ? j.points : [];
      const window = j.window || {};
      const openTs = window.open_ts_utc || window.open_ts || 0;
      const closeTs = window.close_ts_utc || window.close_ts || 0;

      dbg(`pts=${points.length} open=${openTs} close=${closeTs}`);

      if(!openTs || !closeTs){
        if (metaEl) metaEl.textContent = "NO SAMPLES (TODAY)";
        return;
      }

      const bins = buildBins(openTs, closeTs);
      const segs = carryForward(points, bins);
      render(segs, openTs, closeTs);
    } catch(e){
      dbg(String(e));
    }
  }

  load();
})();
</script>

<script>
async function mmFetchJson(url){
  const r = await fetch(url, {cache:"no-store"});
  const ct = (r.headers.get("content-type")||"").toLowerCase();
  if(!r.ok){
    const txt = await r.text();
    throw new Error("HTTP " + r.status + " " + (txt||"").slice(0,600));
  }
  if(ct.includes("application/json")) return await r.json();
  const txt = await r.text();
  throw new Error("Non-JSON: " + (txt||"").slice(0,600));
}

function fmtPct(x){
  if(!isFinite(x)) return "";
  return (x*100).toFixed(1) + "%";
}
function tagClass(reg){
  reg=(reg||"").toLowerCase();
  if(reg==="chop") return "tag chop";
  if(reg==="trend") return "tag trend";
  if(reg==="dead") return "tag dead";
  return "tag";
}

async function loadBucket(){
  const b = (document.getElementById("bucket").value || "today").toLowerCase();
  const errEl = document.getElementById("err");
  const tbody = document.getElementById("tbody");
  errEl.textContent = "";
  tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">Loading…</td></tr>';

  try{
    const j = await mmFetchJson("/api/analytics/buy_regime?bucket=" + encodeURIComponent(b));
    const rows = j.rows || [];
    const total = rows.reduce((a,r)=>a+(+r.count||0),0);

    document.getElementById("k-total").textContent = String(total);
    document.getElementById("k-top").textContent = (j.top_regime || "—");

    if(!rows.length){
      tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">No rows.</td></tr>';
      return;
    }

    tbody.innerHTML = "";
    rows.forEach(r=>{
      const tr = document.createElement("tr");
      const reg = (r.regime||"").toUpperCase();
      const share = total ? ((+r.count||0)/total) : 0;
      tr.innerHTML = `
        <td><span class="${tagClass(reg)}">${reg || "UNKNOWN"}</span></td>
        <td>${(+r.count||0).toLocaleString()}</td>
        <td>${(r.avg_conf==null) ? "" : (+r.avg_conf).toFixed(0)}</td>
        <td>${fmtPct(share)}</td>
      `;
      tbody.appendChild(tr);
    });
  }catch(e){
    errEl.textContent = String(e && e.message ? e.message : e);
    tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">Error.</td></tr>';
  }
}

async function loadOutcomes(){
  const b = (document.getElementById("bucket").value || "today").toLowerCase();
  const out = document.getElementById("outcomes");
  out.textContent = "Loading…";
  try{
    const j = await mmFetchJson("/api/analytics/buy_regime_outcomes?bucket=" + encodeURIComponent(b));
    if(j && j.summary){
      out.textContent = j.summary;
    }else{
      out.textContent = "OK";
    }
  }catch(e){
    out.textContent = "Outcomes error: " + String(e && e.message ? e.message : e);
  }
}

document.getElementById("bucket").addEventListener("change", ()=>{
  loadBucket();
  loadOutcomes();
});

loadBucket();
loadOutcomes();
</script>

{% endblock %}
