<script>
// MM_REO_SAVE_HOOK_V7
function MM_REO_MERGE_SETTINGS_OBJ(obj){
  try{
    if(!obj || typeof obj !== "object") return obj;
    var ov = null;
    try { ov = (window.MM_REO && window.MM_REO.getOverlay) ? window.MM_REO.getOverlay() : null; } catch(e){ ov = null; }
    if(ov && typeof ov === "object"){
      obj.regime_exit_overlay = ov;
    }
  }catch(e){}
  return obj;
}


  // MM_REO_STATUS_HELPER_V1
  function mmUpdateReoStatus(){
    try{
      const host = document.getElementById("mm-reo-status");
      if(!host) return;

      const keys = ["TREND","CHOP","DEAD","UNKNOWN"];
      let overlay = null;

      if (window.SETTINGS && window.SETTINGS.regime_exit_overlay) {
        overlay = window.SETTINGS.regime_exit_overlay;
      } else if (window.MM_REO && typeof window.MM_REO.getOverlay === "function") {
        overlay = window.MM_REO.getOverlay();
      }

      if(!overlay || typeof overlay !== "object"){
        host.textContent = "Regime overlay status: not loaded.";
        return;
      }

      let neutral = true;
      for (const r of keys){
        const row = overlay[r] || {};
        const stop = Number(row.stop_mult ?? 1);
        const target = Number(row.target_mult ?? 1);
        const time = Number(row.time_mult ?? 1);
        if (stop !== 1 || target !== 1 || time !== 1){
          neutral = false;
          break;
        }
      }

      host.textContent = neutral
        ? "Regime overlay status: neutral / no-op (all multipliers are 1.00)."
        : "Regime overlay status: configured (at least one multiplier differs from 1.00).";
    }catch(e){}
  }

(() => {
  const GROUP = (window.__MM_GROUP__ || "buy");
  const CFG = window.__MM_CFG__ || { cards:[], other:[], gate_primary:[], gate_enhancers:[] };
  const byId = (id) => document.getElementById(id);

  let SETTINGS = {};
  let SCORE = {};

  function normProfile(v){
    v = String(v||"").toLowerCase();
    return (v === "swing") ? "swing" : "day";
  }

  function groupKey(k){
    k = String(k||"").toLowerCase().replace(/\s+/g,"");
    if (k.includes("price_sma")) return "price_sma";
    if (k.includes("bb_break")) return "bb_break";
    if (k.includes("atr_pct")) return "atr_pct";
    if (k.includes("macd_hist")) return "macd_hist";
    if (k === "sma20") return "sma20";
    if (k.startsWith("sma")) return "sma";
    if (k.startsWith("rsi")) return "rsi";
    if (k.startsWith("macd")) return "macd";
    if (k.startsWith("vwap")) return "vwap";
    if (k.startsWith("vol") || k.startsWith("volume")) return "vol";
    if (k.startsWith("range")) return "range";
    if (k.startsWith("gap")) return "gap";
    if (k.startsWith("bb")) return "bb";
    if (k.startsWith("atr")) return "atr";
    if (k.startsWith("adx")) return "adx";
    if (k.startsWith("super")) return "super";
    return k;
  }

  function scoreCount(key){
    const g = groupKey(key);
    const v = (SCORE || {})[g];
    const n = Number(v || 0);
    return Number.isFinite(n) ? n : 0;
  }

  async function apiLoad(profile){
    const r = await fetch(`/api/settings/load?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "load failed");
    return (j.data && typeof j.data === "object") ? j.data : {};
  }

  async function apiSave(profile, data){

    // MM_REO_SAVE_HOOK_V7: force-sync overlay -> hidden JSON/global mirrors before saving
    try { if (window.MM_REO && window.MM_REO.push) window.MM_REO.push(); } catch(e) {}
    const r = await fetch(`/api/settings/save?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, {
      method:"POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(MM_REO_MERGE_SETTINGS_OBJ(data || {}))
    });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "save failed");
    return j;
  }

  async function apiScore(bucket){
    const r = await fetch(`/api/settings/scoreboard?bucket=${encodeURIComponent(bucket)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "scoreboard failed");
    return j.counts || {};
  }

  function getPath(obj, path){
    const parts = String(path||"").split(".");
    let cur = obj;
    for (const p of parts){
      if (!cur || typeof cur !== "object") return undefined;
      cur = cur[p];
    }
    return cur;
  }

  function setPath(obj, path, value){
    const parts = String(path||"").split(".");
    let cur = obj;
    for (let i=0;i<parts.length;i++){
      const p = parts[i];
      if (i === parts.length-1){
        cur[p] = value;
      } else {
        if (!cur[p] || typeof cur[p] !== "object") cur[p] = {};
        cur = cur[p];
      }
    }
  }

  function getEnable(card){
    if (card.enable_is_field){
      return !!SETTINGS[card.enable_key];
    }
    if (!card.enable_key) return true;
    return !!SETTINGS[card.enable_key];
  }

  function setEnable(card, v){
    if (card.enable_is_field){
      SETTINGS[card.enable_key] = !!v;
      return;
    }
    if (!card.enable_key) return;
    SETTINGS[card.enable_key] = !!v;
  }

  function cleanRequiredFilters(){
    const allowed = new Set((CFG.gate_primary || []).map(x => String(x.key||"").toLowerCase()));
    let req = SETTINGS.required_filters;
    if (!Array.isArray(req)) req = [];
    req = req.map(x => String(x||"").toLowerCase()).filter(x => allowed.has(x));
    SETTINGS.required_filters = Array.from(new Set(req));
  }

  function renderGate(){
    const hostA = byId("gateGridPrimary");
    const hostB = byId("gateGridEnhancers");
    if (hostA) hostA.innerHTML = "";
    if (hostB) hostB.innerHTML = "";

    cleanRequiredFilters();

    const reqSet = new Set((SETTINGS.required_filters || []).map(x => String(x||"").toLowerCase()));

    // Primary gate-able
    if (hostA){
      for (const g of (CFG.gate_primary || [])){
        const pill = document.createElement("div");
        pill.className = "mm-gate-pill";
        const id = `gate_${g.key}`;
        const checked = reqSet.has(String(g.key).toLowerCase());
        pill.innerHTML = `
          <input type="checkbox" id="${id}" ${checked ? "checked" : ""}>
          <label for="${id}" style="margin:0;font-weight:800;">${g.label}</label>
        `;
        pill.querySelector("input").onchange = (e) => {
          const on = !!e.target.checked;
          const key = String(g.key).toLowerCase();
          let arr = Array.isArray(SETTINGS.required_filters) ? SETTINGS.required_filters.slice() : [];
          arr = arr.map(x => String(x||"").toLowerCase());
          const s = new Set(arr);
          if (on) s.add(key); else s.delete(key);
          SETTINGS.required_filters = Array.from(s);
          cleanRequiredFilters();
          const hint = byId("gateHint");
          if (hint) hint.textContent = "Required: " + (SETTINGS.required_filters.length ? SETTINGS.required_filters.join(", ") : "(none)");
        };
        hostA.appendChild(pill);
      }
    }

    // Enhancers (display only)
    if (hostB){
      for (const g of (CFG.gate_enhancers || [])){
        const pill = document.createElement("div");
        pill.className = "mm-gate-pill mm-disabled-pill";
        const id = `enh_${g.key}`;
        pill.title = "Enhancer / emitter: cannot be required (not part of Required Signals Gate).";
        pill.innerHTML = `
          <input type="checkbox" id="${id}" disabled>
          <label for="${id}" style="margin:0;font-weight:800;">${g.label}</label>
        `;
        hostB.appendChild(pill);
      }
    }

    const hint = byId("gateHint");
    if (hint) hint.textContent = "Required: " + (reqSet.size ? Array.from(reqSet).join(", ") : "(none)");
  }

  function renderScoreboard(){
    const host = byId("scoreboardCards");
    if (!host) return;
    host.innerHTML = "";

    const items = (CFG.cards || []).map(c => {
      return {
        key: c.key,
        label: c.label,
        enabled: getEnable(c),
        count: scoreCount(c.key)
      };
    }).sort((a,b) => (b.count - a.count));

    for (const it of items){
      const div = document.createElement("div");
      div.className = "mm-gate-pill";
      div.style.justifyContent = "space-between";
      div.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;">
          <div style="font-weight:800;">${it.label}</div>
          <div class="mm-count">count: ${it.count}</div>
        </div>
        <div class="mm-count">${it.enabled ? "Enabled" : "Disabled"}</div>
      `;
      host.appendChild(div);
    }
  }

  function renderCards(){
    const host = byId("indicatorCards");
    if (!host) return;
    host.innerHTML = "";

    for (const card of (CFG.cards || [])){
      const det = document.createElement("details");
      det.className = "mm-ind";
      det.open = true;

      const enabled = getEnable(card);
      const cnt = scoreCount(card.key);

      const sum = document.createElement("summary");

      const enableHtml = card.enable_key ? `
        <label class="mm-toggle" onclick="event.stopPropagation();">
          <input type="checkbox" ${enabled ? "checked" : ""} style="transform:scale(1.05);">
          <span style="font-weight:800;">Enabled</span>
        </label>
      ` : ``;

      sum.innerHTML = `
        <div class="mm-title">${card.label}</div>
        <div class="mm-right">
          <div class="mm-count">count: ${cnt}</div>
          ${enableHtml}
        </div>
      `;
      det.appendChild(sum);

      const body = document.createElement("div");
      body.className = "mm-body";
      const grid = document.createElement("div");
      grid.className = "mm-grid";

      for (const f of (card.fields || [])){
        const key = f.k;
        const label = f.label || key;
        const type = f.type || "text";
        const optional = !!f.optional;

        const existing = key.includes(".") ? (getPath(SETTINGS, key) !== undefined) : (SETTINGS[key] !== undefined);
        if (optional && !existing) continue;

        const rowLabel = document.createElement("label");
        rowLabel.textContent = label;

        let input;
        if (type === "bool"){
          input = document.createElement("input");
          input.type = "checkbox";
          input.checked = !!(key.includes(".") ? getPath(SETTINGS, key) : SETTINGS[key]);
          input.onchange = () => {
            const v = !!input.checked;
            if (key.includes(".")) setPath(SETTINGS, key, v);
            else SETTINGS[key] = v;
          };
        } else {
          input = document.createElement("input");
          input.type = (type === "number") ? "number" : "text";
          const v = key.includes(".") ? getPath(SETTINGS, key) : SETTINGS[key];
          input.value = (v === undefined || v === null) ? "" : String(v);
          input.oninput = () => {
            const val = (type === "number") ? Number(input.value) : input.value;
            if (key.includes(".")) setPath(SETTINGS, key, val);
            else SETTINGS[key] = val;
          };
        }

        const box = document.createElement("div");
        box.appendChild(input);

        grid.appendChild(rowLabel);
        grid.appendChild(box);
      }

      body.appendChild(grid);
      det.appendChild(body);
      host.appendChild(det);

      if (card.enable_key){
        const chk = sum.querySelector('input[type="checkbox"]');
        if (chk){
          chk.onchange = () => {
            setEnable(card, !!chk.checked);
            renderScoreboard();
          };
        }
      }
    }
  }

  function renderOther(){
    const host = byId("otherFields");
    if (!host) return;
    host.innerHTML = "";

    for (const f of (CFG.other || [])){
      const key = f.k;
      const label = f.label || key;
      const type = f.type || "text";
      const optional = !!f.optional;

      const existing = SETTINGS[key] !== undefined;
      if (optional && !existing) continue;

      const rowLabel = document.createElement("label");
      rowLabel.textContent = label;

      let input;
      if (type === "bool"){
        input = document.createElement("input");
        input.type = "checkbox";
        input.checked = !!SETTINGS[key];
        input.onchange = () => SETTINGS[key] = !!input.checked;
      } else {
        input = document.createElement("input");
        input.type = (type === "number") ? "number" : "text";
        const v = SETTINGS[key];
        input.value = (v === undefined || v === null) ? "" : String(v);
        input.oninput = () => SETTINGS[key] = (type === "number") ? Number(input.value) : input.value;
      }

      const box = document.createElement("div");
      box.appendChild(input);

      host.appendChild(rowLabel);
      host.appendChild(box);
    }
  }

  async function refreshAll(){
    const prof = normProfile(byId("profileSel")?.value || "day");
    byId("stickyProfile").textContent = prof.toUpperCase();
    byId("stickyGroup").textContent = GROUP.toUpperCase();

    try {
      SETTINGS = await apiLoad(prof);
    } catch(e) {
      console.error(e);
      SETTINGS = {};
    }

    if (!SETTINGS.ai || typeof SETTINGS.ai !== "object") {
      SETTINGS.ai = { enabled:false, use_entries:false, use_exits:false };
    }

    try {
      SCORE = await apiScore(byId("bucketSel")?.value || "today");
      const err = byId("scoreErr");
      if (err) err.style.display = "none";
    } catch(e) {
      console.error(e);
      SCORE = {};
      const err = byId("scoreErr");
      if (err) {
        err.textContent = "Scoreboard unavailable";
        err.style.display = "block";
      }
    }

    renderScoreboard();
    renderGate();
    renderCards();
    renderOther();
    mmUpdateReoStatus();
  }

  async function doSave(){
    const prof = normProfile(byId("profileSel")?.value || "day");
    const msg2 = byId("saveMsgTop");
    if (msg2) msg2.textContent = "Saving...";
    try {
      cleanRequiredFilters();
      await apiSave(prof, SETTINGS);
      if (msg2) msg2.textContent = "Saved.";
      setTimeout(() => { if (msg2) msg2.textContent = ""; }, 1500);
    } catch(e) {
      console.error(e);
      if (msg2) msg2.textContent = "Save failed.";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const profileSel = byId("profileSel");
    if (profileSel) profileSel.onchange = refreshAll;

    const saveBtnTop = byId("saveBtnTop");
    if (saveBtnTop) saveBtnTop.onclick = doSave;

    refreshAll();
  });
})();

</script>

