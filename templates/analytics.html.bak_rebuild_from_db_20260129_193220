<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$$Machine - Daily Analytics</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="bg-dark text-light">

<div class="container-fluid px-3 py-3">

  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <img src="/static/Max.png" alt="Max" style="width:36px;height:36px;border-radius:8px;">
      <div>
        <div class="h4 m-0">Daily Analytics</div>
        <div class="text-secondary small">Date (ET): <span id="ax-date">—</span></div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-outline-warning btn-sm" href="/live"><i class="bi bi-speedometer2"></i> Live</a>
      <a class="btn btn-outline-info btn-sm" id="ax-yesterday" href="/analytics?day=yesterday"><i class="bi bi-arrow-left-circle"></i> Yesterday</a>
      <button class="btn btn-outline-light btn-sm" id="ax-refresh"><i class="bi bi-arrow-repeat"></i> Refresh</button>
    </div>
  </div>

  <div id="ax-errors" class="mt-3"></div>

  <div class="row g-3 mt-1">
    <div class="col-12 col-xl-6">
      <div class="card bg-black border border-secondary">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div class="fw-semibold text-success"><i class="bi bi-box-arrow-in-right"></i> Buys (ET)</div>
          <div class="text-secondary small" id="ax-buy-count">0</div>
        </div>
        <div class="card-body p-2">
          <div id="ax-buy-col" class="text-secondary">loading…</div>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-6">
      <div class="card bg-black border border-secondary">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div class="fw-semibold text-danger"><i class="bi bi-box-arrow-right"></i> Sells (ET)</div>
          <div class="text-secondary small" id="ax-sell-count">0</div>
        </div>
        <div class="card-body p-2">
          <div id="ax-sell-col" class="text-secondary">loading…</div>
        </div>
      </div>
    </div>
  </div>

  <div class="text-secondary small mt-3" id="ax-files"></div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/static/js/analytics.js?v="></script>
</body>
</html>
