{# --- MM_ANALYTICS_TOOLBAR_PARTIAL_V1 --- #}
<div class="mm-ax-toolbar" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 14px 14px 14px;">
  <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <a class="mm-ax-btn" href="/analytics">Daily</a>
    <a class="mm-ax-btn" href="/analytics/buy">Buy Analytics</a>
    <a class="mm-ax-btn" href="/analytics/sell">Sell Analytics</a>
    <a class="mm-ax-btn" href="/analytics/buy_regime">Buy Regime</a>
    <a class="mm-ax-btn" href="/analytics/sell_regime">Sell Regime</a>
  </div>

  <div style="flex:1 1 auto;"></div>

  <div class="mm-ax-buckets" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
    <button class="mm-ax-btn mm-ax-bucket" data-bucket="today" type="button">Today</button>
    <button class="mm-ax-btn mm-ax-bucket" data-bucket="7d" type="button">7D</button>
    <button class="mm-ax-btn mm-ax-bucket" data-bucket="30d" type="button">30D</button>
    <button class="mm-ax-btn mm-ax-bucket" data-bucket="all" type="button">All</button>
  </div>
</div>

<style>
  /* keep this self-contained + consistent */
  .mm-ax-btn{
    display:inline-block;
    padding:10px 16px;
    border-radius:6px;
    border:1px solid rgba(0,255,255,.55);
    color:#66f6ff;
    text-decoration:none;
    background:rgba(0,0,0,.20);
    font-weight:600;
    letter-spacing:.2px;
  }
  .mm-ax-btn:hover{ filter:brightness(1.15); }
  .mm-ax-btn.mm-ax-active{
    border-color: rgba(255,200,0,.85);
    color:#ffd54a;
    box-shadow: 0 0 0 1px rgba(255,200,0,.20) inset;
  }
</style>

<script>
(function(){
  // ---- active page highlight ----
  try{
    const p = (location.pathname || "").toLowerCase();
    const links = document.querySelectorAll('.mm-ax-toolbar a.mm-ax-btn');
    links.forEach(a=>{
      const href = (a.getAttribute('href')||"").toLowerCase();
      if(href && (p === href || (href !== "/analytics" && p.startsWith(href)) || (href==="/analytics" && (p==="/analytics" || p==="/analytics/")))){
        a.classList.add('mm-ax-active');
      }
    });
  }catch(e){}

  // ---- bucket buttons ----
  function getQS(){
    const q = new URLSearchParams(location.search || "");
    return q;
  }
  function getBucket(){
    const q = getQS();
    const b = (q.get("bucket")||"").toLowerCase().trim();
    if(b==="today"||b==="7d"||b==="30d"||b==="all") return b;
    return "today";
  }
  function setBucketActive(b){
    document.querySelectorAll('.mm-ax-bucket').forEach(btn=>{
      const bb = (btn.getAttribute("data-bucket")||"").toLowerCase();
      if(bb === b) btn.classList.add("mm-ax-active");
      else btn.classList.remove("mm-ax-active");
    });
  }
  function navWithBucket(b){
    const q = getQS();
    q.set("bucket", b);
    // keep date parameter if present (Daily may still use it elsewhere)
    const url = location.pathname + "?" + q.toString();
    location.assign(url);
  }

  const b = getBucket();
  setBucketActive(b);

  document.querySelectorAll('.mm-ax-bucket').forEach(btn=>{
    btn.addEventListener("click", ()=>{
      const bb = (btn.getAttribute("data-bucket")||"").toLowerCase();
      if(bb) navWithBucket(bb);
    });
  });
})();
</script>
{# --- /MM_ANALYTICS_TOOLBAR_PARTIAL_V1 --- #}
