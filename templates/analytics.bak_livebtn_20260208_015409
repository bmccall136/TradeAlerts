{% extends "layout.html" %}
{% block content %}

<style>
/* AX_DARK_CARDS_V1 */
.ax-card, .ax-panel, .card, .mm-card {
  background: #0f1118 !important;
  border: 1px solid #222531 !important;
  color: #e8e8e8 !important;
}
.ax-card .card-body, .card .card-body { background: transparent !important; }
.ax-muted { opacity: .82; }

/* Date picker to match button vibe */
.ax-date-wrap { display:flex; align-items:center; gap:8px; }
.ax-date-input {
  background: transparent;
  border: 1px solid #6c757d;
  color: #e8e8e8;
  border-radius: 6px;
  padding: 4px 8px;
  height: 31px; /* matches btn-sm */
}
.ax-date-input:focus { outline: none; box-shadow: none; border-color: #8b94a3; }
</style>

<div class="container-fluid py-3">

  <div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
      <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
      <div>
        <div class="h4 mb-0">Daily Analytics</div>
        <div class="text-secondary small" id="ax-date">Loading…</div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>

      <div class="ax-date-wrap">
        <a class="btn btn-sm btn-outline-warning" id="ax-yesterday" href="#">Yesterday</a>

        <input
          type="date"
          class="ax-date-input"
          id="ax-datepick"
          value="{{ request.args.get('date','') }}"
          aria-label="Select date"
        />

        <a class="btn btn-sm btn-outline-warning" id="ax-datego" href="#">Go</a>
      </div>

      <a class="btn btn-sm btn-outline-secondary" href="/live">Live</a>
    </div>
  </div>

  <div id="ax-errors" class="mb-3"></div>

  <div class="row g-3">
    <div class="col-12 col-xxl-6">
      <div class="card mm-card">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div class="fw-bold text-success">BUYS</div>
          <div class="small text-secondary" id="ax-buy-count">0 rows</div>
        </div>
        <div class="card-body">
          <div id="ax-buy-col" class="text-secondary small">loading…</div>
        </div>
      </div>
    </div>

    <div class="col-12 col-xxl-6">
      <div class="card mm-card">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div class="fw-bold text-danger">SELLS</div>
          <div class="small text-secondary" id="ax-sell-count">0 rows</div>
        </div>
        <div class="card-body">
          <div id="ax-sell-col" class="text-secondary small">loading…</div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3 small text-secondary" id="ax-files"></div>
</div>

<script>
(function(){
  function pad2(n){ return String(n).padStart(2,'0'); }
  function fmtDate(d){
    return d.getFullYear() + "-" + pad2(d.getMonth()+1) + "-" + pad2(d.getDate());
  }
  function setUrlDate(dateStr){
    if (!dateStr) return;
    const u = new URL(window.location.href);
    u.searchParams.set("date", dateStr);
    window.location.href = u.toString();
  }

  const yBtn = document.getElementById("ax-yesterday");
  const pick = document.getElementById("ax-datepick");
  const go   = document.getElementById("ax-datego");

  // Yesterday button -> ?date=YYYY-MM-DD
  if (yBtn){
    const yd = new Date();
    yd.setDate(yd.getDate() - 1);
    yBtn.href = (function(){
      const u = new URL(window.location.href);
      u.searchParams.set("date", fmtDate(yd));
      return u.toString();
    })();
  }

  // Go button uses picker value
  if (go){
    go.addEventListener("click", function(e){
      e.preventDefault();
      setUrlDate(pick ? pick.value : "");
    });
  }

  // Optional: hitting Enter on date picker triggers Go
  if (pick){
    pick.addEventListener("keydown", function(e){
      if (e.key === "Enter") setUrlDate(pick.value);
    });
  }
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/static/js/analytics.js?v={{ (config.get('BUILD_ID') or '') }}"></script>

{% endblock %}
