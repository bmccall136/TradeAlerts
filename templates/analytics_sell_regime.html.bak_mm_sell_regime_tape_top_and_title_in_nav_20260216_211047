{# templates/analytics_sell_regime.html #}
{% extends "layout.html" %}
{% block content %}

<!-- MM_AX_SELL_REGIME_LAYOUT_V2_TOP_TAPE_TITLE_IN_NAV -->

<style>
  body { padding-top: 42px; }
  #mm-ax-tape-fixed {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 9999;
    background: rgba(0,0,0,.92);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .mm-ax-full { margin: 0 14px; }
  .mm-ax-inner { max-width: 1100px; margin: 0 auto; }

  .mm-ax-navrail { padding: 10px 0 8px 0; margin: 6px 0 10px 0; }
  .mm-ax-navrow { display:flex; align-items:flex-end; justify-content:space-between; gap:14px; }
  .mm-ax-titlewrap { display:flex; align-items:center; gap:12px; min-width:280px; }
  .mm-ax-title { font-size:34px; font-weight:800; line-height:1.05; }
  .mm-ax-sub { opacity:.70; margin-top:2px; }

  .mm-ax-card { padding: 14px 14px; margin: 0 0 14px 0; }

  .mm-ax-controls { display:flex; flex-wrap:wrap; gap:14px; align-items:center; }
  .mm-ax-controls .mm-ax-spacer { flex: 1; }
</style>

<!-- FIXED TOP TAPE -->
<div id="mm-ax-tape-fixed">
  <div class="mm-ax-full">
    <div id="mm-ax-tape-wrap" style="margin: 6px 0 8px 0;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
        <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
        <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
      </div>
      <div style="position:relative;">
        <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>
        <div id="mm-ax-tape"
             style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);
                    background:rgba(255,255,255,.04);">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- NAV RAIL -->
<div class="mm-ax-full mm-ax-navrail">
  <div class="mm-ax-inner">
    <div class="mm-ax-navrow">
      <div class="mm-ax-titlewrap">
        <img src="/static/Max.png" alt="Max"
             style="width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,215,0,.35);" />
        <div>
          <div class="mm-ax-title">Sell Regime</div>
          <div class="mm-ax-sub">Today</div>
        </div>
      </div>

      <div style="display:flex; align-items:center; justify-content:flex-end;">
        {% include "_analytics_toolbar.html" %}
      </div>
    </div>
  </div>
</div>

<!-- NARROW CONTENT -->
<div class="mm-ax-full">
  <div class="mm-ax-inner">

    <div style="opacity:.70; margin: 0 0 16px 0;">
      Breakdown of SELL activity by market regime (TREND / CHOP / DEAD) and related outcomes.
    </div>

    <div class="mm-card mm-ax-card">
      <div class="mm-ax-controls">
        <div style="min-width:260px;">
          <div style="font-weight:700; margin-bottom:6px;">Bucket</div>
          <select id="mm-sr-bucket" class="mm-input" style="width:100%;">
            <option value="today">TODAY</option>
            <option value="1d">1D</option>
            <option value="7d" selected>7D</option>
            <option value="30d">30D</option>
            <option value="90d">90D</option>
            <option value="ytd">YTD</option>
          </select>
        </div>

        <div class="mm-ax-spacer"></div>
        <div id="mm-sr-meta" style="opacity:.75; font-size:12px; text-align:right;"></div>
      </div>
    </div>

    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Sells by regime</div>
      <div style="opacity:.70; margin-bottom:10px;">
        Source: <span style="color:#ff4fd8;">sell_events</span> rows stamped with <span style="color:#ff4fd8;">regime</span>.
      </div>
      <div id="mm-sr-regime-table" class="mm-table-wrap"></div>
    </div>

    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Outcomes by regime</div>
      <div style="opacity:.70; margin-bottom:10px;">Counts by event type (FILLED / POSITION_CLOSED / STOPLOSS_DECISION / etc.).</div>
      <div id="mm-sr-outcomes-table" class="mm-table-wrap"></div>
    </div>

    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Exit reasons by regime</div>
      <div style="opacity:.70; margin-bottom:10px;">Reasons come from FILLED rows (when available).</div>
      <div id="mm-sr-reasons-table" class="mm-table-wrap"></div>
    </div>

    <div id="mm-sr-error" class="mm-card" style="display:none; padding: 14px 14px; border: 1px solid rgba(255,0,0,.25); background: rgba(255,0,0,.08);">
      <div style="font-weight:800; margin-bottom:6px;">sell_regime failed</div>
      <pre id="mm-sr-error-pre" style="white-space:pre-wrap; margin:0; opacity:.9;"></pre>
    </div>

  </div>
</div>

<script src="/static/js/analytics_sell_regime.js?v=1"></script>
{% endblock %}
