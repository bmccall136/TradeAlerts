{% extends "layout.html" %}
{% block content %}

<div class="tr-wrap">
  <div class="tr-topbar">
    <div>
      <div class="tr-title">$$Machine ? Trade Review</div>
      <div class="tr-sub">
        One trade story. Chart shows only the held window (time-at-risk). Shading is green for wins and red for losses.
      </div>
      <div class="tr-src">
        Source of truth: local DB (closed trade). Reasons: logs\\triggers_YYYY-MM-DD.csv + logs\\sell_triggers_YYYY-MM-DD.csv
      </div>
    </div>
    <div class="tr-actions">
      <a class="tr-btn" href="/analytics">Analytics</a>
      <a class="tr-btn" href="/analytics/recent_sells">Pick another</a>
      <a class="tr-btn" href="/trade_review/trade/{{ trade_id }}">Refresh</a>
    </div>
  </div>

  {% if error %}
    <div class="tr-error">{{ error }}</div>
  {% else %}

  <div class="tr-head">
    <div class="tr-hleft">
      <span class="tr-symbol">{{ trade.symbol }}</span>
      <span class="tr-name">{{ trade.name or '' }}</span>
    </div>
    <div class="tr-hright">
      <span class="tr-pill {% if trade.is_win %}win{% else %}loss{% endif %}">
        {% if trade.is_win %}WIN{% else %}LOSS{% endif %}
      </span>
      <span class="tr-pnl">{{ trade.pnl_text }}</span>
    </div>
  </div>

  <div class="tr-meta-row">
    <div><span class="k">Buy:</span> <span class="v">{{ trade.buy_time }}</span></div>
    <div><span class="k">Sell:</span> <span class="v">{{ trade.sell_time }}</span></div>
    <div><span class="k">Qty:</span> <span class="v">{{ trade.qty }}</span></div>
    <div><span class="k">Entry:</span> <span class="v">{{ trade.entry_price }}</span></div>
    <div><span class="k">Exit:</span> <span class="v">{{ trade.exit_price }}</span></div>
  </div>

  <div class="tr-card">
    <img class="tr-chart-img"
         src="/trade_review/chart/{{ trade_id }}.png"
         alt="Trade chart">
  </div>

  <div class="tr-grid">
    <section class="tr-col">
      <div class="tr-col-title">Buy Reasons (exact trigger row)</div>
      {% if buy_row %}
        <table class="tr-table">
          <tbody>
            {% for k,v in buy_row.items() %}
              <tr><td class="tr-k">{{ k }}</td><td class="tr-v">{{ v }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="tr-empty">No matching buy trigger row found in logs.</div>
      {% endif %}
    </section>

    <section class="tr-col">
      <div class="tr-col-title">Sell Reasons (exact trigger row)</div>
      {% if sell_row %}
        <table class="tr-table">
          <tbody>
            {% for k,v in sell_row.items() %}
              <tr><td class="tr-k">{{ k }}</td><td class="tr-v">{{ v }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="tr-empty">No matching sell trigger row found in logs.</div>
      {% endif %}
    </section>
  </div>

  {% endif %}
</div>

<style>
  .tr-wrap { max-width: 1400px; margin: 0 auto; padding: 18px 0; }
  .tr-topbar { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:14px; }
  .tr-title { color:#ffe900; font-size: 22px; font-weight: 700; }
  .tr-sub { color:#cfcfcf; margin-top:6px; font-size: 13px; }
  .tr-src { color:#8f8f8f; margin-top:10px; font-size: 12px; }
  .tr-actions { display:flex; gap:10px; }
  .tr-btn {
    display:inline-block; padding:7px 14px; border-radius: 12px;
    background:#1a1a1a; border:1px solid #3a3a3a; color:#ffe900;
    text-decoration:none; font-size: 13px;
  }
  .tr-btn:hover { border-color:#ffe900; }

  .tr-error { padding:10px 12px; border:1px solid #7a1a1a; background:#1a0b0b; color:#ffb3b3; border-radius:12px; }
  .tr-empty { color:#cfcfcf; opacity:0.85; margin-top: 6px; }

  .tr-head { display:flex; justify-content:space-between; align-items:center; margin: 8px 0 10px; }
  .tr-symbol { color:#fff; font-weight: 800; font-size: 18px; margin-right:10px; }
  .tr-name { color:#bdbdbd; font-size: 12px; }
  .tr-hright { display:flex; align-items:center; gap:10px; }
  .tr-pill { font-size: 11px; padding: 2px 10px; border-radius: 999px; font-weight:800; }
  .tr-pill.win { background:#102510; border:1px solid #2e7d32; color:#a9f5a9; }
  .tr-pill.loss { background:#2a1010; border:1px solid #b71c1c; color:#ffb3b3; }
  .tr-pnl { color:#e0e0e0; font-weight:700; }

  .tr-meta-row { display:flex; flex-wrap:wrap; gap:14px; color:#bdbdbd; font-size:12px; margin-bottom:12px; }
  .tr-meta-row .k { color:#8f8f8f; margin-right:6px; }
  .tr-meta-row .v { color:#e0e0e0; }

  .tr-card { background:#0f0f0f; border:1px solid #2a2a2a; border-radius:14px; padding:12px; margin-bottom: 14px; }
  .tr-chart-img{
    width: 100%;
    height: 240px;
    display:block;
    border-radius:12px;
    border:1px solid #2a2a2a;
    background:#0b0b0b;
    object-fit: cover;
  }

  .tr-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .tr-col { background:#0f0f0f; border:1px solid #2a2a2a; border-radius:14px; padding:12px; }
  .tr-col-title { color:#ffe900; font-weight:700; margin: 0 0 10px; font-size: 13px; }

  .tr-table { width:100%; border-collapse: collapse; font-size: 12px; }
  .tr-table td { padding: 6px 8px; border-bottom: 1px solid #1f1f1f; vertical-align: top; }
  .tr-k { color:#9d9d9d; width: 32%; }
  .tr-v { color:#e0e0e0; word-break: break-word; }

  @media (max-width: 1100px) {
    .tr-grid { grid-template-columns: 1fr; }
  }
</style>

{% endblock %}

