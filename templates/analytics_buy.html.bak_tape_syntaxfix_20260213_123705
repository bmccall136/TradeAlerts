    document.getElementById('fStrict').textContent  = fmtInt(j.strict_pass);
    document.getElementById('fBuyable').textContent = fmtInt(j.buyable);
    document.getElementById('fBought').textContent  = fmtInt(j.bought);
    document.getElementById('funnelMeta').textContent = `Bucket: ${j.bucket}  ?  Strict>=${j.strict_n}`;
  } catch(e) {}
}

function syncFunnelVisibility() {
  try {
    const sel = document.getElementById('sourceSel');
    const source = (sel && sel.value) ? sel.value : 'pregate';
    const el = document.getElementById('funnelCard');
    if (!el) return;
    el.style.display = (source === 'candidate') ? '' : 'none';
  } catch(e) {}
}


async function load(){

  // keep funnel visibility aligned to Source
  if (typeof syncFunnelVisibility === 'function') syncFunnelVisibility();

  // if Source is candidate, populate funnel KPIs
  try {
    const _srcSel = document.getElementById('sourceSel');
    const _source = (_srcSel && _srcSel.value) ? _srcSel.value : 'pregate';
    const _bucketSel = document.getElementById('bucketSel');
    const _bucket = (_bucketSel && _bucketSel.value) ? _bucketSel.value : 'all';
    if (_source === 'candidate' && (typeof loadFunnel === 'function')) {
      await loadFunnel(_bucket);
    }
  } catch(e) {}

    const bucket = $("bucketSel").value || "7d";
    $("metaText").textContent = "Loading...";
    $("rows").innerHTML = "";

        const source = (document.getElementById('sourceSel')?.value || 'pregate');
    if (typeof syncFunnelVisibility === 'function') syncFunnelVisibility();
    if (source === 'candidate') { await loadFunnel(bucket); }

    const endpoint = (source === 'candidate') ? '/api/analytics/candidate_fires' : '/api/analytics/fires';
    const r = await fetch(`${endpoint}?bucket=${encodeURIComponent(bucket)}`, {cache:"no-store"});
    const j = await r.json();
    if (!j || !j.ok){
      $("metaText").textContent = "Load failed.";
      return;
    }

    const items = j.items || [];
    const total = j.total || 0;

    $("metaText").textContent = `Rows: ${total} • Bucket: ${j.bucket || bucket}`;

    if (!items.length){
      $("rows").innerHTML = `<tr><td colspan="3" class="mm-muted">No data in this bucket.</td></tr>`;
      return;
    }

    const frag = [];
    for (const it of items){
      const ind = esc(it.indicator);
      const n = Number(it.n || 0);
      frag.push(`
        <tr>
          <td><b>${ind}</b></td>
          <td>${n.toLocaleString()}</td>
          <td>${pct(n, total)}</td>
        </tr>
      `);
    }
    $("rows").innerHTML = frag.join("");
  }

  document.addEventListener("DOMContentLoaded", ()=>{
    $("refreshBtn").addEventListener("click", load);
    $("bucketSel").addEventListener("change", load);
    $("sourceSel").addEventListener("change", load);
    load();
  });
})();
</script>
