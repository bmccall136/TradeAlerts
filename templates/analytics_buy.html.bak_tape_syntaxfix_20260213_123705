<script>

  // MM_FETCH_JSON_V1: safe fetch wrapper (prevents JSON.parse crashes on HTML/500)
  async function mmFetchJson(url) {
    const res = await fetch(url, { cache: "no-store" });
    const ct = (res.headers.get("content-type") || "").toLowerCase();
    if (!res.ok) {
      const txt = await res.text();
      throw new Error(`HTTP ${res.status} ${res.statusText}\n${txt.slice(0, 1200)}`);
    }
    if (!ct.includes("application/json")) {
      const txt = await res.text();
      throw new Error(`Expected JSON but got: ${ct}\n${txt.slice(0, 1200)}`);
    }
    return await res.json();
  }


// --- MM_CANDIDATE_UI_SHIM_V1 ---
// Some backends return only {counts:{signal_fires,trigger_fires}} for candidate_fires.
// The BUY Analytics template historically expects cand/req/strict/buyable/bought/strict_n.
// This shim fills those from counts when missing so the UI doesn't show "?".
function mmNormCandidatePayload(j){
  j = j || {};
  const counts = j.counts || {};
  const out = Object.assign({}, j);
  out.cand = (out.cand !== undefined) ? out.cand : (counts.signal_fires !== undefined ? counts.signal_fires : 0);
  out.req  = (out.req  !== undefined) ? out.req  : (counts.trigger_fires !== undefined ? counts.trigger_fires : 0);
  out.strict   = (out.strict   !== undefined) ? out.strict   : 0;
  out.buyable  = (out.buyable  !== undefined) ? out.buyable  : 0;
  out.bought   = (out.bought   !== undefined) ? out.bought   : 0;
  out.strict_n = (out.strict_n !== undefined) ? out.strict_n : 0;
  return out;
}
// --- /MM_CANDIDATE_UI_SHIM_V1 ---

// --- MM_BUCKET_NORMALIZE_V1 ---
function mmNormBucket(b) {
  if (!b) return "today";
  const s = String(b).trim();
  const u = s.toUpperCase();
  if (u === "TODAY") return "today";
  if (u === "7D") return "7d";
  if (u === "30D") return "30d";
  if (u === "ALL") return "all";
  return s.toLowerCase();
}

(function(){
