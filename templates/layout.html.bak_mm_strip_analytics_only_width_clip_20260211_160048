<style>
/* MM_REGIME_STRIP_STYLE_V1 */
/* MM_REGIME_STRIP_CSS_V2 */
.mm-regime-bar{
  width:420px;
  height:18px;
  border:1px solid rgba(255,255,255,0.35);
  border-radius:2px;
  display:flex;
  overflow:hidden;
  background:rgba(0,0,0,0.35);
  position:relative; /* REQUIRED for ::after ticks */

  --mm-hour-step: 64.615px;   /* 60m */
  --mm-minor-step: 10.769px; /* 10m */
}

.mm-regime-bar > div{
  height:100%;
  position:relative;
  z-index:2; /* ABOVE ticks */
}
.mm-regime-bar::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  opacity:0.75;

  /* major ticks exactly on the hour (9:30->16:00 maps to 420px over 390m) */
  background:
    repeating-linear-gradient(
      to right,
      rgba(255,255,255,0.70) 0px,
      rgba(255,255,255,0.70) 1px,
      rgba(255,255,255,0.0)  1px,
      rgba(255,255,255,0.0)  var(--mm-hour-step)
    ),
    repeating-linear-gradient(
      to right,
      rgba(255,255,255,0.28) 0px,
      rgba(255,255,255,0.28) 1px,
      rgba(255,255,255,0.0)  1px,
      rgba(255,255,255,0.0)  var(--mm-minor-step)
    );
}
/* Hour labels row */
.mm-regime-hours{
  width:420px;
  display:flex;
  justify-content:space-between;
  padding-top:2px;
  font-size:13px;
  opacity:0.85;
}


/* MM_REGIME_STRIP_ZFIX_V1 */
.ax-regime-bar > div, .mm-regime-bar > div, .regime-bar > div {
  position: relative;
  z-index: 2;
}

/* ---- Regime strip polish (Analytics timeline strip rendered in layout slot) ---- */

/* Make the TREND/CHOP/DEAD legend smaller + tighter */
.ax-regime-legend, .mm-regime-legend, .regime-legend {
  font-size: 14px !important;
  line-height: 1 !important;
  letter-spacing: 0.5px !important;
  opacity: 0.9 !important;
  margin-right: 10px !important;
  white-space: nowrap !important;
}

/* Slightly reduce hour labels too (10 11 12 1 2 3 4) */
.ax-regime-hours, .mm-regime-hours, .regime-hours {
  font-size: 13px !important;
  opacity: 0.85 !important;
}

/* Hour tick marks on the bar: 6 intervals between 7 hour labels (10..4) */
.ax-regime-bar, .mm-regime-bar, .regime-bar {
  position: relative !important;
  overflow: hidden !important;
}

.ax-regime-bar::after,
.mm-regime-bar::after,
.regime-bar::after {
  z-index: 1;
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  /* 1px vertical line repeated every 1/6th width */
  background-image: linear-gradient(to right, rgba(255,255,255,0.25) 1px, transparent 1px);
  background-size: calc(100% / 6) 100%;
  background-repeat: repeat;
  opacity: 0.55;
}
</style>


