<script id="mm-regime-canonical">
(function(){
  function setDot(reg){
    var dot = document.getElementById("mm-regime-dot");
    if(!dot) return;
var r = String(reg || "UNKNOWN").toUpperCase();
    if(r === "TREND") dot.style.backgroundColor = "#4caf50";
    else if(r === "CHOP") dot.style.backgroundColor = "#ffb300";
    else if(r === "DEAD") dot.style.backgroundColor = "#f44336";
    else dot.style.backgroundColor = "#9e9e9e";
  }

  async function update(){
    try{
      const res = await fetch("/api/market_regime", {cache:"no-store"});
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();

      var reg = (j.label || j.regime_label || j.regime || j.state || j.name || "UNKNOWN");
var conf = (j.confidence != null ? j.confidence : (j.conf != null ? j.conf : j.score));

      var confTxt = "";
      if(typeof conf === "number" && isFinite(conf)){
        confTxt = " " + Math.round(conf) + "%";
      } else if (conf != null && String(conf).trim() !== ""){
        confTxt = " " + String(conf).trim();
      }

      var nameEl = document.getElementById("mm-regime-name");
      var confEl = document.getElementById("mm-regime-conf");
      if(nameEl) nameEl.textContent = String(reg).toUpperCase();
      if(confEl) confEl.textContent = confTxt;

      setDot(reg);
      // MM_REGIME_SAMPLE_POST_V1 removed (no-op)
    }catch(e){
      var nameEl = document.getElementById("mm-regime-name");
      if(nameEl && (!nameEl.textContent || nameEl.textContent.trim()==="?")) nameEl.textContent = "UNKNOWN";
      setDot("UNKNOWN");
    }
  }

  if(window.__mmRegimeTimer) clearInterval(window.__mmRegimeTimer);
  update();
  window.__mmRegimeTimer = setInterval(update, 60000);
})();
</script>


<script>
/* MM_REGIME_STRIP_RENDERER_V1 */
(function(){
  function q(sel){ return document.querySelector(sel); }

  function getAnalyticsDate(){
    // Prefer analytics page date input if present
    const di = q('input[type="date"], input[name="date"], #date, #analytics-date');
    if (di && di.value) return di.value;
    // Fall back: try to parse the visible "YYYY-MM-DD" under Daily Analytics
    const el = q('.page-subtitle, .subtitle, .ax-date, .analytics-date');
    if (el){
      const m = (el.textContent||'').match(/(\d{4}-\d{2}-\d{2})/);
      if (m) return m[1];
    }
    return "";
  }

  function compressBuckets(buckets){
    // buckets: [{t:"HH:MM", r:"TREND|CHOP|DEAD", ...}, ...]
    if (!buckets || !buckets.length) return [];
    const segs = [];
    let cur = buckets[0].r, start = 0;
    for (let i=1;i<buckets.length;i++){
      if (buckets[i].r !== cur){
        segs.push({r: cur, n: i - start});
        cur = buckets[i].r;
        start = i;
      }
    }
    segs.push({r: cur, n: buckets.length - start});
    return segs;
  }

  function colorFor(r){
    r = (r||'').toUpperCase();
    if (r === 'TREND') return '#00d26a';
    if (r === 'CHOP')  return '#ffd400';
    if (r === 'DEAD')  return '#ff4a4a';
    return 'rgba(255,255,255,0.12)';
  }

  async function render(){
    const host = q('#mm-regime-strip');
    try{ host.setAttribute('data-painted','1'); }catch(e){}
    if (!host) return;

    const bar = q('.mm-regime-bar') || q('.ax-regime-bar') || q('.regime-bar');
    if (!bar) return;

    // wipe bar
    bar.innerHTML = '';

    const date = getAnalyticsDate();
    const url = date ? ('/api/market_regime_timeline?date=' + encodeURIComponent(date)) : '/api/market_regime_timeline';

    try{
      const r = await fetch(url, {cache:'no-store'});
      if (!r.ok) return;
      const j = await r.json();
            // --- MM_REGIME_HOURS_FALLBACK_V1 ---
      // Ensure the hours row exists and is visible; if tick builder fails or is overridden, we still show hours.
      const labels = document.querySelector('#mm-regime-strip .mm-regime-hours');
      if (labels){
        labels.style.display = 'block';
        labels.style.position = 'relative';
        labels.style.height = '16px';
        labels.style.width = (j && j.width_px ? (String(j.width_px) + 'px') : labels.style.width) || labels.style.width;

        // Clear + rebuild hour labels from start_et/end_et when needed.
        const ensureHours = () => {
          if (labels.querySelector('.mm-hour')) return; // already has labels
          const start = (j && j.start_et) ? j.start_et : '09:30';
          const end   = (j && j.end_et)   ? j.end_et   : '16:00';

          // Compute hour marks (10..16) within the session, place them proportionally.
          // Session in minutes (handles 09:30 start cleanly).
          const toMin = (hhmm) => {
            const m = String(hhmm||'').match(/^(\d{1,2}):(\d{2})$/);
            if (!m) return None;
            return (int(m[1]) * 60) + int(m[2]);
          };

          // JS version inline (avoid python replacement complexity)
        };

        // We run this after a short delay too (in case other code wipes labels)
        setTimeout(() => {
          if (labels.querySelector('.mm-hour')) return;
          labels.innerHTML = '';

          const parse = (hhmm) => {
            const m = String(hhmm||'').match(/^(\d{1,2}):(\d{2})$/);
            if (!m) return null;
            return (parseInt(m[1],10)*60) + parseInt(m[2],10);
          };

          const startMin = parse((j && j.start_et) ? j.start_et : '09:30') || (9*60+30);
          const endMin   = parse((j && j.end_et)   ? j.end_et   : '16:00') || (16*60);

          const span = Math.max(1, endMin - startMin);

          // Label hours 10..16 (display 10,11,12,1,2,3,4)
          const hours = [10,11,12,13,14,15,16];
          for (const h of hours){
            const t = h*60;
            if (t < startMin || t > endMin) continue;
            const pct = ((t - startMin) / span) * 100;

            const sp = document.createElement('span');
            sp.className = 'mm-hour';
            sp.style.left = pct.toFixed(3) + '%';
            sp.textContent = (h <= 12) ? String(h) : String(h-12);
            labels.appendChild(sp);
          }
        }, 50);
      }
      // --- /MM_REGIME_HOURS_FALLBACK_V1 ---
const buckets = j.buckets || [];
      
    

      // --- MM_STRIP_WIDTH_CLIP_TO_NOW_V1 ---
      // Visually stop the strip at "now" (ET) when viewing TODAY.
      // This avoids "strip extends to close" even when buckets don't carry ts_utc.
      try {
        const widthFull = (j && j.width_px) ? parseInt(j.width_px, 10) : 520;

        // Determine if we're viewing today in ET (no date param OR date==todayEt)
        const etNow = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
        const etY = etNow.getFullYear();
        const etM = String(etNow.getMonth()+1).padStart(2,'0');
        const etD = String(etNow.getDate()).padStart(2,'0');
        const todayEt = `${etY}-${etM}-${etD}`;
        const viewingToday = (!date) || (String(date).slice(0,10) === todayEt);

        if (viewingToday) {
          const parseHHMM = (hhmm) => {
            const mm = String(hhmm||'').match(/^(\d{1,2}):(\d{2})$/);
            if (!mm) return null;
            return (parseInt(mm[1],10)*60) + parseInt(mm[2],10);
          };

          const startMin = parseHHMM((j && j.start_et) ? j.start_et : '09:30') ?? (9*60+30);
          const endMin   = parseHHMM((j && j.end_et)   ? j.end_et   : '16:00') ?? (16*60);
          const nowMin   = etNow.getHours()*60 + etNow.getMinutes();

          const span = Math.max(1, endMin - startMin);
          const elapsed = Math.max(0, Math.min(span, nowMin - startMin));
          const pct = elapsed / span;
          const w = Math.max(2, Math.round(widthFull * pct)); // never zero-width

          // Apply width clip to the BAR (and hours row to keep alignment).
          bar.style.width = w + "px";

          const labels = document.querySelector('#mm-regime-strip .mm-regime-hours');
          if (labels) labels.style.width = w + "px";
        } else {
          // Non-today: render full width from API
          bar.style.width = ((j && j.width_px) ? (String(j.width_px) + "px") : "520px");
        }
      } catch(e) {}
      // --- /MM_STRIP_WIDTH_CLIP_TO_NOW_V1 ---


    // --- MM_CLIP_STRIP_TO_NOW_V1 ---
    try {
      // Clip future buckets when viewing "today" (no date param) or date == today (ET)
      const nowUtc = Math.floor(Date.now()/1000);
      const etNow = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
      const etY = etNow.getFullYear();
      const etM = String(etNow.getMonth()+1).padStart(2,'0');
      const etD = String(etNow.getDate()).padStart(2,'0');
      const todayEt = `${etY}-${etM}-${etD}`;
      const viewingToday = (!date) || (String(date).slice(0,10) === todayEt);
      if (viewingToday && Array.isArray(buckets) && buckets.length) {
        // ts_utc can be under different keys depending on API version
        const tsKey = (buckets[0] && (('ts_utc' in buckets[0]) ? 'ts_utc' : (('ts' in buckets[0]) ? 'ts' : (('t' in buckets[0]) ? 't' : null))));
        if (tsKey) {
          const before = buckets.length;
          const clipped = buckets.filter(b => {
            const t = parseInt(b?.[tsKey] ?? 0, 10);
            return !t || t <= nowUtc;
          });
          // mutate in-place to preserve downstream references
          buckets.length = 0;
          for (const b of clipped) buckets.push(b);
          // console.log("MM clip buckets", before, "->", buckets.length, "nowUtc", nowUtc);
        }
      }
    } catch(e) {}
// --- MM_CLIP_STRIP_TO_NOW_V1 ---
    try {
      // Clip future buckets when viewing "today" (no date param) or date == today (ET)
      const nowUtc = Math.floor(Date.now()/1000);
      const etNow = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
      const etY = etNow.getFullYear();
      const etM = String(etNow.getMonth()+1).padStart(2,'0');
      const etD = String(etNow.getDate()).padStart(2,'0');
      const todayEt = `${etY}-${etM}-${etD}`;
      const viewingToday = (!date) || (String(date).slice(0,10) === todayEt);
      if (viewingToday && Array.isArray(buckets) && buckets.length) {
        // ts_utc can be under different keys depending on API version
        const tsKey = (buckets[0] && (('ts_utc' in buckets[0]) ? 'ts_utc' : (('ts' in buckets[0]) ? 'ts' : (('t' in buckets[0]) ? 't' : null))));
        if (tsKey) {
          const before = buckets.length;
          const clipped = buckets.filter(b => {
            const t = parseInt(b?.[tsKey] ?? 0, 10);
            return !t || t <= nowUtc;
          });
          // mutate in-place to preserve downstream references
          buckets.length = 0;
          for (const b of clipped) buckets.push(b);
          // console.log("MM clip buckets", before, "->", buckets.length, "nowUtc", nowUtc);
        }
      }
    } catch(e) {}
if (!buckets.length) return;

      const segs = compressBuckets(buckets);
      const total = buckets.length;

      for (const s of segs){
        const div = document.createElement('div');
        div.style.flex = String(s.n);
        div.style.background = colorFor(s.r);
        div.title = s.r + ' (' + s.n + ' buckets)';
        bar.appendChild(div);
      }
    }catch(e){
      // silent
    }
  }

  // render on load + after a short delay (in case analytics date input populates late)
  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', ()=>{ render(); setTimeout(render, 600); });
  } else {
    render(); setTimeout(render, 600);
  }
})();
</script>

