{% extends "layout.html" %}
{% block content %}
<style>
  .mm-card { background:#0f1118; border:1px solid #222531; border-radius:10px; }
  .mm-muted { opacity:.82; }
  .mm-stickybar {
    position: sticky; top: 10px; z-index: 50;
    background: rgba(15,17,24,.95);
    border: 1px solid #222531;
    border-radius: 10px;
    padding: 10px 12px;
    backdrop-filter: blur(6px);
  }
  .mm-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }

  .mm-gate-grid{
    display:grid;
    grid-template-columns: repeat(8, minmax(120px, 1fr));
    gap: 8px 10px;
  }
  @media (max-width: 1200px) { .mm-gate-grid { grid-template-columns: repeat(4, minmax(140px, 1fr)); } }
  @media (max-width: 700px)  { .mm-gate-grid { grid-template-columns: repeat(2, minmax(140px, 1fr)); } }

  .mm-gate-pill{
    display:flex; align-items:center; gap:8px;
    border:1px solid #262a38; border-radius:10px; padding:6px 8px;
    background:#0b0d14;
  }
  .mm-gate-pill input { transform: scale(1.05); }
  .mm-disabled-pill { opacity:.55; filter: grayscale(20%); }
  .mm-disabled-pill input { cursor:not-allowed; }
  .mm-disabled-pill label { cursor:not-allowed; }

  .mm-gate-subtitle { font-weight:800; margin: 12px 0 6px 0; }
  .mm-gate-note { font-size: 12px; opacity:.85; margin: 0 0 10px 0; }
  .mm-divider { height:1px; background:#222531; margin: 14px 0; }

  .mm-cards { display:flex; flex-direction:column; gap:10px; }
  details.mm-ind { border:1px solid #222531; border-radius:10px; background:#0b0d14; }
  details.mm-ind[open] { background:#0f1118; }
  details.mm-ind > summary {
    list-style:none; cursor:pointer;
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:10px 12px;
  }
  details.mm-ind > summary::-webkit-details-marker { display:none; }
  .mm-title { font-weight:800; }
  .mm-right { display:flex; align-items:center; gap:10px; }
  .mm-count { font-size:12px; opacity:.85; }

  .mm-body { padding: 8px 12px 12px 12px; border-top:1px solid #222531; }
  .mm-grid {
    display:grid;
    grid-template-columns: 1fr 260px;
    gap: 8px 12px;
    align-items:center;
  }
  @media (max-width: 700px) { .mm-grid { grid-template-columns: 1fr; } }

  .mm-grid label { opacity:.95; color:#d7dbe6; font-weight:700; }
  .mm-grid input[type="text"], .mm-grid input[type="number"], .mm-grid select {
    width:100%;
    background:#0b0d14;
    border:1px solid #262a38;
    border-radius:8px;
    color:#e8e8e8;
    padding:6px 8px;
  }
  .mm-toggle {
    display:flex; align-items:center; gap:8px;
    border:1px solid #262a38; border-radius:10px; padding:6px 8px;
    background:#0b0d14;
  }
  .mm-section-title { font-size:18px; font-weight:800; margin-bottom:6px; }
  .mm-subtitle { margin-top:0; margin-bottom:10px; }

  /* Checkbox accent */
  #settings-page input[type="checkbox"] { accent-color: #f5d400; }
  #settings-page input[type="checkbox"]:focus { outline:none; box-shadow: 0 0 0 2px rgba(245,212,0,0.25); }

  #settings-page { max-width: 1100px !important; margin-left:auto !important; margin-right:auto !important; }
  body, #settings-page { color:#e9edf6; }
</style>

<div id="settings-page" class="container-fluid" style="max-width:1100px;margin-left:auto;margin-right:auto;">

  <div class="d-flex align-items-center justify-content-between" style="margin:18px 0 10px 0;">
    <div style="font-size:22px;font-weight:800;">Settings</div>
    <div class="d-flex align-items-center" style="gap:10px;">
      <div class="btn-group" role="group" aria-label="settings tabs">
        <a class="btn btn-sm btn-dark" href="/settings/buy">BUY</a>
        <a class="btn btn-sm btn-warning" href="/settings/sell">SELL</a>
      </div>
      <div class="d-flex align-items-center" style="gap:8px;">
        <div style="opacity:.85;">Profile</div>
        <select id="profileSel" class="form-select form-select-sm" style="width:130px;">
          <option value="day">DAY</option>
          <option value="swing">SWING</option>
        </select>
      </div>
    </div>
  </div>

  <div class="mm-stickybar mb-3">
    <div class="mm-row">
      <div class="mm-muted">Editing: <b id="stickyGroup">SELL</b> / <b id="stickyProfile">DAY</b></div>
      <div style="display:flex; align-items:center; gap:10px;">
        <button id="saveBtnTop" class="btn btn-warning">Save</button>
        <div id="saveMsgTop" class="mm-muted"></div>
      </div>
    </div>
  </div>

  <!-- SELL "splitâ€ legend (like BUY, but NOT a gate) -->
  <div id="sellLegendCard" class="card mm-card mb-3">
    <div class="card-body">
      <div style="font-size:18px;font-weight:700;">Sell Modules Overview</div>
      <div style="opacity:.9;margin:2px 0 10px 0;">
        <b>Exit Triggers</b> decide "should we sellâ€. <b>Execution/Safety</b> controls how we place orders and guardrails.
      </div>

      <div class="mm-gate-subtitle">Exit Triggers (cause a sell)</div>
      <div class="mm-gate-note">These are the decision engines that fire sell actions.</div>
      <div id="sellGridTriggers" class="mm-gate-grid"></div>

      <div class="mm-divider"></div>

      <div class="mm-gate-subtitle">Execution / Safety (does not "causeâ€ a sell)</div>
      <div class="mm-gate-note">These control routing, windows, throttles, counts, and safety rules.</div>
      <div id="sellGridExec" class="mm-gate-grid"></div>
    </div>
  </div>

  <div class="card mm-card mb-3">
    <div class="card-body">
      <div class="mm-section-title">Sell Modules</div>
      <div class="mm-muted mm-subtitle">Each section can be expanded/collapsed. Settings live inside each card.</div>
      <div id="indicatorCards" class="mm-cards"></div>
    </div>
  </div>

</div>

<script>
  window.__MM_GROUP__ = "sell";
  window.__MM_CFG__ = {
    // Cards are your existing SELL modules (kept), with better labeling.
    cards: [
      {
        "key":"ai",
        "label":"AI Advisor (SELL)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"ai.enabled","label":"Enabled","type":"bool"},
          {"k":"ai.use_entries","label":"Use Entries","type":"bool"},
          {"k":"ai.use_exits","label":"Use Exits","type":"bool"}
        ]
      },
      {
        "key":"sell_guard_core",
        "label":"Core Loop / Session / Throttle (execution)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"sell_guard.mode","label":"Mode","type":"text","optional":true},
          {"k":"sell_guard.interval_sec","label":"Interval Secs","type":"number","optional":true},
          {"k":"sell_guard.sell_window_start_et","label":"Sell Window Start (ET)","type":"text","optional":true},
          {"k":"sell_guard.sell_window_end_et","label":"Sell Window End (ET)","type":"text","optional":true},
          {"k":"sell_guard.use_extended_hours","label":"Use Extended Hours","type":"bool","optional":true},
          {"k":"sell_guard.throttle_ms","label":"Throttle ms","type":"number","optional":true}
        ]
      },
      {
        "key":"targets",
        "label":"Targets & Stops (exit triggers)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"sell_guard.target_gain_pct","label":"Target Gain % (sell_guard)","type":"number","optional":true},
          {"k":"sell_guard.target_bps","label":"Target bps (sell_guard)","type":"number","optional":true},
          {"k":"sell_guard.stop_bps","label":"Stop bps (sell_guard)","type":"number","optional":true},
          {"k":"sell_guard.timeout_exit_pct","label":"Timeout Exit % (sell_guard)","type":"number","optional":true},
          {"k":"sell_guard.allow_intraday_stoploss","label":"Allow Intraday Stop","type":"bool","optional":true},
          {"k":"sell_guard.intraday_stoploss_pct","label":"Intraday Stop %","type":"number","optional":true}
        ]
      },
      {
        "key":"timeouts",
        "label":"Timeout / Hold Rules (exit triggers)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"sell_guard.enable_timeout_exits","label":"Enable Timeout Exits","type":"bool","optional":true},
          {"k":"sell_guard.max_hold_minutes","label":"Max Hold Minutes","type":"number","optional":true},
          {"k":"sell_guard.min_hold_minutes","label":"Min Hold Minutes","type":"number","optional":true},
          {"k":"sell_guard.min_hold_days","label":"Min Hold Days","type":"number","optional":true}
        ]
      },
	  {
	  "key":"stale_relief_exit",
	  "label":"Stale Relief Exit (exit triggers)",
	  "enable_key": null, "enable_is_field": false,
	  "fields":[
		{"k":"stale_relief_exit.enabled","label":"Enabled","type":"bool"},
		{"k":"stale_relief_exit.min_hold_days","label":"Min Hold Days","type":"number"},
		{"k":"stale_relief_exit.relief_gain_pct","label":"Relief Gain % (exit when >=)","type":"number"},
		{"k":"stale_relief_exit.runner_max_gain_pct","label":"Runner Max Gain % (ignore if ever >=)","type":"number"},
		{"k":"stale_relief_exit.require_regime_nontrend","label":"Require Non-TREND Regime","type":"bool"},
		{"k":"stale_relief_exit.regime_conf_max","label":"Regime Conf Max","type":"number"}
	  ]
	},
      {
        "key":"protect",
        "label":"Protect / Trailing (exit triggers)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"sell_guard.trail_arm_gain_pct","label":"Trail Arm Gain %","type":"number","optional":true},
          {"k":"sell_guard.trail_backoff_pct","label":"Trail Backoff %","type":"number","optional":true},
          {"k":"sell_guard.protect_min_gain_pct","label":"Protect Min Gain %","type":"number","optional":true},
          {"k":"sell_guard.protect_trail_arm_pct","label":"Protect Trail Arm %","type":"number","optional":true},
          {"k":"sell_guard.protect_trail_pct","label":"Protect Trail %","type":"number","optional":true},
          {"k":"sell_guard.sell_protect_after_mins","label":"Protect After Mins","type":"number","optional":true}
        ]
      },
      {
        "key":"filters",
        "label":"Filters / Safety (execution)",
        "enable_key": null, "enable_is_field": false,
        "fields":[
          {"k":"sell_guard.blocklist","label":"Blocklist","type":"text","optional":true},
          {"k":"sell_guard.only_allow_symbol","label":"Only Allow Symbol","type":"text","optional":true},
          {"k":"sell_guard.avoid_daytrades","label":"Avoid Daytrades","type":"bool","optional":true},
          {"k":"sell_guard.pdt_allow_stop","label":"PDT Allow Stop","type":"bool","optional":true},
          {"k":"sell_guard.max_place_attempts","label":"Max Place Attempts","type":"number","optional":true},
          {"k":"sell_guard.normalize_tick","label":"Normalize Tick","type":"number","optional":true},
          {"k":"sell_guard.limit_from","label":"Limit From","type":"text","optional":true},
          {"k":"sell_guard.limit_offset_bps","label":"Limit Offset bps","type":"number","optional":true}
        ]
      }
    ],

    // "Splitâ€ legend pills
    triggers: [
      {"key":"targets","label":"TARGET/STOP"},
      {"key":"timeouts","label":"TIMEOUT/HOLD"},
      {"key":"protect","label":"PROTECT/TRAIL"},
      {"key":"ai","label":"AI EXITS"}
    ],
    exec: [
      {"key":"sell_guard_core","label":"CORE LOOP"},
      {"key":"filters","label":"FILTERS/SAFETY"}
    ]
  };
</script>

<script>
// MM_REO_SAVE_HOOK_V7
function MM_REO_MERGE_SETTINGS_OBJ(obj){
  try{
    if(!obj || typeof obj !== "object") return obj;
    var ov = null;
    try { ov = (window.MM_REO && window.MM_REO.getOverlay) ? window.MM_REO.getOverlay() : null; } catch(e){ ov = null; }
    if(ov && typeof ov === "object"){
      obj.regime_exit_overlay = ov;
    }
  }catch(e){}
  return obj;
}

(() => {
  const GROUP = (window.__MM_GROUP__ || "sell");
  const CFG = window.__MM_CFG__ || { cards:[], triggers:[], exec:[] };
  const byId = (id) => document.getElementById(id);

  let SETTINGS = {};

  function normProfile(v){
    v = String(v||"").toLowerCase();
    return (v === "swing") ? "swing" : "day";
  }

  async function apiLoad(profile){
    const r = await fetch(`/api/settings/load?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "load failed");
    return (j.data && typeof j.data === "object") ? j.data : {};
  }

  async function apiSave(profile, data){

    // MM_REO_SAVE_HOOK_V7: force-sync overlay -> hidden JSON/global mirrors before saving
    try { if (window.MM_REO && window.MM_REO.push) window.MM_REO.push(); } catch(e) {}
    const r = await fetch(`/api/settings/save?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, {
      method:"POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(MM_REO_MERGE_SETTINGS_OBJ(data || {}))
    });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "save failed");
    return j;
  }

  function getPath(obj, path){
    const parts = String(path||"").split(".");
    let cur = obj;
    for (const p of parts){
      if (!cur || typeof cur !== "object") return undefined;
      cur = cur[p];
    }
    return cur;
  }

  function setPath(obj, path, value){
    const parts = String(path||"").split(".");
    let cur = obj;
    for (let i=0;i<parts.length;i++){
      const p = parts[i];
      if (i === parts.length-1){
        cur[p] = value;
      } else {
        if (!cur[p] || typeof cur[p] !== "object") cur[p] = {};
        cur = cur[p];
      }
    }
  }

  function renderLegend(){
    const hostA = byId("sellGridTriggers");
    const hostB = byId("sellGridExec");
    if (hostA) hostA.innerHTML = "";
    if (hostB) hostB.innerHTML = "";

    const mk = (g, disabled=false) => {
      const pill = document.createElement("div");
      pill.className = "mm-gate-pill" + (disabled ? " mm-disabled-pill" : "");
      const id = `pill_${g.key}`;
      pill.innerHTML = `
        <input type="checkbox" id="${id}" ${disabled ? "disabled" : "disabled"}>
        <label for="${id}" style="margin:0;font-weight:800;">${g.label}</label>
      `;
      pill.title = disabled ? "Execution/Safety module (not an exit trigger itself)." : "Exit trigger module.";
      return pill;
    };

    // Triggers: show as "active categoryâ€ pills (still disabled - this is a legend, not a gate)
    if (hostA){
      for (const g of (CFG.triggers || [])) hostA.appendChild(mk(g,false));
    }
    // Exec: show as disabled/greyed legend pills
    if (hostB){
      for (const g of (CFG.exec || [])) hostB.appendChild(mk(g,true));
    }
  }

  function renderCards(){
    const host = byId("indicatorCards");
    if (!host) return;
    host.innerHTML = "";

    for (const card of (CFG.cards || [])){
      const det = document.createElement("details");
      det.className = "mm-ind";
      det.open = true;

      const sum = document.createElement("summary");
      sum.innerHTML = `
        <div class="mm-title">${card.label}</div>
        <div class="mm-right"></div>
      `;
      det.appendChild(sum);

      const body = document.createElement("div");
      body.className = "mm-body";
      const grid = document.createElement("div");
      grid.className = "mm-grid";

      for (const f of (card.fields || [])){
        const key = f.k;
        const label = f.label || key;
        const type = f.type || "text";
        const optional = !!f.optional;

        const existing = key.includes(".") ? (getPath(SETTINGS, key) !== undefined) : (SETTINGS[key] !== undefined);
        if (optional && !existing) continue;

        const rowLabel = document.createElement("label");
        rowLabel.textContent = label;

        let input;
        if (type === "bool"){
          input = document.createElement("input");
          input.type = "checkbox";
          input.checked = !!(key.includes(".") ? getPath(SETTINGS, key) : SETTINGS[key]);
          input.onchange = () => {
            const v = !!input.checked;
            if (key.includes(".")) setPath(SETTINGS, key, v);
            else SETTINGS[key] = v;
          };
        } else {
          input = document.createElement("input");
          input.type = (type === "number") ? "number" : "text";
          const v = key.includes(".") ? getPath(SETTINGS, key) : SETTINGS[key];
          input.value = (v === undefined || v === null) ? "" : String(v);
          input.oninput = () => {
            const val = (type === "number") ? Number(input.value) : input.value;
            if (key.includes(".")) setPath(SETTINGS, key, val);
            else SETTINGS[key] = val;
          };
        }

        const box = document.createElement("div");
        box.appendChild(input);

        grid.appendChild(rowLabel);
        grid.appendChild(box);
      }

      body.appendChild(grid);
      det.appendChild(body);
      host.appendChild(det);
    }
  }

  async function refreshAll(){
    const prof = normProfile(byId("profileSel")?.value || "day");
    byId("stickyProfile").textContent = prof.toUpperCase();
    byId("stickyGroup").textContent = "SELL";

    try { SETTINGS = await apiLoad(prof); }
    catch(e){ console.error(e); SETTINGS = {}; }

    if (!SETTINGS.ai || typeof SETTINGS.ai !== "object") {
      SETTINGS.ai = { enabled:false, use_entries:false, use_exits:false };
    }
    renderLegend();
    renderCards();
  }

  async function doSave(){
    const prof = normProfile(byId("profileSel")?.value || "day");
    const msg = byId("saveMsgTop");
    if (msg) msg.textContent = "Saving...";
    try {
      await apiSave(prof, SETTINGS);
      if (msg) msg.textContent = "Saved.";
      setTimeout(() => { if (msg) msg.textContent = ""; }, 1500);
    } catch(e){
      console.error(e);
      if (msg) msg.textContent = "Save failed.";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const profileSel = byId("profileSel");
    if (profileSel) profileSel.onchange = refreshAll;

    const saveBtnTop = byId("saveBtnTop");
    if (saveBtnTop) saveBtnTop.onclick = doSave;

    refreshAll();
  });
})();
</script>

<!-- MM_REGIME_EXIT_OVERLAY_UI_V5_START -->
<div class="card mb-3" id="mm-regime-exit-overlay-card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div class="fw-bold">Regime Exit Overlay</div>
    <div class="small text-secondary">target_mult / stop_mult / time_mult</div>
  </div>
  <div class="card-body">
    <div class="row g-2">

    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="fw-bold" style="min-width:110px">TREND</div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <label class="small text-secondary mb-0">target</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="TREND.target_mult">
          <label class="small text-secondary mb-0">stop</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="TREND.stop_mult">
          <label class="small text-secondary mb-0">time</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="TREND.time_mult">
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="fw-bold" style="min-width:110px">CHOP</div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <label class="small text-secondary mb-0">target</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="CHOP.target_mult">
          <label class="small text-secondary mb-0">stop</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="CHOP.stop_mult">
          <label class="small text-secondary mb-0">time</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="CHOP.time_mult">
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="fw-bold" style="min-width:110px">DEAD</div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <label class="small text-secondary mb-0">target</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="DEAD.target_mult">
          <label class="small text-secondary mb-0">stop</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="DEAD.stop_mult">
          <label class="small text-secondary mb-0">time</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="DEAD.time_mult">
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="fw-bold" style="min-width:110px">UNKNOWN</div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <label class="small text-secondary mb-0">target</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="UNKNOWN.target_mult">
          <label class="small text-secondary mb-0">stop</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="UNKNOWN.stop_mult">
          <label class="small text-secondary mb-0">time</label>
          <input class="form-control form-control-sm" style="width:120px" type="number" step="0.01" data-mm-reo="UNKNOWN.time_mult">
        </div>
      </div>
    </div>
    </div>
    <div class="mt-2 small text-secondary">
      Applies on regime changes only. Stored in <code>regime_exit_overlay</code>.
      Active file is chosen by <code>live_mode.txt</code>.
    </div>
  </div>
</div>

<!-- keep JSON hidden (human-first UI) -->
<textarea id="settings_json" name="settings_json" style="display:none" aria-hidden="true"></textarea>

<script>
(function(){
  function qs(sel){ return document.querySelector(sel); }
  function qsa(sel){ return Array.prototype.slice.call(document.querySelectorAll(sel)); }


  // MM_REO_ENSURE_CARD_V9
  // The settings pages are fetch-driven; DOM can be rebuilt. Ensure the overlay card exists in the visible flow.
  function MM_REO_ENSURE_CARD(){
    try{
      var card = document.getElementById("mm-regime-exit-overlay-card");
      if(!card) return;

      // Prefer placing it before "Other Settings" section if present
      var anchors = [
        document.querySelector('h5, h4, h3'),
        document.querySelector('[data-mm-section="other-settings"]'),
        document.querySelector('#mm-other-settings'),
        document.querySelector('.mm-other-settings'),
      ].filter(Boolean);

      // If we can find the "Other Settings" header by text, use it
      var hs = Array.prototype.slice.call(document.querySelectorAll("h1,h2,h3,h4,h5,div,span"));
      var other = null;
      for(var i=0;i<hs.length;i++){
        var t = (hs[i].textContent||"").trim().toLowerCase();
        if(t === "other settings" || t.indexOf("other settings") >= 0){
          other = hs[i];
          break;
        }
      }

      var insertBefore = other || anchors[0] || null;

      // Fallback: insert near the top of the main content container
      var main = document.querySelector("main") || document.querySelector(".container") || document.body;

      // If card isn't currently inside main visible area, move it
      if(main && !main.contains(card)){
        main.insertBefore(card, main.firstChild);
      }

      // If we have a good insertBefore anchor within main, move card right above it
      if(insertBefore && insertBefore.parentNode){
        insertBefore.parentNode.insertBefore(card, insertBefore);
      }
    }catch(e){}
  }

  var regimes = ["TREND","CHOP","DEAD","UNKNOWN"];
  var keys = ["target_mult","stop_mult","time_mult"];

  function tryReadSettingsObject(){
    try {
      if (window.MM_SETTINGS && typeof window.MM_SETTINGS === "object") return window.MM_SETTINGS;
      if (window.mmSettings && typeof window.mmSettings === "object") return window.mmSettings;
      if (window.settings && typeof window.settings === "object") return window.settings;
    } catch(e) {}

    try {
      var el = qs("#mm-settings-json");
      if (el && (el.type || "").toLowerCase() === "application/json") {
        return JSON.parse(el.textContent || "{}");
      }
    } catch(e) {}

    return null;
  }

  function ensureOverlay(obj){
    if(!obj || typeof obj !== "object") obj = {};
    if(!obj.regime_exit_overlay || typeof obj.regime_exit_overlay !== "object") obj.regime_exit_overlay = {};
    regimes.forEach(function(r){
      if(!obj.regime_exit_overlay[r] || typeof obj.regime_exit_overlay[r] !== "object") obj.regime_exit_overlay[r] = {};
      keys.forEach(function(k){
        var v = obj.regime_exit_overlay[r][k];
        if(typeof v !== "number" || !isFinite(v)) obj.regime_exit_overlay[r][k] = 1.0;
      });
    });
    return obj;
  }

  function readCurrentJSON(){
    var ta = qs("#settings_json");
    if (ta && (ta.value || "").trim()) {
      try { return JSON.parse(ta.value); } catch(e) {}
    }
    var obj = tryReadSettingsObject();
    if (obj) return obj;
    return {};
  }

  function writeCurrentJSON(obj){
    var ta = qs("#settings_json");
    if(!ta) return;
    try { ta.value = JSON.stringify(obj, null, 2); } catch(e) {}
  }

  function hydrate(){
    var obj = ensureOverlay(readCurrentJSON());
    qsa("[data-mm-reo]").forEach(function(inp){
      var path = (inp.getAttribute("data-mm-reo") || "");
      var parts = path.split(".");
      if(parts.length !== 2) return;
      var r = parts[0], k = parts[1];
      try {
        var v = obj.regime_exit_overlay[r][k];
        if(typeof v === "number" && isFinite(v)) inp.value = String(v);
      } catch(e){}
    });
    writeCurrentJSON(obj);
     // MM_REO_EXPORT_V7
     // Expose small API so the page's Save flow can force-sync overlay -> settings object
     try {
       window.MM_REO = window.MM_REO || {};
       window.MM_REO.push = push;
       window.MM_REO.hydrate = hydrate;
       window.MM_REO.getOverlay = function(){
         try {
           var obj = ensureOverlay(readCurrentJSON());
           return (obj && obj.regime_exit_overlay) ? obj.regime_exit_overlay : null;
         } catch(e){ return null; }
       };
     } catch(e) {}
    // keep any global mirrors aligned if they exist
    try { if(window.MM_SETTINGS && typeof window.MM_SETTINGS === "object") window.MM_SETTINGS = obj; } catch(e){}
    try { if(window.mmSettings && typeof window.mmSettings === "object") window.mmSettings = obj; } catch(e){}
  }

  function push(){
    var obj = ensureOverlay(readCurrentJSON());
    qsa("[data-mm-reo]").forEach(function(inp){
      var path = (inp.getAttribute("data-mm-reo") || "");
      var parts = path.split(".");
      if(parts.length !== 2) return;
      var r = parts[0], k = parts[1];
      var num = parseFloat(inp.value);
      if(!isFinite(num)) return;
      obj.regime_exit_overlay[r][k] = num;
    });
    writeCurrentJSON(obj);
    try { if(window.MM_SETTINGS && typeof window.MM_SETTINGS === "object") window.MM_SETTINGS = obj; } catch(e){}
    try { if(window.mmSettings && typeof window.mmSettings === "object") window.mmSettings = obj; } catch(e){}
  }

  qsa("[data-mm-reo]").forEach(function(inp){
    inp.addEventListener("input", push);
    inp.addEventListener("change", push);
  });

    // MM_REO_HYDRATE_RETRY_V6
  // If settings are populated later (fetch / async), retry hydrate for a short window.
  (function(){
    var tries = 0;
    function tick(){
      tries++;
      try {
        var ta = qs("#settings_json");
        var hasTA = ta && (ta.value || "").trim().length > 0;
        var hasObj = false;
        try { hasObj = !!tryReadSettingsObject(); } catch(e) { hasObj = false; }

        if (hasTA || hasObj) {
          hydrate();
          try{ MM_REO_ENSURE_CARD(); }catch(e){}

          return;
        }
      } catch(e) {}
      if (tries < 25) setTimeout(tick, 200);
    }
    tick();
  })();
})();


  // MM_REO_ENSURE_CARD_DOMREADY_V9
  try{
    if(document.readyState === "loading"){
      document.addEventListener("DOMContentLoaded", function(){ try{ MM_REO_ENSURE_CARD(); }catch(e){} });
    }else{
      MM_REO_ENSURE_CARD();
    }
  }catch(e){}
</script>
<!-- MM_REGIME_EXIT_OVERLAY_UI_V5_END -->

{% endblock %}
