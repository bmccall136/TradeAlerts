  <!-- REGIME EXIT OVERLAY -->
  <div class="card mb-4" id="mm-regime-exit-overlay-card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <div class="fw-semibold"><i class="bi bi-speedometer2"></i> Regime Exit Overlay</div>
      <span class="badge bg-secondary">Multipliers</span>
    </div>
    <div class="card-body">
      <div class="text-muted small mb-2">These multiply Sell Guard behavior by market regime.</div>
      <div id="mm-reo-status" class="small mb-2" style="color:#f5d400;"></div>
      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle">
          <thead>
            <tr>
              <th style="width:120px;">Regime</th>
