{# templates/layout.html #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
	<title>$$Machine</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%92%B0%3C/text%3E%3C/svg%3E">

  <!-- 1) Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- 2) Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- 3) App CSS -->
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />

  {% block head %}{% endblock %}

<style id="mm-regime-css">
  /* Canonical Market Regime badge: centered UNDER $$Machine */
  .mm-regime-wrap{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    margin:10px auto 0 auto;
    padding:6px 12px;
    border-radius:999px;
    background:rgba(30,30,35,.55);
    border:1px solid rgba(255,255,255,.10);
    color:#e8e8e8;
    font-size:14px;
    line-height:1;
    max-width:420px;
  }
  .mm-regime-dot{ font-size:14px; }
  .mm-regime-text{ opacity:.85; }
  .mm-regime-name{ font-weight:700; letter-spacing:.5px; }
  .mm-regime-conf{ opacity:.80; }
</style>

</head>
<body class="black-bg text-light">
<!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black py-2 position-relative">
    <div class="container-fluid">

	<!-- Left: primary nav -->
	<div class="d-flex align-items-center mb-3 gap-3">

	  <div id="live-mode-toggle" class="btn-group btn-group-sm" role="group" aria-label="Trade mode">
		<button type="button" class="btn btn-outline-warning" data-mode="DAY">Day Trader</button>
		<button type="button" class="btn btn-outline-secondary" data-mode="SWING">Swing Trader</button>
	  </div>

	  <div class="ai-toggle">
		<label class="ai-toggle-label d-flex align-items-center mb-0">
		  <input type="checkbox" id="ai-enabled-toggle" class="me-2">
		  <span class="me-1">AI Advisor</span>
		  <span class="ai-emoji">🤖</span>
		</label>
	  </div>

	  <a class="btn btn-sm btn-outline-warning btn-fixed"
		 href="/settings/buy" title="Settings"><i class="bi bi-gear-fill"></i> Settings
	  </a>

	</div>

	<div class="trade-alerts-title position-absolute top-50 start-50 translate-middle text-center">
	  <b>$$Machine</b>
	  <img id="maxInsideBadge" class="ms-2 mm-gear"
		   src="{{ url_for('static', filename='Max.png') }}"
		   alt="Max">
	</div>

      <!-- Right: actions -->
		<div class="d-flex align-items-center gap-2 ms-auto">
		<a class="btn btn-sm btn-outline-warning btn-fixed ms-2"
		   href="/live" title="Dashboard">
		  📟 Dashboard
		</a>
		<!-- Dashboard -->
		<a class="btn btn-sm btn-outline-warning btn-fixed ms-2"
		   href="/analytics" title="Daily Analytics">
		  📊 Analytics
		</a>
        <!-- Checkpoint -->
        <form action="{{ url_for('run_checkpoint') }}" method="get" class="m-0">
          <button class="btn btn-small btn-checkpoint">
		  ✅ Checkpoint</button>
        </form>
        <!-- Reconnect API -->
        <a class="btn btn-sm btn-outline-warning btn-fixed"
           href="{{ url_for('etrade_reconnect') }}">
          🔁 Reconnect API
        </a>
      </div>

    </div>
  </nav>

<!-- mm-regime-canonical -->
<div id="mm-regime-wrap" class="mm-regime-wrap" aria-live="polite">
  <span class="mm-regime-dot" id="mm-regime-dot">?</span>
  <span class="mm-regime-text">Regime:</span>
  <span class="mm-regime-name" id="mm-regime-name">?</span>
  <span class="mm-regime-conf" id="mm-regime-conf"></span>
</div>

</div>


<!-- MAIN -->
  <main class="container py-4">
    {% block content %}{% endblock %}
  </main>

  <!-- Bootstrap JS -->
  


<script id="mm-regime-canonical">
(function(){
  function setDot(reg){
    var dot = document.getElementById("mm-regime-dot");
    if(!dot) return;
    var r = String(reg || "UNKNOWN").toUpperCase();
    if(r === "TREND") dot.style.color = "#4caf50";
    else if(r === "CHOP") dot.style.color = "#ffb300";
    else if(r === "DEAD") dot.style.color = "#f44336";
    else dot.style.color = "#9e9e9e";
  }

  async function update(){
    try{
      const res = await fetch("/api/market_regime", {cache:"no-store"});
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();

      var reg  = (j.regime || j.state || j.name || "UNKNOWN");
      var conf = (j.confidence != null ? j.confidence : (j.conf != null ? j.conf : j.score));

      var confTxt = "";
      if(typeof conf === "number" && isFinite(conf)){
        confTxt = " " + Math.round(conf) + "%";
      } else if (conf != null && String(conf).trim() !== ""){
        confTxt = " " + String(conf).trim();
      }

      var nameEl = document.getElementById("mm-regime-name");
      var confEl = document.getElementById("mm-regime-conf");
      if(nameEl) nameEl.textContent = String(reg).toUpperCase();
      if(confEl) confEl.textContent = confTxt;

      setDot(reg);
    }catch(e){
      var nameEl = document.getElementById("mm-regime-name");
      if(nameEl && (!nameEl.textContent || nameEl.textContent.trim()==="?")) nameEl.textContent = "UNKNOWN";
      setDot("UNKNOWN");
    }
  }

  if(window.__mmRegimeTimer) clearInterval(window.__mmRegimeTimer);
  update();
  window.__mmRegimeTimer = setInterval(update, 60000);
})();
</script>

</body>

</html>
