{# templates/_analytics_toolbar.html
   Minimal shared analytics toolbar partial.
   Safe defaults: does not require any variables from caller.
#}

<div id="mm-ax-toolbar" style="display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin:8px 0 8px 0;">
  <a class="mm-btn mm-btn-ax" href="/analytics">Daily</a>
  <a class="mm-btn mm-btn-ax" href="/analytics/buy">Buy Analytics</a>
  <a class="mm-btn mm-btn-ax" href="/analytics/sell">Sell Analytics</a>
  <a class="mm-btn mm-btn-ax" href="/analytics/buy_regime">Buy Regime</a>
  <a class="mm-btn mm-btn-ax" href="/analytics/sell_regime">Sell Regime</a>

  <span style="width:12px;display:inline-block;"></span>

  <a class="mm-btn mm-btn-warn" href="/analytics?date=yesterday">Yesterday</a>
</div>

<style>
  /* scoped + safe: only affects this toolbar */
  #mm-ax-toolbar .mm-btn{
    display:inline-flex; align-items:center; justify-content:center;
    padding:6px 12px; border-radius:6px;
    border:1px solid rgba(0,255,255,.55);
    color:rgba(0,255,255,.92);
    text-decoration:none;
    background:rgba(0,0,0,.25);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    font-weight:600;
    letter-spacing:.2px;
  }
  #mm-ax-toolbar .mm-btn:hover{
    background:rgba(0,255,255,.10);
    border-color:rgba(0,255,255,.85);
  }
  #mm-ax-toolbar .mm-btn-warn{
    border-color: rgba(255,200,0,.70);
    color: rgba(255,200,0,.95);
  }
  #mm-ax-toolbar .mm-btn-warn:hover{
    background: rgba(255,200,0,.10);
    border-color: rgba(255,200,0,.95);
  }
</style>

<!-- MM_BUCKET_BTN_YELLOW_V2 20260216_200729 -->
<style>
  /* Bucket buttons (Today / 7D / 30D / All) ? make them yellow */
  .mm-ax-toolbar a[href*="bucket="],
  .mm-ax-toolbar a[data-bucket],
  a.mm-ax-bucket,
  a.mm-bucket,
  a.bucket-btn,
  a.ax-bucket {
    border: 1px solid rgba(245, 196, 0, .75) !important;
    color: rgba(245, 196, 0, .95) !important;
    background: rgba(245, 196, 0, .08) !important;
  }

  .mm-ax-toolbar a[href*="bucket="]:hover,
  .mm-ax-toolbar a[data-bucket]:hover,
  a.mm-ax-bucket:hover,
  a.mm-bucket:hover,
  a.bucket-btn:hover,
  a.ax-bucket:hover {
    border-color: rgba(245, 196, 0, .95) !important;
    color: rgba(255, 220, 80, 1) !important;
    background: rgba(245, 196, 0, .14) !important;
  }

  /* Active bucket */
  .mm-ax-toolbar a.active[href*="bucket="],
  .mm-ax-toolbar a.active[data-bucket],
  .mm-ax-toolbar a[aria-current="page"][href*="bucket="],
  .mm-ax-toolbar a[aria-current="page"][data-bucket] {
    border-color: rgba(245, 196, 0, .95) !important;
    color: rgba(245, 196, 0, 1) !important;
    background: rgba(245, 196, 0, .18) !important;
    box-shadow: 0 0 0 1px rgba(245, 196, 0, .20) inset !important;
  }
</style>

