{% extends "layout.html" %}
{% block content %}

<div class="tr-wrap">
  <div class="tr-topbar">
    <div>
      <div class="tr-title">$$Machine â€” Trade Review</div>
      <div class="tr-sub">
        Live view from <code>/api/trade_review</code>. Buys are allowed to fall back to <code>position_opened</code> when trigger logs donâ€™t contain BUY events.
      </div>
      <div class="tr-src" id="tr-src"></div>
    </div>

    <div class="tr-actions">
      <a class="tr-btn" href="/analytics">Analytics</a>
      <a class="tr-btn" href="/trade_review">Refresh</a>
    </div>
  </div>

  <div class="tr-grid">
    <section class="tr-col">
      <div class="tr-col-title">Recent Buys</div>
      <div id="buys" class="tr-list">
        <div class="tr-empty">Loadingâ€¦</div>
      </div>
    </section>

    <section class="tr-col">
      <div class="tr-col-title">Recent Sells</div>
      <div id="sells" class="tr-list">
        <div class="tr-empty">Loadingâ€¦</div>
      </div>
    </section>
  </div>
</div>

<style>
  .tr-wrap { max-width: 1400px; margin: 0 auto; padding: 18px 0; }
  .tr-topbar { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
  .tr-title { color:#ffe900; font-size: 22px; font-weight: 700; }
  .tr-sub { color:#cfcfcf; margin-top:6px; font-size: 13px; }
  .tr-src { color:#8f8f8f; margin-top:10px; font-size: 12px; }
  .tr-actions { display:flex; gap:10px; }
  .tr-btn {
    display:inline-block; padding:7px 14px; border-radius: 12px;
    background:#1a1a1a; border:1px solid #3a3a3a; color:#ffe900;
    text-decoration:none; font-size: 13px;
  }
  .tr-btn:hover { border-color:#ffe900; }

  .tr-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 26px; }
  .tr-col-title { color:#ffe900; font-weight:700; margin: 8px 0 10px; }
  .tr-empty { color:#cfcfcf; opacity:0.85; margin-top: 6px; }

  .tr-card {
    background:#0f0f0f; border:1px solid #2a2a2a; border-radius: 14px;
    padding: 12px; margin-bottom: 14px;
  }
  .tr-card-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom: 10px; }
  .tr-card-left { display:flex; align-items:center; gap:10px; min-width:0; }
  .tr-symbol { color:#fff; font-weight: 700; }
  .tr-time { color:#8f8f8f; font-size: 12px; }
  .tr-titleline { color:#bdbdbd; font-size: 12px; margin-top: 2px; }
  .tr-reason { color:#8f8f8f; font-size: 12px; margin-top: 2px; }

  .tr-badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight:700; }
  .tr-badge-buy  { background:#102510; border:1px solid #2e7d32; color:#a9f5a9; }
  .tr-badge-sell { background:#2a1010; border:1px solid #b71c1c; color:#ffb3b3; }

  .tr-pnl { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px; border:1px solid #333; }
  .tr-pnl-pos { color:#a9f5a9; background:#102510; border-color:#2e7d32; }
  .tr-pnl-neg { color:#ffb3b3; background:#2a1010; border-color:#b71c1c; }

  .tr-chart {
    height: 180px;
    border-radius: 12px;
    border: 1px solid #232323;
    background: #0b0b0b;
    margin-bottom: 10px;
    position: relative;
    overflow: hidden;
  }
  .tr-chart svg { width: 100%; height: 100%; display:block; }
  .tr-chart-fallback {
    height: 180px;
    border-radius: 12px;
    border: 1px dashed #2f2f2f;
    background: #0b0b0b;
    display:flex; align-items:center; justify-content:center;
    color:#6f6f6f; font-size: 12px;
    margin-bottom: 10px;
  }

  .tr-rows-title { color:#cfcfcf; font-size: 12px; margin: 8px 0; font-weight: 700; }
  .tr-table { width:100%; border-collapse: collapse; font-size: 12px; }
  .tr-table td { padding: 6px 8px; border-bottom: 1px solid #1f1f1f; vertical-align: top; }
  .tr-k { color:#9d9d9d; width: 32%; }
  .tr-v { color:#e0e0e0; word-break: break-word; white-space: pre-wrap; }

  @media (max-width: 1100px) {
    .tr-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
(function() {
  function esc(s) {
    return (s === null || s === undefined) ? "" : String(s)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  }

  function parseIso(s) {
    if (!s) return null;
    const d = new Date(s);
    if (isNaN(d.getTime())) return null;
    return d;
  }

  function pctFmt(x) {
    if (x === null || x === undefined || x === "") return "";
    const n = Number(x);
    if (!isFinite(n)) return "";
    const sign = (n >= 0) ? "+" : "";
    return sign + n.toFixed(2) + "%";
  }

  function buildDetailsTable(rows) {
    if (!rows || !rows.length) return '<div class="tr-empty">No trigger rows in window.</div>';

    // Show each row as a compact key/value table, stacked (most recent last already; API slices)
    let out = "";
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i] || {};
      out += '<table class="tr-table"><tbody>';
      for (const k of Object.keys(r)) {
        out += '<tr><td class="tr-k">' + esc(k) + '</td><td class="tr-v">' + esc(r[k]) + '</td></tr>';
      }
      out += '</tbody></table>';
      if (i !== rows.length - 1) out += '<div style="height:8px"></div>';
    }
    return out;
  }

  function seriesToSvg(series, shade) {
    if (!series || !series.length) return null;

    // Pull times/prices
    const pts = [];
    for (const p of series) {
      const t = parseIso(p.t);
      const y = Number(p.c);
      if (!t || !isFinite(y)) continue;
      pts.push({ t: t.getTime(), y: y });
    }
    if (pts.length < 2) return null;

    let tMin = pts[0].t, tMax = pts[0].t, yMin = pts[0].y, yMax = pts[0].y;
    for (const p of pts) {
      if (p.t < tMin) tMin = p.t;
      if (p.t > tMax) tMax = p.t;
      if (p.y < yMin) yMin = p.y;
      if (p.y > yMax) yMax = p.y;
    }
    if (tMax === tMin) return null;
    if (yMax === yMin) { yMax = yMin + 1.0; }

    // SVG viewBox
    const W = 1000, H = 180;
    const padX = 14, padY = 12;
    const innerW = W - padX*2;
    const innerH = H - padY*2;

    function xOf(t) { return padX + ((t - tMin) / (tMax - tMin)) * innerW; }
    function yOf(v) { return padY + (1 - ((v - yMin) / (yMax - yMin))) * innerH; }

    // Polyline points
    let d = "";
    for (let i = 0; i < pts.length; i++) {
      const x = xOf(pts[i].t).toFixed(2);
      const y = yOf(pts[i].y).toFixed(2);
      d += (i === 0 ? "M " : " L ") + x + " " + y;
    }

    // Shade window (best-effort)
    let shadeRect = "";
    let buyLine = "";
    let sellLine = "";
    if (shade && shade.from && shade.to) {
      const df = parseIso(shade.from);
      const dt = parseIso(shade.to);
      if (df && dt) {
        const x1 = xOf(df.getTime());
        const x2 = xOf(dt.getTime());
        const left = Math.max(padX, Math.min(x1, x2));
        const right = Math.min(padX + innerW, Math.max(x1, x2));
        const width = Math.max(0, right - left);
        const col = shade.color || "rgba(255,255,255,0.10)";
        shadeRect = '<rect x="'+left.toFixed(2)+'" y="'+padY+'" width="'+width.toFixed(2)+'" height="'+innerH+'" fill="'+esc(col)+'" />';
        buyLine  = '<line x1="'+left.toFixed(2)+'" y1="'+padY+'" x2="'+left.toFixed(2)+'" y2="'+(padY+innerH)+'" stroke="rgba(255,233,0,0.55)" stroke-width="2"/>';
        sellLine = '<line x1="'+right.toFixed(2)+'" y1="'+padY+'" x2="'+right.toFixed(2)+'" y2="'+(padY+innerH)+'" stroke="rgba(255,233,0,0.55)" stroke-width="2"/>';
      }
    }

    const svg =
      '<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">' +
        // background grid (subtle)
        '<rect x="0" y="0" width="'+W+'" height="'+H+'" fill="#0b0b0b"/>' +
        '<line x1="0" y1="'+(H/2)+'" x2="'+W+'" y2="'+(H/2)+'" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>' +
        shadeRect +
        buyLine + sellLine +
        '<path d="'+d+'" fill="none" stroke="rgba(255,233,0,0.85)" stroke-width="2.2" />' +
      '</svg>';

    return svg;
  }

  function cardHTML(kind, item) {
    const isBuy = (kind === "BUY");
    const badgeCls = isBuy ? "tr-badge-buy" : "tr-badge-sell";
    const sym = item.symbol || "";
    const ts = item.ts_et || "";
    const reason = item.reason || "";
    const titleLine = item.title_line || "";
    const pnl = item.pnl_pct;

    let pnlChip = "";
    if (!isBuy && pnl !== null && pnl !== undefined && pnl !== "") {
      const cls = (Number(pnl) >= 0) ? "tr-pnl tr-pnl-pos" : "tr-pnl tr-pnl-neg";
      pnlChip = '<span class="'+cls+'">'+esc(pctFmt(pnl))+'</span>';
    }

    const svg = seriesToSvg(item.series || [], item.shade || null);
    const chart = svg
      ? '<div class="tr-chart">' + svg + '</div>'
      : '<div class="tr-chart-fallback">No Yahoo intraday series for chart.</div>';

    const details = buildDetailsTable(item.detail_rows || []);

    return '' +
      '<div class="tr-card">' +
        '<div class="tr-card-head">' +
          '<div class="tr-card-left">' +
            '<span class="tr-badge '+badgeCls+'">'+esc(kind)+'</span>' +
            '<span class="tr-symbol">'+esc(sym)+'</span>' +
            pnlChip +
          '</div>' +
          '<div class="tr-card-right">' +
            '<span class="tr-time">'+esc(ts)+'</span>' +
          '</div>' +
        '</div>' +

        (titleLine ? '<div class="tr-titleline">'+esc(titleLine)+'</div>' : '') +
        (reason ? '<div class="tr-reason">Reason: <span style="color:#cfcfcf">'+esc(reason)+'</span></div>' : '') +

        chart +

        '<div class="tr-rows">' +
          '<div class="tr-rows-title">Trigger Rows (window)</div>' +
          details +
        '</div>' +
      '</div>';
  }

  async function load() {
    const buysEl = document.getElementById("buys");
    const sellsEl = document.getElementById("sells");
    const srcEl = document.getElementById("tr-src");

    const params = new URLSearchParams(window.location.search);
    const limit = params.get("limit") || "12";
    const interval = params.get("interval") || "5m";

    buysEl.innerHTML = '<div class="tr-empty">Loadingâ€¦</div>';
    sellsEl.innerHTML = '<div class="tr-empty">Loadingâ€¦</div>';

    const url = "/api/trade_review?limit=" + encodeURIComponent(limit) + "&interval=" + encodeURIComponent(interval);

    try {
      const res = await fetch(url, { cache: "no-store" });
      const j = await res.json();

      if (!j || j.ok === false) {
        const msg = (j && j.error) ? j.error : "Unknown error from /api/trade_review";
        buysEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
        sellsEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
        return;
      }

      const buys = j.buys || [];
      const sells = j.sells || [];

      const buyLog = j.buy_log || "";
      const sellLog = j.sell_log || "";
      srcEl.textContent = "API: " + url + " | buy_log: " + buyLog + " | sell_log: " + sellLog;

      if (!buys.length) {
        buysEl.innerHTML = '<div class="tr-empty">No recent buys returned by API.</div>';
      } else {
        buysEl.innerHTML = buys.map(b => cardHTML("BUY", b)).join("");
      }

      if (!sells.length) {
        sellsEl.innerHTML = '<div class="tr-empty">No recent sells returned by API.</div>';
      } else {
        sellsEl.innerHTML = sells.map(s => cardHTML("SELL", s)).join("");
      }
    } catch (e) {
      const msg = "Failed to load /api/trade_review: " + (e && e.message ? e.message : String(e));
      buysEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
      sellsEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
    }
  }

  load();
})();
</script>

{% endblock %}


<!-- TRADE_REVIEW_FORCE_SYMBOL_V1 -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const sym = "{{ symbol|default('') }}".trim();
  const ts  = "{{ ts|default('') }}".trim();
  if (!sym) return;

  // Find the chart img (first img that points at /trade_review/chart)
  const img = document.querySelector('img[src*="/trade_review/chart"]');
  if (!img) return;

  const cur = (img.getAttribute('src') || '');
  // If it's already symbol-based, do nothing
  if (cur.includes('symbol=')) return;

  const url = "/trade_review/chart?symbol=" + encodeURIComponent(sym)
            + (ts ? ("&ts=" + encodeURIComponent(ts)) : "")
            + "&v=" + Date.now();
  img.setAttribute('src', url);
});
</script>

