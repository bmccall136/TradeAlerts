
<!-- MM_ANALYTICS_TOOLBAR_V1 -->
<div class="mm-axbar" id="mm-axbar">
  <div class="mm-axbar-row">
    <div class="mm-axbar-links">
      <a class="mm-axlink" href="/analytics">Daily</a>
      <a class="mm-axlink" href="/analytics/buy">Buy</a>
      <a class="mm-axlink" href="/analytics/sell">Sell</a>
      <a class="mm-axlink" href="/analytics/buy_regime">Buy Regime</a>
      <a class="mm-axlink" href="/analytics/sell_regime">Sell Regime</a>
    </div>

    <div class="mm-axbar-right">
      <label class="mm-axbar-label" for="mm-ax-bucket">Bucket</label>
      <select id="mm-ax-bucket" class="mm-axbar-select">
        <option value="today">Today</option>
        <option value="7d">7D</option>
        <option value="30d">30D</option>
        <option value="all">All</option>
      </select>
    </div>
  </div>
</div>

<style>
  .mm-axbar{margin:12px 0 14px 0;padding:10px 12px;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:rgba(255,255,255,.04)}
  .mm-axbar-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .mm-axbar-links{display:flex;gap:10px;flex-wrap:wrap}
  .mm-axlink{display:inline-block;padding:6px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.12);text-decoration:none}
  .mm-axlink:hover{border-color:rgba(255,255,255,.25)}
  .mm-axbar-right{display:flex;align-items:center;gap:8px}
  .mm-axbar-label{opacity:.85}
  .mm-axbar-select{padding:6px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.25);color:inherit}
</style>

<script>
  // MM_ANALYTICS_TOOLBAR_V1
  (function(){
    const sel = document.getElementById("mm-ax-bucket");
    if (!sel) return;

    const u = new URL(window.location.href);
    const bucket = (u.searchParams.get("bucket") || u.searchParams.get("range") || "").toLowerCase();
    const v = (bucket === "today" || bucket === "7d" || bucket === "30d" || bucket === "all") ? bucket : "7d";
    sel.value = v;

    sel.addEventListener("change", () => {
      const u2 = new URL(window.location.href);
      u2.searchParams.set("bucket", sel.value);
      // keep date= on Daily, keep anything else you already have
      window.location.href = u2.toString();
    });
  })();
</script>

{% extends "layout.html" %}
{% block content %}
<style>
  .mm-wrap { max-width: 1180px; margin: 0 auto; }
  .mm-h1 { font-size: 28px; font-weight: 800; margin: 6px 0 10px; }
  .mm-sub { opacity: .85; margin-bottom: 14px; }
  .mm-row { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .mm-card { background:#0f1118; border:1px solid #222531; border-radius:12px; padding:14px 14px; box-shadow: 0 0 0 rgba(0,0,0,0); }
  .mm-card h3 { font-size:16px; margin:0 0 10px; opacity:.95; }
  .mm-kv { display:grid; grid-template-columns: repeat(4, minmax(140px, 1fr)); gap:10px; }
  @media (max-width: 900px) { .mm-kv { grid-template-columns: repeat(2, minmax(160px, 1fr)); } }
  .mm-pill { display:flex; flex-direction:column; gap:4px; padding:10px 10px; border-radius:10px; border:1px solid #2a2f3f; background:#0c0e14; }
  .mm-pill .k { font-size:12px; opacity:.75; }
  .mm-pill .v { font-size:20px; font-weight:800; }
  .mm-btn { display:inline-flex; align-items:center; gap:8px; padding:7px 10px; border-radius:10px; border:1px solid #2a2f3f; background:#0c0e14; color:#ddd; text-decoration:none; cursor:pointer; }
  .mm-btn:hover { border-color:#3a4157; }
  .mm-btn.active { border-color:#f5c400; box-shadow: 0 0 0 1px rgba(245,196,0,.25) inset; }
  .mm-muted { opacity:.75; }
  .mm-grid { display:grid; grid-template-columns: 1fr; gap:12px; }
  .mm-list { display:grid; grid-template-columns: repeat(5, minmax(120px, 1fr)); gap:10px; }
  @media (max-width: 1100px) { .mm-list { grid-template-columns: repeat(3, minmax(140px, 1fr)); } }
  @media (max-width: 700px) { .mm-list { grid-template-columns: repeat(2, minmax(140px, 1fr)); } }
  .mm-foot { margin-top: 12px; display:flex; justify-content:flex-start; }
</style>

<div class="mm-wrap">
  <div class="mm-h1">Sell Analytics</div>
  <div class="mm-sub">
    This page focuses on <b>exit reasons</b>, <b>execution outcomes</b>, and <b>time-in-position</b>.
    (Counts stay off the SELL Settings page.)
  </div>

  <div class="mm-card">
    <div class="mm-row">
      <div class="mm-muted">Bucket</div>
      <div class="mm-row">
        <button class="mm-btn" data-bucket="today">TODAY</button>
        <button class="mm-btn" data-bucket="7d">7D</button>
        <button class="mm-btn" data-bucket="30d">30D</button>
        <button class="mm-btn" data-bucket="all">ALL</button>
        <a class="mm-btn" href="/analytics">Back to Analytics</a>
      </div>
    </div>
  </div>

  <div class="mm-grid" style="margin-top:12px;">
    <div class="mm-card">
      <h3>Exit reason breakdown</h3>
      <div id="exit-reasons" class="mm-kv">
        <div class="mm-pill"><div class="k">Loading</div><div class="v">?</div></div>
      </div>
      <div class="mm-muted" style="margin-top:10px;">
        Reason counts come from <code>sell_events</code> where <code>event=FILLED</code>.
      </div>
    </div>

    <div class="mm-card">
      <h3>Execution outcomes</h3>
      <div id="outcomes" class="mm-list">
        <div class="mm-pill"><div class="k">Loading</div><div class="v">?</div></div>
      </div>
      <div class="mm-muted" style="margin-top:10px;">
        Outcomes come from all <code>sell_events</code> rows in the bucket.
      </div>
    </div>

    <div class="mm-card">
      <h3>Hold-time buckets</h3>
      <div id="hold-buckets" class="mm-list"><div class="mm-pill"><div class="k">Loading</div><div class="v">?</div></div></div>
    </div>
  </div>

  <div class="mm-foot">
    <a class="mm-btn" href="/analytics">Back to Analytics</a>
  </div>
</div>

<script>

  // MM_FETCH_JSON_V1: safe fetch wrapper (prevents JSON.parse crashes on HTML/500)
  async function mmFetchJson(url) {
    const res = await fetch(url, { cache: "no-store" });
    const ct = (res.headers.get("content-type") || "").toLowerCase();
    if (!res.ok) {
      const txt = await res.text();
      throw new Error(`HTTP ${res.status} ${res.statusText}\n${txt.slice(0, 1200)}`);
    }
    if (!ct.includes("application/json")) {
      const txt = await res.text();
      throw new Error(`Expected JSON but got: ${ct}\n${txt.slice(0, 1200)}`);
    }
    return await res.json();
  }


// --- MM_BUCKET_NORMALIZE_V1 ---
function mmNormBucket(b) {
  if (!b) return "today";
  const s = String(b).trim();
  const u = s.toUpperCase();
  if (u === "TODAY") return "today";
  if (u === "7D") return "7d";
  if (u === "30D") return "30d";
  if (u === "ALL") return "all";
  return s.toLowerCase();
}

(function() {
  const $  = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));

  function esc(s) {
    return String(s ?? "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function setActive(bucket) {
    $$('.mm-btn[data-bucket]').forEach(b => b.classList.toggle('active', b.dataset.bucket === bucket));
  }

  function pill(k, v) {
    return `<div class="mm-pill"><div class="k">${esc(k)}</div><div class="v">${esc(v)}</div></div>`;
  }

  function renderReasons(map) {
    const el = $("#exit-reasons");
    const keys = Object.keys(map || {});
    if (!keys.length) {
      el.innerHTML = pill("FILLED (no reason yet)", 0) + pill("Tip", "need FILLED rows");
      return;
    }
    // stable ordering
    const order = ["TARGET","STOP","TIMEOUT","PROTECT","AI","MANUAL","UNKNOWN"];
    const items = order.filter(k => k in map).map(k => [k, map[k]]).concat(
      keys.filter(k => !order.includes(k)).sort().map(k => [k, map[k]])
    );
    el.innerHTML = items.map(([k,v]) => pill(k, v)).join("");
  }

  function renderHolds(arr) {
    const el = $("#hold-buckets");
    const a = Array.isArray(arr) ? arr : [];
    if (!a.length) {
      el.innerHTML = pill("No hold data", 0);
      return;
    }
    el.innerHTML = a.map(x => pill(x.bucket ?? "?", x.ct ?? 0)).join("");
  }

  function renderOutcomes(map) {
    const el = $("#outcomes");
    const keys = Object.keys(map || {});
    if (!keys.length) {
      el.innerHTML = pill("No events", 0);
      return;
    }
    const order = ["ATTEMPTED","PLACED","FILLED","SKIPPED","FAILED","RAW"];
    const items = order.filter(k => k in map).map(k => [k, map[k]]).concat(
      keys.filter(k => !order.includes(k)).sort().map(k => [k, map[k]])
    );
    el.innerHTML = items.map(([k,v]) => pill(k, v)).join("");
  }

  async function load(bucket) {
    setActive(bucket);
    $("#exit-reasons").innerHTML = pill("Loading", "?");
    $("#outcomes").innerHTML = pill("Loading", "?");

    const url = `/api/analytics/sell?bucket=${encodeURIComponent(bucket)}`;
    const r = await fetch(url, { cache: "no-store" });
    const j = await r.json();

    renderReasons(j.exit_reason_breakdown || {});
    renderOutcomes(j.execution_outcomes || {});
    renderHolds(j.hold_buckets || []);
  }

  // default bucket = 7d
  let bucket = "today";
  setActive(bucket);
  load(bucket);

  $$('.mm-btn[data-bucket]').forEach(btn => {
    btn.addEventListener("click", () => {
      bucket = btn.dataset.bucket;
      load(bucket);
    });
  });
})();
</script>

<!-- MM_SELL_REGIME_UI_V1 -->
<div class="card" style="margin-top:16px;">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div>
      <div style="font-size:18px; font-weight:700;">Market Regime breakdown</div>
      <div style="opacity:.8; font-size:13px;">Counts/avg confidence come from <code>sell_events</code> in the selected bucket.</div>
    </div>
    <button id="mmSellRegimeRefresh" class="btn">Refresh</button>
  </div>

  <div id="mmSellRegimeMeta" style="margin-top:10px; opacity:.85; font-size:13px;"></div>

  <div id="mmSellRegimeCards" style="margin-top:12px; display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:12px;">
    <!-- cards injected -->
  </div>
</div>

<script>
(function(){
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>"']/g, m=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[m])); }

  function getBucket(){
    // try existing bucket buttons/controls on the page
    const active = document.querySelector('.bucket-btn.active,[data-bucket].active');
    if (active && (active.dataset && active.dataset.bucket)) return active.dataset.bucket;

    // fallback: try URL param
    const u = new URL(window.location.href);
    const b = u.searchParams.get('bucket');
    return b || 'today';
  }

  async function loadSellRegime(){
    const bucket = getBucket();
    const metaEl  = document.getElementById('mmSellRegimeMeta');
    const cardsEl = document.getElementById('mmSellRegimeCards');
    if (!metaEl || !cardsEl) return;

    metaEl.textContent = 'Loading?';
    cardsEl.innerHTML = '';

    try{
      const r = await fetch(`/api/analytics/sell_regime?bucket=${encodeURIComponent(bucket)}`, { cache: 'no-store' });
      const j = await r.json();

      if (!j || !j.ok){
        metaEl.textContent = `Error: ${esc(j && j.error ? j.error : 'unknown')}`;
        return;
      }

      const rows = Array.isArray(j.by_regime) ? j.by_regime : [];
      const total = rows.reduce((a,x)=>a+(Number(x.count)||0),0);

      metaEl.textContent = `Bucket: ${bucket.toUpperCase()} ? Rows: ${total.toLocaleString()} ? Since ts_utc: ${esc(j.since_ts_utc)}`;

      rows.forEach(x=>{
        const regime = esc(x.regime || 'UNKNOWN');
        const count  = Number(x.count)||0;
        const avg    = (x.avg_conf==null ? null : Number(x.avg_conf));
        const share  = total ? (count/total*100) : 0;

        const card = document.createElement('div');
        card.className = 'mini-card';
        card.style.padding = '12px';
        card.style.border = '1px solid rgba(255,255,255,.08)';
        card.style.borderRadius = '12px';
        card.style.background = 'rgba(255,255,255,.03)';

        card.innerHTML = `
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <div style="font-weight:800; letter-spacing:.5px;">${regime}</div>
            <div style="opacity:.8; font-size:12px;">${share.toFixed(1)}%</div>
          </div>
          <div style="margin-top:8px; font-size:22px; font-weight:800;">${count.toLocaleString()}</div>
          <div style="opacity:.8; font-size:13px;">avg conf: ${avg==null ? '?' : avg.toFixed(1)}</div>
        `;
        cardsEl.appendChild(card);
      });

      if (!rows.length){
        metaEl.textContent = `Bucket: ${bucket.toUpperCase()} ? No rows returned.`;
      }
    }catch(e){
      metaEl.textContent = 'Error: ' + (e && e.message ? e.message : String(e));
    }
  }

  // wire refresh button
  const btn = document.getElementById('mmSellRegimeRefresh');
  if (btn) btn.addEventListener('click', loadSellRegime);

  // initial load
  loadSellRegime();
})();
</script>

{% endblock %}
