{# templates/analytics_sell.html #}
{% extends "layout.html" %}
{% block content %}

<!-- MM_AX_SELL_LAYOUT_V2_TOP_TAPE_TITLE_IN_NAV -->

<style>
  /* --- TOP TAPE: fixed at very top of the page --- */
  body { padding-top: 42px; } /* pushes GLOBAL header + everything down on this page */
  #mm-ax-tape-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: rgba(0,0,0,.92);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  /* Full-width rails, with centered inner content */
  .mm-ax-full { margin: 0 14px; }
  .mm-ax-inner { max-width: 1100px; margin: 0 auto; }

  /* Nav rail: title IN the rail, toolbar on the right */
  .mm-ax-navrail {
    padding: 10px 0 8px 0;
    margin: 6px 0 10px 0;
  }
  .mm-ax-navrow {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
  }
  .mm-ax-titlewrap {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 280px;
  }
  .mm-ax-title {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.05;
  }
  .mm-ax-sub {
    opacity: .70;
    margin-top: 2px;
  }

  /* Compartment cards */
  .mm-ax-card { padding: 14px 14px; margin: 0 0 14px 0; }

  /* Controls row */
  .mm-ax-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .mm-ax-controls .mm-ax-spacer { flex: 1; }

</style>

<!-- FIXED TOP TAPE (above global header) -->
<div id="mm-ax-tape-fixed">
  <div class="mm-ax-full">
    <div id="mm-ax-tape-wrap" style="margin: 6px 0 8px 0;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
        <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
        <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
      </div>

      <div style="position:relative;">
        <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>
        <div id="mm-ax-tape"
             style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);
                    background:rgba(255,255,255,.04);">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- NAV RAIL: title is IN this rail (left), toolbar (right) -->
<div class="mm-ax-full mm-ax-navrail">
  <div class="mm-ax-inner">
    <div class="mm-ax-navrow">
      <div class="mm-ax-titlewrap">
        <img src="/static/Max.png" alt="Max"
             style="width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,215,0,.35);" />
        <div>
          <div class="mm-ax-title">Sell Analytics</div>
          <div class="mm-ax-sub">Today</div>
        </div>
      </div>

      <div style="display:flex; align-items:center; justify-content:flex-end;">
        {% include "_analytics_toolbar.html" %}
      </div>
    </div>
  </div>
</div>

<!-- NARROW CONTENT -->
<div class="mm-ax-full">
  <div class="mm-ax-inner">

    <div style="opacity:.70; margin: 0 0 16px 0;">
      This page focuses on exit reasons, execution outcomes, and time-in-position. (Counts stay off the SELL Settings page.)
    </div>

    <!-- Controls -->
    <div class="mm-card mm-ax-card">
      <div class="mm-ax-controls">
        <div style="min-width:260px;">
          <div style="font-weight:700; margin-bottom:6px;">Bucket</div>
          <select id="mm-sell-bucket" class="mm-input" style="width:100%;">
            <option value="today">TODAY</option>
            <option value="1d">1D</option>
            <option value="7d" selected>7D</option>
            <option value="30d">30D</option>
            <option value="90d">90D</option>
            <option value="ytd">YTD</option>
          </select>
        </div>

        <div class="mm-ax-spacer"></div>

        <div id="mm-sell-meta" style="opacity:.75; font-size:12px; text-align:right;"></div>
      </div>
    </div>

    <!-- Exit reasons -->
    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Exit reason breakdown</div>
      <div style="opacity:.70; margin-bottom:10px;">
        Reason counts come from <span style="color:#ff4fd8;">sell_events</span> where <span style="color:#ff4fd8;">event=FILLED</span>.
      </div>
      <div id="mm-sell-reasons"></div>
    </div>

    <!-- Outcomes -->
    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Execution outcomes</div>
      <div style="opacity:.70; margin-bottom:10px;">
        Outcomes come from all <span style="color:#ff4fd8;">sell_events</span> rows in the bucket.
      </div>
      <div id="mm-sell-outcomes"></div>
    </div>

    <!-- Hold time -->
    <div class="mm-card mm-ax-card">
      <div style="font-size:18px; font-weight:800; margin-bottom:8px;">Hold-time buckets</div>
      <div style="opacity:.70; margin-bottom:10px;">
        Hold time is computed from open/close timestamps when available. Missing data shows as empty bucket.
      </div>
      <div id="mm-sell-hold"></div>
    </div>

    <!-- Error -->
    <div id="mm-sell-error" class="mm-card" style="display:none; padding: 14px 14px; border: 1px solid rgba(255,0,0,.25); background: rgba(255,0,0,.08);">
      <div style="font-weight:800; margin-bottom:6px;">Sell Analytics failed</div>
      <pre id="mm-sell-error-pre" style="white-space:pre-wrap; margin:0; opacity:.9;"></pre>
    </div>

  </div>
</div>

<script>
/* MM_SELL_ANALYTICS_JS_V1 */
(function(){
  function $(id){ return document.getElementById(id); }
  function esc(s){
    return String(s ?? "").replace(/[&<>"']/g, (c)=>({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[c]));
  }
  async function fetchJson(url){
    const r = await fetch(url, { cache:"no-store" });
    const txt = await r.text();
    if(!r.ok){
      const e = new Error("HTTP " + r.status);
      e.status = r.status;
      e.body = txt;
      throw e;
    }
    try { return JSON.parse(txt); }
    catch(e){
      const x = new Error("Non-JSON response");
      x.body = txt;
      throw x;
    }
  }
  function showErr(title, body){
    const wrap = $("mm-sell-error");
    const pre  = $("mm-sell-error-pre");
    if(!wrap || !pre) return;
    wrap.style.display = "block";
    pre.textContent = (title ? String(title) : "Error") + "\n\n" + (body ? String(body) : "");
  }
  function clearErr(){
    const wrap = $("mm-sell-error");
    if(wrap) wrap.style.display = "none";
  }

  function renderKVList(elId, rows, keyName, valName){
    const el = $(elId);
    if(!el) return;
    if(!rows || !rows.length){
      el.innerHTML = '<div style="opacity:.65;">No data in this bucket.</div>';
      return;
    }
    const html = rows.map(r=>{
      const k = r[keyName] ?? r.event ?? r.reason ?? r.bucket ?? "(none)";
      const v = r[valName] ?? r.count ?? r.ct ?? r.n ?? "";
      return `
        <div class="mm-card" style="padding:10px 12px; margin: 0 0 10px 0;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
            <div style="font-weight:700;">${esc(k)}</div>
            <div style="font-weight:900;">${esc(v)}</div>
          </div>
        </div>
      `;
    }).join("");
    el.innerHTML = html;
  }

  async function load(){
    clearErr();
    const bucket = ($("mm-sell-bucket") && $("mm-sell-bucket").value) ? $("mm-sell-bucket").value : "today";
    const meta = $("mm-sell-meta");
    if(meta) meta.textContent = "Loading…";

    try{
      const j = await fetchJson(`/api/analytics/sell?bucket=${encodeURIComponent(bucket)}`);

      if(meta){
        const since = j && j.since_ts_utc ? ("since_ts_utc=" + j.since_ts_utc) : "";
        meta.textContent = `${bucket.toUpperCase()}${since ? " • " + since : ""}`;
      }

      const reasons = j.reasons || j.reason_breakdown || [];
      renderKVList("mm-sell-reasons", reasons, "reason", "ct");

      const outcomes = j.outcomes || [];
      renderKVList("mm-sell-outcomes", outcomes, "event", "ct");

      const hold = j.hold_buckets || j.hold_time_buckets || [];
      renderKVList("mm-sell-hold", hold, "bucket", "count");

    }catch(e){
      const body = e && e.body ? e.body : (e && e.stack ? e.stack : String(e));
      showErr("Sell Analytics failed: " + (e.status ? ("HTTP " + e.status) : ""), body);
      if(meta) meta.textContent = "";
    }
  }

  document.addEventListener("DOMContentLoaded", function(){
    const b = $("mm-sell-bucket");
    if(b) b.addEventListener("change", load);
    load();
  });
})();
</script>

{% endblock %}
