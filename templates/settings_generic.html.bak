{% extends "layout.html" %}
{% block content %}
<div style="max-width:960px;margin:18px auto;padding:16px;background:#161723;border-radius:10px;">
  <h2 style="margin:0 0 12px;">{{ title }}</h2>
  {% with messages = get_flashed_messages(category_filter=['ok']) %}
    {% if messages %}
      <div style="margin:8px 0;padding:8px 10px;border:1px solid #2e7d32;border-radius:6px;background:#102012;">
        {{ messages[0] }}
      </div>
    {% endif %}
  {% endwith %}

  {% if settings %}
  <form method="post" action="{{ save_url }}">
    <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">
      {% for k, v in settings.items() %}
        <label style="display:flex;flex-direction:column;gap:6px;">
          <span style="opacity:.9;">{{ k }}</span>
          {% if v is boolean %}
            <input type="checkbox" name="{{ k }}" {% if v %}checked{% endif %}>
          {% elif v is number %}
            <input type="number" name="{{ k }}" step="any" value="{{ v }}">
          {% else %}
            <input type="text" name="{{ k }}" value="{{ v }}">
          {% endif %}
        </label>
      {% endfor %}
    </div>
    <div style="margin-top:16px;">
      <button class="btn-simulation">Save</button>
    </div>
  </form>
  {% else %}
    <p>No settings found. Create or populate the JSON file.</p>
  {% endif %}
</div>
{% endblock %}
