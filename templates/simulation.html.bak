{% extends "layout.html" %}
{% block content %}

<div class="container">
  <div class="d-flex align-items-center position-relative mb-4">
    <!-- Export CSV at absolute left -->
    <a href="{{ url_for('export_simulation') }}"
       class="btn btn-outline-light position-absolute start-0">
      <i class="bi bi-download"></i> Export CSV
    </a>
    <!-- Centered title -->
    <h2 class="text-warning mb-0 mx-auto">Simulation Dashboard</h2>
  </div>
</div>

<div class="simulation-summary text-center mb-4">
  <p><strong>Cash:</strong> ${{ '%.2f'|format(cash) }}</p>
  <p><strong>Unrealized P&L:</strong> ${{ '%.2f'|format(unrealized_pnl) }}</p>
  <p><strong>Unrealized P&L %:</strong> {{ '%.2f'|format(unrealized_pnl_pct) }}%</p>
  <p><strong>Realized P&L:</strong> ${{ '%.2f'|format(realized_pnl) }}</p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="text-white mb-0">Holdings</h3>
  <span id="sim-status" class="badge bg-secondary">
    Status: <span id="sim-status-text">Stopped</span>
  </span>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Symbol</th><th>Last Price</th><th>Change</th><th>Change %</th>
        <th>Qty</th><th>Price Paid</th><th>Day Gain/Loss</th>
        <th>Total Gain/Loss</th><th>Value</th>
      </tr>
    </thead>
      <tbody>
        {% for h in holdings %}
        <tr>
          <td>{{ h.symbol }}</td>
          <td>${{ '%.2f'|format(h.last_price) }}</td>
          <td>${{ '%.2f'|format(h.day_gain) }}</td>
          <td>{{ '%.1f'|format(h.change_pct) }}%</td>
          <td>{{ h.qty }}</td>
          <td>${{ '%.2f'|format(h.price_paid) }}</td>
          <td>${{ '%.2f'|format(h.day_gain) }}</td>
          <td>
            {% if h.total_gain is not none %}
              ${{ '%.2f'|format(h.total_gain) }}
            {% else %}
              &mdash;
            {% endif %}
          </td>
          <td>${{ '%.2f'|format(h.value) }}</td>
          <td><!-- you can drop or leave blank since you auto‐sell --></td>
        </tr>
        {% endfor %}
      </tbody>

  </table>
</div>

<h3 class="text-white mt-5 mb-3">Trade History</h3>
<div class="table-responsive">
  <table class="table table-striped table-bordered alerts-table text-white">
    <thead class="table-light">
      <tr>
        <th>Time</th><th>Symbol</th><th>Action</th>
        <th>Qty</th><th>Price</th><th>P/L</th>
      </tr>
    </thead>
    <tbody>
      {% for t in history %}
      <tr>
        <td>{{ t.time }}</td>
        <td>{{ t.symbol }}</td>
        <td>{{ t.action }}</td>
        <td>{{ t.qty }}</td>
		<td>${{ '%.2f'|format(t.price|float) }}</td>
        <td>
          {% if t.pl is not none %}
            ${{ '%.2f'|format(t.pl) }}
          {% else %}
            &mdash;
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="text-center">No trades yet</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{# ... Sell button JS and status-poller JS as before ... #}

{% endblock %}
