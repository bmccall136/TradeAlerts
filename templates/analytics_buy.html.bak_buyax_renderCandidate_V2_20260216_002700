<script>

  // MM_FETCH_JSON_V1: safe fetch wrapper (prevents JSON.parse crashes on HTML/500)
  async function mmFetchJson(url) {
    const res = await fetch(url, { cache: "no-store" });
    const ct = (res.headers.get("content-type") || "").toLowerCase();
    if (!res.ok) {
      const txt = await res.text();
      throw new Error(`HTTP ${res.status} ${res.statusText}\n${txt.slice(0, 1200)}`);
    }
    if (!ct.includes("application/json")) {
      const txt = await res.text();
      throw new Error(`Expected JSON but got: ${ct}\n${txt.slice(0, 1200)}`);
    }
    return await res.json();
  }


// --- MM_CANDIDATE_UI_SHIM_V1 ---
// Some backends return only {counts:{signal_fires,trigger_fires}} for candidate_fires.
// The BUY Analytics template historically expects cand/req/strict/buyable/bought/strict_n.
// This shim fills those from counts when missing so the UI doesn't show "?".
function mmNormCandidatePayload(j){
  j = j || {};
  const counts = j.counts || {};
  const out = Object.assign({}, j);
  out.cand = (out.cand !== undefined) ? out.cand : (counts.signal_fires !== undefined ? counts.signal_fires : 0);
  out.req  = (out.req  !== undefined) ? out.req  : (counts.trigger_fires !== undefined ? counts.trigger_fires : 0);
  out.strict   = (out.strict   !== undefined) ? out.strict   : 0;
  out.buyable  = (out.buyable  !== undefined) ? out.buyable  : 0;
  out.bought   = (out.bought   !== undefined) ? out.bought   : 0;
  out.strict_n = (out.strict_n !== undefined) ? out.strict_n : 0;
  return out;
}
// --- /MM_CANDIDATE_UI_SHIM_V1 ---

// --- MM_BUCKET_NORMALIZE_V1 ---
function mmNormBucket(b) {
  if (!b) return "today";
  const s = String(b).trim();
  const u = s.toUpperCase();
  if (u === "TODAY") return "today";
  if (u === "7D") return "7d";
  if (u === "30D") return "30d";
  if (u === "ALL") return "all";
  return s.toLowerCase();
}

(function(){
  const $ = (id)=>document.getElementById(id);

  function pct(n, d){
    if (!d) return "0%";
    return (100 * (n/d)).toFixed(1) + "%";
  }

  function esc(s){
    return String(s ?? "").replace(/[&<>"]/g, c => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"
    }[c]));
  }

  
async function loadFunnel(bucket) {
  try {
    const r = await fetch(`/api/analytics/buy_funnel?bucket=${encodeURIComponent(bucket)}`, {cache:'no-store'});
    const j = await r.json();
    if (!j || !j.ok) return;
    const fmtInt = (n) => (n==null ? '?' : Number(n).toLocaleString());
    document.getElementById('fCand').textContent    = fmtInt(j.candidates);
    document.getElementById('fReq').textContent     = fmtInt(j.required_pass);
    document.getElementById('fStrict').textContent  = fmtInt(j.strict_pass);
    document.getElementById('fBuyable').textContent = fmtInt(j.buyable);
    document.getElementById('fBought').textContent  = fmtInt(j.bought);
    document.getElementById('funnelMeta').textContent = `Bucket: ${j.bucket}  ?  Strict>=${j.strict_n}`;
  } catch(e) {}
}

function syncFunnelVisibility() {
  try {
    const sel = document.getElementById('sourceSel');
    const source = (sel && sel.value) ? sel.value : 'pregate';
    const el = document.getElementById('funnelCard');
    if (!el) return;
    el.style.display = (source === 'candidate') ? '' : 'none';
  } catch(e) {}
}


async function load(){

  // keep funnel visibility aligned to Source
  if (typeof syncFunnelVisibility === 'function') syncFunnelVisibility();

  // if Source is candidate, populate funnel KPIs
  try {
    const _srcSel = document.getElementById('sourceSel');
    const _source = (_srcSel && _srcSel.value) ? _srcSel.value : 'pregate';
    const _bucketSel = document.getElementById('bucketSel');
    const _bucket = (_bucketSel && _bucketSel.value) ? _bucketSel.value : 'all';
    if (_source === 'candidate' && (typeof loadFunnel === 'function')) {
      await loadFunnel(_bucket);
    }
  } catch(e) {}

    const bucket = $("bucketSel").value || "7d";
    $("metaText").textContent = "Loading...";
    $("rows").innerHTML = "";

        const source = (document.getElementById('sourceSel')?.value || 'pregate');
    if (typeof syncFunnelVisibility === 'function') syncFunnelVisibility();
    if (source === 'candidate') { await loadFunnel(bucket); }

    const endpoint = (source === 'candidate') ? '/api/analytics/candidate_fires' : '/api/analytics/fires';
    const r = await fetch(`${endpoint}?bucket=${encodeURIComponent(bucket)}`, {cache:"no-store"});
    const j = await r.json();
    if (!j || !j.ok){
      $("metaText").textContent = "Load failed.";
      return;
    }

    const items = j.items || [];
    const total = j.total || 0;

    $("metaText").textContent = `Rows: ${total} • Bucket: ${j.bucket || bucket}`;

    if (!items.length){
      $("rows").innerHTML = `<tr><td colspan="3" class="mm-muted">No data in this bucket.</td></tr>`;
      return;
    }

    const frag = [];
    for (const it of items){
      const ind = esc(it.indicator);
      const n = Number(it.n || 0);
      frag.push(`
        <tr>
          <td><b>${ind}</b></td>
          <td>${n.toLocaleString()}</td>
          <td>${pct(n, total)}</td>
        </tr>
      `);
    }
    $("rows").innerHTML = frag.join("");
  }

  document.addEventListener("DOMContentLoaded", ()=>{
    $("refreshBtn").addEventListener("click", load);
    $("bucketSel").addEventListener("change", load);
    $("sourceSel").addEventListener("change", load);
    load();
  });
})();
</script>
