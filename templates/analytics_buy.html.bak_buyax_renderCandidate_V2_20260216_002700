<script>
(function(){
  function esc(s){
    s = String(s==null?"":s);
    return s.replace(/[&<>"']/g, function(m){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m];
    });
  }

  function getSelValue(ids, fallback){
    for(var i=0;i<ids.length;i++){
      var el = document.getElementById(ids[i]);
      if(el && el.value != null) return String(el.value);
    }
    return fallback;
  }

  async function fetchJson(url){
    var r = await fetch(url, {cache:"no-store"});
    var ct = (r.headers.get("content-type")||"").toLowerCase();
    var txt = await r.text();
    if(!r.ok){
      throw new Error("HTTP " + r.status + " " + r.statusText + " :: " + txt.slice(0,400));
    }
    if(ct.indexOf("application/json") >= 0){
      return JSON.parse(txt);
    }
    try{ return JSON.parse(txt); }catch(e){
      throw new Error("Non-JSON response (ct=" + ct + "): " + txt.slice(0,400));
    }
  }

  function chipClass(ind){
    ind = (ind||"").toLowerCase();
    if(ind==="sma") return "mm-sma";
    if(ind==="vwap") return "mm-vwap";
    if(ind==="macd") return "mm-macd";
    if(ind==="vol") return "mm-vol";
    if(ind==="rsi") return "mm-rsi";
    if(ind==="bb") return "mm-bb";
    return "";
  }

  function renderFires(j){
    var items = (j && j.items) ? j.items : [];
    var total = (j && j.total!=null) ? j.total : items.reduce(function(a,x){ return a + (x.n||0); }, 0);

    var h = "";
    h += '<div class="mm-ax-head">';
    h +=   '<div class="mm-ax-title">Pre-gate Fires</div>';
    h +=   '<div style="display:flex;gap:10px;flex-wrap:wrap;">';
    h +=     '<span class="mm-pill mm-warn">Total <b>' + esc(total) + '</b></span>';
    h +=     '<span class="mm-pill">Bucket <b>' + esc(j.bucket||"") + '</b></span>';
    h +=   '</div>';
    h += '</div>';

    h += '<table class="mm-table">';
    h += '<thead><tr>';
    h += '<th style="width:42%;">Indicator</th>';
    h += '<th style="width:18%;">Fires</th>';
    h += '<th>Share</th>';
    h += '</tr></thead><tbody>';

    for(var i=0;i<items.length;i++){
      var row = items[i] || {};
      var ind = (row.indicator||"").toLowerCase();
      var n = row.n || 0;
      var share = total ? (100*n/total) : 0;

      h += '<tr>';
      h +=   '<td><span class="mm-chip ' + chipClass(ind) + '">' + esc(ind||row.indicator||"") + '</span></td>';
      h +=   '<td><b>' + esc(n) + '</b></td>';
      h +=   '<td>';
      h +=     '<div class="mm-share">';
      h +=       '<div class="mm-bar"><div style="width:' + (Math.max(0, Math.min(100, share))).toFixed(1) + '%"></div></div>';
      h +=       '<div class="mm-muted" style="min-width:56px;text-align:right;">' + share.toFixed(1) + '%</div>';
      h +=     '</div>';
      h +=   '</td>';
      h += '</tr>';
    }

    h += '</tbody></table>';
    return h;
  }

  function renderCandidate(j){
    var cand = (j && j.cand!=null) ? j.cand : 0;
    var req = (j && j.req!=null) ? j.req : 0;
    var strict = (j && j.strict!=null) ? j.strict : 0;
    var buyable = (j && j.buyable!=null) ? j.buyable : 0;
    var bought = (j && j.bought!=null) ? j.bought : 0;
    var counts = (j && j.counts) ? j.counts : {};
    var sf = (counts.signal_fires!=null) ? counts.signal_fires : 0;
    var tf = (counts.trigger_fires!=null) ? counts.trigger_fires : 0;

    var strictClass = (strict > 0) ? "mm-good" : "mm-bad";
    var buyableClass = (buyable > 0) ? "mm-good" : "mm-bad";
    var boughtClass = (bought > 0) ? "mm-good" : "mm-bad";

    var h = "";
    h += '<div class="mm-ax-head">';
    h +=   '<div class="mm-ax-title">Candidate Fires</div>';
    h +=   '<div style="display:flex;gap:10px;flex-wrap:wrap;">';
    h +=     '<span class="mm-pill">cand <b>' + esc(cand) + '</b></span>';
    h +=     '<span class="mm-pill">req <b>' + esc(req) + '</b></span>';
    h +=     '<span class="mm-pill ' + strictClass + '">strict <b>' + esc(strict) + '</b></span>';
    h +=     '<span class="mm-pill ' + buyableClass + '">buyable <b>' + esc(buyable) + '</b></span>';
    h +=     '<span class="mm-pill ' + boughtClass + '">bought <b>' + esc(bought) + '</b></span>';
    h +=     '<span class="mm-pill mm-warn">signal_fires <b>' + esc(sf) + '</b></span>';
    h +=     '<span class="mm-pill">trigger_fires <b>' + esc(tf) + '</b></span>';
    h +=     '<span class="mm-pill">bucket <b>' + esc(j.bucket||"") + '</b></span>';
    h +=   '</div>';
    h += '</div>';

    var rows = (j && Array.isArray(j.rows)) ? j.rows : [];
    if(!rows.length){
      h += '<div class="mm-muted">No candidate rows returned (rows=[]). Summary above is still live.</div>';
      return h;
    }

    var cols = Object.keys(rows[0] || {});
    h += '<table class="mm-table" style="margin-top:10px;">';
    h += '<thead><tr>';
    for(var c=0;c<cols.length;c++){ h += '<th>' + esc(cols[c]) + '</th>'; }
    h += '</tr></thead><tbody>';

    for(var r=0;r<Math.min(200, rows.length);r++){
      h += '<tr>';
      for(var c2=0;c2<cols.length;c2++){
        var k = cols[c2];
        h += '<td>' + esc(rows[r][k]) + '</td>';
      }
      h += '</tr>';
    }

    h += '</tbody></table>';
    return h;
  }

  async function refresh(){
    var status = document.getElementById("mm-buyax-status");
    var out = document.getElementById("mm-buyax-table");
    if(!status || !out) return;

    var source = getSelValue(["mm-ax-source","ax-source","source","buy-source"], "fires");
    var bucket = getSelValue(["mm-ax-bucket","ax-bucket","bucket","buy-bucket"], "today");

    status.textContent = "Loading? source=" + source + " bucket=" + bucket;

    try{
      if(source === "candidate_fires"){
        var j = await fetchJson("/api/analytics/candidate_fires?bucket=" + encodeURIComponent(bucket));
        out.innerHTML = renderCandidate(j);
        status.textContent = "OK (candidate_fires)";
      } else {
        var j2 = await fetchJson("/api/analytics/fires?bucket=" + encodeURIComponent(bucket));
        out.innerHTML = renderFires(j2);
        status.textContent = "OK (fires)";
      }
    }catch(e){
      status.textContent = "ERROR: " + (e && e.message ? e.message : String(e));
      out.innerHTML = "";
    }
  }

  function hook(){
    var ids = ["mm-ax-source","mm-ax-bucket","ax-source","ax-bucket","source","bucket","buy-source","buy-bucket"];
    for(var i=0;i<ids.length;i++){
      var el = document.getElementById(ids[i]);
      if(el){ el.addEventListener("change", refresh); }
    }
    refresh();
  }

  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", hook);
  else hook();
})();
</script>
