<div id="mm-ax-tape-wrap" style="margin:10px 14px 18px 14px;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
    <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
    <div id="mm-ax-tape-debug" style="margin-top:4px;font-size:12px;opacity:.92;color:#ffcc00;"></div>
  </div>

  <div style="position:relative;">
    <!-- tick labels -->
    <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>

    <!-- tape -->
    <div id="mm-ax-tape"
         style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);
                background:rgba(255,255,255,.04);">
    </div>

    <!-- tick lines overlay -->
    <div id="mm-ax-ticklines" style="position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;"></div>
  </div>
</div>

<script>
/* MM_ANALYTICS_TAPE_SCRIPT_CLEAN_V1 */
(function(){
  const el = document.getElementById("mm-ax-tape");
  const ticksEl = document.getElementById("mm-ax-ticks");
  const linesEl = document.getElementById("mm-ax-ticklines");
  const metaEl = document.getElementById("mm-ax-tape-meta");
  const dbgEl  = document.getElementById("mm-ax-tape-debug");
  if (!el || !ticksEl || !linesEl) return;

  function dbg(msg){
    try{
      if(!dbgEl) return;
      const u = new URL(window.location.href);
      const on = (u.searchParams.get("tape_debug") || "").trim() === "1";
      dbgEl.textContent = on ? msg : "";
    }catch(e){}
  }

  function colorFor(reg){
    reg = (reg||"").toUpperCase();
    if (reg === "TREND") return "rgba(0, 200, 120, .95)";
    if (reg === "CHOP")  return "rgba(240, 200, 0, .95)";
    if (reg === "DEAD")  return "rgba(220, 60, 60, .95)";
    return "rgba(160,160,160,.35)"; // unknown
  }

  function buildBins(openTs, closeTs){
    const bins = [];
    const start = openTs - (openTs % 300);
    const end   = closeTs - (closeTs % 300);
    for (let t = start; t <= end; t += 300) bins.push(t);
    return bins;
  }

  function carryForward(points, bins){
    const map = new Map();
    (points||[]).forEach(p => {
      const t = (p.ts_utc||0);
      const bt = t - (t % 300);
      map.set(bt, { regime: p.regime, conf: p.conf });
    });

    let last = null;
    const segs = [];
    for (const b of bins){
      if (map.has(b)) last = map.get(b);
      segs.push({ ts:b, regime: last?.regime || "UNKNOWN", conf: (last?.conf ?? null) });
    }
    return segs;
  }

  function render(segs, openTs, closeTs){
    // base bar always visible
    el.innerHTML = "";
    ticksEl.innerHTML = "";
    linesEl.innerHTML = "";
    if (metaEl) metaEl.textContent = "";

    if (!segs || !segs.length){
      dbg("no segs");
      return;
    }

    // progress-only: paint only up to NOW; future stays gray
    const nowTs = Math.floor(Date.now()/1000);
    const paintUntil = Math.max(openTs, Math.min(closeTs, nowTs));

    let n = 0;
    for (let i=0; i<segs.length; i++){
      if (segs[i].ts <= paintUntil) n = i+1;
      else break;
    }
    if (n === 0) n = 1; // show at least first slot

    const w = 100 / segs.length;
    let html = "";
    for (let i=0; i<n; i++){
      const s = segs[i];
      html += `<div style="float:left;height:100%;width:${w}%;background:${colorFor(s.regime)}"></div>`;
    }
    el.innerHTML = html + '<div style="clear:both"></div>';

    // tick marks at 9:30, 10:30, 12:00, 14:00, 16:00 ET
    const mk = [
      { ts: openTs,               label:"9:30"  },
      { ts: openTs + 60*60,       label:"10:30" },
      { ts: openTs + 150*60,      label:"12"    },
      { ts: openTs + 270*60,      label:"2"     },
      { ts: closeTs,              label:"4"     },
    ];

    let tHtml = "";
    let lHtml = "";
    for (const t of mk){
      if (t.ts < openTs || t.ts > closeTs) continue;
      const pct = ((t.ts - openTs) / (closeTs - openTs)) * 100;
      tHtml += `<div style="position:absolute;left:calc(${pct}% - 14px);top:0;width:28px;text-align:center;">${t.label}</div>`;
      lHtml += `<div style="position:absolute;left:${pct}%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.10)"></div>`;
    }
    ticksEl.innerHTML = tHtml;
    linesEl.innerHTML = lHtml;

    // meta progress
    const prog = Math.max(0, Math.min(1, (paintUntil - openTs) / (closeTs - openTs)));
    if (metaEl) metaEl.textContent = `progress: ${(prog*100).toFixed(0)}%`;
  }

  async function tick(){
    try{
      const res = await /* MM_TAPE_DATE_FETCH_V1 */
      (function(){
      const u0 = new URL(window.location.href);
      const d0 = (u0.searchParams.get("date") || "").trim();
      const api = d0 ? ("/api/market_regime_timeline?date=" + encodeURIComponent(d0))
                     : "/api/market_regime_timeline?bucket=today";
      return fetch(api, { cache:"no-store" });
    })();
      if (!res.ok){ dbg("api not ok"); return; }
      const j = await res.json();
      const pts = (j.points && j.points.length) ? j.points : (j.buckets || []);
      const win = j.window || {};
      const since = win.since_ts_utc || 0;
      if (!since){ dbg("no window.since_ts_utc"); return; }

      // since is ET-midnight UTC epoch (your server does ET-midnight->UTC)
      // market hours: 09:30?16:00 ET
      const openTs  = since + (9*3600) + (30*60);
      const closeTs = since + (16*3600);

      const bins = buildBins(openTs, closeTs);
      const segs = carryForward(pts, bins);

      dbg(`pts=${pts.length} bins=${bins.length} segs=${segs.length} open=${openTs} close=${closeTs}`);
      render(segs, openTs, closeTs);
    }catch(e){
      dbg("tick err: " + (e && e.message ? e.message : String(e)));
    }
  }

  tick();
  setInterval(tick, 60*1000);
})();
</script>



