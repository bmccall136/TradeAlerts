

{# === MM_AX_CENTERING_V2_START === #}
<style>
  /* V2: brute-force center for analytics pages even if inner nodes try to right-rail */
  .mm-ax-page{
    width:100% !important;
    display:flex !important;
    justify-content:center !important;
    align-items:stretch !important;
  }
  .mm-ax-container{
    width:100% !important;
    max-width:1180px !important;
    margin:0 auto !important;
    padding:0 14px 22px 14px !important;
    box-sizing:border-box !important;
  }

  /* If some inner wrapper is forcing a narrow right panel, neutralize it */
  .mm-ax-container > *{
    width:100% !important;
    max-width:1180px !important;
    margin-left:0 !important;
    margin-right:0 !important;
  }

  /* Kill common right-rail patterns inside analytics toolbars */
  .mm-ax-container .mm-ax-right{
    min-width:0 !important;
    justify-content:flex-end;
  }
  .mm-ax-container [style*="margin-left: auto"],
  .mm-ax-container [style*="margin-left:auto"]{
    margin-left:0 !important;
  }
</style>
{# === MM_AX_CENTERING_V2_END === #}

﻿{% extends "layout.html" %}

{# Analytics-only: keep tape at the VERY TOP by overriding layout.html's analytics_tape slot #}
{% block analytics_tape %}
  {# Default tape renderer (analytics pages). Child pages can override this block if needed. #}
  <div id="mm-ax-tape-wrap" style="margin:0 14px 10px 14px;">
    {# If your existing tape is rendered by JS, keep only the container. #}
    <div id="mm-ax-tape-inner"></div>
  </div>
{% endblock %}

{% block content %}
<!-- MM_WRAP_AX_LAYOUT_CENTER_V1_START -->
<div class="analytics-page"><div class="mm-ax-container">

{# === MM_AX_WRAP_CONTENT_V1_START === #}
<div class="mm-ax-page"><div class="mm-ax-container">

<div class="container-fluid py-3">

  <div class="d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-2">
      <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
      <div>
        <div class="h4 mb-0">{% block analytics_title %}Analytics
</div></div>
{# === MM_AX_WRAP_CONTENT_V1_END === #}
{% endblock %}</div>
        <div class="text-secondary small" id="ax-date">{% block analytics_subtitle %}Loading…{% endblock %}</div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
      <a class="btn btn-sm btn-outline-info" href="/analytics">Daily</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy_regime">Buy Regime</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell_regime">Sell Regime</a>

      <div class="ax-date-wrap d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-warning" id="ax-yesterday" href="#">Yesterday</a>

        <input type="date"
               class="form-control form-control-sm"
               style="width: 150px; background:#0b0b0b; color:#ddd; border:1px solid #444;"
               id="ax-datepick"
               value="{{ request.args.get('date','') }}"
               aria-label="Select date" />

        <a class="btn btn-sm btn-outline-warning" id="ax-datego" href="#">Go</a>
      </div>

      <a class="btn btn-sm btn-outline-secondary" id="ax-live" href="/analytics">Live</a>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <div style="width:100%; max-width:1180px;">
      {% block analytics_body %}{% endblock %}
    </div>
  </div>

</div>

</div></div>
<!-- MM_WRAP_AX_LAYOUT_CENTER_V1_END -->
{% endblock %}
