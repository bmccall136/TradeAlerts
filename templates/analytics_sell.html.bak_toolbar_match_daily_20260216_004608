{% extends "layout.html" %}
{% block content %}

<!-- ====== REGIME TAPE (Analytics pages only) ====== -->
<div id="mm-ax-tape-wrap" style="margin:10px 14px 14px 14px;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
    <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
  </div>
  <div style="position:relative;">
    <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>
    <div id="mm-ax-tape"
         style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);
                background:rgba(255,255,255,.04);">
    </div>
  </div>
</div>

<style>
  /* MM_SELL_ICONIMG_STYLE_V1 */
  .mm-title-iconimg{ width:34px; height:34px; border-radius:999px;     border:1px solid rgba(255,215,0,.55); background:rgba(0,0,0,.25); }

  /* ---- Tabs / chips (keep consistent) ---- */
  .mm-ax-tab{
    display:inline-flex;align-items:center;justify-content:center;
    padding:8px 12px;border-radius:8px;text-decoration:none;
    border:1px solid rgba(0,255,255,.45);
    color:#bff; background: rgba(0,0,0,.18);
    font-weight:700; font-size:14px;
    white-space:nowrap;
  }
  .mm-ax-tab.active{ border-color: rgba(255,215,0,.85); color:#ffd700; }

  .mm-ax-chip{
    padding:8px 12px;border-radius:8px;
    border:1px solid rgba(255,215,0,.55);
    background: rgba(0,0,0,.18);
    color:#ffd700; font-weight:800; cursor:pointer; text-decoration:none;
    white-space:nowrap;
  }
  .mm-ax-date{
    padding:7px 10px;border-radius:8px;
    border:1px solid rgba(255,215,0,.35);
    background: rgba(0,0,0,.18);
    color:#ddd; font-weight:700;
  }

  /* ---- Title block (match Buy Analytics feel) ---- */
  .mm-title-row{
    margin:8px 14px 0 14px;
    display:flex;
    align-items:flex-start;
    gap:16px;
  }
  .mm-title-left{ flex:1 1 auto; min-width:520px; }
  .mm-title-head{
    display:flex;
    align-items:center;
    gap:12px;
    line-height:1.1;
  }
  .mm-title-icon{
    width:34px;height:34px;border-radius:999px;
    display:inline-flex;align-items:center;justify-content:center;
    border:1px solid rgba(255,215,0,.55);
    background: rgba(0,0,0,.25);
    box-shadow: 0 0 0 1px rgba(255,255,255,.06) inset;
    flex:0 0 auto;
  }
  .mm-title-icon svg{ width:20px;height:20px; opacity:.95; }
  .mm-title-text{
    font-size:26px;           /* smaller than the wonky 30+ */
    font-weight:900;
    letter-spacing:.2px;
  }
  .mm-title-sub{
    margin-left:10px;
    font-size:13px;
    opacity:.70;
    font-weight:700;
    align-self:flex-end;
    transform: translateY(-2px);
  }
  .mm-title-desc{
    opacity:.70;
    font-size:13px;
    margin-top:6px;
    max-width:760px;
  }

  /* ---- Controls under title (Buy-style) ---- */
  .mm-ctl-row{ display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-top:10px; }
  .mm-ctl{ display:flex; align-items:center; gap:10px; }
  .mm-ctl label{ opacity:.8; font-weight:800; min-width:70px; }
  .mm-select{
    min-width:240px;
    padding:9px 10px;
    border-radius:10px;
    border:1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.22);
    color:#eaeaea;
    font-weight:800;
  }

  /* ---- Right toolbar: keep date controls together so Go/Live don't drop ---- */
  .mm-toolbar{
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:flex-end;
    flex-wrap:wrap;
    flex:0 0 auto;
  }
  .mm-toolbar-group{
    display:flex;
    gap:10px;
    align-items:center;
    flex-wrap:nowrap;
  }
  .mm-toolbar-spacer{ width:10px; height:1px; }

  /* ---- Cards ---- */
  .mm-card{
    margin:14px 14px;
    padding:14px 14px;
    border-radius:14px;
    background: rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.08);
  }
  .mm-card h3{ margin:0 0 10px 0; font-size:16px; }
  .mm-row{ display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; }
  .mm-mini{
    min-width:280px;
    padding:10px 12px;border-radius:12px;
    background: rgba(0,0,0,.22);
    border:1px solid rgba(255,255,255,.08);
  }
  .mm-err{
    display:none;
    margin:10px 14px;
    padding:10px 12px;
    border-radius:10px;
    border:1px solid rgba(255,80,80,.35);
    background: rgba(255,80,80,.10);
    color:#ffb3b3;
    white-space:pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size:12px;
  }
  table.mm-t{ width:100%; border-collapse:collapse; }
  table.mm-t td{ padding:6px 4px; border-bottom:1px solid rgba(255,255,255,.06); font-size:13px; }
  table.mm-t td.k{ opacity:.85; }
  table.mm-t td.v{ text-align:right; font-weight:800; }
</style>

<!-- ====== HEADER ROW (now matches Buy Analytics) ====== -->
<div class="mm-title-row">
  <div class="mm-title-left">
    <div class="mm-title-head">
      <img class="mm-title-iconimg" src="/static/Max.png" alt="" />

      <div class="mm-title-text">Sell Analytics</div>
      <div class="mm-title-sub" id="mm-sell-sub">Today</div>
    </div>

    <div class="mm-title-desc">
      This page focuses on exit reasons, execution outcomes, and time-in-position. (Counts stay off the SELL Settings page.)
    </div>

    <div class="mm-ctl-row">
      <div class="mm-ctl">
        <label for="mm-sell-bucket">Bucket</label>
        <select id="mm-sell-bucket" class="mm-select">
          <option value="today">TODAY</option>
          <option value="7d">7D</option>
          <option value="30d">30D</option>
          <option value="all">ALL</option>
        </select>
      </div>
    </div>
  </div>

  <div class="mm-toolbar">
    <div class="mm-toolbar-group">
      <a class="mm-ax-tab" href="/analytics">Daily</a>
      <a class="mm-ax-tab" href="/analytics/buy">Buy Analytics</a>
      <a class="mm-ax-tab active" href="/analytics/sell">Sell Analytics</a>
      <a class="mm-ax-tab" href="/analytics/buy_regime">Buy Regime</a>
      <a class="mm-ax-tab" href="/analytics/sell_regime">Sell Regime</a>
    </div>

    <div class="mm-toolbar-spacer"></div>

    <div class="mm-toolbar-group">
      <button class="mm-ax-chip" id="mm-ax-yday" type="button">Yesterday</button>
      <input class="mm-ax-date" id="mm-ax-date" type="date" />
      <button class="mm-ax-chip" id="mm-ax-go" type="button">Go</button>
      <a class="mm-ax-chip" href="/live">Live</a>
    </div>
  </div>
</div>

<div id="mm-sell-err" class="mm-err"></div>

<!-- ====== CARDS ====== -->
<div class="mm-card">
  <h3>Exit reason breakdown</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="mm-muted" id="mm-exit-loading">Loading?</div>
      <div id="mm-exit-box"></div>
    </div>
    <div class="mm-title-desc" style="padding-top:6px;max-width:none;">
      Reason counts come from <span style="color:#ff66cc;font-family:monospace;">sell_events</span> where <span style="color:#ff66cc;font-family:monospace;">event=FILLED</span>.
    </div>
  </div>
</div>

<div class="mm-card">
  <h3>Execution outcomes</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="mm-muted" id="mm-outcome-loading">Loading?</div>
      <div id="mm-outcome-box"></div>
    </div>
    <div class="mm-title-desc" style="padding-top:6px;max-width:none;">
      Outcomes come from all <span style="color:#ff66cc;font-family:monospace;">sell_events</span> rows in the bucket.
    </div>
  </div>
</div>

<div class="mm-card">
  <h3>Hold-time buckets</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="mm-muted" id="mm-hold-loading">Loading?</div>
      <div id="mm-hold-box"></div>
    </div>
    <div class="mm-title-desc" style="padding-top:6px;max-width:none;">
      Hold time is computed from open?close timestamps when available. Missing data shows as empty bucket.
    </div>
  </div>
</div>

<script src="/static/js/analytics_sell.js"></script>
<script>
  (function(){
    const d = document.getElementById('mm-ax-date');
    const go = document.getElementById('mm-ax-go');
    const yd = document.getElementById('mm-ax-yday');
    if(d){
      try{
        const u = new URL(window.location.href);
        const qd = u.searchParams.get('date');
        if(qd) d.value = qd;
      }catch(e){}
    }
    function navDate(v){
      const u = new URL(window.location.href);
      if(v) u.searchParams.set('date', v);
      else u.searchParams.delete('date');
      window.location.href = u.toString();
    }
    if(go && d) go.addEventListener('click', ()=> navDate(d.value));
    if(yd) yd.addEventListener('click', ()=>{
      const t = new Date();
      t.setDate(t.getDate()-1);
      const y = t.getFullYear();
      const m = String(t.getMonth()+1).padStart(2,'0');
      const da= String(t.getDate()).padStart(2,'0');
      navDate(`${y}-${m}-${da}`);
    });
  })();
</script>

{% endblock %}
