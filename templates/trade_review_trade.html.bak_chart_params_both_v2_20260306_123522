{% extends "layout.html" %}
{% block content %}

<div class="tr-wrap">
  <div class="tr-topbar">
    <div>
      <div class="tr-title">$$Machine ? Trade Review</div>
      <div class="tr-sub">
        One trade story. Chart shows only the held window (time-at-risk). Shading is green for wins and red for losses.
      </div>
      <div class="tr-src">
        Source of truth: local DB (closed trade). Reasons: logs\\triggers_YYYY-MM-DD.csv + logs\\sell_triggers_YYYY-MM-DD.csv
      </div>
    </div>
    <div class="tr-actions">
      <a class="tr-btn" href="/analytics">Analytics</a>
      <a class="tr-btn" href="/analytics/recent_sells">Pick another</a>
      <a class="tr-btn" href="/trade_review/trade/{{ trade_id }}">Refresh</a>
    </div>
  </div>

  {% if error %}
    <div class="tr-error">{{ error }}</div>
  {% else %}

  <div class="tr-head">
    <div class="tr-hleft">
      <span class="tr-symbol">{{ trade.symbol }}</span>
      <span class="tr-name">{{ trade.name or '' }}</span>
    </div>
    <div class="tr-hright">
      <span class="tr-pill {% if trade.is_win %}win{% else %}loss{% endif %}">
        {% if trade.is_win %}WIN{% else %}LOSS{% endif %}
      </span>
      <span class="tr-pnl">{{ trade.pnl_text }}</span>
    </div>
  </div>

  <div class="tr-meta-row">
    <div><span class="k">Buy:</span> <span class="v">{{ trade.buy_time }}</span></div>
    <div><span class="k">Sell:</span> <span class="v">{{ trade.sell_time }}</span></div>
    <div><span class="k">Qty:</span> <span class="v">{{ trade.qty }}</span></div>
    <div><span class="k">Entry:</span> <span class="v">{{ trade.entry_price }}</span></div>
    <div><span class="k">Exit:</span> <span class="v">{{ trade.exit_price }}</span></div>
  </div>

  <div class="tr-card">
    <img class="tr-chart-img"
         src="/trade_review/chart/{{ trade_id }}.png"
         alt="Trade chart">
  </div>

  <div class="tr-grid">
    <section class="tr-col">
      <div class="tr-col-title">Buy Reasons (exact trigger row)</div>
      {% if buy_row %}
        <table class="tr-table">
          <tbody>
            {% for k,v in buy_row.items() %}
              <tr><td class="tr-k">{{ k }}</td><td class="tr-v">{{ v }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="tr-empty">No matching buy trigger row found in logs.</div>
      {% endif %}
    </section>

    <section class="tr-col">
      <div class="tr-col-title">Sell Reasons (exact trigger row)</div>
      {% if sell_row %}
        <table class="tr-table">
          <tbody>
            {% for k,v in sell_row.items() %}
              <tr><td class="tr-k">{{ k }}</td><td class="tr-v">{{ v }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="tr-empty">No matching sell trigger row found in logs.</div>
      {% endif %}
    </section>
  </div>

  {% endif %}
</div>

<style>
  .tr-wrap { max-width: 1400px; margin: 0 auto; padding: 18px 0; }
  .tr-topbar { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:14px; }
  .tr-title { color:#ffe900; font-size: 22px; font-weight: 700; }
  .tr-sub { color:#cfcfcf; margin-top:6px; font-size: 13px; }
  .tr-src { color:#8f8f8f; margin-top:10px; font-size: 12px; }
  .tr-actions { display:flex; gap:10px; }
  .tr-btn {
    display:inline-block; padding:7px 14px; border-radius: 12px;
    background:#1a1a1a; border:1px solid #3a3a3a; color:#ffe900;
    text-decoration:none; font-size: 13px;
  }
  .tr-btn:hover { border-color:#ffe900; }

  .tr-error { padding:10px 12px; border:1px solid #7a1a1a; background:#1a0b0b; color:#ffb3b3; border-radius:12px; }
  .tr-empty { color:#cfcfcf; opacity:0.85; margin-top: 6px; }

  .tr-head { display:flex; justify-content:space-between; align-items:center; margin: 8px 0 10px; }
  .tr-symbol { color:#fff; font-weight: 800; font-size: 18px; margin-right:10px; }
  .tr-name { color:#bdbdbd; font-size: 12px; }
  .tr-hright { display:flex; align-items:center; gap:10px; }
  .tr-pill { font-size: 11px; padding: 2px 10px; border-radius: 999px; font-weight:800; }
  .tr-pill.win { background:#102510; border:1px solid #2e7d32; color:#a9f5a9; }
  .tr-pill.loss { background:#2a1010; border:1px solid #b71c1c; color:#ffb3b3; }
  .tr-pnl { color:#e0e0e0; font-weight:700; }

  .tr-meta-row { display:flex; flex-wrap:wrap; gap:14px; color:#bdbdbd; font-size:12px; margin-bottom:12px; }
  .tr-meta-row .k { color:#8f8f8f; margin-right:6px; }
  .tr-meta-row .v { color:#e0e0e0; }

  .tr-card { background:#0f0f0f; border:1px solid #2a2a2a; border-radius:14px; padding:12px; margin-bottom: 14px; }
  .tr-chart-img{
    width: 100%;
    height: 240px;
    display:block;
    border-radius:12px;
    border:1px solid #2a2a2a;
    background:#0b0b0b;
    object-fit: cover;
  }

  .tr-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .tr-col { background:#0f0f0f; border:1px solid #2a2a2a; border-radius:14px; padding:12px; }
  .tr-col-title { color:#ffe900; font-weight:700; margin: 0 0 10px; font-size: 13px; }

  .tr-table { width:100%; border-collapse: collapse; font-size: 12px; }
  .tr-table td { padding: 6px 8px; border-bottom: 1px solid #1f1f1f; vertical-align: top; }
  .tr-k { color:#9d9d9d; width: 32%; }
  .tr-v { color:#e0e0e0; word-break: break-word; }

  @media (max-width: 1100px) {
    .tr-grid { grid-template-columns: 1fr; }
  }
</style>

{% endblock %}


<!-- MM_TRV_TRADE_RENDER_FROM_API_V2 -->
<script>
(function() {
  function esc(s) {
    return (s === null || s === undefined) ? "" : String(s)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  }

  function parseIso(s) {
    if (!s) return null;
    const d = new Date(s);
    if (isNaN(d.getTime())) return null;
    return d;
  }

  function parseAnyTime(v) {
    if (v === null || v === undefined || v === "") return null;
    if (typeof v === "number" && isFinite(v)) {
      // assume epoch seconds if small, ms if large
      return new Date(v > 1e12 ? v : v * 1000);
    }
    if (typeof v === "string" && /^\d+$/.test(v)) {
      const n = Number(v);
      return new Date(n > 1e12 ? n : n * 1000);
    }
    return parseIso(v);
  }

  function pctFmt(x) {
    if (x === null || x === undefined || x === "") return "";
    const n = Number(x);
    if (!isFinite(n)) return "";
    const sign = (n >= 0) ? "+" : "";
    return sign + n.toFixed(2) + "%";
  }

  function buildDetailsTable(rows, emptyMsg) {
    if (!rows || !rows.length) return '<div class="tr-empty">' + esc(emptyMsg || 'No triggers found.') + '</div>';
    let out = "";
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i] || {};
      out += '<table class="tr-table"><tbody>';
      for (const k of Object.keys(r)) {
        out += '<tr><td class="tr-k">' + esc(k) + '</td><td class="tr-v">' + esc(r[k]) + '</td></tr>';
      }
      out += '</tbody></table>';
      if (i !== rows.length - 1) out += '<div style="height:8px"></div>';
    }
    return out;
  }

  function lineSvg(x, padY, innerH, stroke, width, dash) {
    return '<line x1="' + x.toFixed(2) + '" y1="' + padY + '" x2="' + x.toFixed(2) + '" y2="' + (padY + innerH) +
           '" stroke="' + stroke + '" stroke-width="' + width + '"' +
           (dash ? ' stroke-dasharray="' + dash + '"' : '') + '/>';
  }

  function textSvg(x, y, txt, fill) {
    return '<text x="' + x.toFixed(2) + '" y="' + y.toFixed(2) + '" fill="' + fill +
           '" font-size="11" font-weight="700" text-anchor="middle">' + esc(txt) + '</text>';
  }

  function seriesToSvg(series, overlay) {
    if (!series || !series.length) return null;

    const pts = [];
    for (const p of series) {
      const t = parseIso(p.t);
      const y = Number(p.c);
      if (!t || !isFinite(y)) continue;
      pts.push({ t: t.getTime(), y });
    }
    if (pts.length < 2) return null;

    let tMin = pts[0].t, tMax = pts[0].t, yMin = pts[0].y, yMax = pts[0].y;
    for (const p of pts) {
      if (p.t < tMin) tMin = p.t;
      if (p.t > tMax) tMax = p.t;
      if (p.y < yMin) yMin = p.y;
      if (p.y > yMax) yMax = p.y;
    }
    if (tMax === tMin) return null;
    if (yMax === yMin) yMax = yMin + 1.0;

    const W = 1000, H = 180;
    const padX = 14, padY = 12;
    const innerW = W - padX * 2;
    const innerH = H - padY * 2;

    function xOf(t) { return padX + ((t - tMin) / (tMax - tMin)) * innerW; }
    function yOf(v) { return padY + (1 - ((v - yMin) / (yMax - yMin))) * innerH; }

    let d = "";
    for (let i = 0; i < pts.length; i++) {
      const x = xOf(pts[i].t).toFixed(2);
      const y = yOf(pts[i].y).toFixed(2);
      d += (i === 0 ? "M " : " L ") + x + " " + y;
    }

    let shadeRect = "";
    let overlayLines = "";
    let overlayLabels = "";

    const buyAt = parseAnyTime(overlay && overlay.buy_at);
    const sellAt = parseAnyTime(overlay && overlay.sell_at);

    if (buyAt && buyAt.getTime() >= tMin && buyAt.getTime() <= tMax) {
      const xb = xOf(buyAt.getTime());
      overlayLines += lineSvg(xb, padY, innerH, "rgba(0,255,120,0.90)", 2.2, "");
      overlayLabels += textSvg(xb, padY + 12, "BUY", "#7CFFB2");
    }

    if (sellAt && sellAt.getTime() >= tMin && sellAt.getTime() <= tMax) {
      const xs = xOf(sellAt.getTime());
      overlayLines += lineSvg(xs, padY, innerH, "rgba(255,80,80,0.90)", 2.2, "");
      overlayLabels += textSvg(xs, padY + 12, "SELL", "#FF9A9A");
    }

    if (buyAt && sellAt) {
      const x1 = xOf(buyAt.getTime());
      const x2 = xOf(sellAt.getTime());
      const left = Math.max(padX, Math.min(x1, x2));
      const right = Math.min(padX + innerW, Math.max(x1, x2));
      const width = Math.max(0, right - left);
      shadeRect = '<rect x="' + left.toFixed(2) + '" y="' + padY + '" width="' + width.toFixed(2) +
                  '" height="' + innerH + '" fill="rgba(255,255,255,0.08)" />';
    }

    const triggerLines = [];
    const buyTriggers = (overlay && overlay.buy_triggers) || [];
    const sellTriggers = (overlay && overlay.sell_triggers) || [];

    buyTriggers.forEach(t => {
      const dt = parseAnyTime(t && (t.ts_utc || t.time_et || t.ts_et));
      if (!dt) return;
      const ms = dt.getTime();
      if (ms < tMin || ms > tMax) return;
      const x = xOf(ms);
      triggerLines.push(
        lineSvg(x, padY, innerH, "rgba(0,255,120,0.45)", 1.2, "4 4") +
        textSvg(x, H - 6, "B", "#7CFFB2")
      );
    });

    sellTriggers.forEach(t => {
      const dt = parseAnyTime(t && (t.ts_utc || t.time_et || t.ts_et));
      if (!dt) return;
      const ms = dt.getTime();
      if (ms < tMin || ms > tMax) return;
      const x = xOf(ms);
      triggerLines.push(
        lineSvg(x, padY, innerH, "rgba(255,80,80,0.45)", 1.2, "4 4") +
        textSvg(x, H - 6, "S", "#FF9A9A")
      );
    });

    return (
      '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">' +
        '<rect x="0" y="0" width="' + W + '" height="' + H + '" fill="#0b0b0b"/>' +
        '<line x1="0" y1="' + (H/2) + '" x2="' + W + '" y2="' + (H/2) + '" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>' +
        shadeRect +
        triggerLines.join("") +
        overlayLines +
        '<path d="' + d + '" fill="none" stroke="rgba(255,233,0,0.85)" stroke-width="2.2" />' +
        overlayLabels +
      '</svg>'
    );
  }

  function cardHTML(kind, item) {
    const isBuy = (kind === "BUY");
    const badgeCls = isBuy ? "tr-badge-buy" : "tr-badge-sell";
    const sym = item.symbol || "";
    const ts = item.ts_et || "";
    const reason = item.reason || "";
    const titleLine = item.title_line || "";
    const pnl = item.pnl_pct;

    let pnlChip = "";
    if (!isBuy && pnl !== null && pnl !== undefined && pnl !== "") {
      const cls = (Number(pnl) >= 0) ? "tr-pnl tr-pnl-pos" : "tr-pnl tr-pnl-neg";
      pnlChip = '<span class="' + cls + '">' + esc(pctFmt(pnl)) + '</span>';
    }

    const svg = seriesToSvg(item.series || [], {
      buy_at: item.buy_at || item.anchor_buy_ts_utc || item.anchor_buy_time_et || item.shade?.from || null,
      sell_at: item.sell_at || item.anchor_sell_ts_utc || item.anchor_sell_time_et || item.shade?.to || null,
      buy_triggers: item.buy_triggers || item.detail_rows || [],
      sell_triggers: item.sell_triggers || []
    });

    const chart = svg
      ? '<div class="tr-chart">' + svg + '</div>'
      : '<div class="tr-chart-fallback">No Yahoo intraday series for chart.</div>';

    const trigTitle = isBuy ? "Buy Triggers" : "Sell Triggers";
    const trigEmpty = isBuy ? "No buy triggers found." : "No sell triggers found.";
    const details = buildDetailsTable(item.detail_rows || [], trigEmpty);

    return '' +
      '<div class="tr-card">' +
        '<div class="tr-card-head">' +
          '<div class="tr-card-left">' +
            '<span class="tr-badge ' + badgeCls + '">' + esc(kind) + '</span>' +
            '<span class="tr-symbol">' + esc(sym) + '</span>' +
            pnlChip +
          '</div>' +
          '<div class="tr-card-right">' +
            '<span class="tr-time">' + esc(ts) + '</span>' +
          '</div>' +
        '</div>' +
        (titleLine ? '<div class="tr-titleline">' + esc(titleLine) + '</div>' : '') +
        (reason ? '<div class="tr-reason">Reason: <span style="color:#cfcfcf">' + esc(reason) + '</span></div>' : '') +
        chart +
        '<div class="tr-rows">' +
          '<div class="tr-rows-title">' + esc(trigTitle) + '</div>' +
          details +
        '</div>' +
      '</div>';
  }

  async function load() {
    const buysEl = document.getElementById("buys");
    const sellsEl = document.getElementById("sells");
    const srcEl = document.getElementById("tr-src");

    const params = new URLSearchParams(window.location.search);
    const limit = params.get("limit") || "12";
    const interval = params.get("interval") || "5m";

    buysEl.innerHTML = '<div class="tr-empty">Loading...</div>';
    sellsEl.innerHTML = '<div class="tr-empty">Loading...</div>';

    const url = "/api/trade_review?limit=" + encodeURIComponent(limit) + "&interval=" + encodeURIComponent(interval);

    try {
      const res = await fetch(url, { cache: "no-store" });
      const j = await res.json();

      if (!j || j.ok === false) {
        const msg = (j && j.error) ? j.error : "Unknown error from /api/trade_review";
        buysEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
        sellsEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
        return;
      }

      const buys = j.buys || [];
      const sells = j.sells || [];

      srcEl.textContent = "API: " + url;

      buysEl.innerHTML = buys.length
        ? buys.map(b => cardHTML("BUY", b)).join("")
        : '<div class="tr-empty">No recent buys returned by API.</div>';

      sellsEl.innerHTML = sells.length
        ? sells.map(s => cardHTML("SELL", s)).join("")
        : '<div class="tr-empty">No recent sells returned by API.</div>';
    } catch (e) {
      const msg = "Failed to load /api/trade_review: " + (e && e.message ? e.message : String(e));
      buysEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
      sellsEl.innerHTML = '<div class="tr-empty">' + esc(msg) + '</div>';
    }
  }

  load();
})();
</script>
<style>
  .mm-trv-row{margin:6px 0;padding:6px 10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.04)}
  .mm-trv-line1{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .mm-trv-time{display:inline-block;min-width:170px;opacity:.9}
  .mm-trv-price{display:inline-block;min-width:70px;opacity:.95;font-weight:800}
  .mm-trv-sig{margin-top:4px;opacity:.95}
  .mm-muted{opacity:.65}
</style>
<!-- /MM_TRV_TRADE_RENDER_FROM_API_V2 -->


