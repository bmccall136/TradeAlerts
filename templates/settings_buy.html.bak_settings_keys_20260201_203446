{% extends "layout.html" %}
{% block content %}
<div class="container-fluid" style="max-width:1200px;margin:0 auto;">
  <div class="d-flex align-items-center justify-content-between" style="margin:18px 0 10px 0;">
    <div style="font-size:22px;font-weight:700;">Settings</div>
    <div class="d-flex align-items-center" style="gap:10px;">
      <div class="btn-group" role="group" aria-label="settings tabs">
        <a class="btn btn-sm btn-warning" href="/settings/buy">BUY</a>
        <a class="btn btn-sm btn-dark" href="/settings/sell">SELL</a>
      </div>
      <div class="d-flex align-items-center" style="gap:8px;">
        <div style="opacity:.85;">Profile</div>
        <select id="profileSel" class="form-select form-select-sm" style="width:130px;">
          <option value="day">DAY</option>
          <option value="swing">SWING</option>
        </select>
      </div>
    </div>
  </div>

  <div class="card" style="background:rgba(10,18,35,.65);border:1px solid rgba(255,255,255,.08);border-radius:14px;margin-bottom:12px;">
    <div class="card-body">
      <div style="font-size:18px;font-weight:700;">Signal Scoreboard</div>
      <div style="opacity:.9;margin:2px 0 10px 0;">Counts increment even if disabled. Toggles affect eligibility only.</div>

      <div class="d-flex align-items-center" style="gap:10px;margin-bottom:10px;">
        <div style="min-width:60px;opacity:.85;">Bucket</div>
        <select id="bucketSel" class="form-select form-select-sm" style="width:160px;">
          <option value="today" selected>TODAY</option>
          <option value="7d">7D</option>
          <option value="30d">30D</option>
          <option value="all">ALL</option>
        </select>
        <div id="bucketHint" style="opacity:.75;"></div>
        <div id="scoreErr" style="display:none;color:#ff6b6b;font-weight:600;"></div>
      </div>

      <div class="table-responsive">
        <table class="table table-sm table-dark align-middle" style="margin:0;">
          <thead>
            <tr>
              <th style="width:55%;">Indicator</th>
              <th style="width:15%;text-align:center;">Count</th>
              <th style="width:15%;text-align:center;">Enabled</th>
              <th style="width:15%;text-align:right;opacity:.8;">Key</th>
            </tr>
          </thead>
          <tbody id="scoreRows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="gateCard" class="card" style="background:rgba(10,18,35,.65);border:1px solid rgba(255,255,255,.08);border-radius:14px;margin-bottom:12px;">
    <div class="card-body">
      <div style="font-size:18px;font-weight:700;">Required Signals Gate</div>
      <div style="opacity:.9;margin:2px 0 10px 0;">Minimum number of ON signals that must fire before we consider a trade.</div>

      <div class="d-flex align-items-center" style="gap:10px;">
        <div style="min-width:130px;opacity:.85;">Minimum required</div>
        <select id="minReqSel" class="form-select form-select-sm" style="width:140px;"></select>
        <div id="gateHint" style="opacity:.75;"></div>
      </div>
    </div>
  </div>

  <div class="card" style="background:rgba(10,18,35,.65);border:1px solid rgba(255,255,255,.08);border-radius:14px;margin-bottom:18px;">
    <div class="card-body">
      <div style="font-size:18px;font-weight:700;">Settings</div>
      <div style="opacity:.9;margin:2px 0 10px 0;">Grouped. No raw JSON.</div>

      <div id="groups"></div>

      <div class="d-flex align-items-center" style="gap:10px;margin-top:14px;">
        <button id="saveBtn" class="btn btn-warning">Save</button>
        <div id="saveMsg" style="opacity:.85;"></div>
      </div>
    </div>
  </div>
</div>


<script>
  // page indicator model
  window.__INDICATORS__ = [
  { label: "MACD", enable_key: "enable_macd" },
  { label: "RSI",  enable_key: "enable_rsi" },
  { label: "VWAP", enable_key: "enable_vwap" },
  { label: "BB",   enable_key: "enable_bb" },
  { label: "ADX",  enable_key: "enable_adx" },
  { label: "VOL",  enable_key: "enable_vol" }
];
</script>

<script>
(() => {
  const GROUP = "buy"; // dashboard.py passes group=buy/sell into template
  const byId = (id) => document.getElementById(id);

  // Page-specific indicator model injected by each page
  const INDICATORS = window.__INDICATORS__ || [];

  function normProfile(v){
    v = String(v || "").toLowerCase();
    if (v === "day" || v === "swing") return v;
    return "day";
  }

  async function apiLoad(group, profile){
    const r = await fetch(`/api/settings/load?group=${encodeURIComponent(group)}&profile=${encodeURIComponent(profile)}`, { cache: "no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "settings load not-ok");
    return (j.data && typeof j.data === "object") ? j.data : {};
  }

  async function apiSave(group, profile, data){
    const r = await fetch(`/api/settings/save?group=${encodeURIComponent(group)}&profile=${encodeURIComponent(profile)}`, {
      method: "POST",
      headers: { "Content-Type":"application/json" },
      body: JSON.stringify(data || {})
    });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "settings save not-ok");
    return j;
  }

  async function apiScoreboard(bucket){
    const r = await fetch(`/api/settings/scoreboard?bucket=${encodeURIComponent(bucket)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "scoreboard not-ok");
    return j;
  }

  function enabledIndicators(settings){
    const out = [];
    for (const it of INDICATORS){
      const k = it.enable_key;
      const on = !!settings[k];
      if (on) out.push(it);
    }
    return out;
  }

  function renderGate(settings){
    const minReqSel = byId("minReqSel");
    const gateHint  = byId("gateHint");
    if (!minReqSel) return;

    const enabled = enabledIndicators(settings);
    const maxOpt = Math.max(1, enabled.length || 1);

    // build options 1..maxOpt (always at least 1)
    minReqSel.innerHTML = "";
    for (let i=1; i<=maxOpt; i++){
      const opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = String(i);
      minReqSel.appendChild(opt);
    }

    let cur = parseInt(settings.required_signals_min, 10);
    if (!Number.isFinite(cur) || cur < 1) cur = 1;
    if (cur > maxOpt) cur = maxOpt;
    minReqSel.value = String(cur);
    settings.required_signals_min = cur;

    if (gateHint){
      if (!enabled.length) gateHint.textContent = "No indicators enabled.";
      else gateHint.textContent = enabled.length + " enabled: " + enabled.map(x => x.label).join(", ");
    }

    minReqSel.onchange = () => {
      const v = parseInt(minReqSel.value, 10) || 1;
      settings.required_signals_min = v;
    };
  }

  function groupKeys(settings){
    const keys = Object.keys(settings || {});
    const groups = [
      { title: "Indicator Parameters", match: k => /^(rsi_|macd_|bb_|bollinger|vwap_)/i.test(k) && !/^(enable_|enabled|use_)/i.test(k) },
      { title: "Risk / Trade Controls", match: k => /(max_per_trade|single_entry|pyramids|risk|exposure|budget|qty)/i.test(k) },
      { title: "Timing", match: k => /(sell_after|days|poll|interval|sleep|cooldown|timeout|hold)/i.test(k) },
      { title: "Other", match: k => true }
    ];

    // keep enable_* keys out of the generic groups; those are controlled by the scoreboard toggles
    const skip = (k) => /^(enable_|enabled|use_)/i.test(k);

    const used = new Set();
    const out = [];
    for (const g of groups){
      const gkeys = keys.filter(k => !skip(k) && !used.has(k) && g.match(k));
      for (const k of gkeys) used.add(k);
      if (gkeys.length) out.push({ title: g.title, keys: gkeys.sort() });
    }
    return out;
  }

  function renderGroups(settings){
    const root = byId("groups");
    if (!root) return;

    const groups = groupKeys(settings);
    const chunks = [];

    for (const g of groups){
      chunks.push(`<div class="card" style="background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.06);border-radius:12px;margin:10px 0;">
        <div class="card-body">
          <div style="font-weight:700;margin-bottom:8px;opacity:.95;">${g.title}</div>
          <div class="table-responsive">
            <table class="table table-sm table-dark align-middle" style="margin:0;">
              <tbody>
                ${g.keys.map(k => {
                  const v = settings[k];
                  const id = "k_" + k.replace(/[^a-z0-9_]/gi, "_");
                  if (typeof v === "boolean"){
                    return `<tr>
                      <td style="width:70%;opacity:.9;">${k}</td>
                      <td style="width:30%;text-align:right;">
                        <input type="checkbox" id="${id}" ${v ? "checked":""}/>
                      </td>
                    </tr>`;
                  }
                  if (typeof v === "number"){
                    return `<tr>
                      <td style="width:70%;opacity:.9;">${k}</td>
                      <td style="width:30%;text-align:right;">
                        <input type="number" class="form-control form-control-sm" id="${id}" value="${String(v)}" style="max-width:180px;display:inline-block;"/>
                      </td>
                    </tr>`;
                  }
                  return `<tr>
                    <td style="width:70%;opacity:.9;">${k}</td>
                    <td style="width:30%;text-align:right;">
                      <input type="text" class="form-control form-control-sm" id="${id}" value="${(v===null||v===undefined) ? "" : String(v)}" style="max-width:260px;display:inline-block;"/>
                    </td>
                  </tr>`;
                }).join("")}
              </tbody>
            </table>
          </div>
        </div>
      </div>`);
    }

    root.innerHTML = chunks.join("");

    // wire inputs -> settings
    for (const g of groups){
      for (const k of g.keys){
        const id = "k_" + k.replace(/[^a-z0-9_]/gi, "_");
        const el = byId(id);
        if (!el) continue;
        if (el.type === "checkbox"){
          el.onchange = () => { settings[k] = !!el.checked; };
        } else if (el.type === "number"){
          el.onchange = () => {
            const n = Number(el.value);
            settings[k] = Number.isFinite(n) ? n : settings[k];
          };
        } else {
          el.onchange = () => { settings[k] = String(el.value); };
        }
      }
    }
  }

  function renderScoreboard(settings, counts, bucket){
    const scoreRows = byId("scoreRows");
    const bucketHint = byId("bucketHint");
    const scoreErr = byId("scoreErr");
    if (!scoreRows) return;

    if (scoreErr){ scoreErr.style.display="none"; scoreErr.textContent=""; }

    const rows = INDICATORS.map(it => {
      const cnt = (counts && typeof counts === "object" && counts[it.label] !== undefined) ? counts[it.label] : 0;
      const on  = !!settings[it.enable_key];
      const id  = "en_" + it.enable_key.replace(/[^a-z0-9_]/gi, "_");
      return `<tr>
        <td style="opacity:.95;">${it.label}</td>
        <td style="text-align:center;">${cnt}</td>
        <td style="text-align:center;">
          <input type="checkbox" id="${id}" ${on ? "checked":""}/>
        </td>
        <td style="text-align:right;opacity:.75;">${it.enable_key}</td>
      </tr>`;
    }).join("");

    scoreRows.innerHTML = rows || `<tr><td colspan="4" style="opacity:.75;">No indicators defined for this page.</td></tr>`;

    // wire toggles -> settings
    for (const it of INDICATORS){
      const id  = "en_" + it.enable_key.replace(/[^a-z0-9_]/gi, "_");
      const el = byId(id);
      if (!el) continue;
      el.onchange = () => {
        settings[it.enable_key] = !!el.checked;
        renderGate(settings);
      };
    }

    if (bucketHint){
      bucketHint.textContent = bucket ? `(${bucket.toUpperCase()})` : "";
    }
  }

  async function refreshAll(){
    const profileSel = byId("profileSel");
    const bucketSel  = byId("bucketSel");
    const saveMsg    = byId("saveMsg");
    const scoreErr   = byId("scoreErr");

    const profile = normProfile(profileSel ? profileSel.value : "day");
    const bucket  = (bucketSel ? bucketSel.value : "today").toLowerCase();

    if (saveMsg){ saveMsg.textContent = ""; }

    // Load settings
    let settings = {};
    try{
      settings = await apiLoad(GROUP, profile);
    } catch(e){
      if (saveMsg){
        saveMsg.style.color = "#ff6b6b";
        saveMsg.textContent = "Load error: " + (e && e.message ? e.message : String(e));
      }
      return;
    }

    window.currentSettings = settings;

    // Fetch scoreboard counts
    let sc = null;
    try{
      sc = await apiScoreboard(bucket);
    } catch(e){
      if (scoreErr){
        scoreErr.style.display="block";
        scoreErr.textContent = "Scoreboard error: " + (e && e.message ? e.message : String(e));
      }
    }

    renderScoreboard(settings, sc ? sc.counts : {}, bucket);
    renderGate(settings);
    renderGroups(settings);

    // hook saves
    const saveBtn = byId("saveBtn");
    if (saveBtn){
      saveBtn.onclick = async () => {
        try{
          const r = await apiSave(GROUP, profile, window.currentSettings || settings);
          if (saveMsg){
            saveMsg.style.color = "#9fffa8";
            saveMsg.textContent = "Saved.";
          }
          // reload (ensures what?s on disk is what we show)
          await refreshAll();
        } catch(e){
          if (saveMsg){
            saveMsg.style.color = "#ff6b6b";
            saveMsg.textContent = "Save error: " + (e && e.message ? e.message : String(e));
          }
        }
      };
    }
  }

  function init(){
    const profileSel = byId("profileSel");
    const bucketSel  = byId("bucketSel");
    if (profileSel) profileSel.onchange = refreshAll;
    if (bucketSel)  bucketSel.onchange  = refreshAll;
    refreshAll();
  }

  document.addEventListener("DOMContentLoaded", init);
})();
</script>
{% endblock %}
