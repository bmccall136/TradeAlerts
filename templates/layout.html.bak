{# templates/layout.html #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{% block title %}🚀 TradeAlerts 🚀{% endblock %}</title>

  <!-- 1) Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- 2) Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- 3) App CSS -->
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />

  {% block head %}{% endblock %}
</head>
<body class="black-bg text-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black py-2 position-relative">
    <div class="container-fluid">

      <!-- Left: primary nav -->
      <div class="navbar-nav">
        <a class="nav-link" href="{{ url_for('live_view') }}">Live</a>
      </div>

      <!-- Center: big title -->
      <div class="trade-alerts-title position-absolute top-50 start-50 translate-middle text-center">
        🚀 <b>TradeAlerts</b> 🚀
      </div>

      <!-- Right: actions -->
      <div class="d-flex align-items-center gap-2 ms-auto">
        <!-- Checkpoint -->
        <form action="{{ url_for('run_checkpoint') }}" method="get" class="m-0">
          <button type="submit" class="btn btn-sm btn-warning btn-fixed">✅ Checkpoint</button>
        </form>

        <!-- Reconnect API -->
        <a class="btn btn-sm btn-outline-warning btn-fixed"
           href="{{ url_for('etrade_reconnect') }}">
          🔁 Reconnect API
        </a>
      </div>

    </div>
  </nav>

  <!-- MAIN -->
  <main class="container py-4">
    {% block content %}{% endblock %}
  </main>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
