<script id="mm-regime-canonical">
(function(){
  function setDot(reg){
    var dot = document.getElementById("mm-regime-dot");
    if(!dot) return;
var r = String(reg || "UNKNOWN").toUpperCase();
    if(r === "TREND") dot.style.backgroundColor = "#4caf50";
    else if(r === "CHOP") dot.style.backgroundColor = "#ffb300";
    else if(r === "DEAD") dot.style.backgroundColor = "#f44336";
    else dot.style.backgroundColor = "#9e9e9e";
  }

  async function update(){
    try{
      const res = await fetch("/api/market_regime", {cache:"no-store"});
      if(!res.ok) throw new Error("HTTP " + res.status);
      const j = await res.json();

      var reg = (j.label || j.regime_label || j.regime || j.state || j.name || "UNKNOWN");
var conf = (j.confidence != null ? j.confidence : (j.conf != null ? j.conf : j.score));

      var confTxt = "";
      if(typeof conf === "number" && isFinite(conf)){
        confTxt = " " + Math.round(conf) + "%";
      } else if (conf != null && String(conf).trim() !== ""){
        confTxt = " " + String(conf).trim();
      }

      var nameEl = document.getElementById("mm-regime-name");
      var confEl = document.getElementById("mm-regime-conf");
      if(nameEl) nameEl.textContent = String(reg).toUpperCase();
      if(confEl) confEl.textContent = confTxt;

      setDot(reg);

      // MM_REGIME_SAMPLE_POST_V1: persist regime samples for timeline (server throttles)
      try{
        fetch('/api/market_regime_sample', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            regime: String(reg || '').toUpperCase(),
            confidence: (typeof conf === 'number' && isFinite(conf)) ? Math.round(conf) : conf,
            reason: (j.reason || j.regime_reason || j.explain || j.rationale || '')
          })
        }).catch(()=>{});
      }catch(_e){}
    }catch(e){
      var nameEl = document.getElementById("mm-regime-name");
      if(nameEl && (!nameEl.textContent || nameEl.textContent.trim()==="?")) nameEl.textContent = "UNKNOWN";
      setDot("UNKNOWN");
    }
  }

  if(window.__mmRegimeTimer) clearInterval(window.__mmRegimeTimer);
  update();
  window.__mmRegimeTimer = setInterval(update, 60000);
})();
</script>


<script>
/* MM_REGIME_STRIP_RENDERER_V4_TODAY_ONLY */
(function(){
  function colorFor(reg){
    const r = (reg||"").toUpperCase();
    if (r === "TREND") return "rgba(0, 255, 140, 0.70)";
    if (r === "CHOP")  return "rgba(255, 220, 0, 0.75)";
    if (r === "DEAD")  return "rgba(255, 70, 70, 0.65)";
    return "rgba(160,160,160,0.55)";
  }

  function host(){
    return document.querySelector("#mm-regime-strip") || document.querySelector(".mm-regime-strip-wrap");
  }

  function barEl(h){
    return (h && (h.querySelector(".mm-regime-bar") || h.querySelector(".regime-bar") || h.querySelector(".ax-regime-bar"))) || null;
  }

  function legendEl(h){
    return (h && (h.querySelector(".mm-regime-legend") || h.querySelector(".regime-legend") || h.querySelector(".ax-regime-legend"))) || null;
  }

  function compress(points){
    const out = [];
    let last = null;
    for (const p of (points||[])){
      const ts = Number(p.ts_utc || p.ts || 0);
      const reg = (p.regime || p.label || "UNKNOWN");
      const confRaw = (p.conf ?? p.regime_conf ?? p.confidence);
      const conf = Number.isFinite(Number(confRaw)) ? Number(confRaw) : 50;
      if (!ts) continue;

      if (last && last.regime === reg && last.conf === conf){
        if (ts - last.ts_utc < 120) continue; // collapse spam
      }
      const row = {ts_utc: ts, regime: reg, conf: conf};
      out.push((typeof row !== "undefined") ? row : "");
      last = row;
    }
    out.sort((a,b)=>a.ts_utc-b.ts_utc);
    return out;
  }

  function drawEmpty(bar, leg){
    if (!bar) return;
    bar.innerHTML = "";
    const seg = document.createElement("div");
    seg.style.width = "100%";
    seg.style.background = "rgba(160,160,160,0.18)";
    seg.title = "No regime samples for TODAY yet";
    bar.appendChild(seg);

    if (leg){
      // keep your colored legend but append a small status note
      if (!leg.querySelector(".mm-regime-nodata")){
        const note = document.createElement("span");
        note.className = "mm-regime-nodata";
        note.style.marginLeft = "10px";
        note.style.opacity = "0.75";
        note.style.fontSize = "12px";
        note.textContent = "? NO SAMPLES (TODAY)";
        leg.appendChild(note);
      }
    }
  }

  function clearNoDataNote(leg){
    const n = leg && leg.querySelector(".mm-regime-nodata");
    if (n) n.remove();
  }

  function draw(bar, pts, leg){
    if (!bar) return;
    bar.innerHTML = "";
    clearNoDataNote(leg);

    const minT = pts[0].ts_utc;
    const maxT = pts[pts.length-1].ts_utc;
    const span = Math.max(1, maxT - minT);

    for (let i=0; i<pts.length; i++){
      const a = pts[i];
      const nxt = pts[i+1];
      const t1 = a.ts_utc;
      const t2 = nxt ? nxt.ts_utc : (maxT + 1);
      const w = Math.max(0.004, (t2 - t1) / span);

      const seg = document.createElement("div");
      seg.style.width = (w*100).toFixed(3) + "%";
      seg.style.background = colorFor(a.regime);
      seg.title = `${String(a.regime||"UNKNOWN").toUpperCase()} ${Math.round(a.conf||0)}%`;
      bar.appendChild(seg);
    }
  }

  async function fetchToday(){
    const res = await fetch(`/api/market_regime_timeline?bucket=today`, { cache:"no-store" });
    if (!res.ok) return [];
    const j = await res.json();
    return compress(j.points || j.buckets || []);
  }

  async function render(){
    const h = host();
    const bar = barEl(h);
    const leg = legendEl(h);
    if (!h || !bar) return;

    const pts = await fetchToday();
    if (!pts.length){
      drawEmpty(bar, leg);
      return;
    }
    draw(bar, pts, leg);
  }

  render().catch(()=>{});
  setInterval(()=>render().catch(()=>{}), 30000);
})();</script>


