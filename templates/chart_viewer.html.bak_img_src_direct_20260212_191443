{% extends "layout.html" %}
{% block content %}
<div class="container py-4" style="max-width:1400px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;">
    <div>
      <div style="color:#ffe900;font-weight:800;font-size:22px;">Chart Viewer</div>
      <div style="color:#bdbdbd;font-size:12px;margin-top:4px;">
        <span style="opacity:.85;">Symbol:</span> <span style="color:#fff;font-weight:700;">{{ symbol }}</span>
        {% if ts_utc %}<span style="opacity:.6;"> ? ts:</span> <span style="opacity:.9;">{{ ts_utc }}</span>{% endif %}
      </div>
    </div>
    <div style="display:flex;gap:10px;">
      <a class="btn btn-sm btn-outline-warning" href="/trade_review">Trade Review</a>
      <a class="btn btn-sm btn-outline-warning" href="/analytics">Analytics</a>
    </div>
  </div>

  <div style="background:#0b0b0b;border:1px solid #232323;border-radius:14px;padding:10px;">
    <img
      src="/chart_img/{{ symbol }}{% if ts_utc %}?ts={{ ts_utc }}{% endif %}"
      alt="chart {{ symbol }}"
      style="width:100%;height:auto;display:block;border-radius:10px;"
    />
  </div>
</div>
{% endblock %}
