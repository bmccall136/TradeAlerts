{# MM_ANALYTICS_TAPE_PARTIAL_V2 #}
<div id="mm-ax-tape-wrap" style="margin:0 0 10px 0;direction:ltr;unicode-bidi:isolate;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
    <div id="mm-ax-tape-status" style="font-size:12px;opacity:.75;">loading?</div>
  </div>

  <div style="height:10px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden;direction:ltr;unicode-bidi:isolate;">
    <div id="mm-ax-tape-bar" style="height:10px;width:0%;background:transparent;transform-origin:left center;direction:ltr;unicode-bidi:isolate;background-position:left top;background-repeat:no-repeat;"></div>
  </div>

  <div id="mm-ax-tape-scale"
       style="display:flex;justify-content:space-between;font-size:11px;opacity:.6;margin-top:4px;">
    <span>9:30</span><span>10:30</span><span>12</span><span>2</span><span>4</span>
  </div>
</div>

<script>
(function(){
  const wrap = document.getElementById('mm-ax-tape-wrap');
  const bar  = document.getElementById('mm-ax-tape-bar');
  const st   = document.getElementById('mm-ax-tape-status');
  if(!bar || !st) return;

  // MM_TAPE_GLOBAL_STAMP_V1
  try {
    window.MM_TAPE_LTR_SORT_V1 = 1;
    document.documentElement.setAttribute('data-mm-tape', 'MM_TAPE_LTR_SORT_V1');
    if (!window.__mmTapeStampLogged) {
      window.__mmTapeStampLogged = true;
      console.log('MM_TAPE_LTR_SORT_V1 stamp: OK');
    }
  } catch (e) {}

  if(window.__mmTapeRunning) return;
  window.__mmTapeRunning = true;

  // Force LTR at container level too
  try {
    if (wrap) {
      wrap.style.direction = 'ltr';
      wrap.style.unicodeBidi = 'isolate';
    }
    bar.style.direction = 'ltr';
    bar.style.unicodeBidi = 'isolate';
    bar.style.transformOrigin = 'left center';
  } catch(e) {}

  function setStatus(s){ st.textContent = s; }

  // 9:30–16:00 = 390 minutes; 5m cadence ~= 78 points
  const EXPECTED_PTS = 78;

  function color(reg){
    const r = String(reg || 'UNKNOWN').toUpperCase();
    if (r === 'TREND') return 'rgba(0, 210, 255, 0.95)';
    if (r === 'CHOP')  return 'rgba(255, 215, 0, 0.95)';
    if (r === 'DEAD')  return 'rgba(180, 180, 180, 0.85)';
    return 'rgba(255,255,255,0.08)'; // UNKNOWN
  }

  function normalizeList(j){
    const raw = (j && (j.points || j.buckets)) || [];
    const arr = (Array.isArray(raw) ? raw.slice() : []).filter(p => p && typeof p === 'object');
    // MM_TAPE_SORT_ASC_V1
    arr.sort((a,b)=> (Number(a.ts_utc||0) - Number(b.ts_utc||0)));
    return arr;
  }

  function renderSegments(arr){
    bar.innerHTML = '';
    bar.style.width = '100%';
    bar.style.display = 'flex';
    bar.style.flexDirection = 'row';
    bar.style.alignItems = 'stretch';
    bar.style.background = 'transparent';

    const n = arr.length;
    for (let i=0; i<n; i++){
      const seg = document.createElement('div');
      seg.style.height = '10px';
      seg.style.flex = '1 1 0';
      seg.style.background = color(arr[i].regime);
      bar.appendChild(seg);
    }
    const pct = Math.min(100, Math.round((n / EXPECTED_PTS) * 100));
    setStatus('progress: ' + pct + '% (' + n + ' pts)');
  }

  async function load(){
    try{
      setStatus('loading?');
      const r = await fetch('/api/market_regime_timeline?bucket=today', { cache:'no-store' });
      if(!r.ok){
        const t = await r.text();
        setStatus('tape error: ' + r.status);
        console.warn('tape bad response', r.status, t);
        return;
      }
      const j = await r.json();
      const arr = normalizeList(j);
      if(!arr.length){
        // empty tape
        bar.innerHTML = '';
        bar.style.width = '0%';
        bar.style.background = 'transparent';
        setStatus('NO SAMPLES (TODAY)');
        return;
      }
      renderSegments(arr);
    }catch(e){
      console.warn('tape exception', e);
      setStatus('tape error');
    }
  }

  load();
  setInterval(load, 30000);
})();
</script>
