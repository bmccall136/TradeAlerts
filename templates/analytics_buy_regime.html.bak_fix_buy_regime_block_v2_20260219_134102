{% extends "analytics_regime_layout.html" %}
{% block analytics_tape %}
  {% include "_analytics_tape.html" %}
{% endblock %}
{% set mm_page_title = "Buy Regime" %}
{% set mm_page_subtitle = "By market regime (entries)" %}
{% block content %}
<div id="mm-buy-regime-root" class="mm-ax-container">

  <div class="mm-ax-card">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div style="font-size:14px;font-weight:700;">Entry distribution by regime</div>
      <div style="font-size:12px;opacity:.75;" id="mm-br-meta">Loading…</div>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-dark align-middle mb-0" style="border-radius:10px;overflow:hidden;">
        <thead>
          <tr style="opacity:.85;">
            <th style="width:140px;">Regime</th>
            <th style="width:90px;">Count</th>
            <th style="width:140px;">Avg conf</th>
          </tr>
        </thead>
        <tbody id="mm-br-by-regime">
          <tr><td colspan="3" style="opacity:.75;">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mm-ax-card mt-3">
    <div style="font-size:14px;font-weight:700;" class="mb-2">Notes</div>
    <div style="font-size:12px;opacity:.8;line-height:1.35;">
      This page summarizes BUY-side activity by regime using LIVE_DB as the source of truth.
      It?s intended to help tune entry behavior per regime (TREND/CHOP/DEAD).
    </div>
  </div>

</div>

<script>
(function(){
  const root = document.getElementById("mm-buy-regime-root");
  if(!root) return;

  const params = new URLSearchParams(window.location.search);
  const bucket = (params.get("bucket") || "today").toLowerCase();

  const meta = document.getElementById("mm-br-meta");
  const body = document.getElementById("mm-br-by-regime");

  function esc(s){ return String(s ?? "").replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
  function pct(x){
    if(x === null || x === undefined || x === "") return "?";
    const n = Number(x);
    if(!isFinite(n)) return "?";
    return Math.round(n) + "%";
  }

  async function load(){
    meta.textContent = `bucket=${bucket}`;
    body.innerHTML = `<tr><td colspan="3" style="opacity:.75;">Loading…</td></tr>`;

    let res, txt;
    try{
      res = await fetch(`/api/analytics/buy_regime?bucket=${encodeURIComponent(bucket)}`, {cache:"no-store"});
      txt = await res.text();
    }catch(e){
      body.innerHTML = `<tr><td colspan="3" style="color:#ff6b6b;">Fetch failed: ${esc(e)}</td></tr>`;
      return;
    }

    let j;
    try{
      j = JSON.parse(txt);
    }catch(e){
      body.innerHTML = `<tr><td colspan="3" style="color:#ff6b6b;">Non-JSON response (${res.status}).</td></tr>`;
      return;
    }

    const rows = (j.by_regime || []);
    if(!rows.length){
      body.innerHTML = `<tr><td colspan="3" style="opacity:.75;">No rows for this bucket.</td></tr>`;
      return;
    }

    body.innerHTML = rows.map(r => {
      const regime = esc(r.regime || "UNKNOWN");
      const ct = esc(r.count ?? 0);
      const conf = pct(r.avg_conf ?? r.conf ?? null);
      return `<tr>
        <td style="font-weight:700;">${regime}</td>
        <td>${ct}</td>
        <td>${conf}</td>
      </tr>`;
    }).join("");
  }

  load();
})();
</script>
{% endblock %}