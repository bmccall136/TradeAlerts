<!-- MM_SELL_ANALYTICS_CENTER_CARDS_V1_END -->
{% block content %}

<style>
  /* MM_SELL_ANALYTICS_FINAL_V1 */

  .mm-err{
    display:none;
    margin:10px 14px;
    padding:10px 12px;
    border-radius:10px;
    border:1px solid rgba(255,80,80,.35);
    background: rgba(255,80,80,.10);
    color:#ffb3b3;
    white-space:pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size:12px;
  }

  .mm-card{
    margin:14px 14px;
    padding:14px 14px;
    border-radius:14px;
    background: rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.08);
  }
  .mm-card h3{ margin:0 0 10px 0; font-size:16px; }
  .mm-row{ display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; }
  .mm-mini{
    min-width:280px;
    padding:10px 12px;border-radius:12px;
    background: rgba(0,0,0,.22);
    border:1px solid rgba(255,255,255,.08);
  }

  table.mm-t{ width:100%; border-collapse:collapse; }
  table.mm-t td{ padding:6px 4px; border-bottom:1px solid rgba(255,255,255,.06); font-size:13px; }
  table.mm-t td.k{ opacity:.85; }
  table.mm-t td.v{ text-align:right; font-weight:800; }

  /* force small select to behave in dark theme */
  #mm-sell-bucket.form-select.form-select-sm{
    background-color: rgba(0,0,0,.15) !important;
    color: #e8e8e8 !important;
    border-color: rgba(255,255,255,.20) !important;
    max-width: 260px;
  }

  .ax-date-wrap { display:flex; align-items:center; gap:8px; flex-wrap:nowrap; }
  .ax-date-input {
    background: transparent;
    border: 1px solid #6c757d;
    color: #e8e8e8;
    border-radius: 6px;
    padding: 4px 8px;
    height: 31px; /* btn-sm height */
  }
  .ax-date-input:focus { outline: none; box-shadow: none; border-color: #8b94a3; }
</style>

<div class="mm-ax-container" style="padding-top:0;">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-2">
      <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
      <div>
        <div class="h4 mb-0">Sell Analytics</div>
        <div class="text-secondary small" id="mm-sell-sub">Today</div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a class="btn btn-sm btn-outline-info" href="/analytics">Daily</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/buy_regime">Buy Regime</a>
      <a class="btn btn-sm btn-outline-info" href="/analytics/sell_regime">Sell Regime</a>

      <div class="ax-date-wrap ms-2">
        <a class="btn btn-sm btn-outline-warning" id="ax-yesterday" href="#">Yesterday</a>
        <input type="date" class="ax-date-input" id="ax-datepick" value="{{ request.args.get('date','') }}" aria-label="Select date"/>
        <a class="btn btn-sm btn-outline-warning" id="ax-datego" href="#">Go</a>
      </div>

      <a class="btn btn-sm btn-outline-secondary" id="ax-live" href="/analytics/sell">Live</a>
    </div>
  </div>

  <div class="text-secondary small" style="margin-top:2px;opacity:.82;">
    This page focuses on exit reasons, execution outcomes, and time-in-position. (Counts stay off the SELL Settings page.)
  </div>

  <div class="d-flex align-items-center gap-2 flex-wrap" style="margin-top:10px;">
    <div class="fw-bold" style="opacity:.8; min-width:70px;">Bucket</div>
    <select id="mm-sell-bucket" class="form-select form-select-sm">
      <option value="today">TODAY</option>
      <option value="7d">7D</option>
      <option value="30d">30D</option>
      <option value="all">ALL</option>
    </select>
  </div>
</div>

<div id="mm-sell-err" class="mm-err"></div>

<div class="mm-card">
  <h3>Exit reason breakdown</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="text-secondary small" id="mm-exit-loading">Loading?</div>
      <div id="mm-exit-box"></div>
    </div>
    <div class="text-secondary small" style="padding-top:6px;">
      Reason counts come from <span style="color:#ff66cc;font-family:monospace;">sell_events</span> where <span style="color:#ff66cc;font-family:monospace;">event=FILLED</span>.
    </div>
  </div>
</div>

<div class="mm-card">
  <h3>Execution outcomes</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="text-secondary small" id="mm-outcome-loading">Loading?</div>
      <div id="mm-outcome-box"></div>
    </div>
    <div class="text-secondary small" style="padding-top:6px;">
      Outcomes come from all <span style="color:#ff66cc;font-family:monospace;">sell_events</span> rows in the bucket.
    </div>
  </div>
</div>

<div class="mm-card">
  <h3>Hold-time buckets</h3>
  <div class="mm-row">
    <div class="mm-mini">
      <div class="text-secondary small" id="mm-hold-loading">Loading?</div>
      <div id="mm-hold-box"></div>
    </div>
    <div class="text-secondary small" style="padding-top:6px;">
      Hold time is computed from open?close timestamps when available. Missing data shows as empty bucket.
    </div>
  </div>
</div>

<script>
(function(){
  function pad2(n){ return String(n).padStart(2,'0'); }
  function fmtDate(d){ return d.getFullYear()+"-"+pad2(d.getMonth()+1)+"-"+pad2(d.getDate()); }
  function setUrlDate(dateStr){
    if(!dateStr) return;
    const u = new URL(window.location.href);
    u.searchParams.set("date", dateStr);
    window.location.href = u.toString();
  }

  const yBtn = document.getElementById("ax-yesterday");
  const pick = document.getElementById("ax-datepick");
  const go   = document.getElementById("ax-datego");

  if(yBtn){
    const yd = new Date();
    yd.setDate(yd.getDate()-1);
    const u = new URL(window.location.href);
    u.searchParams.set("date", fmtDate(yd));
    yBtn.href = u.toString();
  }
  if(go){
    go.addEventListener("click", function(e){
      e.preventDefault();
      setUrlDate(pick ? pick.value : "");
    });
  }
  if(pick){
    pick.addEventListener("keydown", function(e){
      if(e.key === "Enter") setUrlDate(pick.value);
    });
  }

  // live button accent when NOT on today
  const liveBtn = document.getElementById("ax-live");
  if(liveBtn){
    const u = new URL(window.location.href);
    const cur = (u.searchParams.get("date") || "").trim();
    const now = new Date();
    const today = now.getFullYear()+"-"+pad2(now.getMonth()+1)+"-"+pad2(now.getDate());
    const onToday = (!cur) || (cur === today);
    liveBtn.classList.remove("btn-outline-secondary","btn-outline-warning");
    liveBtn.classList.add(onToday ? "btn-outline-secondary" : "btn-outline-warning");
  }
})();
</script>

<script src="/static/js/analytics_sell.js"></script>

</div>
{% endblock %}
