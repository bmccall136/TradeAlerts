{% extends "layout.html" %}
{% block analytics_tape %}
<div id="mm-ax-tape-wrap" style="margin:10px 14px 18px 14px;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
    <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
  </div>
  <div style="position:relative;">
    <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>
    <div id="mm-ax-tape" style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.04);"></div>
    <div id="mm-ax-ticklines" style="position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;"></div>
  </div>
</div>

<!-- MM_AX_TAPE_RENDERER_V1_START -->
<script>
(function(){
  const tape = document.getElementById("mm-ax-tape");
  const meta = document.getElementById("mm-ax-tape-meta");
  if(!tape) return;

  function colorFor(r){
    r = String(r||"").toUpperCase();
    if(r.indexOf("TREND")>=0) return "#18c964";
    if(r.indexOf("CHOP")>=0)  return "#ffcc00";
    if(r.indexOf("DEAD")>=0)  return "#666666";
    return "#444444";
  }
  function clear(el){ while(el && el.firstChild) el.removeChild(el.firstChild); }

  function compress(points){
    const out=[];
    let last=null;
    for(const p of (points||[])){
      const ts = Number((p && (p.ts_utc || p.ts)) || 0);
      const reg = (p && (p.regime || p.label || p.state || p.name)) || "UNKNOWN";
      const confRaw = (p && (p.conf ?? p.confidence ?? p.avg_conf));
      const conf = Number.isFinite(Number(confRaw)) ? Number(confRaw) : null;
      if(!ts) continue;

      const row = {ts_utc:ts, regime:String(reg), conf:conf};
      if(last && last.regime===row.regime && last.conf===row.conf && (row.ts_utc-last.ts_utc)<120) continue;
      out.push(row); last=row;
    }
    out.sort((a,b)=>a.ts_utc-b.ts_utc);
    return out;
  }

  function downsample(points, maxSeg){
    if(!points || !points.length) return [];
    if(points.length<=maxSeg) return points;
    const step = points.length / maxSeg;
    const out=[];
    for(let i=0;i<maxSeg;i++) out.push(points[Math.floor(i*step)]);
    return out;
  }

  function paint(points){
    clear(tape);
    tape.style.display="flex";
    tape.style.gap="0";
    tape.style.alignItems="stretch";

    if(!points || !points.length){
      if(meta) meta.textContent="No regime points";
      tape.style.background="rgba(255,255,255,.04)";
      tape.style.border="1px solid rgba(255,255,255,.10)";
      return;
    }

    const segs = downsample(points, 240);
    for(const p of segs){
      const seg=document.createElement("div");
      seg.style.flex="1 1 0";
      seg.style.background=colorFor(p.regime);
      tape.appendChild(seg);
    }

    const last = points[points.length-1];
    const rr = (last && last.regime) ? String(last.regime).toUpperCase() : "?";
    const cc = (last && last.conf!=null) ? (String(Math.round(last.conf))+"%") : "";
    if(meta) meta.textContent = "pts=" + points.length + " last=" + rr + (cc?(" "+cc):"");
  }

  fetch("/api/market_regime_timeline?bucket=today", {cache:"no-store"})
    .then(async (r) => {
      const txt = await r.text();
      if(!r.ok) return {_err:r.status, _body: txt.slice(0, 600)};
      try{ return JSON.parse(txt); }
      catch(e){ return {_err:"json", _body: txt.slice(0, 600)}; }
    })
    .then(j => {
      if(!j || j._err){
        if(meta) meta.textContent = "Tape error: " + String(j && j._err) + (j && j._body ? (" :: " + j._body) : "");
        return;
      }
      const srcArr = (j.points && j.points.length) ? j.points
                   : ((j.buckets && j.buckets.length) ? j.buckets
                   : (j.pts || []));
      const pts = compress(srcArr);
      paint(pts);
    })
    .catch((e)=>{
      if(meta) meta.textContent="Tape error: " + (e && e.message ? e.message : "exception");
    });
})();
</script>
<!-- MM_AX_TAPE_RENDERER_V1_END -->
{% endblock %}


<!-- MM_SELL_TAPE_HYDRATOR_V1_START -->
<style>
/* SELL-only: make the tape visibly present even before JS paints */
#mm-ax-tape {
  min-height: 14px;
  border: 1px solid rgba(255,255,255,.14) !important;
  background: rgba(255,255,255,.05) !important;
}
</style>

<script>
(function () {
  const tape = document.getElementById("mm-ax-tape");
  const meta = document.getElementById("mm-ax-tape-meta");
  const ticks = document.getElementById("mm-ax-ticks");
  const lines = document.getElementById("mm-ax-ticklines");
  if (!tape) return;

  function colorFor(r) {
    r = (r || "").toUpperCase();
    if (r.includes("TREND")) return "#18c964";
    if (r.includes("CHOP"))  return "#ffcc00";
    if (r.includes("DEAD"))  return "#666666";
    return "#444444";
  }
  function clear(el) { while (el && el.firstChild) el.removeChild(el.firstChild); }

  function downsample(points, maxSeg) {
    if (!points || !points.length) return [];
    if (points.length <= maxSeg) return points;
    const step = points.length / maxSeg;
    const out = [];
    for (let i = 0; i < maxSeg; i++) {
      out.push(points[Math.floor(i * step)]);
    }
    return out;
  }

  function paint(points) {
    clear(tape); clear(ticks); clear(lines);
    tape.style.display = "flex";
    tape.style.gap = "0";
    tape.style.alignItems = "stretch";

    if (!points || !points.length) {
      if (meta) meta.textContent = "No regime points";
      return;
    }

    // Make it visible: cap segments so each has real width
    const segs = downsample(points, 240);

    for (const p of segs) {
      const seg = document.createElement("div");
      seg.style.flex = "1 1 0";
      seg.style.background = colorFor(p.regime);
      tape.appendChild(seg);
    }

    if (meta) {
      const last = points[points.length - 1];
      const rr = (last && last.regime) || "?";
      const conf = (last && last.conf);
      meta.textContent = (conf != null) ? ("Regime: " + rr + "  " + String(conf) + "%") : ("Regime: " + rr);
    }
  }

  fetch("/api/market_regime_timeline?bucket=today", { cache: "no-store" })
    .then(res => res.ok ? res.json() : res.text().then(t => ({ _err: res.status, _body: t })))
    .then(j => {
      if (!j || j._err) { if (meta) meta.textContent = "Tape error"; return; }
      const pts = j.buckets || j.points || j.pts || [];
      paint(Array.isArray(pts) ? pts : []);
    })
    .catch(() => { if (meta) meta.textContent = "Tape error"; });
})();
</script>
<!-- MM_SELL_TAPE_HYDRATOR_V1_END -->
<!-- MM_SELL_ANALYTICS_CENTER_CARDS_V1_START -->
<style>
