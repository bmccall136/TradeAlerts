<#  Start-Dashboard.ps1
    Starts the TradeAlerts Flask dashboard reliably from Task Scheduler or a console.
    - Detects & prefers a local venv at .\venv\Scripts\python.exe
    - Falls back to py/python on PATH
    - Logs stdout/stderr to .\logs\dashboard-YYYYMMDD_HHMMSS.log
    - Detaches from the Task Scheduler task so the site keeps running
#>

# --- Safety & setup ---
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)

# Work from this script's folder (C:\TradeAlerts)
Set-Location -Path $PSScriptRoot

# Optional: set a port (dashboard.py uses $env:PORT or 5000)
# $env:PORT = '5000'

# --- Pick a Python ---
$pythonCandidates = @(
  Join-Path $PSScriptRoot 'venv\Scripts\python.exe'), # project venv
  'py',                                               # launcher (pref on Windows)
  'python'                                            # plain python on PATH
) | Where-Object { $_ }  # drop empties

$python = $null
foreach ($cand in $pythonCandidates) {
    if ($cand -eq 'py') {
        # Quick probe: does `py -3 -V` succeed?
        $proc = Start-Process -FilePath 'py' -ArgumentList '-3','-V' -NoNewWindow -PassThru -Wait -ErrorAction SilentlyContinue
        if ($proc -and $proc.ExitCode -eq 0) { $python = 'py -3'; break }
    } elseif ($cand -eq 'python') {
        $proc = Start-Process -FilePath 'python' -ArgumentList '--version' -NoNewWindow -PassThru -Wait -ErrorAction SilentlyContinue
        if ($proc -and $proc.ExitCode -eq 0) { $python = 'python'; break }
    } else {
        if (Test-Path $cand) { $python = ('"{0}"' -f $cand); break }
    }
}
if (-not $python) { throw "Could not find Python. Install it or add to PATH, or create .\venv first." }

# --- Logs ---
$logsDir = Join-Path $PSScriptRoot 'logs'
if (-not (Test-Path $logsDir)) { New-Item -ItemType Directory -Path $logsDir | Out-Null }
$stamp   = Get-Date -Format 'yyyyMMdd_HHmmss'
$logFile = Join-Path $logsDir "dashboard-$stamp.log"

# --- Command ---
# Use -u for unbuffered output so logs flush immediately (py/python only; venv exe supports it too)
$dashboardPy = Join-Path $PSScriptRoot 'dashboard.py'
if (-not (Test-Path $dashboardPy)) { throw "dashboard.py not found at $dashboardPy" }

# If using the py launcher, it’s already "py -3"; otherwise it's a path/exe.
# Build a full argument string accordingly.
if ($python.StartsWith('py ')) {
    $exe  = 'py'
    $args = "-3 -u `"$dashboardPy`""
} else {
    # Strip surrounding quotes if present when we split exe/args
    $exe, $maybeArgs = if ($python.StartsWith('"')) { $python.Trim('"'), '' } else { $python, '' }
    $args = "$maybeArgs -u `"$dashboardPy`""
}

# --- Start detached so the Task doesn’t “own” the process ---
# Redirect output to the log file
$startInfo = @{
    FilePath     = $exe
    ArgumentList = $args
    WorkingDirectory = $PSScriptRoot
    RedirectStandardOutput = $logFile
    RedirectStandardError  = $logFile
    UseNewWindow   = $true      # pop its own window if you double-click; in scheduler it runs headless
    WindowStyle    = 'Hidden'   # scheduler won’t show a window anyway
    PassThru       = $true
}
$proc = Start-Process @startInfo

"[$(Get-Date -Format o)] Started dashboard (PID $($proc.Id)) using: $exe $args" | Add-Content $logFile
"[$(Get-Date -Format o)] Logs: $logFile"                                           | Add-Content $logFile
