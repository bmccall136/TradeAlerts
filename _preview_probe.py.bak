# _preview_probe.py
import json, sys, traceback
from datetime import datetime, time as dtime

# Use your project modules
from services import etrade_service as et  # <-- your existing wrapper

SYMBOL   = "HPQ"
QTY      = 1
SIDE     = "BUY"

def now_session() -> str:
    t = datetime.now().time()
    return "REGULAR" if dtime(9,30) <= t <= dtime(16,0) else "EXTENDED"

def glimpse(obj, n=1200):
    try:
        return json.dumps(obj, indent=2)[:n]
    except Exception:
        return str(obj)[:n]

def extract_preview_id(resp: dict):
    paths = [
        lambda r: (r.get("PreviewIds") or [None])[0],
        lambda r: (r.get("previewIds") or [None])[0],
        lambda r: (r.get("Order") or {}).get("previewIds", [None])[0],
        lambda r: (r.get("order") or [{}])[0].get("previewId"),
        lambda r: (r.get("Order") or [{}])[0].get("PreviewIds", [None])[0],
    ]
    for fn in paths:
        try:
            pid = fn(resp)
            if pid:
                return str(pid)
        except Exception:
            pass
    return None

def main():
    print("=== Preview probe starting ===")
    # Try to get account identifiers if your wrapper exposes them
    acct_key = None
    acct_num = None
    try:
        acct = et.get_primary_account()
        acct_key = acct.get("accountIdKey")
        acct_num = acct.get("accountId")
        print(f"[acct] key={acct_key} num={acct_num}")
    except Exception as e:
        print(f"[acct] could not resolve primary account: {e}")

    req = dict(
        symbol=SYMBOL,
        quantity=int(QTY),
        side=SIDE,
        price=None,                  # MARKET
        order_type="MARKET",
        time_in_force="DAY",
        market_session=now_session()
    )

    # Attempt 1: account key path if available
    resp = None
    try:
        if acct_key:
            resp = et.preview_equity_order(account_key=acct_key, **req)
            print("\n--- RAW PREVIEW (key) ---")
            print(glimpse(resp))
    except Exception:
        print("\n[warn] key-path preview threw:")
        traceback.print_exc()

    pid = extract_preview_id(resp or {}) if resp else None

    # Attempt 2: numeric account id
    if not pid and acct_num:
        try:
            resp2 = et.preview_equity_order(account_id=acct_num, **req)
            print("\n--- RAW PREVIEW (numeric) ---")
            print(glimpse(resp2))
            resp = resp2
            pid = extract_preview_id(resp2 or {})
        except Exception:
            print("\n[warn] numeric-path preview threw:")
            traceback.print_exc()

    # Report findings
    msgs = (resp or {}).get("messages") or (resp or {}).get("Messages") or []
    print("\n=== RESULT ===")
    print(f"previewId: {pid}")
    if msgs:
        print("messages:", glimpse(msgs, 2000))

    # Helpful exit code
    sys.exit(0 if pid else 2)

if __name__ == "__main__":
    main()
