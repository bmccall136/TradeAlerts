# --- SAFE settings loader ---
def _load_settings_safe():
    try:
        from services.simulation_service import load_simulation_settings
        return load_simulation_settings()
    except Exception:
        from types import SimpleNamespace
        return SimpleNamespace(
            max_per_trade=0.0,
            single_entry_only=False,
            use_trailing_stop=False,
            trailing_stop_pct=0.0,
            sell_after_days=None
        )
# --- PDT helpers (finish + wire) ------------------------------------
PDT_MIN_EQUITY = 25_000.0

def enforce_pdt_on_sell(
    symbol: str,
    qty: int,
    now: datetime | None = None,
    account_type: str = "MARGIN",
    hard_block_on_cash: bool = False,
) -> tuple[bool, str | None]:
    """
    Returns (ok, reason). Block a SELL that would create a 4th (or more) day trade
    in a rolling 5 business-day window when equity < $25k on margin.
    For CASH accounts we allow it unless `hard_block_on_cash=True`.
    """
    # CASH accounts aren’t subject to PDT unless you choose to hard-block.
    if account_type.upper() == "CASH" and not hard_block_on_cash:
        return True, None

    eq = _compute_equity()
    if eq >= PDT_MIN_EQUITY:
        return True, None  # Above $25k, PDT doesn’t apply

    # Count completed day trades in the last ~5 biz days (7 calendar days window)
    count_last5 = _count_day_trades_last5(now)
    would_be_dt = _sell_would_be_day_trade(symbol, qty, now)

    # Block only if this SELL would be the 4th+ day trade
    if would_be_dt and count_last5 >= 3:
        return False, (f"PDT block: equity ${eq:.2f}, rolling day-trades={count_last5}, "
                       f"this SELL would create another day trade.")
    return True, None

def _trail_update_and_hit(symbol: str, current: float, pct: float) -> bool:
    if not (current and pct and pct > 0):
        return False

    conn = _connect()
    cur  = conn.cursor()
    cur.execute("SELECT peak FROM trail_state WHERE symbol=?;", (symbol,))
    row = cur.fetchone()
    if row:
        peak = max(float(row[0] or 0.0), float(current))
        cur.execute("UPDATE trail_state SET peak=? WHERE symbol=?;", (peak, symbol))
    else:
        peak = float(current)
        cur.execute(
            "INSERT OR REPLACE INTO trail_state(symbol, peak, since) VALUES (?,?,?);",
            (symbol, peak, datetime.now(timezone.utc).isoformat())
        )
    conn.commit()
    conn.close()

    stop_level = peak * (1 - float(pct) / 100.0)
    return current <= stop_level

# --- PDT helpers -------------------------------------------------------
from datetime import datetime, timedelta, timezone
import math

from datetime import datetime, timezone

def _as_dt_utc(ts):
    if ts is None:
        return None
    if isinstance(ts, datetime):
        return ts if ts.tzinfo else ts.replace(tzinfo=timezone.utc)
    # string → dt
    try:
        dt = datetime.fromisoformat(str(ts))
        return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
    except Exception:
        return None

PDT_MIN_EQUITY = 25_000.0

def _to_et(dt: datetime) -> datetime:
    # Ensure timezone-aware and convert to ET
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(ET)

def _et_day(dt: datetime):
    return _to_et(dt).date()

def _window_7_calendar_days(now_et=None):
    """Approx 5 business days => last 7 calendar days window in ET."""
    now_et = _to_et(datetime.now(timezone.utc)) if now_et is None else _to_et(now_et)
    start = now_et - timedelta(days=7)
    # inclusive window [start, now]
    return start, now_et

def _fetch_trades_in_window(start_et: datetime, end_et: datetime):
    """Return raw rows for trades whose ET timestamps fall in [start_et, end_et]."""
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("""
        SELECT trade_time, symbol, action, qty, price
        FROM simulation_trades
        ORDER BY trade_time ASC
    """)
    rows = cur.fetchall()
    conn.close()

    kept = []
    for trade_time, symbol, action, qty, price in rows:
        try:
            ts = datetime.fromisoformat(str(trade_time))
        except Exception:
            continue
        ts_et = _to_et(ts)
        if start_et <= ts_et <= end_et:
            kept.append((ts_et, symbol, (action or "").upper(), int(qty or 0), float(price or 0.0)))
    return kept

def _count_day_trades_last5(now: datetime = None) -> int:
    """
    Count day trades in the last ~5 business days (7 calendar days).
    A 'day trade' is any SELL that closes shares opened (BUY) the same ET day.
    Multiple closing sells in a day count as multiple day trades (common broker behavior).
    """
    start_et, end_et = _window_7_calendar_days(now)
    rows = _fetch_trades_in_window(start_et, end_et)

    # group by (day, symbol), process in time order
    from collections import defaultdict
    grouped = defaultdict(list)
    for ts_et, sym, side, qty, _ in rows:
        grouped[(_et_day(ts_et), sym)].append((ts_et, side, qty))

    total_day_trades = 0

    for (_, _sym), events in grouped.items():
        events.sort(key=lambda x: x[0])
        opened_today = 0  # shares bought today that are not yet closed
        # We only track long-side day trades here (BUY then SELL same day)
        for _ts, side, qty in events:
            if side == "BUY":
                opened_today += max(0, qty)
            elif side == "SELL":
                # How many of this sell are closing shares opened today?
                matched = min(max(0, qty), max(0, opened_today))
                if matched > 0:
                    total_day_trades += 1  # count per closing transaction
                    opened_today -= matched
            # (Short day-trading not modeled here; add if you simulate shorts.)
    return total_day_trades

def _sell_would_be_day_trade(symbol: str, sell_qty: int, now: datetime = None) -> bool:
    """
    Determine if this SELL closes any shares that were BOUGHT today (ET),
    which makes it a day trade.
    """
    now_et = _to_et(datetime.now(timezone.utc) if now is None else now)
    # Pull today's trades for this symbol
    start_et = datetime.combine(now_et.date(), datetime.min.time(), tzinfo=now_et.tzinfo)
    end_et   = datetime.combine(now_et.date(), datetime.max.time(), tzinfo=now_et.tzinfo)
    rows = _fetch_trades_in_window(start_et, end_et)
    # Filter this symbol
    events = [(ts, side, qty) for ts, sym, side, qty, _ in rows if sym == symbol]
    events.sort(key=lambda x: x[0])

    opened_today = 0
    for _ts, side, qty in events:
        if side == "BUY":
            opened_today += max(0, qty)
        elif side == "SELL":
            # Close against same-day opens
            matched = min(max(0, qty), max(0, opened_today))
            opened_today -= matched

    # This SELL will close up to 'min(sell_qty, opened_today_remaining)'
    return min(max(0, sell_qty), max(0, opened_today)) > 0

def _compute_equity() -> float:
    """
    Equity = cash + sum(last_price * qty). Uses holdings.last_price.
    """
    eq = float(get_cash() or 0.0)
    for sym, qty, _avg, last in get_holdings():
        try:
            eq += float(last or 0.0) * int(qty or 0)
        except Exception:
            pass
    return round(eq, 2)

