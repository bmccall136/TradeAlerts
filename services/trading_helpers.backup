# --- OPTIONAL: simple wash-sale window (loss SELL within last 30 days) ---
def _recent_loss_sell(symbol: str, days: int = 30):
    conn = _connect()
    cur = conn.cursor()
    cur.execute("""
        SELECT trade_time, COALESCE(pnl, 0.0)
        FROM simulation_trades
        WHERE symbol = ? AND action = 'SELL'
        ORDER BY trade_time DESC
        LIMIT 50;
    """, (symbol,))
    rows = cur.fetchall()
    conn.close()

    now = datetime.now(timezone.utc)
    for ts, pnl in rows:
        try:
            dt = datetime.fromisoformat(str(ts))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
        except Exception:
            continue
        if float(pnl or 0.0) < 0.0 and now <= dt + timedelta(days=days):
            return dt
    return None

# --- Hard pre-buy risk checks (call inside buy_stock) ---
def _pre_buy_risk_checks(symbol: str, qty: int, price: float):
    settings = _load_settings_safe()

    # single-entry-only
    if getattr(settings, "single_entry_only", False) and get_position_qty(symbol) > 0:
        raise RuntimeError(f"[RISK] Already holding {symbol} (single_entry_only).")

    # max-per-trade (hard)
    max_per = float(getattr(settings, "max_per_trade", 0.0) or 0.0)
    if max_per > 0 and qty * price > max_per:
        raise RuntimeError(f"[RISK] Order ${qty*price:.2f} exceeds max_per_trade ${max_per:.2f}.")

    # optional wash-sale block (comment out to only warn)
    ws_dt = _recent_loss_sell(symbol, days=30)
    if ws_dt:
        until = (ws_dt + timedelta(days=30)).astimezone(ET)
        raise RuntimeError(f"[RISK] Wash-sale window active until {until:%Y-%m-%d}.")

# Track per-symbol peak seen since entry (resets when position closes)
TRAIL_PEAKS: dict[str, float] = {}

# --- N+2 / settlement helpers ---------------------------------
def _t_plus_n_close(ts, n=2):
    """
    Return the market close timestamp (UTC) of T+n trading days after ts.
    Uses the NYSE calendar already initialized in this module.
    """
    ts_et = _as_utc(ts).astimezone(ET)

    # cover enough days to find T+n even across holidays
    sched = nyse.schedule(
        start_date=(ts_et.date() - timedelta(days=1)),
        end_date=(ts_et.date() + timedelta(days=15)),
    )

    # find the session containing or immediately after ts
    session_idx = None
    for i, (_, row) in enumerate(sched.iterrows()):
        open_et  = row["market_open"].tz_convert(ET)
        close_et = row["market_close"].tz_convert(ET)
        if open_et <= ts_et <= close_et:
            session_idx = i
            break
        if ts_et < open_et and session_idx is None:
            session_idx = i
            break
    if session_idx is None:
        session_idx = 0

    tplus_idx = min(session_idx + int(n), len(sched) - 1)
    settle_close_et = sched.iloc[tplus_idx]["market_close"].tz_convert(ET)
    return settle_close_et.astimezone(timezone.utc)


def enforce_n_plus_2(symbol: str, now=None):
    """
    Block a BUY if the last SELL for this symbol hasn't reached T+2 close.
    Returns (ok: bool, reason: str).
    """
    conn = _connect()
    cur  = conn.cursor()
    cur.execute(
        "SELECT trade_time FROM simulation_trades "
        "WHERE symbol=? AND action='SELL' "
        "ORDER BY trade_time DESC LIMIT 1;",
        (symbol,)
    )
    row = cur.fetchone()
    conn.close()

    if not row:
        return True, "no prior SELL"

    last_sell_ts = _as_utc(row[0])
    settle_utc   = _t_plus_n_close(last_sell_ts, n=2)
    now_utc      = _as_utc(now or datetime.now(timezone.utc))

    if now_utc < settle_utc:
        reason = (f"{symbol} not settled until "
                  f"{settle_utc.astimezone(ET).strftime('%Y-%m-%d %H:%M ET')}")
        return False, reason
    return True, "settled"

def get_realized_pnl_sum(db_path: str | Path | None = None) -> float:
    """
    Sum realized P&L from the trades table.
    Works whether the column is named 'pnl' or 'pl'. Returns 0.0 on any issue.
    """
    path = Path(db_path) if db_path else Path(SIM_DB_PATH)
    try:
        with sqlite3.connect(str(path)) as con:
            cur = con.cursor()
            for col in ("pnl", "pl"):
                try:
                    cur.execute(f"SELECT COALESCE(SUM({col}), 0) FROM trades")
                    val = cur.fetchone()[0]
                    if val is not None:
                        return round(float(val or 0.0), 2)
                except sqlite3.OperationalError:
                    # column not present; try the next candidate
                    continue
    except Exception:
        # optional: log via your helper logger if present
        try:
            logger.exception("get_realized_pnl_sum failed")
        except Exception:
            pass
    return 0.0

def get_realized_pl_sum() -> float:
    conn = _connect()
    cur  = conn.cursor()
    (val,) = cur.execute(
        "SELECT COALESCE(SUM(pnl),0) FROM simulation_trades WHERE action='SELL';"
    ).fetchone()
    conn.close()
    return float(val or 0.0)

