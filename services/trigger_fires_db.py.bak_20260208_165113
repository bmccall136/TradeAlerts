# services/trigger_fires_db.py
from __future__ import annotations

import os
import sqlite3
from datetime import datetime, timezone
from typing import Any, Dict

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
LIVE_DB_DEFAULT = os.path.join(ROOT, "live.db")

def _db_path() -> str:
    return os.environ.get("LIVE_DB", LIVE_DB_DEFAULT)

def ensure_trigger_fires_table(db_path: str | None = None) -> None:
    db = db_path or _db_path()
    con = sqlite3.connect(db)
    try:
        cur = con.cursor()
        cur.execute("""
            CREATE TABLE IF NOT EXISTS trigger_fires (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ts_utc   INTEGER NOT NULL,
                symbol   TEXT NOT NULL,
                price    REAL,
                source   TEXT,
                notes    TEXT,
                signals_pretty TEXT,
                mode     TEXT,
                stage    TEXT,
                day_et   TEXT,
                time_et  TEXT
            )
        """)
        cur.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_ts ON trigger_fires(ts_utc)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_sym ON trigger_fires(symbol)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_mode ON trigger_fires(mode)")
        con.commit()
    finally:
        con.close()

def _parse_ts_utc(row: Dict[str, Any]) -> int:
    """
    Prefer row['ts_utc'] if present:
      - if numeric -> epoch
      - if ISO -> parse
    Else fallback to now.
    """
    v = (row.get("ts_utc") or "").strip()
    if v:
        # numeric epoch?
        try:
            return int(float(v))
        except Exception:
            pass
        # ISO-ish?
        try:
            # allow 'Z'
            vv = v.replace("Z", "+00:00")
            d = datetime.fromisoformat(vv)
            if d.tzinfo is None:
                d = d.replace(tzinfo=timezone.utc)
            return int(d.timestamp())
        except Exception:
            pass
    return int(datetime.now(timezone.utc).timestamp())

def log_trigger_fire(
    symbol: str,
    row: Dict[str, Any],
    *,
    mode: str = "",
    stage: str = "CANDIDATE",
    db_path: str | None = None,
) -> None:
    """
    Fire-and-forget: never raises.
    Stores canonical ts_utc epoch seconds.
    """
    try:
        ensure_trigger_fires_table(db_path)
        db = db_path or _db_path()
        sym = (symbol or row.get("symbol") or "").strip().upper()
        if not sym:
            return

        ts_utc = _parse_ts_utc(row)

        price = row.get("price")
        try:
            price = float(price) if price not in (None, "") else None
        except Exception:
            price = None

        source = (row.get("source") or "").strip() or None
        notes  = (row.get("notes") or "").strip() or None
        sigs   = (row.get("signals_pretty") or "").strip() or None

        # best-effort ET strings (if present in CSV row)
        time_et = (row.get("time_et") or "").strip() or None
        day_et  = None
        if time_et and len(time_et) >= 10:
            day_et = time_et[:10]

        con = sqlite3.connect(db)
        try:
            cur = con.cursor()
            cur.execute("""
                INSERT INTO trigger_fires
                (ts_utc, symbol, price, source, notes, signals_pretty, mode, stage, day_et, time_et)
                VALUES (?,?,?,?,?,?,?,?,?,?)
            """, (ts_utc, sym, price, source, notes, sigs, (mode or "").strip().upper(), (stage or "").strip().upper(), day_et, time_et))
            con.commit()
        finally:
            con.close()
    except Exception:
        # never break the live loop
        return
