
# services/broker_patch_cash.py
# Drop-in monkey patch to make LiveBroker cash-account friendly.
# - get_buying_power(): uses AvailableToTrade (ATT-first; falls back to buyingPower/availableFunds).
# - get_settled_cash(): returns 0.0 (stub) to satisfy callers, but NOT used for sizing.
#
# Usage:
#   Place this file at C:\TradeAlerts\services\broker_patch_cash.py
#   Then add near the top of live_start.py (BEFORE wiring/starting the loop):
#       import services.broker_patch_cash  # cash-account funds (ATT-first)
#
# You should see a log line:
#   [broker_patch] LiveBroker patched (ATT-first; cash-account friendly)

import logging
LOG = logging.getLogger("broker_patch")

try:
    from services import broker as _broker
    from services import etrade_service as _et
except Exception as e:
    raise RuntimeError(f"[broker_patch] failed to import services: {e}")

def _parse_balances(bal):
    """Return dict with keys: availableToTrade, buyingPower, availableFunds, positionsValue."""
    if not isinstance(bal, dict):
        return {}
    # Accept either flattened or nested shapes
    d = {}
    # common keys (flattened by caller)
    for k in ("availableToTrade", "buyingPower", "availableFunds", "positionsValue"):
        if k in bal:
            d[k] = bal.get(k)
    # E*TRADE shapes often have keys like 'accountBalance' or 'Computed'
    for k in ("accountBalance", "balance", "account_balances", "Bal", "Computed"):
        v = bal.get(k)
        if isinstance(v, dict):
            for kk in ("availableToTrade", "buyingPower", "availableFunds", "positionsValue"):
                if kk in v and kk not in d:
                    d[kk] = v.get(kk)
    return d

def _to_float(x, default=0.0):
    try:
        if x is None:
            return default
        return float(x)
    except Exception:
        try:
            # sometimes comes as string '$123.45' or '123.45'
            s = str(x).replace('$','').replace(',','').strip()
            return float(s) if s else default
        except Exception:
            return default

def _get_account_key():
    try:
        # prefer cached list.json route in etrade_service if present
        acct = getattr(_et, "get_primary_account", None)
        if callable(acct):
            info = acct()
            key = (info or {}).get("account_id_key") or (info or {}).get("accountIdKey")
            if key:
                return key
    except Exception:
        pass
    # fallback to broker helper if available
    try:
        if hasattr(_broker, "get_primary_account"):
            info = _broker.get_primary_account()
            key = (info or {}).get("account_id_key") or (info or {}).get("accountIdKey")
            if key:
                return key
    except Exception:
        pass
    # last-resort: environment or None
    import os
    return os.environ.get("ETRADE_ACCOUNT_KEY") or None

def _fetch_balances_dict():
    key = _get_account_key()
    if not key:
        return {}
    try:
        bal = _et.get_balances(key)  # expect a dict
        if isinstance(bal, dict):
            return bal
        return {}
    except Exception:
        # swallow; return empty dict
        return {}

# --- patch LiveBroker methods ---
try:
    LiveBroker = getattr(_broker, "LiveBroker", None)
    if LiveBroker is None:
        raise AttributeError("LiveBroker not found in services.broker")

    def _bp(self):
        bal = _fetch_balances_dict()
        d = _parse_balances(bal)
        # ATT-first, then buyingPower, then availableFunds
        att = _to_float(d.get("availableToTrade"))
        if att > 0:
            return att
        bp  = _to_float(d.get("buyingPower"))
        if bp > 0:
            return bp
        af  = _to_float(d.get("availableFunds"))
        return af

    def _settled(self):
        # For cash accounts, we want to ignore "settled" for buys.
        # Returning 0.0 ensures any selection logic that prefers bp will win.
        return 0.0

    # attach if missing or override anyway
    setattr(LiveBroker, "get_buying_power", _bp)
    setattr(LiveBroker, "get_settled_cash", _settled)

    LOG.info("LiveBroker patched (ATT-first; cash-account friendly)")
except Exception as e:
    raise RuntimeError(f"[broker_patch] patch failed: {e}")
