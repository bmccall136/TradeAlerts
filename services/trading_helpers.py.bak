# services/trading_helpers.py

import sqlite3
from datetime import datetime
from config import SIM_DB, BACKTEST_DB

# ─── Internal connect helper ────────────────────────────────
def _connect():
    return sqlite3.connect(SIM_DB, detect_types=sqlite3.PARSE_DECLTYPES)

# ─── Schema setup ──────────────────────────────────────────
def setup_simulation_db():
    """
    Ensure the simulation schema exists and seed the state row.
    Tables:
      - state       (id=1, cash REAL, realized_pl REAL)
      - holdings    (symbol TEXT PK, qty INT, avg_cost REAL, last_price REAL)
      - simulation_trades
    """
    conn = _connect()
    cur  = conn.cursor()

    # State table
    cur.execute("""
    CREATE TABLE IF NOT EXISTS state (
      id           INTEGER PRIMARY KEY CHECK (id = 1),
      cash         REAL    NOT NULL DEFAULT 0.0,
      realized_pl  REAL    NOT NULL DEFAULT 0.0
    );
    """)
    cur.execute("INSERT OR IGNORE INTO state (id, cash, realized_pl) VALUES (1, 0.0, 0.0);")

    # Holdings table
    cur.execute("""
    CREATE TABLE IF NOT EXISTS holdings (
      symbol      TEXT PRIMARY KEY,
      qty         INTEGER NOT NULL,
      avg_cost    REAL    NOT NULL,
      last_price  REAL    NOT NULL
    );
    """)

    # Trades table
    cur.execute("""
    CREATE TABLE IF NOT EXISTS simulation_trades (
      id         INTEGER PRIMARY KEY AUTOINCREMENT,
      symbol     TEXT    NOT NULL,
      action     TEXT    NOT NULL CHECK (action IN ('BUY','SELL')),
      price      REAL    NOT NULL,
      qty        INTEGER NOT NULL,
      trade_time TEXT    NOT NULL,
      pnl        REAL
    );
    """)

    conn.commit()
    conn.close()
def load_your_symbols():
    """Load your symbol list from the SP500 file."""
    with open(Path(__file__).parent.parent / "sp500_symbols.txt") as f:
        return [s.strip() for s in f if s.strip()]

# ─── Hard reset ─────────────────────────────────────────────
def nuke_simulation_db():
    """
    Drop & recreate the entire simulation schema with fresh state.
    """
    conn = _connect()
    cur  = conn.cursor()
    cur.executescript("""
    DROP TABLE IF EXISTS state;
    DROP TABLE IF EXISTS holdings;
    DROP TABLE IF EXISTS simulation_trades;
    """)
    conn.commit()
    conn.close()
    setup_simulation_db()

# ─── Data accessors ─────────────────────────────────────────
def get_cash() -> float:
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("SELECT cash FROM state WHERE id = 1;")
    row = cur.fetchone()
    conn.close()
    return float(row[0]) if row else 0.0

def set_cash(amount: float):
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("UPDATE state SET cash = ? WHERE id = 1;", (amount,))
    conn.commit()
    conn.close()

def get_realized_pl() -> float:
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("SELECT realized_pl FROM state WHERE id = 1;")
    row = cur.fetchone()
    conn.close()
    return float(row[0]) if row else 0.0

def get_unrealized_pl() -> float:
    conn     = _connect()
    cur      = conn.cursor()
    cur.execute("SELECT symbol, qty, avg_cost, last_price FROM holdings;")
    total = 0.0
    for sym, qty, avg, last in cur.fetchall():
        total += (last - avg) * qty
    conn.close()
    return total

def get_holdings():
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("SELECT symbol, qty, avg_cost, last_price FROM holdings;")
    rows = cur.fetchall()
    conn.close()
    return rows

def get_trades():
    conn = _connect()
    cur  = conn.cursor()
    cur.execute("""
      SELECT symbol, action, price, qty, trade_time, pnl
        FROM simulation_trades
       ORDER BY trade_time;
    """)
    rows = cur.fetchall()
    conn.close()
    return rows

# ─── Trading operations ─────────────────────────────────────
def buy_stock(symbol: str, qty: int, price: float, trade_time: str = None):
    conn = _connect()
    cur  = conn.cursor()
    # check cash
    cur.execute("SELECT cash, realized_pl FROM state WHERE id = 1;")
    cash_now, realized = cur.fetchone()
    cost = price * qty
    if cash_now < cost:
        conn.close()
        raise ValueError("Insufficient cash")
    tstamp = trade_time or datetime.utcnow().isoformat(sep=' ')
    # record trade
    cur.execute("""
      INSERT INTO simulation_trades
        (symbol, action, price, qty, trade_time, pnl)
      VALUES (?, 'BUY', ?, ?, ?, NULL);
    """, (symbol, price, qty, tstamp))
    # deduct cash
    cur.execute("UPDATE state SET cash = cash - ? WHERE id = 1;", (cost,))
    # upsert holding
    cur.execute("SELECT qty, avg_cost FROM holdings WHERE symbol = ?;", (symbol,))
    row = cur.fetchone()
    if row:
        old_qty, old_avg = row
        new_qty = old_qty + qty
        new_avg = ((old_avg * old_qty) + cost) / new_qty
        cur.execute("""
          UPDATE holdings
             SET qty = ?, avg_cost = ?, last_price = ?
           WHERE symbol = ?;
        """, (new_qty, new_avg, price, symbol))
    else:
        cur.execute("""
          INSERT INTO holdings (symbol, qty, avg_cost, last_price)
          VALUES (?, ?, ?, ?);
        """, (symbol, qty, price, price))

    conn.commit()
    conn.close()

def sell_stock(symbol: str, qty: int, price: float, trade_time: str = None):
    conn = _connect()
    cur  = conn.cursor()
    # load state and holding
    cur.execute("SELECT cash, realized_pl FROM state WHERE id = 1;")
    cash_now, realized = cur.fetchone()
    cur.execute("SELECT qty, avg_cost FROM holdings WHERE symbol = ?;", (symbol,))
    row = cur.fetchone()
    if not row or row[0] < qty:
        conn.close()
        raise ValueError("Not enough shares")
    old_qty, avg_cost = row
    proceeds = price * qty
    pl = (price - avg_cost) * qty
    tstamp = trade_time or datetime.utcnow().isoformat(sep=' ')
    # record trade
    cur.execute("""
      INSERT INTO simulation_trades
        (symbol, action, price, qty, trade_time, pnl)
      VALUES (?, 'SELL', ?, ?, ?, ?);
    """, (symbol, price, qty, tstamp, pl))
    # update holding
    new_qty = old_qty - qty
    if new_qty:
        cur.execute("""
          UPDATE holdings
             SET qty = ?, last_price = ?
           WHERE symbol = ?;
        """, (new_qty, price, symbol))
    else:
        cur.execute("DELETE FROM holdings WHERE symbol = ?;", (symbol,))
    # credit cash & realized P/L
    cur.execute("""
      UPDATE state
         SET cash = cash + ?, realized_pl = realized_pl + ?
       WHERE id = 1;
    """, (proceeds, pl))

    conn.commit()
    conn.close()

# ─── Backtest DB init ──────────────────────────────────────
def init_backtest_db():
    from config import BACKTEST_SCHEMA
    conn = sqlite3.connect(BACKTEST_DB)
    conn.executescript(BACKTEST_SCHEMA)
    conn.commit()
    conn.close()

# ensure schema is ready whenever this module is imported
setup_simulation_db()
