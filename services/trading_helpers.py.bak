import sqlite3
import os
from datetime import datetime

# ── Path to your simulation DB ────────────────────────────────
SIM_DB = os.path.join(os.getcwd(), 'simulation.db')

# ── CORE DB CONNECTION ────────────────────────────────────────
def get_db_connection():
    """Return a SQLite connection to the simulation DB."""
    conn = sqlite3.connect(SIM_DB, detect_types=sqlite3.PARSE_DECLTYPES)
    conn.row_factory = sqlite3.Row
    return conn

# ── SCHEMA MANAGEMENT ─────────────────────────────────────────
def nuke_simulation_db():
    conn = get_db_connection()
    cur  = conn.cursor()

    # drop any old tables
    cur.execute("DROP TABLE IF EXISTS state")
    cur.execute("DROP TABLE IF EXISTS holdings")
    cur.execute("DROP TABLE IF EXISTS trades")

    # recreate them
    cur.execute("""
      CREATE TABLE state (
        key   TEXT PRIMARY KEY,
        value REAL
      )
    """)
    cur.execute("""
      CREATE TABLE holdings (
        symbol     TEXT,
        qty        INTEGER,
        price_paid REAL
      )
    """)
    cur.execute("""
      CREATE TABLE trades (
        symbol     TEXT,
        action     TEXT,
        price      REAL,
        qty        INTEGER,
        trade_time TEXT,
        pnl        REAL
      )
    """)
    conn.commit()
    conn.close()

# ── CASH MANAGEMENT ──────────────────────────────────────────
def set_cash(amount: float):
    """Seed or update your cash balance."""
    conn = get_db_connection()
    cur  = conn.cursor()
    # store under key='cash'
    cur.execute("""
      INSERT INTO state(key,value)
      VALUES(?,?)
      ON CONFLICT(key) DO UPDATE SET value=excluded.value
    """, ("cash", amount))
    conn.commit()
    conn.close()

def get_cash() -> float:
    """Retrieve current cash balance (0.0 if missing)."""
    conn = get_db_connection()
    cur  = conn.cursor()
    cur.execute("SELECT value FROM state WHERE key='cash'")
    row = cur.fetchone()
    conn.close()
    return float(row["value"]) if row else 0.0

def get_realized_pl() -> float:
    """Sum of all P/L from the trades table."""
    conn = get_db_connection()
    cur  = conn.cursor()
    cur.execute("SELECT SUM(pnl) as total FROM trades")
    row = cur.fetchone()
    conn.close()
    return float(row["total"] or 0.0)

# ── HOLDINGS CRUD ────────────────────────────────────────────
def buy_stock(symbol: str, qty: int, price: float, trade_time: str=None):
    """Record a buy: add to holdings, log trade."""
    if qty <= 0:
        raise ValueError("Quantity must be > 0")
    conn = get_db_connection()
    cur  = conn.cursor()
    # upsert holdings
    cur.execute("SELECT qty, price_paid FROM holdings WHERE symbol=?", (symbol,))
    existing = cur.fetchone()
    if existing:
        prev_qty, prev_cost = existing["qty"], existing["price_paid"]
        total_cost = prev_cost * prev_qty + price * qty
        new_qty   = prev_qty + qty
        new_price = total_cost / new_qty
        cur.execute(
            "UPDATE holdings SET qty=?, price_paid=? WHERE symbol=?",
            (new_qty, new_price, symbol)
        )
    else:
        cur.execute(
            "INSERT INTO holdings(symbol,qty,price_paid) VALUES(?,?,?)",
            (symbol, qty, price)
        )

    # log trade with pnl=NULL
    cur.execute("""
      INSERT INTO trades(symbol,action,price,qty,trade_time,pnl)
      VALUES(?,?,?,?,?,NULL)
    """, (symbol, "BUY", price, qty, trade_time or datetime.utcnow().isoformat(sep=' ')))
    conn.commit()
    conn.close()

def sell_stock(symbol: str, qty: int, price: float, trade_time: str=None):
    """Record a sell: remove from holdings, compute & log P/L."""
    conn = get_db_connection()
    cur  = conn.cursor()
    cur.execute("SELECT qty, price_paid FROM holdings WHERE symbol=?", (symbol,))
    row = cur.fetchone()
    if not row or row["qty"] < qty:
        conn.close()
        raise ValueError("Insufficient shares")
    prev_qty, prev_cost = row["qty"], row["price_paid"]
    # remaining shares
    new_qty = prev_qty - qty
    if new_qty > 0:
        cur.execute(
            "UPDATE holdings SET qty=? WHERE symbol=?",
            (new_qty, symbol)
        )
    else:
        cur.execute("DELETE FROM holdings WHERE symbol=?", (symbol,))

    # compute pnl = (sell_price - avg_cost) * qty
    pnl = (price - prev_cost) * qty
    cur.execute("""
      INSERT INTO trades(symbol,action,price,qty,trade_time,pnl)
      VALUES(?,?,?,?,?,?)
    """, (symbol, "SELL", price, qty, trade_time or datetime.utcnow().isoformat(sep=' '), pnl))
    conn.commit()
    conn.close()

def get_holdings():
    """Return list of (symbol, qty, price_paid)."""
    conn = get_db_connection()
    cur  = conn.cursor()
    cur.execute("SELECT symbol, qty, price_paid FROM holdings")
    rows = cur.fetchall()
    conn.close()
    # you can return dicts or tuples; simulation view handles both
    return [dict(row) for row in rows]

def get_trades():
    """Return full history: (symbol,action,price,qty,trade_time,pnl)."""
    conn = get_db_connection()
    cur  = conn.cursor()
    cur.execute("""
      SELECT symbol,action,price,qty,trade_time,pnl
      FROM trades
      ORDER BY trade_time DESC
    """)
    rows = cur.fetchall()
    conn.close()
    return [dict(row) for row in rows]
