# services/live_ledger.py
from __future__ import annotations
import os, json, datetime as dt
from typing import Dict, List

LEDGER_PATH = os.path.join(os.path.dirname(__file__), "..", "data", "live_ledger.json")

def _today() -> str:
    return dt.date.today().isoformat()

def _load() -> Dict:
    try:
        with open(LEDGER_PATH, "r", encoding="utf-8") as f:
            db = json.load(f)
    except Exception:
        db = {}
    # normalize set-like "seen"
    for day, s in db.items():
        if isinstance(s.get("seen"), list):
            s["seen"] = set(s["seen"])
    return db

def _save(db: Dict) -> None:
    os.makedirs(os.path.dirname(LEDGER_PATH), exist_ok=True)
    # sets -> lists
    dump = {k: {**v, "seen": sorted(list(v.get("seen", set())))} for k, v in db.items()}
    with open(LEDGER_PATH, "w", encoding="utf-8") as f:
        json.dump(dump, f, indent=2)

def _state_for(db: Dict, day: str) -> Dict:
    if day not in db:
        db[day] = {"symbols": {}, "trades": [], "realized": 0.0, "basis_sold": 0.0, "seen": set()}
    return db[day]

def _sym_state(state: Dict, sym: str) -> Dict:
    syms = state["symbols"]
    if sym not in syms:
        syms[sym] = {"lots": []}  # list of {"qty": int, "price": float}
    return syms[sym]

def apply_fill(fill: Dict, ignore: set[str] | None = None) -> None:
    """
    fill = {time, symbol, action, qty, price}
    FIFO for buys; realized on sells. Idempotent per (time|sym|side|qty|price).
    """
    ignore = ignore or set()
    sym = (fill.get("symbol") or "").upper()
    if not sym or sym in ignore:
        return

    sig = f"{fill.get('time')}|{sym}|{(fill.get('action') or '').upper()}|{int(fill.get('qty') or 0)}|{float(fill.get('price') or 0)}"

    db = _load()
    st = _state_for(db, _today())
    if sig in st["seen"]:
        return
    st["seen"].add(sig)

    side = (fill.get("action") or "").upper()
    qty  = int(fill.get("qty") or 0)
    px   = float(fill.get("price") or 0)

    sst = _sym_state(st, sym)

    if side == "BUY":
        # add a lot
        sst["lots"].append({"qty": qty, "price": px})
    elif side == "SELL":
        # consume FIFO lots
        remain = qty
        used_basis = 0.0
        while remain > 0 and sst["lots"]:
            lot = sst["lots"][0]
            take = min(remain, int(lot["qty"]))
            used_basis += take * float(lot["price"])
            lot["qty"] -= take
            remain -= take
            if lot["qty"] <= 0:
                sst["lots"].pop(0)
        # anything sold without basis -> treat cost 0 (cashflow only)
        realized = qty * px - used_basis
        pl_pct = (realized / used_basis * 100.0) if used_basis > 0 else 0.0

        st["realized"]  += realized
        st["basis_sold"] += used_basis
        st["trades"].append({
            "time": fill.get("time"),
            "symbol": sym,
            "action": "SELL",
            "qty": qty,
            "price": px,
            "basis_used": round(used_basis, 2),
            "pl": round(realized, 2),
            "pl_pct": round(pl_pct, 2),
        })
    else:
        # ignore other actions
        pass

    _save(db)

def summarize_today() -> Dict:
    db = _load()
    st = _state_for(db, _today())
    total = float(st.get("realized") or 0.0)
    basis = float(st.get("basis_sold") or 0.0)
    pct   = round((total / basis * 100.0), 2) if basis > 0 else 0.0
    return {
        "trades": st.get("trades", []),
        "realized_total": round(total, 2),
        "realized_pct": pct,
    }
