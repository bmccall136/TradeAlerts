            return float(last_trade)
        else:
            raise ValueError(f"No lastTrade in E*TRADE quote for {symbol}: {resp}")
    except Exception as e:
        print(f"[CHECK-EXITS] Could not fetch quote for {symbol}: {e}")
        raise
