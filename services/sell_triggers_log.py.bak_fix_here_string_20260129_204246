from __future__ import annotations

import csv
import json
import os
import re
import threading
import time
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any, Optional

# -----------------------------------------------------------------------------
# Sell Triggers Logger
#
# Writes: logs/sell_triggers_YYYY-MM-DD.csv  (date boundary default: ET)
#
# Goals:
#   - Never raise (must not crash sell_guard)
#   - Capture REAL sell reasons (DECISION) and order outcomes (PREVIEW/PLACE)
#   - Avoid CSV spam by default (EVAL rows disabled unless explicitly enabled)
#
# Env:
#   SELL_TRIGGERS_DIR             override log dir
#   SELL_TRIGGERS_ROTATE_UTC      true|false  (default false => ET day boundary)
#   SELL_TRIGGERS_BACKUP_DAYS     retention days (default 14)
#   SELL_TRIGGERS_LOG_EVAL        true|false  (default false)
# -----------------------------------------------------------------------------

_LOCK = threading.Lock()
_PRUNE_EVERY_SEC = 300
_LAST_PRUNE_TS = 0.0

DATE_FILE_RE = re.compile(r"^sell_triggers_(\d{4}-\d{2}-\d{2})\.csv$")


def _env_bool(name: str, default: bool = False) -> bool:
    try:
        v = (os.environ.get(name, "") or "").strip().lower()
        if not v:
            return default
        return v in ("1", "true", "yes", "y", "on")
    except Exception:
        return default


def _now_et() -> datetime:
    # Avoid external deps; rely on system local time being ET on the box
    # If your server is not in ET, set SELL_TRIGGERS_ROTATE_UTC=true to at least be consistent.
    return datetime.now().astimezone()


def _day_key_dt() -> datetime:
    """
    Return datetime used to compute "today's" file name boundary.
    If SELL_TRIGGERS_ROTATE_UTC=true, use UTC. Default: local (ET).
    """
    rotate_utc = _env_bool("SELL_TRIGGERS_ROTATE_UTC", default=False)
    if rotate_utc:
        return datetime.now(tz=UTC)
    return _now_et()


def _log_dir() -> Path:
    d = os.environ.get("SELL_TRIGGERS_DIR", "").strip()
    if d:
        p = Path(d).expanduser()
    else:
        # services/ -> project root -> logs/
        p = (Path(__file__).resolve().parent.parent / "logs").resolve()
    try:
        p.mkdir(parents=True, exist_ok=True)
    except Exception:
        # last resort: current working directory
        p = Path(".").resolve()
        try:
            p.mkdir(parents=True, exist_ok=True)
        except Exception:
            pass
    return p


def _file_path_for_today() -> Path:
    dt = _day_key_dt()
    day = dt.strftime("%Y-%m-%d")
    return _log_dir() / f"sell_triggers_{day}.csv"


DEFAULT_COLUMNS = [
    "ts_utc",
    "ts_et",
    "event",        # EVAL | DECISION | PREVIEW_OK | PLACE_OK | SKIP | ERROR | POSITION_DISAPPEARED
    "symbol",
    "qty",
    "action",       # SELL (mostly), but keep flexible
    "reason",       # human-readable reason string
    "trigger",      # STOPLOSS | TARGET | TRAIL | PROTECT | TIMEOUT | MANUAL | ...
    "pl_pct",
    "hold_min",
    "order_type",   # MARKET/LIMIT/STOP/...
    "limit_price",
    "attempt",
    "status",       # OK/SKIP/ERR
    "err",
    "meta_json",    # freeform json blob (dict)
]


def _ensure_header(path: Path, columns: list[str]) -> None:
    try:
        if not path.exists() or path.stat().st_size == 0:
            with path.open("a", newline="", encoding="utf-8") as f:
                w = csv.writer(f)
                w.writerow(columns)
    except Exception:
        return


def _prune_old_files(now_ts: float) -> None:
    global _LAST_PRUNE_TS
    try:
        if (now_ts - _LAST_PRUNE_TS) < _PRUNE_EVERY_SEC:
            return
        _LAST_PRUNE_TS = now_ts

        backup_days = int(os.environ.get("SELL_TRIGGERS_BACKUP_DAYS", "14") or 14)
        cutoff = _day_key_dt() - timedelta(days=backup_days)

        ld = _log_dir()
        for fp in ld.iterdir():
            try:
                if not fp.is_file():
                    continue
                m = DATE_FILE_RE.match(fp.name)
                if not m:
                    continue
                dt = datetime.strptime(m.group(1), "%Y-%m-%d")
                # interpret dt in same boundary system as _day_key_dt()
                if _env_bool("SELL_TRIGGERS_ROTATE_UTC", default=False):
                    dt = dt.replace(tzinfo=UTC)
                else:
                    dt = dt.replace(tzinfo=_day_key_dt().tzinfo)
                if dt < cutoff:
                    fp.unlink(missing_ok=True)
            except Exception:
                continue
    except Exception:
        return


def emit_sell_event(
    *,
    symbol: str,
    qty: float,
    action: str,
    event: str = "EVAL",
    reason: str = "",
    trigger: str = "",
    pl_pct: Optional[float] = None,
    hold_min: Optional[float] = None,
    order_type: str = "",
    limit_price: Optional[float] = None,
    attempt: Optional[int] = None,
    status: str = "",
    err: str = "",
    meta: Optional[dict[str, Any]] = None,
    **_compat: Any,  # swallow unknown kwargs so logging never breaks caller
) -> None:
    """
    Append a sell-trigger row to today's dated CSV file.
    This function must NEVER raise.
    """
    try:
        sym = (symbol or "").strip().upper()
        if not sym:
            return

        # Default: do NOT spam EVAL rows unless explicitly enabled.
        if (event or "").upper() == "EVAL" and not _env_bool("SELL_TRIGGERS_LOG_EVAL", default=False):
            return

        now_utc = datetime.now(tz=UTC)
        now_et = _now_et()

        row = {
            "ts_utc": now_utc.isoformat(timespec="seconds"),
            "ts_et": now_et.isoformat(timespec="seconds"),
            "event": (event or "").upper(),
            "symbol": sym,
            "qty": float(qty or 0),
            "action": (action or "").upper(),
            "reason": str(reason or ""),
            "trigger": str(trigger or ""),
            "pl_pct": (None if pl_pct is None else float(pl_pct)),
            "hold_min": (None if hold_min is None else float(hold_min)),
            "order_type": str(order_type or ""),
            "limit_price": (None if limit_price is None else float(limit_price)),
            "attempt": (None if attempt is None else int(attempt)),
            "status": str(status or ""),
            "err": str(err or ""),
            "meta_json": "",
        }

        if meta and isinstance(meta, dict):
            try:
                row["meta_json"] = json.dumps(meta, separators=(",", ":"), ensure_ascii=False)
            except Exception:
                row["meta_json"] = ""

        path = _file_path_for_today()

        with _LOCK:
            _ensure_header(path, DEFAULT_COLUMNS)
            with path.open("a", newline="", encoding="utf-8") as f:
                w = csv.DictWriter(f, fieldnames=DEFAULT_COLUMNS, extrasaction="ignore")
                w.writerow(row)

            # retention cleanup (cheap, rate-limited)
            try:
                _prune_old_files(time.time())
            except Exception:
                pass

    except Exception:
        return
