    """
    Legacy name kept for compatibility, but this now prefers REAL data
    from the E*TRADE API. If the API fails for any reason, it falls back
    to the local live.db realized_trades table.

    Returns:
        {
          "pnl": {
            "today": float,
            "week": float,
            "month": float,
            "all": float,
          }
        }
    """
    # --- 1) Try E*TRADE-based buckets first -------------------------------
    try:
        # If you already have account_key in scope, you can skip this call
        # and just reuse the existing variable.
        buckets = realized_buckets_from_live_db_db(LIVE_DB)
        # Shape it the same way the old DB helper returned it:
        return {
            "pnl": {
                "today": float(buckets.get("today", 0.0)),
                "week": float(buckets.get("week", 0.0)),
                "month": float(buckets.get("month", 0.0)),
                "all": float(buckets.get("all", 0.0)),
            }
        }
    except Exception as exc:
        # Log and fall back to the SQLite version so the widget never breaks.
        LOG.warning("realized_buckets_from_live_db: E*TRADE API failed, "
                    "falling back to DB: %s", exc)

    # --- 2) Fallback: use existing SQLite realized_trades logic ----------
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    try:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT close_date, gain
            FROM realized_trades
            WHERE UPPER(action) = 'SELL'
              AND symbol <> 'TEST'
            ORDER BY close_date DESC
            """
        )
        rows = cur.fetchall()
    finally:
        conn.close()

    # If you were already doing this logic before, you can keep your
    # existing bucketing code here; I’m showing one standard version:
    if ETZ is not None:
        now_local = datetime.now(tz=ETZ)
    else:  # pragma: no cover
        now_local = datetime.now()

    today = now_local.date()
    week_start = today - timedelta(days=6)
    month_start = today.replace(day=1)

    buckets = {
        "today": 0.0,
        "week": 0.0,
        "month": 0.0,
        "all": 0.0,
    }

    for r in rows:
        try:
            ts = r["close_date"]
            if isinstance(ts, (int, float)):
                dt = datetime.fromtimestamp(ts, tz=UTC)
            else:
                dt = datetime.fromisoformat(str(ts)).replace(tzinfo=UTC)

            dt_local = dt.astimezone(now_local.tzinfo)
            d = dt_local.date()

            gain = float(r["gain"] or 0.0)
            buckets["all"] += gain
            if d == today:
                buckets["today"] += gain
            if d >= week_start:
                buckets["week"] += gain
            if d >= month_start:
                buckets["month"] += gain
        except Exception:
            continue

    return {
        "pnl": {
            "today": buckets["today"],
            "week": buckets["week"],
            "month": buckets["month"],
            "all": buckets["all"],
        }
    }
def _enrich_trades_from_realized(trades: list[dict]) -> list[dict]:
    """
    For SELL trades that have price_paid == 0 (or missing), patch them using
    realized_trades from live.db so Recent Trades shows correct Price Paid and P&L.

    Matching strategy:
      - key = (symbol, close_date truncated to seconds)
      - use trade['time_utc'] or trade['time'] for the timestamp
    """
    if not trades:
        return trades

    # Build an index of realized_trades keyed by (SYMBOL, CLOSE_TS)
    try:
        conn = sqlite3.connect(str(LIVE_DB))
        cur = conn.cursor()
        cur.execute(
            """
            SELECT
                symbol,
                close_date,
                qty,
                cost_share,
                total_cost,
                gain
            FROM realized_trades
            """
        )
        realized_index: dict[tuple[str, str], dict] = {}

        def _norm_ts(s: str | None) -> str:
            if not s:
                return ""
            s = str(s).replace("T", " ")
            return s[:19]  # "YYYY-MM-DD HH:MM:SS"

        for sym, close_date, qty, cost_share, total_cost, gain in cur.fetchall():
            key = (str(sym or "").upper(), _norm_ts(close_date))
            realized_index[key] = {
                "qty": float(qty or 0.0),
                "cost_share": float(cost_share or 0.0),
                "total_cost": float(total_cost or 0.0),
                "gain": float(gain or 0.0),
            }

        conn.close()
    except Exception as exc:
        log.error("_enrich_trades_from_realized: failed to read realized_trades: %s", exc)
        return trades

    def _norm_ts_trade(t: dict) -> str:
        ts = t.get("time_utc") or t.get("time") or ""
        ts = str(ts).replace("T", " ")
        return ts[:19]

    enriched: list[dict] = []

    for t in trades:
        action = (t.get("action") or t.get("side") or "").upper()
        if action != "SELL":
            enriched.append(t)
            continue

        price_paid = t.get("price_paid")
        # Only patch clearly bogus values
        if price_paid not in (None, 0, 0.0):
            enriched.append(t)
            continue

        sym = (t.get("symbol") or "").upper()
        if not sym:
            enriched.append(t)
            continue

        key = (sym, _norm_ts_trade(t))
        r = realized_index.get(key)
        if not r:
            enriched.append(t)
            continue

        qty = t.get("qty")
        try:
            qty_f = float(qty or r["qty"] or 0.0)
        except Exception:
            qty_f = float(r["qty"] or 0.0)

        cost_share = r["cost_share"]
        total_cost = r["total_cost"] or (cost_share * qty_f)
        gain = r["gain"]

        if qty_f <= 0 or cost_share <= 0:
            enriched.append(t)
            continue

        pl = gain
        pl_pct = (pl / total_cost * 100.0) if total_cost > 0 else 0.0

        t2 = dict(t)
        t2["price_paid"] = round(cost_share, 4)
        t2["pl"] = round(pl, 2)
        t2["pl_pct"] = round(pl_pct, 2)
        enriched.append(t2)

    return enriched

from typing import Any

def normalize_positions_payload(raw):
    """
    Normalize E*TRADE PortfolioResponse payload into a list of dicts your dashboard can use.

    Output rows contain (at least):
      symbol, name, qty, price_paid, last_price, day_pl, day_pl_pct,
      total_pl, total_pl_pct, prior_close, opened_utc, value

    This function is defensive:
      - accepts dict payloads OR list payloads
      - accepts already-normalized rows and passes them through
    """
    if not raw:
        return []

    # If someone already passed a list of normalized rows, pass through.
    if isinstance(raw, list):
        # If these already look normalized, return as-is.
        if raw and isinstance(raw[0], dict) and ("symbol" in raw[0] or "qty" in raw[0]):
            return raw
        # Otherwise, treat list items as Position dicts.
        positions = [p for p in raw if isinstance(p, dict)]
    elif isinstance(raw, dict):
        pr = raw.get("PortfolioResponse") or raw.get("portfolioResponse") or raw
        acct_list = pr.get("AccountPortfolio") or pr.get("accountPortfolio") or []
        positions = []
        for acct in acct_list if isinstance(acct_list, list) else []:
            pos_list = acct.get("Position") or acct.get("position") or []
            if isinstance(pos_list, list):
                positions.extend([p for p in pos_list if isinstance(p, dict)])
    else:
        return []

    out = []
    for p in positions:
        # Already-normalized?
        if "symbol" in p and ("qty" in p or "quantity" in p):
            out.append(p)
            continue

        prod = p.get("Product") or {}
        quick = p.get("Quick") or {}

        symbol = (
            prod.get("symbol")
            or (prod.get("productId") or {}).get("symbol")
            or p.get("symbol")
            or p.get("symbolDescription")
        )
        if not symbol:
            continue

        qty = p.get("quantity")
        try:
            qty = float(qty) if qty is not None else 0.0
        except Exception:
            qty = 0.0

        # Cost / paid
        price_paid = p.get("pricePaid")
        if price_paid is None:
            price_paid = p.get("costPerShare")
        try:
            price_paid = float(price_paid) if price_paid is not None else 0.0
        except Exception:
            price_paid = 0.0

        # Last price: prefer Quick.lastTrade, else derive from marketValue/qty
        last_price = quick.get("lastTrade")
        if last_price is None:
            mv = p.get("marketValue")
            try:
                mv = float(mv) if mv is not None else None
            except Exception:
                mv = None
            if mv is not None and qty:
                last_price = mv / qty
        try:
            last_price = float(last_price) if last_price is not None else 0.0
        except Exception:
            last_price = 0.0

        # P&L fields
        day_pl = p.get("daysGain")
        day_pl_pct = p.get("daysGainPct")
        total_pl = p.get("totalGain")
        total_pl_pct = p.get("totalGainPct")

        def _f(x):
            try:
                return float(x) if x is not None else 0.0
            except Exception:
                return 0.0

        day_pl = _f(day_pl)
        day_pl_pct = _f(day_pl_pct)
        total_pl = _f(total_pl)
        total_pl_pct = _f(total_pl_pct)

        prior_close = _f(p.get("adjPrevClose"))

        # Opened: E*TRADE gives ms epoch in dateAcquired
        opened_utc = None
        da = p.get("dateAcquired")
        try:
            if da is not None:
                da = int(da)
                # dateAcquired is ms since epoch
                opened_utc = da / 1000.0
        except Exception:
            opened_utc = None

        value = _f(p.get("marketValue"))

        name = p.get("symbolDescription") or symbol

        out.append(
            {
                "symbol": symbol,
                "name": name,
                "qty": qty,
                "price_paid": price_paid,
                "last_price": last_price,
                "day_pl": day_pl,
                "day_pl_pct": day_pl_pct,
                "total_pl": total_pl,
                "total_pl_pct": total_pl_pct,
                "prior_close": prior_close,
                "opened_utc": opened_utc,  # float epoch seconds, or None
                "value": value,
                # Keep raw around in case you want to inspect in /live/data?debug=1
                "_raw": p,
            }
        )

    return out

def _sync_realized_from_trades(trades: list[dict], db_path: str) -> int:
    """
    Method #1:
    Whenever we observe an executed SELL trade in our trades feed,
    write it into live.db.realized_trades (INSERT OR IGNORE style).

    This makes realized buckets independent of E*TRADE transactions
    (which often omit gainLoss).
    """
    if not trades:
        return 0

    n = 0
    for t in trades:
        try:
            action = (t.get("action") or t.get("side") or "").upper()
            if action != "SELL":
                continue

            sym = (t.get("symbol") or "").strip().upper()
            qty = float(t.get("qty") or t.get("quantity") or 0)
            sold = float(t.get("price") or t.get("price_sold") or t.get("fill_price") or 0)
            paid = float(t.get("price_paid") or t.get("cost_share") or 0)

            # normalize close_date to YYYY-MM-DD (matches your existing rows)
            ts = t.get("time_utc") or t.get("time") or t.get("date") or t.get("close_date") or ""
            ts = str(ts).replace("T", " ")
            close_date = ts[:10] if len(ts) >= 10 else ts

            if not sym or qty <= 0 or sold <= 0 or paid <= 0 or not close_date:
                continue

            # insert_realized_trade is already INSERT/IGNORE-protected by your unique index
            insert_realized_trade(db_path, sym, int(qty), paid, sold, None, close_date)
            n += 1
        except Exception:
            continue

    return n
from typing import Any

def _positions_rows_from_any(raw: Any) -> list[dict]:
    """
    Coerce whatever we got back (None / dict / list) into normalized position rows.

    Accepts:
      - None -> []
      - dict (E*TRADE PortfolioResponse JSON) -> normalize_positions_payload(dict)
      - list of dict rows already normalized -> returned as-is
      - list containing a single dict payload -> normalized
    """
    if raw is None:
        return []

    # If we already have normalized rows, just return them
    if isinstance(raw, list):
        if not raw:
            return []

        # list of normalized dict rows?
        if all(isinstance(x, dict) and ("symbol" in x) for x in raw):
            # Heuristic: if it looks like a PortfolioResponse wrapper, normalize instead
            # (Some code paths may wrap payloads in a list)
            if len(raw) == 1 and isinstance(raw[0], dict) and (
                "PortfolioResponse" in raw[0] or "AccountPortfolio" in raw[0]
            ):
                return normalize_positions_payload(raw[0])
            return raw

        # list but not dict rows -> treat as empty
        if len(raw) == 1 and isinstance(raw[0], dict):
            return normalize_positions_payload(raw[0])
        return []

    if isinstance(raw, dict):
        return normalize_positions_payload(raw)

    return []

def _build_holdings_from_positions(
    pos_rows: list[dict] | None,
) -> tuple[list[dict], float]:
    """
    From normalized positions rows, compute holdings rows with:
      symbol, name, opened_et, qty, price_paid, last_price, value,
      day_pl, day_pl_pct, total_pl, total_pl_pct.
    """
    from services import live_guardrails as gr
    from datetime import datetime
    from zoneinfo import ZoneInfo

    def _safe_float(v, default: float = 0.0) -> float:
        try:
            if v is None:
                return float(default)
            if isinstance(v, bool):
                return float(default)
            return float(v)
        except Exception:
            return float(default)

    ETZ = ZoneInfo("America/New_York")
    pos_rows = pos_rows or []

    # map of symbol -> opened_at from guardrails
    opened_map: dict[str, datetime] = {}
    try:
        entries = gr.list_open_entries() or []
        for e in entries:
            if not isinstance(e, dict):
                continue
            sym = (e.get("symbol") or "").upper()
            ts = e.get("opened_at")
            if not sym or not ts:
                continue
            try:
                dt = datetime.fromisoformat(ts)
                if dt.tzinfo is None:
                    dt = dt.replace(tzinfo=ETZ)
                else:
                    dt = dt.astimezone(ETZ)
                opened_map[sym] = dt
            except Exception:
                continue
    except Exception:
        pass

    holdings: list[dict] = []
    positions_value = 0.0

    for r in pos_rows:
        if not isinstance(r, dict):
            continue

        sym = (r.get("symbol") or "").upper()
        if not sym:
            continue

        name = (r.get("name") or r.get("full_name") or r.get("company") or "").strip()

        qty = _safe_float(r.get("qty", r.get("quantity")), 0.0)
        paid = _safe_float(r.get("price_paid", r.get("pricePaid")), 0.0)
        last = _safe_float(r.get("last_price", r.get("lastPrice")), 0.0)
        prior = r.get("prior_close", r.get("priorClose"))

        if qty <= 0 or last <= 0:
            continue

        opened_dt = opened_map.get(sym)
        opened_str = opened_dt.strftime("%Y-%m-%d %H:%M") if opened_dt else "—"

        value = round(qty * last, 2)
        positions_value += value

        # Total P&L (since bought)
        cost = qty * paid
        total_pl = round(value - cost, 2) if cost > 0 else 0.0
        total_pl_pct = round((total_pl / cost) * 100.0, 2) if cost > 0 else 0.0

        # Day P&L (today): prefer provided day_pl, else compute from last vs prior close
        day_pl = r.get("day_pl", r.get("daysGain"))
        day_pl_pct = r.get("day_pl_pct", r.get("daysGainPct"))

        if day_pl is None or day_pl_pct is None:
            pc = _safe_float(prior, 0.0)
            if pc > 0 and last > 0:
                if day_pl is None:
                    day_pl = (last - pc) * qty
                if day_pl_pct is None:
                    day_pl_pct = ((last - pc) / pc) * 100.0
            else:
                day_pl = 0.0 if day_pl is None else _safe_float(day_pl, 0.0)
                day_pl_pct = 0.0 if day_pl_pct is None else _safe_float(day_pl_pct, 0.0)

        holdings.append(
            {
                "symbol": sym,
                "name": name,
                "opened_et": opened_str,
                "qty": qty,
                "price_paid": round(paid, 4),
                "last_price": round(last, 4),
                "value": value,
                "day_pl": round(float(_safe_float(day_pl, 0.0)), 2),
                "day_pl_pct": round(float(_safe_float(day_pl_pct, 0.0)), 2),
                "total_pl": total_pl,
                "total_pl_pct": total_pl_pct,
                "has_news": False,
            }
        )

    return holdings, round(positions_value, 2)

