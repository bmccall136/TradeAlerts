        )

        # ---- positions / holdings ----
        import json
        raw_positions = et.get_positions() or {}
        LOG.info("LIVE: positions raw type=%s keys=%s", type(raw_positions), list(raw_positions.keys()) if isinstance(raw_positions, dict) else "n/a")

