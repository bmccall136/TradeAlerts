#!/usr/bin/env python3
"""
E*TRADE OAuth1 (OOB / PIN) auth flow.
- Requests request token from api.etrade.com (or apisb.etrade.com)
- Opens authorize URL in browser
- Prompts for PIN (oauth_verifier)
- Exchanges for access token + secret
- Writes OAUTH_TOKEN / OAUTH_TOKEN_SECRET to .env
"""

import os
import sys
import webbrowser
from pathlib import Path

from authlib.integrations.requests_client import OAuth1Session


ENV_PATH = Path(__file__).resolve().parent / ".env"

KEY_OAUTH_TOKEN = "OAUTH_TOKEN"
KEY_OAUTH_TOKEN_SECRET = "OAUTH_TOKEN_SECRET"


def _get_env(name: str, default: str = "") -> str:
    return (os.getenv(name) or default).strip()


def _set_key(env_path: Path, key: str, value: str) -> None:
    # simple .env updater: replace existing key line, else append
    txt = ""
    if env_path.exists():
        txt = env_path.read_text(encoding="utf-8", errors="ignore")

    lines = txt.splitlines()
    out = []
    found = False
    for ln in lines:
        if ln.strip().startswith(key + "=") or ln.strip().startswith(key + " ="):
            out.append(f"{key}={value}")
            found = True
        else:
            out.append(ln)
    if not found:
        if out and out[-1].strip() != "":
            out.append("")
        out.append(f"{key}={value}")

    env_path.write_text("\n".join(out).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    # --- config ---
    env = _get_env("ETRADE_ENV", _get_env("ENV", "production")).lower()
    if env in ("sandbox", "sb", "test", "testing"):
        base_url = "https://apisb.etrade.com"
    else:
        base_url = "https://api.etrade.com"

    request_token_url = f"{base_url}/oauth/request_token"
    access_token_url = f"{base_url}/oauth/access_token"
    authorize_url = "https://us.etrade.com/e/t/etws/authorize"

    consumer_key = _get_env("ETRADE_API_KEY", _get_env("CONSUMER_KEY"))
    consumer_secret = _get_env("ETRADE_API_SECRET", _get_env("CONSUMER_SECRET"))

    if not consumer_key or not consumer_secret:
        print("ERROR: Missing ETRADE_API_KEY/ETRADE_API_SECRET (or CONSUMER_KEY/CONSUMER_SECRET).")
        return 2

    print("AUTH DEBUG: ETRADE_ENV =", env)
    print("AUTH DEBUG: REQUEST_TOKEN_URL =", request_token_url)
    print("AUTH DEBUG: ACCESS_TOKEN_URL  =", access_token_url)

    # --- OAuth session (OOB / PIN) ---
    oauth = OAuth1Session(
        consumer_key,
        client_secret=consumer_secret,
        callback_uri="oob",
    )

    # IMPORTANT: don't let requests pick up HTTP(S)_PROXY env vars that can hijack calls
    oauth.trust_env = False

    try:
        fetch_response = oauth.fetch_request_token(request_token_url)
    except Exception as e:
        print(f"? Failed to fetch request token: {e}")
        return 3

    resource_owner_key = fetch_response.get("oauth_token")
    resource_owner_secret = fetch_response.get("oauth_token_secret")

    if not resource_owner_key or not resource_owner_secret:
        print("ERROR: request token response missing oauth_token / oauth_token_secret")
        return 4

    oauth.auth.token = resource_owner_key
    oauth.auth.token_secret = resource_owner_secret

    auth_url = f"{authorize_url}?key={consumer_key}&token={resource_owner_key}"

    print("\n?? Opening browser to authorize E*TRADE access?")
    print("?? If nothing opens automatically, visit this URL:")
    print(auth_url)
    try:
        webbrowser.open(auth_url)
    except Exception:
        pass

    pin = input("\nEnter the PIN (verifier) from E*TRADE: ").strip()
    if not pin:
        print("ERROR: Missing PIN (oauth_verifier).")
        return 5

    try:
        tokens = oauth.fetch_access_token(access_token_url, verifier=pin)
    except Exception as e:
        print(f"? Failed to fetch access token: {e}")
        return 6

    access_token = tokens.get("oauth_token")
    access_secret = tokens.get("oauth_token_secret")

    if not access_token or not access_secret:
        print("ERROR: access token response missing oauth_token / oauth_token_secret")
        return 7

    _set_key(ENV_PATH, KEY_OAUTH_TOKEN, access_token)
    _set_key(ENV_PATH, KEY_OAUTH_TOKEN_SECRET, access_secret)

    print("\n? Saved access token to .env:")
    print(f"   {KEY_OAUTH_TOKEN}        = (hidden)")
    print(f"   {KEY_OAUTH_TOKEN_SECRET} = (hidden)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
