from pathlib import Path as _Path
import csv as _csv
import re as _re
from datetime import datetime as _dt

def _today_et_ymd() -> str:
    try:
        from zoneinfo import ZoneInfo
        et = ZoneInfo("America/New_York")
        return _dt.now(et).strftime("%Y-%m-%d")
    except Exception:
        return _dt.now().strftime("%Y-%m-%d")

def _norm_trigger_family(x: str) -> str:
    s = (x or "").strip().lower()
    s = _re.sub(r'[\s\-\_\(\)\[\]\{\}\:\;,\>\<]+', '', s)
    if "macd" in s: return "macd"
    if "vwap" in s: return "vwap"
    if "adx"  in s: return "adx"
    if "rsi"  in s: return "rsi"
    if "bb" in s or "boll" in s: return "bb"
    if "vol" in s or "volume" in s: return "vol"
    if "sma" in s: return "sma"
    if "atr" in s: return "atr"
    return s or "(blank)"

def _read_csv_rows(path: str):
    rows = []
    with open(path, newline="", encoding="utf-8", errors="ignore") as f:
        r = _csv.DictReader(f)
        for row in r:
            if isinstance(row, dict):
                rows.append(row)
    return rows

def _bucket_hold_min(x):
    if x is None: return "(na)"
    try:
        v = float(x)
    except Exception:
        return "(na)"
    if v < 0: return "(na)"
    if v < 5: return "0-5"
    if v < 15: return "5-15"
    if v < 30: return "15-30"
    if v < 60: return "30-60"
    if v < 120: return "1-2h"
    if v < 240: return "2-4h"
    if v < 480: return "4-8h"
    if v < 1440: return "8h-1d"
    return "1d+"

def _bucket_pl_pct(x):
    if x is None: return "(na)"
    try:
        v = float(x)
    except Exception:
        return "(na)"
    # percent buckets
    if v <= -5: return "<= -5%"
    if v <= -3: return "-5%..-3%"
    if v <= -2: return "-3%..-2%"
    if v <= -1: return "-2%..-1%"
    if v < 0: return "-1%..0%"
    if v < 1: return "0%..+1%"
    if v < 2: return "+1%..+2%"
    if v < 3: return "+2%..+3%"
    if v < 5: return "+3%..+5%"
    return ">= +5%"

def _compute_buy_analytics(buy_rows):
    from collections import Counter
    by_sym = Counter()
    by_trig = Counter()
    by_combo = Counter()

    # Guess trigger column name
    cols = set()
    if buy_rows:
        cols = set((buy_rows[0] or {}).keys())

    trigk = None
    for k in cols:
        kl = k.lower()
        if "signals_pretty" in kl or "signals" in kl or "trigger" in kl:
            trigk = k
            break

    symk = None
    for k in cols:
        if k.lower() in ("symbol","sym","ticker"):
            symk = k
            break

    for row in buy_rows:
        sym = ((row.get(symk) if symk else "") or "").strip().upper()
        if sym:
            by_sym[sym] += 1

        ts = (row.get(trigk) if trigk else "") or ""
        raw = _re.sub(r'[\[\]\']', '', str(ts))
        parts = [t.strip() for t in raw.split(",") if t.strip()]
        fams = sorted({_norm_trigger_family(t) for t in parts})
        for f in fams:
            by_trig[f] += 1
        if fams:
            by_combo["+".join(fams)] += 1

    return {
        "rows": len(buy_rows),
        "top_symbols": by_sym.most_common(20),
        "top_triggers": by_trig.most_common(20),
        "top_combos": by_combo.most_common(20),
    }

def _compute_sell_analytics(sell_rows):
    from collections import Counter
    actions = Counter()
    reasons = Counter()
    by_sym = Counter()
    hold_b = Counter()
    pl_b = Counter()

    for row in sell_rows:
        sym = (row.get("symbol") or "").strip().upper()
        if sym:
            by_sym[sym] += 1
        act = (row.get("action") or "").strip().upper() or "(blank)"
        actions[act] += 1
        rsn = (row.get("reason") or "").strip() or "(blank)"
        reasons[rsn] += 1

        hold_b[_bucket_hold_min(row.get("hold_min"))] += 1
        pl_b[_bucket_pl_pct(row.get("pl_pct"))] += 1

    return {
        "rows": len(sell_rows),
        "actions": actions.most_common(10),
        "reasons": reasons.most_common(10),
        "top_symbols": by_sym.most_common(20),
        "hold_buckets": hold_b.most_common(20),
        "pl_buckets": pl_b.most_common(20),
    }

