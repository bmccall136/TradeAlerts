def _ax_read_csv_rows(path: str):
    """
    Read a CSV file into a list[dict] with safe UTF-8 handling.
    Returns [] if file missing/unreadable.
    """
    try:
        import csv
        from pathlib import Path as _Path
        p = _Path(path)
        if not p.exists():
            return []
        rows = []
        with p.open("r", encoding="utf-8", errors="ignore", newline="") as f:
            r = csv.DictReader(f)
            for row in r:
                if row is None:
                    continue
                rows.append(dict(row))
        return rows
    except Exception:
        return []

def _ax_pick(row: dict, keys: list[str], default=""):
    for k in keys:
        v = row.get(k)
        if v is not None and str(v).strip() != "":
            return v
    return default

def _ax_rows_to_trades(rows: list[dict], side: str) -> list[dict]:
    """
    Normalize rows from triggers CSVs into a simple list:
      [{symbol, ts_et, reason}]
    """
    out = []
    for r in rows or []:
        sym = str(_ax_pick(r, ["symbol","Symbol","sym","ticker","Ticker"], "")).upper().strip()
        if not sym:
            continue
        ts  = _ax_pick(r, ["ts_et","time_et","timestamp_et","time","timestamp","ts"], "")
        why = _ax_pick(r, ["reason","trigger","triggers","detail","notes"], "")
        # optional side filtering if row contains it
        s = str(_ax_pick(r, ["side","action","type","order_side"], "")).upper().strip()
        if s:
            if side == "BUY" and ("SELL" in s):
                continue
            if side == "SELL" and ("BUY" in s):
                continue
        out.append({"symbol": sym, "ts_et": ts, "reason": why})
    return out[:200]


