def _tr__safe_json_loads(s):
    try:
        import json
        return json.loads(s) if s else {}
    except Exception:
        return {}

def _tr__parse_iso(s):
    # returns aware datetime or None
    try:
        from datetime import datetime
        if not s:
            return None
        ss = str(s).strip()
        if not ss:
            return None
        # normalize Z
        ss = ss.replace("Z", "+00:00")
        return datetime.fromisoformat(ss)
    except Exception:
        return None

def _tr__read_csv_rows(path):
    try:
        import csv
        rows = []
        with open(path, "r", encoding="utf-8", errors="replace", newline="") as f:
            r = csv.DictReader(f)
            for row in r:
                rows.append({k: (v if v is not None else "") for k,v in row.items()})
        return rows
    except Exception:
        return []

def _tr__latest_log_path(prefix):
    import os
    from glob import glob
    base = os.path.join(os.path.dirname(__file__), "logs")
    pat = os.path.join(base, f"{prefix}_*.csv")
    cand = glob(pat)
    if not cand:
        return None
    cand.sort(key=lambda x: os.path.getmtime(x), reverse=True)
    return cand[0]

def _tr__pick_last_events(rows, want_action, want_event, limit):
    # want_event is checked inside extra_json['event'] if present
    out = []
    for row in reversed(rows):  # newest->oldest if file is time-ascending; reverse makes newest-first
        try:
            act = (row.get("action") or "").strip().upper()
            if act != want_action:
                continue
            ex = _tr__safe_json_loads(row.get("extra_json") or "")
            ev = (ex.get("event") or row.get("event") or "").strip().upper()
            if want_event and ev != want_event:
                continue
            # need ts_et + symbol at minimum
            if not (row.get("symbol") or "").strip():
                continue
            if not (row.get("ts_et") or "").strip():
                continue
            out.append(row)
            if len(out) >= limit:
                break
        except Exception:
            continue
    return out

def _tr__find_last_buy_for_symbol(buy_rows, sym, sell_dt):
    sym = (sym or "").upper().strip()
    best = None
    best_dt = None
    for row in buy_rows:
        try:
            if (row.get("symbol") or "").upper().strip() != sym:
                continue
            ex = _tr__safe_json_loads(row.get("extra_json") or "")
            ev = (ex.get("event") or row.get("event") or "").strip().upper()
            if ev and ev != "ORDER_PLACED":
                continue
            dt = _tr__parse_iso(row.get("ts_et"))
            if not dt:
                continue
            if sell_dt and dt > sell_dt:
                continue
            if (best_dt is None) or (dt > best_dt):
                best = row
                best_dt = dt
        except Exception:
            continue
    return best, best_dt

def _tr__rows_in_window(all_rows, sym, start_dt, end_dt):
    sym = (sym or "").upper().strip()
    out = []
    for row in all_rows:
        try:
            if (row.get("symbol") or "").upper().strip() != sym:
                continue
            dt = _tr__parse_iso(row.get("ts_et"))
            if not dt:
                continue
            if start_dt and dt < start_dt:
                continue
            if end_dt and dt > end_dt:
                continue
            out.append(row)
        except Exception:
            continue
    # keep as-is (time ascending if file was)
    return out

def _tr__yahoo_intraday_series(symbol, interval="5m"):
    # Yahoo intraday only (allowed)
    try:
        import yfinance as yf
        import pandas as pd
        sym = (symbol or "").upper().strip()
        if not sym:
            return []
        t = yf.Ticker(sym)
        hist = t.history(period="1d", interval=interval, prepost=True, auto_adjust=False)
        if hist is None or hist.empty:
            # fallback
            hist = t.history(period="1d", interval="1m", prepost=True, auto_adjust=False)
        if hist is None or hist.empty:
            return []
        # normalize to list
        out = []
        for idx, row in hist.iterrows():
            try:
                ts = idx.to_pydatetime().isoformat()
                c = float(row.get("Close"))
                out.append({"t": ts, "c": c})
            except Exception:
                continue
        return out
    except Exception:
        return []

