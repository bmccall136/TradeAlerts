    value_obj = {
        "net_account_value": nav,
        "positions_value": round(_safe_float(positions_value, 0.0), 2),
        "buying_power": ui_buying_power,
    }

    # ---------- 5) TRADES TABLE ----------
    start = (request.args.get("start") or "").strip()
    days = request.args.get("days", type=int)
    max_count = request.args.get("max", default=5000, type=int)

    trades = load_trades_merged(
        days=days,
        start_iso=start,
        max_count=max_count,
    ) or []

    trades = _enrich_trades_from_realized(trades)

    # Enrich trade names AFTER trades exist
    try:
        name_map = {}
        for h in (holdings or []):
            s = (h.get("symbol") or "").strip().upper()
            n = (h.get("name") or "").strip()
