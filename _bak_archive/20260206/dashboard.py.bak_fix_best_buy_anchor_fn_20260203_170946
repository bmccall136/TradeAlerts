        holdings, positions_value = [], 0.0
        day_pnl = day_pct = 0.0
        all_time_pnl = all_time_pct = 0.0

    # ---------- 3) NAV (PREFER BROKER NAV; FALL BACK TO CASH + POSITIONS) ----------
    if nav_from_api > 0:
        nav = float(round(nav_from_api, 2))
    else:
        nav = float(round(cash_balance + _safe_float(positions_value, 0.0), 2))

    # ---------- 4) ACCOUNT OBJECT + UI BUYING POWER ----------
    # Account metadata lives under BalanceResponse (not the outer wrapper)
    acct_type = (bal.get("accountType") or acct_summary_raw.get("account_type") or "").strip()
