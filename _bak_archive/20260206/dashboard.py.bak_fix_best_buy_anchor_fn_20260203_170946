@app.route("/api/analytics/day")
def api_analytics_day():
    """
    Daily Analytics (DB-backed)

      BUYS  = buy_cooldowns.last_buy_utc (ET day bucket)
      SELLS = realized_trades.close_date (ET day bucket)

    Notes:
      - buy_cooldowns schema (confirmed): symbol, last_buy_utc, reason
      - realized_trades schema (confirmed): symbol, qty, open_date, close_date, gain, gain_pct, price_bought, price_sold
    """
    from flask import request, jsonify
    import sqlite3
    from datetime import datetime, timezone, timedelta

    # --- pick DB path safely (your project usually defines LIVE_DB or DB_PATH) ---
    db_path = None
    for name in ("LIVE_DB", "DB_PATH"):
        try:
            v = globals().get(name)
            if v:
                db_path = str(v)
                break
        except Exception:
            pass
    if not db_path:
        db_path = r"C:\TradeAlerts\live.db"

    # --- helpers ---
    def _parse_dt(s):
        if not s:
            return None
        s = str(s).strip()
        if not s:
            return None
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        try:
            dt = datetime.fromisoformat(s)
        except Exception:
            for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M:%S.%f"):
                try:
                    dt = datetime.strptime(s, fmt)
                    break
                except Exception:
                    dt = None
            if dt is None:
                return None
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)

    def _utc_to_et(dt_utc):
        try:
            from zoneinfo import ZoneInfo
            et = ZoneInfo("America/New_York")
            return dt_utc.astimezone(et)
        except Exception:
            # fallback: UTC-5 (DST edge cases near midnight only)
            return dt_utc + timedelta(hours=-5)

    def _utc_to_et_date(dt_utc):
        return _utc_to_et(dt_utc).date().isoformat()

    def _utc_to_et_ts(dt_utc):
        return _utc_to_et(dt_utc).strftime("%Y-%m-%d %H:%M:%S")

    # date=YYYY-MM-DD in ET
    date_et = (request.args.get("date") or "").strip()
    if not date_et:
        try:
            from zoneinfo import ZoneInfo
            et = ZoneInfo("America/New_York")
            date_et = datetime.now(et).date().isoformat()
        except Exception:
            date_et = datetime.utcnow().date().isoformat()

    buys = []
    sells = []
    errors = []

    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    cur = con.cursor()

    # helper to get column list
    def _cols(table):
        try:
            rows = cur.execute(f"PRAGMA table_info({table})").fetchall()
            return [r[1] for r in rows]
        except Exception:
            return []

    cols_bc = _cols("buy_cooldowns")
    cols_rt = _cols("realized_trades")

    # --- BUYS from buy_cooldowns ---
    try:
        # select only columns that exist
        sel = ["symbol", "last_buy_utc"]
        if "reason" in cols_bc:
            sel.append("reason")
        q = "SELECT " + ", ".join(sel) + " FROM buy_cooldowns WHERE last_buy_utc IS NOT NULL AND trim(last_buy_utc) <> '' ORDER BY last_buy_utc DESC"
        rows = cur.execute(q).fetchall()

        for r in rows:
            dt_utc = _parse_dt(r["last_buy_utc"])
            if not dt_utc:
                continue
            if _utc_to_et_date(dt_utc) != date_et:
                continue
            buys.append({
                "symbol": r["symbol"],
                "ts_utc": dt_utc.strftime("%Y-%m-%d %H:%M:%S"),
                "ts_et": _utc_to_et_ts(dt_utc),
                "reason": (r["reason"] if "reason" in r.keys() else "") or ""
            })
    except Exception as e:
        errors.append(f"BUYS query failed (buy_cooldowns): {e}")

    # --- SELLS from realized_trades ---
    try:
        # confirmed schema fields
        sel = ["symbol", "qty", "close_date", "gain", "gain_pct"]
        if "price_sold" in cols_rt:
            sel.append("price_sold")
        # some historical variants might have notes/reason; include if present
        if "notes" in cols_rt:
            sel.append("notes")
        if "reason" in cols_rt:
            sel.append("reason")

        q = "SELECT " + ", ".join(sel) + " FROM realized_trades WHERE close_date IS NOT NULL AND trim(close_date) <> '' ORDER BY close_date DESC"
        rows = cur.execute(q).fetchall()

        for r in rows:
            dt_utc = _parse_dt(r["close_date"])
            if not dt_utc:
                continue
            if _utc_to_et_date(dt_utc) != date_et:
                continue

            reason = ""
            if "reason" in r.keys() and r["reason"]:
                reason = r["reason"]
            elif "notes" in r.keys() and r["notes"]:
                reason = r["notes"]

            sells.append({
                "symbol": r["symbol"],
                "qty": r["qty"],
                "ts_utc": dt_utc.strftime("%Y-%m-%d %H:%M:%S"),
                "ts_et": _utc_to_et_ts(dt_utc),
                "price": (r["price_sold"] if "price_sold" in r.keys() else None),
                "gain": r["gain"],
                "gain_pct": r["gain_pct"],
                "reason": reason or ""
            })
    except Exception as e:
        errors.append(f"SELLS query failed (realized_trades): {e}")

    con.close()

    return jsonify({
        "date_et": date_et,
        "buys": buys,
        "sells": sells,
        "errors": errors,
        "source": f"DB={db_path} | BUYS=buy_cooldowns(last_buy_utc) | SELLS=realized_trades(close_date)"
    })
