def _opened_map_et_from_db(db_path: str) -> dict:
    """
    Return {SYMBOL: 'YYYY-MM-DD HH:MM'} in America/New_York from live.db position_opened.opened_utc.
    position_opened.opened_utc stored as ISO UTC string.
    """
    out = {}
    try:
        import sqlite3
        from datetime import datetime as _dt

        # zoneinfo exists in py3.9+, but keep fallback
        try:
            from zoneinfo import ZoneInfo as _ZoneInfo
            _NY = _ZoneInfo("America/New_York")
        except Exception:
            _NY = None

        con = sqlite3.connect(db_path)
        cur = con.cursor()
        cur.execute("SELECT symbol, opened_utc FROM position_opened")
        for sym, opened_utc in cur.fetchall():
            if not sym or not opened_utc:
                continue
            s = str(sym).upper().strip()
            t = str(opened_utc).strip()

            try:
                dt = _dt.fromisoformat(t.replace("Z", "+00:00"))
            except Exception:
                continue

            if _NY is not None and getattr(dt, "tzinfo", None) is not None:
                dt = dt.astimezone(_NY)

            out[s] = dt.strftime("%Y-%m-%d %H:%M")
        con.close()
    except Exception:
        pass
    return out

