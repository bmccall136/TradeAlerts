def _ax_yesterday_ymd(ymd: str | None) -> str:
    """Return yesterday (ET) for a given YYYY-MM-DD (or for today if None/invalid)."""
    import datetime as dt
    base = None
    try:
        if ymd:
            base = dt.datetime.strptime(str(ymd), "%Y-%m-%d")
    except Exception:
        base = None

    if base is None:
        try:
            import pytz
            tz = pytz.timezone("America/New_York")
            base = dt.datetime.now(tz).replace(tzinfo=None)
        except Exception:
            base = dt.datetime.now()

    return (base - dt.timedelta(days=1)).strftime("%Y-%m-%d")


