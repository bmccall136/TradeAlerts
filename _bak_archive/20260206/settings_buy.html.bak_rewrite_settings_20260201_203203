{% extends "layout.html" %}
{% block content %}

<div class="container mt-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
    <h2 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Settings</h2>

    <div class="d-flex align-items-center gap-2">
      <div class="btn-group" role="group" aria-label="Settings group">
        <a class="btn btn-sm btn-warning active" href="/settings/buy">BUY</a>
        <a class="btn btn-sm btn-outline-light" href="/settings/sell">SELL</a>
      </div>

      <div class="d-flex align-items-center gap-2">
        <div class="text-muted small">Profile</div>
        <select id="profileSel" class="form-select form-select-sm" style="width:140px;">
          <option value="day">DAY</option>
          <option value="swing">SWING</option>
        </select>
      </div>
    </div>
  </div>

  <div class="card mt-3 p-3" style="background:#0b1220;border:1px solid rgba(255,255,255,.08);border-radius:14px;">
    <h5 class="mb-1">Signal Scoreboard</h5>
    <div class="text-muted small mb-3">Counts increment even if disabled. Toggles affect eligibility only.</div>

    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
      <div class="text-muted small" style="width:60px;">Bucket</div>
      <select id="bucketSel" class="form-select form-select-sm" style="width:160px;">
        <option value="today" selected>TODAY</option>
        <option value="7d">7D</option>
        <option value="30d">30D</option>
        <option value="all">ALL</option>
      </select>
      <div id="bucketHint" class="text-muted small"></div>
    </div>

    <div id="scoreErr" class="alert alert-danger py-2 px-3" style="display:none;"></div>

    <div class="table-responsive">
      <table class="table table-dark table-sm align-middle mb-0" style="table-layout:fixed;">
        <thead>
          <tr>
            <th style="width:40%;">Indicator</th>
            <th class="text-center" style="width:20%;">Count</th>
            <th class="text-center" style="width:20%;">Enabled</th>
            <th style="width:20%;">Key</th>
          </tr>
        </thead>
        <tbody id="scoreboardBody"></tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3 p-3" style="background:#0b1220;border:1px solid rgba(255,255,255,.08);border-radius:14px;">
    <h5 class="mb-1">Required Signals Gate</h5>
    <div class="text-muted small mb-3">Minimum number of ON signals that must fire before we consider a trade.</div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div class="text-muted small" style="width:140px;">Minimum required</div>
      <select id="minReqSel" class="form-select form-select-sm" style="width:140px;"></select>
      <div id="gateHint" class="text-muted small"></div>
    </div>
  </div>

  <div class="card mt-3 p-3" style="background:#0b1220;border:1px solid rgba(255,255,255,.08);border-radius:14px;">
    <h5 class="mb-1">Settings</h5>
    <div class="text-muted small mb-3">Grouped. No raw JSON.</div>
    <div id="settingsGroups"></div>

    <div class="mt-3">
      <button id="saveBtn" class="btn btn-warning">Save</button>
      <span id="saveMsg" class="ms-3 text-muted small"></span>
    </div>
  </div>
</div>

<script>
(function(){
  "use strict";

  const GROUP = "buy";

  // BUY canonical indicator order + friendly labels
  const BUY_ORDER = [
    { key:"MACD", enable:"enable_macd" },
    { key:"RSI",  enable:"enable_rsi"  },
    { key:"VWAP", enable:"enable_vwap" },
    { key:"BB",   enable:"enable_bb"   },
    { key:"ADX",  enable:"enable_adx"  },
    { key:"VOL",  enable:"enable_vol"  },
  ];

  function byId(id){ return document.getElementById(id); }
  function normProfile(v){ v = String(v||"day").toLowerCase(); return (v==="swing") ? "swing" : "day"; }
  function prettyKey(s){
    s = String(s||"").replace(/^enable_/, "");
    s = s.replace(/_/g, " ");
    return s.toUpperCase();
  }

  let currentSettings = {};
  let scoreboardCounts = {};

  async function apiLoad(profile){
    const r = await fetch(`/api/settings/load?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "load failed");
    return (j.data && typeof j.data === "object") ? j.data : {};
  }

  async function apiSave(profile, data){
    const r = await fetch(`/api/settings/save?group=${encodeURIComponent(GROUP)}&profile=${encodeURIComponent(profile)}`, {
      method:"POST",
      headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ data })
    });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "save failed");
    return j;
  }

  async function apiScoreboard(bucket){
    const r = await fetch(`/api/settings/scoreboard?bucket=${encodeURIComponent(bucket)}`, { cache:"no-store" });
    const j = await r.json();
    if (!j || !j.ok) throw new Error((j && j.error) ? j.error : "scoreboard failed");
    // expected: { ok:true, bucket:"today", counts:{...} }
    return (j.counts && typeof j.counts === "object") ? j.counts : {};
  }

  function collectEnableKeys(obj){
    const keys = Object.keys(obj||{});
    return keys.filter(k => /^enable_/i.test(k)).sort();
  }

  function buildIndicatorListBuy(obj){
    const found = new Set();
    const out = [];

    // canonical first
    for (const it of BUY_ORDER){
      found.add(it.enable);
      out.push({
        label: it.key,
        enableKey: it.enable,
        countKey: String(it.enable).replace(/^enable_/, "").toLowerCase()
      });
    }

    // then any other enable_* keys in settings (so new toggles auto-appear)
    for (const k of collectEnableKeys(obj)){
      if (found.has(k)) continue;
      out.push({
        label: prettyKey(k),
        enableKey: k,
        countKey: String(k).replace(/^enable_/, "").toLowerCase()
      });
    }

    return out;
  }

  function renderScoreboard(indicators){
    const tbody = byId("scoreboardBody");
    tbody.innerHTML = "";

    for (const ind of indicators){
      const tr = document.createElement("tr");

      const tdLabel = document.createElement("td");
      tdLabel.textContent = ind.label;

      const tdCount = document.createElement("td");
      tdCount.className = "text-center";
      tdCount.textContent = String(scoreboardCounts[ind.countKey] || 0);

      const tdToggle = document.createElement("td");
      tdToggle.className = "text-center";
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = !!currentSettings[ind.enableKey];
      cb.addEventListener("change", () => {
        currentSettings[ind.enableKey] = !!cb.checked;
        renderGate(indicators);
        renderSettingsGroups(); // keep UI consistent with toggles
      });
      tdToggle.appendChild(cb);

      const tdKey = document.createElement("td");
      tdKey.className = "text-muted small";
      tdKey.textContent = ind.enableKey;

      tr.appendChild(tdLabel);
      tr.appendChild(tdCount);
      tr.appendChild(tdToggle);
      tr.appendChild(tdKey);

      tbody.appendChild(tr);
    }
  }

  function renderGate(indicators){
    const sel = byId("minReqSel");
    const hint = byId("gateHint");
    const enabled = indicators.filter(x => !!currentSettings[x.enableKey]);

    // choose options: 1..max(1, enabledCount)
    const maxOpt = Math.max(1, enabled.length);
    sel.innerHTML = "";
    for (let i=1; i<=maxOpt; i++){
      const opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = String(i);
      sel.appendChild(opt);
    }

    let cur = parseInt(currentSettings.required_signals_min, 10);
    if (!cur || cur < 1) cur = 1;
    if (cur > maxOpt) cur = maxOpt;
    sel.value = String(cur);
    currentSettings.required_signals_min = cur;

    sel.onchange = () => {
      const v = parseInt(sel.value, 10) || 1;
      currentSettings.required_signals_min = v;
    };

    if (hint){
      if (!enabled.length){
        hint.textContent = "No indicators enabled.";
      } else {
        hint.textContent = enabled.length + " enabled: " + enabled.map(x => x.label).join(", ");
      }
    }
  }

  function renderSettingsGroups(){
    const host = byId("settingsGroups");
    host.innerHTML = "";

    const keys = Object.keys(currentSettings||{});
    const skip = new Set(["required_signals_min"]);
    // enable_* are already handled in scoreboard
    const normal = keys.filter(k => !skip.has(k) && !/^enable_/i.test(k)).sort();

    const groups = [
      { title:"Indicator Parameters", match:(k)=> (k.startsWith("rsi_") || k.startsWith("macd_") || k.startsWith("bb_") || k.startsWith("vwap_")) },
      { title:"Risk / Trade Controls", match:(k)=> (/(max_|risk|budget|qty|limit|exposure)/i.test(k)) },
      { title:"Timing", match:(k)=> (/(interval|sleep|cooldown|timeout|minutes|hours|days)/i.test(k)) },
      { title:"Other", match:(k)=> true },
    ];

    const used = new Set();
    for (const g of groups){
      const gkeys = normal.filter(k => !used.has(k) && g.match(k));
      if (!gkeys.length) continue;
      gkeys.forEach(k => used.add(k));

      const card = document.createElement("div");
      card.className = "mb-3 p-3";
      card.style.background = "rgba(255,255,255,.03)";
      card.style.border = "1px solid rgba(255,255,255,.06)";
      card.style.borderRadius = "12px";

      const h = document.createElement("div");
      h.className = "fw-bold mb-2";
      h.textContent = g.title;

      card.appendChild(h);

      for (const k of gkeys){
        const v = currentSettings[k];

        const row = document.createElement("div");
        row.className = "d-flex align-items-center justify-content-between gap-3 py-2";
        row.style.borderTop = "1px solid rgba(255,255,255,.06)";

        const left = document.createElement("div");
        left.className = "text-muted small";
        left.textContent = k;

        const right = document.createElement("div");

        if (typeof v === "boolean"){
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.checked = !!v;
          cb.addEventListener("change", () => { currentSettings[k] = !!cb.checked; });
          right.appendChild(cb);
        } else if (typeof v === "number"){
          const inp = document.createElement("input");
          inp.type = "number";
          inp.className = "form-control form-control-sm";
          inp.style.width = "180px";
          inp.value = String(v);
          inp.addEventListener("input", () => {
            const n = Number(inp.value);
            if (!Number.isNaN(n)) currentSettings[k] = n;
          });
          right.appendChild(inp);
        } else if (typeof v === "string"){
          const inp = document.createElement("input");
          inp.type = "text";
          inp.className = "form-control form-control-sm";
          inp.style.width = "260px";
          inp.value = v;
          inp.addEventListener("input", () => { currentSettings[k] = inp.value; });
          right.appendChild(inp);
        } else {
          const span = document.createElement("span");
          span.className = "text-muted small";
          span.textContent = "(not editable)";
          right.appendChild(span);
        }

        row.appendChild(left);
        row.appendChild(right);
        card.appendChild(row);
      }

      host.appendChild(card);
    }
  }

  async function refreshAll(){
    const profileSel = byId("profileSel");
    const bucketSel = byId("bucketSel");
    const scoreErr = byId("scoreErr");
    const bucketHint = byId("bucketHint");

    const profile = normProfile(profileSel.value);
    const bucket  = String(bucketSel.value || "today").toLowerCase();

    scoreErr.style.display = "none";
    scoreErr.textContent = "";

    currentSettings = await apiLoad(profile);
    if (!currentSettings || typeof currentSettings !== "object") currentSettings = {};
    if (!("required_signals_min" in currentSettings)) currentSettings.required_signals_min = 1;

    try {
      scoreboardCounts = await apiScoreboard(bucket);
      if (bucketHint) bucketHint.textContent = "";
    } catch (e){
      scoreboardCounts = {};
      scoreErr.style.display = "block";
      scoreErr.textContent = "Scoreboard error: " + (e && e.message ? e.message : String(e));
      if (bucketHint) bucketHint.textContent = "";
    }

    const indicators = buildIndicatorListBuy(currentSettings);
    renderScoreboard(indicators);
    renderGate(indicators);
    renderSettingsGroups();
  }

  async function boot(){
    const profileSel = byId("profileSel");
    const bucketSel = byId("bucketSel");
    const saveBtn = byId("saveBtn");
    const saveMsg = byId("saveMsg");

    profileSel.addEventListener("change", refreshAll);
    bucketSel.addEventListener("change", refreshAll);

    saveBtn.addEventListener("click", async () => {
      saveMsg.textContent = "";
      const profile = normProfile(profileSel.value);
      try {
        await apiSave(profile, currentSettings);
        saveMsg.textContent = "Saved.";
      } catch (e){
        saveMsg.textContent = "Save failed: " + (e && e.message ? e.message : String(e));
      }
    });

    await refreshAll();
  }

  document.addEventListener("DOMContentLoaded", boot);
})();
</script>

{% endblock %}
