
import sqlite3
from typing import Any, Dict, Iterable, Optional

def _norm_side(v: Any) -> str:
    s = ("" if v is None else str(v)).strip().upper()
    if s in ("BUY","SELL"):
        return s
    if s in ("B","BOT"):
        return "BUY"
    if s in ("S","SLD","SOLD"):
        return "SELL"
    return s

def _safe_int(v: Any) -> Optional[int]:
    try:
        if v is None:
            return None
        if isinstance(v, bool):
            return None
        return int(float(v))
    except Exception:
        return None

def _safe_float(v: Any) -> Optional[float]:
    try:
        if v is None or v == "":
            return None
        return float(v)
    except Exception:
        return None

def ensure_trades_schema(con: sqlite3.Connection) -> None:
    cur = con.cursor()
    cur.execute(
        "CREATE UNIQUE INDEX IF NOT EXISTS idx_trades_dedupe "
        "ON trades(ts_utc, symbol, action, qty, price)"
    )
    con.commit()

def persist_trades(db_path: str, rows: Iterable[Dict[str, Any]]) -> int:
    con = sqlite3.connect(db_path)
    try:
        ensure_trades_schema(con)
        cur = con.cursor()
        wrote = 0

        for r in rows:
            ts_utc = _safe_int(r.get("ts_utc"))
            sym = ("" if r.get("symbol") is None else str(r.get("symbol"))).strip().upper()
            action = _norm_side(r.get("action") or r.get("side") or r.get("event"))
            side = _norm_side(r.get("side") or action)
            qty = _safe_int(r.get("qty"))
            price = _safe_float(r.get("price"))
            price_paid = _safe_float(r.get("price_paid"))
            pnl = _safe_float(r.get("pnl") or r.get("gain"))
            pnl_pct = _safe_float(r.get("pnl_pct") or r.get("gain_pct"))
            name = ("" if r.get("name") is None else str(r.get("name"))).strip()
            ts_et = ("" if r.get("ts_et") is None else str(r.get("ts_et"))).strip()
            opened_et = ("" if r.get("opened_et") is None else str(r.get("opened_et"))).strip()
            order_id = ("" if r.get("order_id") is None else str(r.get("order_id"))).strip()
            notes = ("" if r.get("notes") is None else str(r.get("notes"))).strip()
            trade_time = ("" if r.get("time_et") is None else str(r.get("time_et"))).strip()

            if not ts_utc or not sym or action not in ("BUY","SELL"):
                continue

            cur.execute(
                "INSERT OR IGNORE INTO trades "
                "(ts_utc, ts_et, symbol, name, side, qty, price, price_paid, pnl, pnl_pct, opened_et, order_id, notes, trade_time, action) "
                "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (
                    int(ts_utc), ts_et, sym, name, side, qty, price, price_paid,
                    pnl, pnl_pct, opened_et, order_id, notes, trade_time, action
                )
            )
            wrote += cur.rowcount

        con.commit()
        return wrote
    finally:
        try:
            con.close()
        except Exception:
            pass
