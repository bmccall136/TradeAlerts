# services/trigger_fires_db.py
# BUY-side trigger row mirror of CSV triggers_YYYY-MM-DD.csv
# DB = authoritative analytics source; CSV remains debug/audit.

import sqlite3
import time
from datetime import datetime, timezone
from pathlib import Path

def _utc_now_iso() -> str:
    # "YYYY-MM-DD HH:MM:SS" UTC
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")

def _utc_epoch() -> int:
    return int(time.time())

def ensure_trigger_fires_table(db_path: str) -> None:
    conn = sqlite3.connect(db_path)
    try:
        conn.execute("""
        CREATE TABLE IF NOT EXISTS trigger_fires (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts_utc TEXT NOT NULL,
            epoch_utc INTEGER NOT NULL,
            day_et TEXT,
            time_et TEXT,
            symbol TEXT NOT NULL,
            price REAL,
            source TEXT,
            notes TEXT,
            signals_pretty TEXT
        )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_ts ON trigger_fires(ts_utc)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_sym ON trigger_fires(symbol)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_trigger_fires_day_et ON trigger_fires(day_et)")
        conn.commit()
    finally:
        conn.close()

def insert_trigger_fire(db_path: str, symbol: str, price: float, source: str, notes: str, signals_pretty: str,
                        day_et: str | None = None, time_et: str | None = None,
                        ts_utc: str | None = None, epoch_utc: int | None = None) -> None:
    ensure_trigger_fires_table(db_path)
    ts_utc = ts_utc or _utc_now_iso()
    epoch_utc = int(epoch_utc if epoch_utc is not None else _utc_epoch())

    conn = sqlite3.connect(db_path)
    try:
        conn.execute(
            """INSERT INTO trigger_fires
               (ts_utc, epoch_utc, day_et, time_et, symbol, price, source, notes, signals_pretty)
               VALUES (?,?,?,?,?,?,?,?,?)""",
            (ts_utc, epoch_utc, day_et, time_et, symbol, price, source, notes, signals_pretty),
        )
        conn.commit()
    finally:
        conn.close()
