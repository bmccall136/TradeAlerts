import os
import json
from news_service import fetch_latest_headlines

# Just to confirm key is wired
print("NEWSAPI_KEY present:", bool(os.getenv("NEWSAPI_KEY")))

symbol = "SPY"   # or whatever you like
heads = fetch_latest_headlines(symbol, count=5)

print(f"Got {len(heads)} headlines for {symbol}:")
print(json.dumps(heads, indent=2, ensure_ascii=False))
