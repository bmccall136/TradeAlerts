# env knobs
SELL_MODE         = (os.getenv("LIVE_SELL_MODE") or "shadow").strip().lower()   # 'shadow' or 'live'
SELL_FROM         = (os.getenv("SELL_LIMIT_FROM") or "bid").strip().lower()     # 'bid' | 'last' | 'mid'
SELL_OFFSET_BPS   = float(os.getenv("SELL_LIMIT_OFFSET_BPS") or "0")            # e.g. 10 -> 0.10%
SELL_THROTTLE_MS  = int(os.getenv("SELL_THROTTLE_MS") or "30000")

# in-process throttle to avoid duplicate rapid sells per symbol
_last_sell_ms = {}
def _can_sell_now(sym: str, now_ms: int) -> bool:
    last = _last_sell_ms.get(sym, 0)
    if now_ms - last < SELL_THROTTLE_MS:
        return False
    _last_sell_ms[sym] = now_ms
    return True

def _scalp_call(symbol, qty, basis, last, bid, ask, et_mins):
    try:
        out = scalp_decide(symbol, qty, basis, last, bid, ask, et_mins, SCALP_CFG) or {}
        if SELL_OFFSET_BPS and out.get("limit_px") is not None:
            # apply offset in basis points (downward adjustment for sells)
            out = dict(out)
            px  = float(out["limit_px"])
            out["limit_px"] = px * (1.0 - SELL_OFFSET_BPS / 10000.0)
        return out
    except Exception as e:
        return {"action": "HOLD", "error": f"scalp_decide failed: {e}"}
# ──────────────────────────────────────────────────────────────────────────────

def _scalp_call(sym, qty, basis, last, bid, ask, held_mins):
    """
    Adapter to the scalp_gate.decide() kwargs API.
    - sym: str
    - qty, basis, last, bid, ask: numbers (can be None; the gate will no-op)
    - held_mins: minutes held (or None)
    """
    seconds_held = (held_mins * 60) if (held_mins is not None) else None
    return scalp_decide(
        mkt={"last": last, "bid": bid, "ask": ask},
        position={"symbol": sym, "qty": qty, "price_paid": basis},
        cfg=SCALP_CFG,
        seconds_held=seconds_held,
    )

except Exception:
    # Safe fallback so the app still runs if the module is missing
    from dataclasses import dataclass
    @dataclass
    class ScalpCfg:
        tp_bps: int = 40
        sl_bps: int = 60
        min_hold_sec: int = 0
        max_hold_sec: int = 86400
        ref: str = "bid"
        offset_bps: int = 0
        throttle_ms: int = 30000
    def scalp_decide(**kwargs):
        return None

# --- loud E*TRADE logging wrapper (module-scope; not inside live_status) ---
_ET_LOG_WRAPPED = False

# ─────────────────────────────────────────────────────────────────────────────
# DROP-IN: FIFO realized P&L + row enrichment for trades
# Returns: (enriched_trades, realized_today, realized_today_pct)
# Each trade in `trades` should have: symbol, action ("BUY"/"SELL"), qty, price,
# and one of time_utc / time / time_et (ISO or epoch ms).
# ─────────────────────────────────────────────────────────────────────────────
# --- Scalp gate + small utilities ---
import os, json, time

_POS_STATE = {}  # sym -> {"entry_ms": int, "qty": float, "basis": float}

def _ensure_dir(p):
    os.makedirs(p, exist_ok=True)
    return p

_LOG_DIR = _ensure_dir(os.path.join(os.getcwd(), "logs"))
_SIGNALS_FILE = os.path.join(_LOG_DIR, "sell_signals.ndjson")

def _append_ndjson(path, obj):
    try:
        obj = dict(obj)
        obj.setdefault("ts", int(time.time()*1000))
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(obj) + "\n")
    except Exception:
        pass

def _send_sell_limit(et, sym: str, qty: int, limit_price: float, logger=None):
    """
    Best-effort wrapper. Uses preview if available, then places a DAY LIMIT sell.
    Returns (ok: bool, detail: str|dict)
    """
    try:
        qty = int(qty)
        px  = float(limit_price)
        if qty <= 0 or px <= 0:
            return False, "bad_qty_or_price"

        # 1) preview if available
        preview = getattr(et, "preview_equity_order", None) or getattr(et, "preview_order", None)
        place   = (getattr(et, "place_equity_order", None) or
                   getattr(et, "place_order", None))

        if preview:
            try:
                _ = preview(symbol=sym, side="SELL", qty=qty, orderType="LIMIT", limitPrice=px, duration="DAY")
            except Exception as pe:
                if logger: logger.warning("[SELL] preview failed for %s: %s", sym, pe)

        if not place:
            return False, "place_order_not_available"

        # 2) place limit order at/near bid
        resp = place(symbol=sym, side="SELL", qty=qty, orderType="LIMIT", limitPrice=px, duration="DAY")
        return True, resp
    except Exception as e:
        return False, f"exception: {e}"

def _update_pos_state(holdings):
    now_ms = int(time.time()*1000)
    live = set()
    for h in holdings:
        s = (h.get("symbol") or "").upper()
        q = float(h.get("qty") or 0)
        b = float(h.get("price_paid") or 0)
        if s and q > 0:
            live.add(s)
            rec = _POS_STATE.get(s)
            if not rec or rec.get("qty", 0) <= 0:
                _POS_STATE[s] = {"entry_ms": now_ms, "qty": q, "basis": b}
            else:
                _POS_STATE[s].update(qty=q, basis=b)
    for s in list(_POS_STATE.keys()):
        if s not in live:
            _POS_STATE.pop(s, None)

def _et_minutes_to_close():
    try:
        import datetime as _dt
        try:
            import zoneinfo as _zi
            _ET = _zi.ZoneInfo("America/New_York")
        except Exception:
            _ET = _dt.timezone(_dt.timedelta(hours=-5))
        now = _dt.datetime.now(tz=_ET)
        # weekend -> next weekday close
        if now.weekday() >= 5:
            days = (7 - now.weekday()) % 7 or 1
            now = (now + _dt.timedelta(days=days)).replace(tzinfo=_ET)
        close = now.replace(hour=16, minute=0, second=0, microsecond=0)
        return int((close - now).total_seconds() // 60)
    except Exception:
        return None

def _fifo_realized_today(trades):
    import datetime as _dt

    def _to_f(x):
        try:
            if x is None: return None
            if isinstance(x, (int, float)): return float(x)
            return float(str(x).replace(",", "").strip())
        except Exception:
            return None

    def _safe_float(x, d=0.0):
        try: return float(x)
        except Exception: return float(d)

    def _to_ts(val) -> int:
        """Epoch milliseconds from mixed inputs (int ms/s, ISO, or ET string)."""
        try:
            if isinstance(val, (int, float)):
                v = float(val)
                return int(v if v > 10_000_000_000 else v * 1000)
            s = str(val or "")
            if " " in s and "T" not in s:
                s = s.replace(" ", "T")
            if "Z" not in s and "+" not in s:
                s += "Z"
            dt = _dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
            return int(dt.timestamp() * 1000)
        except Exception:
            return 0

    today = _dt.datetime.utcnow().date()
    lots = {}  # sym -> [[qty, px], ...] FIFO
    realized_today = 0.0
    realized_basis = 0.0
    enriched = []

    # process buys -> sells in chronological order
    rows = sorted(trades or [], key=lambda r: _to_ts(r.get("time_utc") or r.get("time") or r.get("time_et")))

    for t in rows:
        sym  = (t.get("symbol") or "").upper()
        side = (t.get("action") or "").upper()
        qty  = int(_safe_float(t.get("qty")))
        px   = _to_f(t.get("price"))
        ts   = _to_ts(t.get("time_utc") or t.get("time") or t.get("time_et"))
        date = _dt.datetime.utcfromtimestamp(ts/1000.0).date() if ts else today

        if not sym or qty <= 0 or (px or 0) <= 0:
            enriched.append(dict(t))
            continue

        lots.setdefault(sym, [])

        if side == "BUY":
            lots[sym].append([qty, px])
            row = dict(t)
            row["price_paid"] = _to_f(row.get("price_paid")) or px
            row["pl"] = _to_f(row.get("pl")) or 0.0
            row["pl_pct"] = _to_f(row.get("pl_pct")) or 0.0
            enriched.append(row)
            continue

        if side == "SELL":
            remain = qty
            basis_cost = 0.0
            basis_shares = 0

            while remain > 0 and lots[sym]:
                lot_qty, lot_px = lots[sym][0]
                take = min(remain, lot_qty)
                basis_cost   += take * lot_px
                basis_shares += take
                lot_qty      -= take
                remain       -= take
                if lot_qty == 0:
                    lots[sym].pop(0)
                else:
                    lots[sym][0][0] = lot_qty

            avg_basis = (basis_cost / basis_shares) if basis_shares else 0.0
            pnl       = (px - avg_basis) * basis_shares if basis_shares else 0.0
            pnl_pct   = ((px / avg_basis - 1.0) * 100.0) if avg_basis else 0.0

            row = dict(t)
            if avg_basis:
                row["price_paid"] = round(avg_basis, 2)
            row["pl"]     = round(pnl, 2)
            row["pl_pct"] = round(pnl_pct, 2)
            enriched.append(row)

            if date == today and basis_shares:
                realized_today += pnl
                realized_basis += (avg_basis * basis_shares)
            continue

        # any other action: pass through
        enriched.append(dict(t))

    realized_today_pct = round((realized_today / realized_basis * 100.0), 2) if realized_basis > 0 else 0.0
    return enriched, round(realized_today, 2), realized_today_pct

def _etrade_log_wrap():
    """Wrap etrade_service get_quotes/get_quote so we SEE calls in Flask logs."""
    global _ET_LOG_WRAPPED
    if _ET_LOG_WRAPPED:
        return
    try:
        from services import etrade_service as et
    except Exception:
        return

    import functools

    def _wrap(name):
        fn = getattr(et, name, None)
        if not callable(fn):
            return

        @functools.wraps(fn)
        def wrapper(*args, **kwargs):
            try:
                # current_app is available when called from a request (like live_status)
                from flask import current_app
                if current_app and current_app.logger:
                    current_app.logger.info("[E*TRADE.%s] CALL args=%s kwargs=%s", name, args, kwargs)
            except Exception:
                pass

            result = fn(*args, **kwargs)

            try:
                from flask import current_app
                if current_app and current_app.logger:
                    current_app.logger.info("[E*TRADE.%s] OK -> %s", name, type(result).__name__)
            except Exception:
                pass

            return result

        setattr(et, name, wrapper)

    for nm in ("get_quotes", "get_quote"):
        _wrap(nm)

    _ET_LOG_WRAPPED = True

