# Try to use your real strategy; otherwise safe fallback.
try:
    from services.strategy.scalp_gate import ScalpCfg, decide as scalp_decide
    SCALP_CFG = ScalpCfg()
except Exception:
    class SCALP_CFG:  # tiny stub so app still runs
        tp_bps = 40
        sl_bps = 60
        min_hold_sec = 0
        max_hold_sec = 86400
        ref = "bid"
        offset_bps = 0
        throttle_ms = 30000
    def scalp_decide(**kwargs):
        # Always HOLD in fallback
        return {"action": "HOLD", "reason": "strategy module unavailable"}

# Env knobs (A/B mode)
SELL_MODE        = (os.getenv("LIVE_SELL_MODE") or "shadow").strip().lower()  # 'shadow' or 'live'
SELL_FROM        = (os.getenv("SELL_LIMIT_FROM") or "bid").strip().lower()    # 'bid' | 'last' | 'mid'
SELL_OFFSET_BPS  = float(os.getenv("SELL_LIMIT_OFFSET_BPS") or "0")           # 10 -> 0.10%
SELL_THROTTLE_MS = int(os.getenv("SELL_THROTTLE_MS") or "30000")

# In-process throttle to avoid duplicate rapid sells per symbol
_last_sell_ms: dict[str, int] = {}
def _can_sell_now(sym: str, now_ms: int) -> bool:
    last = _last_sell_ms.get(sym, 0)
    if now_ms - last < SELL_THROTTLE_MS:
        return False
    _last_sell_ms[sym] = now_ms
    return True

# Minimal persistent state: when did we first see the position, qty, and basis
_POS_STATE: dict[str, dict] = {}  # {SYM: {"entry_ms": int, "qty": float, "basis": float}}

def _update_pos_state(holdings: list[dict]) -> None:
    """Track first-seen time for live positions (for hold time)."""
    now_ms = int(time.time() * 1000)
    live = set()
    for h in holdings or []:
        s = (h.get("symbol") or "").upper()
        q = float(h.get("qty") or 0)
        b = float(h.get("price_paid") or 0)
        if s and q > 0:
            live.add(s)
            rec = _POS_STATE.get(s)
            if not rec or rec.get("qty", 0) <= 0:
                _POS_STATE[s] = {"entry_ms": now_ms, "qty": q, "basis": b}
            else:
                # keep earliest entry_ms; refresh qty/basis if changed
                rec["qty"] = q
                rec["basis"] = b
    # Clear symbols no longer held
    for s in [k for k in _POS_STATE.keys() if k not in live]:
        del _POS_STATE[s]

def _held_minutes(sym: str) -> float | None:
    rec = _POS_STATE.get(sym.upper())
    if not rec: return None
    return max(0.0, (time.time()*1000 - rec["entry_ms"]) / 60000.0)

def _append_ndjson(path: str, obj: dict):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        row = dict(obj); row.setdefault("ts", int(time.time()*1000))
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row) + "\n")
    except Exception:
        pass

# Where to log shadow/live signals
_SIGNALS_FILE = os.path.join(os.getcwd(), "logs", "sell_signals.ndjson")

def _send_sell_limit(et, sym: str, qty: int, limit_price: float, logger=None) -> tuple[bool, str | dict]:
    """Preview then place a DAY LIMIT sell; returns (ok, detail)."""
    try:
        qty = int(qty); px = float(limit_price)
        if qty <= 0 or px <= 0: return False, "bad_qty_or_price"

        preview = getattr(et, "preview_equity_order", None) or getattr(et, "preview_order", None)
        place   = (getattr(et, "place_equity_order", None)  or getattr(et, "place_order", None))

        if preview:
            try:
                _ = preview(symbol=sym, side="SELL", qty=qty, orderType="LIMIT", limitPrice=px, duration="DAY")
            except Exception as pe:
                if logger: logger.warning("[SELL] preview failed for %s: %s", sym, pe)

        if not place:
            return False, "place_order_not_available"

        resp = place(symbol=sym, side="SELL", qty=qty, orderType="LIMIT", limitPrice=px, duration="DAY")
        return True, resp
    except Exception as e:
        return False, f"exception: {e}"

def _decide_and_maybe_sell(et, s: str, qty: float, basis: float, qmap: dict, logger=None) -> dict:
    """
    s: symbol; qty/basis: from holdings; qmap[s] should have last/bid/ask
    Returns a dict with decision info (for logging/ui).
    """
    sU = s.upper()
    q  = qmap.get(sU, {})
    last = q.get("last"); bid = q.get("bid"); ask = q.get("ask")

    held_mins = _held_minutes(sU)
    # Strategy entrypoint (your module if available)
    out = (scalp_decide(
        mkt={"last": last, "bid": bid, "ask": ask},
        position={"symbol": sU, "qty": qty, "price_paid": basis},
        cfg=SCALP_CFG,
        seconds_held=(held_mins * 60 if held_mins is not None else None),
    ) or {})

    # Choose limit price source
    ref_px = None
    if SELL_FROM == "bid" and bid:   ref_px = float(bid)
    elif SELL_FROM == "mid" and bid and ask: ref_px = (float(bid) + float(ask)) / 2.0
    else:                             ref_px = float(last or 0)  # fallback to last

    # Strategy can override via out["limit_px"]
    limit_px = float(out.get("limit_px") or ref_px or 0)
    if SELL_OFFSET_BPS and limit_px > 0:
        limit_px *= (1.0 - SELL_OFFSET_BPS / 10000.0)

    decision = (out.get("action") or "").upper()
    row = {
        "symbol": sU, "qty": qty, "basis": basis,
        "last": last, "bid": bid, "ask": ask,
        "held_mins": held_mins,
        "decision": decision or "HOLD",
        "limit_px": round(limit_px, 2) if limit_px else None,
        "mode": SELL_MODE,
    }

    # Shadow logging
    _append_ndjson(_SIGNALS_FILE, {"type":"signal", **row})

    # Live placement (B mode)
    if decision == "SELL" and SELL_MODE == "live" and limit_px and _can_sell_now(sU, int(time.time()*1000)):
        ok, detail = _send_sell_limit(et, sU, int(qty), limit_px, logger=logger)
        row["placed"] = bool(ok)
        row["place_detail"] = detail if not ok else "ok"
        _append_ndjson(_SIGNALS_FILE, {"type":"place", **row})
    return row
# ==============================================================================

# mode: 'off' | 'shadow' | 'live'
LIVE_SELL_MODE = (os.getenv("LIVE_SELL_MODE") or "shadow").lower().strip()

_POS_STATE = {}  # sym -> {"entry_ms": int, "qty": float, "basis": float}
_LAST_SELL_MS = {}  # throttle per symbol

def _now_ms():
    return int(time.time() * 1000)

def _update_pos_state(holdings):
    now = _now_ms()
    live = set()
    for h in holdings or []:
        s = (h.get("symbol") or "").upper()
        q = float(h.get("qty") or 0)
        b = float(h.get("price_paid") or 0)
        if s and q > 0:
            live.add(s)
            if s not in _POS_STATE or _POS_STATE[s].get("qty", 0) <= 0:
                _POS_STATE[s] = {"entry_ms": now, "qty": q, "basis": b}
            else:
                _POS_STATE[s].update(qty=q, basis=b)
    for s in list(_POS_STATE.keys()):
        if s not in live:
            _POS_STATE.pop(s, None)

def _et_minutes_to_close():
    try:
        import datetime as _dt
        try:
            import zoneinfo as _zi
            _ET = _zi.ZoneInfo("America/New_York")
        except Exception:
            _ET = _dt.timezone(_dt.timedelta(hours=-5))
        now = _dt.datetime.now(tz=_ET)
        if now.weekday() >= 5:
            # weekend: next business day 16:00
            days = (7 - now.weekday()) % 7 or 1
            now = (now + _dt.timedelta(days=days)).replace(tzinfo=_ET)
        close = now.replace(hour=16, minute=0, second=0, microsecond=0)
        return int((close - now).total_seconds() // 60)
    except Exception:
        return None

def _safe_float(val, default: float = 0.0) -> float:
    """
    Parse floats safely from numbers/strings like '$145.85', '1,234.56', or None.
    Returns `default` on any failure.
    """
    if val is None:
        return default
    try:
        if isinstance(val, str):
            s = val.strip().replace('$', '').replace(',', '')
            if s == '':
                return default
            return float(s)
        return float(val)
    except Exception:
        return default

def _fmt_trade_time(ts) -> str:
    """Return a nice local time string from E*TRADE timestamps."""
    if ts in (None, "", 0):
        return ""
    try:
        # numeric? (ms or sec)
        if isinstance(ts, (int, float)) or (isinstance(ts, str) and ts.isdigit()):
            v = float(ts)
            if v > 1e12:  # ms -> sec
                v /= 1000.0
            dt = datetime.fromtimestamp(v, tz=timezone.utc)
        else:
            # ISO-ish (handle trailing Z)
            dt = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
        return dt.astimezone().strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        # last resort: just echo the value
        return str(ts)

def get_recent_trades_and_realized(days:int=2):
    """
    Returns:
      trades: [{time, symbol, action, qty, price, amount}]
      realized: float  (best-effort; uses API gain if available, else 0)
    """
    orders = list_executed_orders(days)
    trades = []

    # ---- normalize orders into simple trades list ----
    # Adjust keys to your existing JSON shapes if needed.
    for o in orders.get("OrderListResponse", {}).get("orders", []):
        ts = o.get("placedTime") or o.get("executedTime") or o.get("updateTime")
        for leg in o.get("orderLegs", []):
            sym = (leg.get("symbol") or "").upper()
            side = leg.get("side") or o.get("orderAction")  # "BUY"/"SELL"
            for ex in (leg.get("executions") or []):
                price = float(ex.get("avgExecPrice") or ex.get("price") or 0)
                qty   = int(ex.get("quantity") or 0)
                amt   = round(price * qty * (1 if side == "SELL" else -1), 2)
                trades.append({
                    "time": ts,
                    "symbol": sym,
                    "action": side,
                    "qty": qty,
                    "price": price,
                    "amount": amt,
                })

    # ---- realized P&L (best available) ----
    realized = 0.0
    tx = list_trade_transactions(days)
    for t in tx.get("TransactionListResponse", {}).get("transactions", []):
        # Many payloads include either explicit gain/loss OR just cash amounts.
        gain = t.get("gainLoss") or t.get("gain") or None
        if gain is not None:
            try:
                realized += float(gain)
                continue
            except Exception:
                pass
        # If no explicit gain, we don’t synthesize here (needs lot cost basis).
        # Leave it 0.0 rather than guessing. Your tax-lot endpoint (if enabled)
        # can be used later for exact realized.
        # Tip: If you already store avg cost per symbol in your DB, you can
        # compute realized for fully-closed symbols here.

    # newest-first
    trades.sort(key=lambda x: str(x["time"]), reverse=True)
    return trades, round(realized, 2)

def _get(path: str, params=None):
    r = requests.get(BASE_URL + path, params=params or {}, auth=_oauth1(), headers={"Accept":"application/json"})
    r.raise_for_status()
    return r

def _http_get(path: str, params: dict | None = None) -> dict:
    base = "https://api.etrade.com"
    r = requests.get(base + path, params=params or {}, auth=_oauth1())
    if r.status_code in (401,403):
        raise RuntimeError(f"E*TRADE auth error {r.status_code}: {r.text}")
    r.raise_for_status()
    return r.json()

def fetch_etrade_quote(symbol: str):
    j = _get(f"/v1/market/quote/{symbol}.json").json()
    try:
        qd  = j["QuoteResponse"]["QuoteData"][0]
        all = qd.get("All", {})
        last = (all.get("ExtendedHourQuoteDetail", {}) or {}).get("lastPrice") \
               or all.get("lastTrade") \
               or all.get("closePrice")
        return float(last)
    except Exception:
        return j

def _primary_account_id():
    j = _get("/v1/accounts/list.json").json()
    accts = j.get("AccountListResponse",{}).get("Accounts",{}).get("Account",[])
    if isinstance(accts, dict): accts = [accts]
    if not accts: raise RuntimeError("No E*TRADE accounts returned")
    return accts[0].get("accountIdKey") or accts[0].get("accountId")

def get_account_summary():
    aid = _primary_account_id()
    return _get(f"/v1/accounts/{aid}/balance.json", params={"instType":"BROKERAGE"}).json()

def get_positions():
    aid = _primary_account_id()
    return _get(f"/v1/accounts/{aid}/portfolio.json", params={"instType":"BROKERAGE"}).json()

