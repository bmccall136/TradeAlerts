import json
from env_alias_shim import ensure_env_aliases
ensure_env_aliases()

# Import the trading service the same way sell_guard does
try:
    from services import etrade_service as et
except Exception:
    import etrade_service as et

print("Mapped keys present?:", {
    k: bool(__import__("os").getenv(k))
    for k in ["ETRADE_CONSUMER_KEY","ETRADE_CONSUMER_SECRET","ETRADE_OAUTH_TOKEN","ETRADE_OAUTH_SECRET","ETRADE_ACCOUNT_ID_KEY"]
})

aid = et.account_id_key()
print("account_id_key:", aid)

# Harmless PREVIEW to prove order auth path (no live order)
try:
    if hasattr(et, "preview_equity_order"):
        prev = et.preview_equity_order(aid, symbol="SPY", quantity=1, price=None, price_type="MARKET", action="SELL")
    elif hasattr(et, "preview_order"):
        prev = et.preview_order(aid, symbol="SPY", qty=1, price=None, order_type="MARKET", side="SELL")
    elif hasattr(et, "place_order"):
        prev = et.place_order(aid, symbol="SPY", side="SELL", qty=1, price=None, order_type="MARKET", preview=True)
    else:
        raise RuntimeError("No preview-capable function found on etrade_service")
    print("PREVIEW OK")
    print(json.dumps(prev, indent=2)[:1500], "...")
except Exception as e:
    print("PREVIEW FAILED:", repr(e))
