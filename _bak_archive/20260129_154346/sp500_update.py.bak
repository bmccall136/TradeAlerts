# sp500_update.py
# Refreshes C:\TradeAlerts\sp500_symbols.txt from Wikipedia (S&P 500 constituents).
# Keeps dot-class tickers (BRK.B, BF.B). One symbol per line, uppercase, deduped, sorted.

import sys, io, re

WIKI_URL = "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"
OUTPUT   = "sp500_symbols.txt"

def _normalize(sym: str) -> str:
    # Strip, uppercase, collapse spaces
    s = (sym or "").strip().upper()
    # Wikipedia sometimes includes footnote markers; remove anything not [A-Z0-9._-]
    s = re.sub(r"[^A-Z0-9.\-_]", "", s)
    # Ensure we keep dot-class tickers as-is (E*TRADE: BRK.B, BF.B)
    return s

def _unique_sorted(symbols):
    # Keep order-insensitive stable list (dedupe then sort)
    uniq = sorted(set(filter(None, symbols)))
    return uniq

def fetch_with_pandas():
    import pandas as pd
    # First table on the page contains constituents
    tables = pd.read_html(WIKI_URL)
    if not tables:
        raise RuntimeError("No tables found on Wikipedia page.")
    # Find the table that has a 'Symbol' column
    tbl = None
    for t in tables:
        if any(str(c).strip().lower() == "symbol" for c in t.columns):
            tbl = t
            break
    if tbl is None:
        raise RuntimeError("Could not find a table with a 'Symbol' column.")
    syms = [_normalize(x) for x in tbl["Symbol"].tolist()]
    return _unique_sorted(syms)

def fetch_with_bs4():
    import requests
    from bs4 import BeautifulSoup
    html = requests.get(WIKI_URL, timeout=20).text
    soup = BeautifulSoup(html, "html.parser")
    table = soup.find("table", {"id": "constituents"}) or soup.find("table", {"class": "wikitable"})
    if table is None:
        raise RuntimeError("Could not find the constituents table.")
    # The first column in that table is Symbol. Extract all rows (skip header).
    symbols = []
    for tr in table.select("tr")[1:]:
        td = tr.find("td")
        if not td:
            continue
        sym = td.get_text(strip=True)
        symbols.append(_normalize(sym))
    return _unique_sorted(symbols)

def main():
    # Try pandas first (more robust), fall back to requests+bs4 if pandas not installed.
    syms = None
    try:
        syms = fetch_with_pandas()
        source = "pandas"
    except Exception as e_pd:
        try:
            syms = fetch_with_bs4()
            source = "bs4"
        except Exception as e_bs:
            print("[ERROR] Could not fetch S&P 500 symbols.")
            print(" pandas error:", e_pd)
            print(" bs4 error:   ", e_bs)
            sys.exit(1)

    # Some sanity tweaks: keep known dot-class; remove empties already handled.
    # (If you need hard filters, add them here.)
    with io.open(OUTPUT, "w", encoding="utf-8", newline="\n") as f:
        for s in syms:
            f.write(s + "\n")

    print(f"[OK] Wrote {len(syms)} symbols to {OUTPUT} (source={source}).")

if __name__ == "__main__":
    main()
