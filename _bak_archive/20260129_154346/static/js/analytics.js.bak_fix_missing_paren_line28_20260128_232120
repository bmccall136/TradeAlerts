      if (box){
        box.innerHTML = `<div style="color:#ff7b7b;white-space:pre-wrap;">loadTodayTrades error:
${String(e && e.stack ? e.stack : e)}</div>`;
      }console.error("[Daily Analytics] loadTodayTrades failed:", e);
    }

}      // If API doesn't provide per-row buys, fall back to buy.top_symbols (signals summary)
      if ((!buysArr || !buysArr.length) && buy && Array.isArray(buy.top_symbols) && buy.top_symbols.length){
        buysArr = buy.top_symbols.map(([sym, cnt]) => ({
          symbol: sym,
          ts_et: (data && data.date_et ? (data.date_et + " (signals: " + cnt + ")") : ("signals: " + cnt))
