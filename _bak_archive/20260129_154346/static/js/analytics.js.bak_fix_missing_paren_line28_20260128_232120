      console.error("[Daily Analytics] today trades load failed:", e);
      const box = el("ax-today-trades");
      if (box) box.innerHTML = `<div style="color:#ff7b7b;white-space:pre-wrap;">${String(e && e.stack ? e.stack : e)}</div>`;
