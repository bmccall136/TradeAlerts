      console.error('[Daily Analytics] unhandledrejection:', ev.reason);
      if (ev.reason && ev.reason.stack) console.error(ev.reason.stack);
    } catch (e) {}
  });

  window.__axDumpIdsOnce = function __axDumpIdsOnce(tag) {
    try {
      if (window.__axDumped) return;
      window.__axDumped = true;
      const ids = Array.from(document.querySelectorAll('[id]')).map(e => e.id).filter(Boolean);
