/* $$Machine Daily Analytics JS (date-aware, no duplicate globals) */

(function () {
  "use strict";

  function getQueryParam(name) {
    try {
      const url = new URL(window.location.href);
      return url.searchParams.get(name);
    } catch (e) {
      return null;
    }
  }

  function currentDateYMD() {
    // Prefer server-provided date chip value if present, then URL param, then today
    const urlDate = getQueryParam("date");
    if (urlDate && /^\d{4}-\d{2}-\d{2}$/.test(urlDate)) return urlDate;

    // If template injected window.__AX_DATE, use it
    if (window.__AX_DATE && /^\d{4}-\d{2}-\d{2}$/.test(window.__AX_DATE)) return window.__AX_DATE;

    const d = new Date();
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    return `${yyyy}-${mm}-${dd}`;
  }

  function ymdMinusOne(ymd) {
    try {
      const [y, m, d] = ymd.split("-").map(Number);
      const dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() - 1);
      const yyyy = dt.getFullYear();
      const mm = String(dt.getMonth() + 1).padStart(2, "0");
      const dd = String(dt.getDate()).padStart(2, "0");
      return `${yyyy}-${mm}-${dd}`;
    } catch (e) {
      return ymd;
    }
  }

  function setDateChip(ymd) {
    const chip = document.getElementById("ax-date-chip");
    if (chip) chip.textContent = ymd;
  }

  async function fetchJSON(url) {
    const r = await fetch(url, { cache: "no-store" });
    if (!r.ok) throw new Error(`${url} -> HTTP ${r.status}`);
    return await r.json();
  }

  function apiURL(path, ymd) {
    const u = new URL(path, window.location.origin);
    if (ymd) u.searchParams.set("date", ymd);
    // cache bust
    u.searchParams.set("_", String(Date.now()));
    return u.toString();
  }

  function wireYesterdayButton(ymd) {
    const btn = document.getElementById("ax-yesterday-btn");
    if (!btn) return;

    btn.addEventListener("click", function (e) {
      e.preventDefault();
      const y = ymdMinusOne(ymd);
      const u = new URL(window.location.href);
      u.searchParams.set("date", y);
      window.location.href = u.toString();
    });
  }

  // ---- main ----
  document.addEventListener("DOMContentLoaded", async function () {
    const ymd = currentDateYMD();
    setDateChip(ymd);
    wireYesterdayButton(ymd);

    try {
      const data = await fetchJSON(apiURL("/api/analytics/today", ymd));

      // IMPORTANT:
      // This file assumes your existing page already has functions that render charts/cards
      // using the "data" payload. If your prior analytics.js had a renderAnalytics(data),
      // keep that function name and call it here.

      if (typeof window.renderDailyAnalytics === "function") {
        window.renderDailyAnalytics(data);
      } else if (typeof renderDailyAnalytics === "function") {
        renderDailyAnalytics(data);
      } else if (typeof window.renderAnalytics === "function") {
        window.renderAnalytics(data);
      } else if (typeof renderAnalytics === "function") {
        renderAnalytics(data);
      } else {
        // Fallback: at least populate the basic counts if the DOM IDs exist
        const buyN = document.getElementById("buy-rows");
        const sellN = document.getElementById("sell-rows");
        if (buyN && data && data.buy && typeof data.buy.row_count === "number") buyN.textContent = data.buy.row_count;
        if (sellN && data && data.sell && typeof data.sell.row_count === "number") sellN.textContent = data.sell.row_count;
        console.warn("[Daily Analytics] No renderer found (renderDailyAnalytics/renderAnalytics). Data loaded though.");
      }
    } catch (err) {
      console.error("[Daily Analytics] analytics load failed:", err);
      const el = document.getElementById("ax-error");
      if (el) el.textContent = String(err);
    }
  });
})();
