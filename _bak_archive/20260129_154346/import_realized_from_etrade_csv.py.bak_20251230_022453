import csv
import sqlite3
import sys
import re
from datetime import datetime

DB_PATH = r"C:\TradeAlerts\live.db"

def _to_float(x):
    if x is None:
        return 0.0
    s = str(x).strip()
    if not s or s == "--":
        return 0.0
    # strip $, commas, and whitespace
    s = s.replace("$", "").replace(",", "").strip()
    # handle parentheses (accounting negative)
    if s.startswith("(") and s.endswith(")"):
        s = "-" + s[1:-1].strip()
    try:
        return float(s)
    except Exception:
        return 0.0

def _to_iso_date(mdy):
    s = str(mdy).strip()
    if not s or s == "--":
        return None
    # E*TRADE is usually M/D/YYYY
    try:
        dt = datetime.strptime(s, "%m/%d/%Y")
        return dt.date().isoformat()
    except Exception:
        # sometimes 1-digit month/day still matches above; if not, bail
        return None

def ensure_table(conn):
    cur = conn.cursor()
    cur.execute("""
    CREATE TABLE IF NOT EXISTS realized_trades (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        symbol TEXT,
        action TEXT,
        qty REAL,
        close_date TEXT,
        gain REAL
    )
    """)
    cur.execute("CREATE INDEX IF NOT EXISTS idx_realized_close_date ON realized_trades(close_date)")
    cur.execute("CREATE INDEX IF NOT EXISTS idx_realized_symbol ON realized_trades(symbol)")
    conn.commit()

def import_etrade_gains_losses(csv_path, db_path=DB_PATH):
    inserted = 0
    skipped = 0

    conn = sqlite3.connect(db_path)
    ensure_table(conn)
    cur = conn.cursor()

    with open(csv_path, "r", encoding="utf-8-sig", newline="") as f:
        r = csv.reader(f)

        # 1) Seek to TAXABLE G&L DETAILS header
        header = None
        for row in r:
            if not row:
                continue
            if row[0].strip().upper() == "TAXABLE G&L DETAILS":
                # next non-empty row is the header row
                for row2 in r:
                    if row2 and any(c.strip() for c in row2):
                        header = [c.strip() for c in row2]
                        break
                break

        if not header:
            raise SystemExit("Could not find 'TAXABLE G&L DETAILS' section in CSV.")

        # 2) Build column index map
        # NOTE: header contains "Date" twice. We want the 2nd one as the SELL date.
        def idx(name):
            try:
                return header.index(name)
            except ValueError:
                return None

        idx_symbol = idx("Symbol")
        idx_qty    = idx("Quantity")
        idx_gain   = idx("Gain $")
        idx_def    = idx("Deferred Loss $")

        date_indexes = [i for i, h in enumerate(header) if h == "Date"]
        if len(date_indexes) >= 2:
            idx_sell_date = date_indexes[1]
        else:
            idx_sell_date = None

        if idx_qty is None or idx_gain is None or idx_sell_date is None:
            raise SystemExit(f"CSV header missing required columns. Header={header}")

        current_symbol = None

        # 3) Parse rows until EOF (or until another section starts)
        for row in r:
            if not row or not any(c.strip() for c in row):
                continue

            first = (row[0] if len(row) > 0 else "").strip()

            # If a new section starts, stop
            if first.upper() in {"END OF REPORT", "DISCLAIMER", "NON-TAXABLE G&L DETAILS"}:
                break

            # Parent symbol line like: ZTS 3 -- -- 368.69 ...
            # It sets the current symbol; we don't insert a trade for this line.
            if first and not first.upper().startswith("SELL") and not first.startswith("Sell"):
                # Some exports put symbol in col 0 even though header says "Symbol"
                # Use whichever column actually has it.
                sym = first
                # quick sanity: symbols are usually letters/dot/dash
                if re.match(r"^[A-Z0-9.\-]{1,10}$", sym.upper()):
                    current_symbol = sym.upper()
                continue

            # Lot line: "Sell" in first cell (often indented)
            if "SELL" in first.upper():
                if not current_symbol:
                    skipped += 1
                    continue

                # Defensive indexing
                def get(i):
                    return row[i] if (i is not None and i < len(row)) else ""

                qty = _to_float(get(idx_qty))
                sell_date_iso = _to_iso_date(get(idx_sell_date))
                gain = _to_float(get(idx_gain))
                deferred = _to_float(get(idx_def)) if idx_def is not None else 0.0

                if qty <= 0 or not sell_date_iso:
                    skipped += 1
                    continue
                # NOTE: For dashboard realized P&L tiles, we use broker 'Gain $' ONLY.
                # Deferred Loss $ is a wash-sale adjustment and is tracked separately.
                net_gain = gain
                cur.execute(
                    "INSERT INTO realized_trades (symbol, action, qty, close_date, gain) VALUES (?, ?, ?, ?, ?)",
                    (current_symbol, "SELL", float(qty), sell_date_iso, float(net_gain))
                )
                inserted += 1
                continue

            skipped += 1

    conn.commit()
    conn.close()
    return inserted, skipped

def main():
    if len(sys.argv) < 2:
        print("Usage: python import_realized_from_etrade_csv.py <path-to-csv> [db_path]")
        sys.exit(2)

    csv_path = sys.argv[1]
    db_path = sys.argv[2] if len(sys.argv) >= 3 else DB_PATH

    ins, sk = import_etrade_gains_losses(csv_path, db_path=db_path)
    print(f"Done. Inserted {ins}, skipped {sk}. DB={db_path}")

if __name__ == "__main__":
    main()
