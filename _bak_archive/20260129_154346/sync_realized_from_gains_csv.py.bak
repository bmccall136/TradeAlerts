import csv
import sqlite3
from datetime import datetime

# --- CONFIG: adjust if your paths differ ---
DB_PATH = r"C:\TradeAlerts\live.db"
CSV_PATH = r"C:\TradeAlerts\GainsAndLossesDowload.csv"
# ------------------------------------------


def parse_date(s: str | None) -> str | None:
    """Convert '11/26/2025' -> '2025-11-26'; return None for blanks/'--'."""
    if not s:
        return None
    s = s.strip()
    if not s or s == "--":
        return None
    return datetime.strptime(s, "%m/%d/%Y").strftime("%Y-%m-%d")


def to_float(s: str | None) -> float:
    """Robust float parser for values like '.00', '-.96', '121.40', or '--'."""
    if not s:
        return 0.0
    s = s.replace("$", "").replace(",", "").strip()
    if not s or s == "--":
        return 0.0
    try:
        return float(s)
    except Exception:
        return 0.0


def row_exists(cur, symbol: str, qty: float, close_date: str, price_share: float, gain: float) -> bool:
    """
    Check if a matching realized_trades row already exists.

    We match on:
      - symbol
      - qty
      - date(close_date)
      - price_share (approx)
      - gain (approx)

    This avoids double-counting rows we've already inserted (including the
    manual 2025-11-26 backfill).
    """
    like_date = close_date  # 'YYYY-MM-DD'
    cur.execute(
        """
        SELECT 1
        FROM realized_trades
        WHERE symbol = ?
          AND qty    = ?
          AND date(close_date) = ?
          AND ABS(price_share - ?) < 0.005
          AND ABS(gain - ?) < 0.005
        LIMIT 1
        """,
        (symbol.upper(), float(qty), like_date, float(price_share), float(gain)),
    )
    return cur.fetchone() is not None


def main() -> None:
    print(f"Using DB:  {DB_PATH}")
    print(f"Using CSV: {CSV_PATH}")

    # Read whole file into lines so we can find the TAXABLE G&L DETAILS section.
    with open(CSV_PATH, "r", encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()

    in_details = False
    current_symbol: str | None = None

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    inserted = 0
    skipped = 0

    for line in lines:
        stripped = line.strip()

        # Start when we hit the details section
        if not in_details:
            if stripped == "TAXABLE G&L DETAILS":
                in_details = True
            continue

        # Once in details, stop when we hit the Total line
        if not stripped:
            continue
        if stripped.startswith("Total,"):
            break

        # Parse CSV row
        row = next(csv.reader([line]))
        first = row[0].strip()

        # Header row inside details
        if first == "Symbol":
            continue

        # Summary line: symbol aggregate
        # Example: 'ZTS,1,--,--,122.63,--,--,121.4,.00,-1.23,Short,--'
        if first and not first.startswith("Sell"):
            current_symbol = first
            continue

        # Detail Sell line (indented '    Sell' or 'Sell')
        if first.endswith("Sell"):
            if not current_symbol:
                continue  # safety

            symbol = current_symbol
            qty = to_float(row[1])
            open_date = parse_date(row[2])
            cost_share = to_float(row[3])
            total_cost = to_float(row[4])
            close_date = parse_date(row[5])
            price_share = to_float(row[6])
            proceeds = to_float(row[7])
            gain = to_float(row[8])
            term = (row[10] or "").strip() or "Short"

            if not symbol or not close_date or qty == 0:
                continue

            # Skip if we already have a matching row in realized_trades
            if row_exists(cur, symbol, qty, close_date, price_share, gain):
                skipped += 1
                continue

            cur.execute(
                """
                INSERT INTO realized_trades
                    (symbol, action, qty,
                     open_date, close_date,
                     price_share, proceeds,
                     cost_share, total_cost,
                     gain, term)
                VALUES (?, 'SELL', ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    symbol.upper(),
                    float(qty),
                    open_date,
                    close_date,
                    float(price_share),
                    float(proceeds),
                    float(cost_share),
                    float(total_cost),
                    float(gain),
                    term,
                ),
            )
            inserted += 1

    conn.commit()
    conn.close()

    print(f"Done. Inserted {inserted} new realized rows, skipped {skipped} existing rows.")


if __name__ == "__main__":
    main()
