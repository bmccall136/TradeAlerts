import os
os.environ.setdefault("ETRADE_ENV", "production")

from services import etrade_service as et

# sanity: see at least one account and positions
acct = et.get_primary_account_key()           # or: et.get_accounts() to inspect
pos  = et.get_positions(acct)                 # or: et.get_positions()
print("acct:", acct)
print("keys:", list(pos.keys()))
