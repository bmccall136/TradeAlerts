# services/trade_source.py
from __future__ import annotations
import datetime as _dt
from typing import List, Dict, Any, Tuple, Optional, Deque
from collections import deque

try:
    from zoneinfo import ZoneInfo
    _ET = ZoneInfo("America/New_York")
except Exception:
    _ET = _dt.timezone(_dt.timedelta(hours=-5))  # fallback

# Your project already wires this.
from . import etrade_service as et


# ───────────────────────── Time helpers ─────────────────────────

def _now_et() -> _dt.datetime:
    return _dt.datetime.now(tz=_ET)

def _as_et(dt: _dt.datetime) -> _dt.datetime:
    if dt.tzinfo is None:
        return dt.replace(tzinfo=_ET)
    return dt.astimezone(_ET)

def _parse_any_dt(s: Any) -> Optional[_dt.datetime]:
    """
    Best-effort parser for common E*TRADE/ISO-ish date strings or epoch sec/ms.
    Returns ET tz-aware dt or None.
    """
    if s is None:
        return None

    # numeric epoch (sec or ms)
    try:
        f = float(s)
        if f > 10_000_000_000:  # ms -> sec
            f = f / 1000.0
        return _as_et(_dt.datetime.fromtimestamp(f, tz=_dt.timezone.utc))
    except Exception:
        pass

    if isinstance(s, str):
        ss = s.strip()
        if not ss:
            return None

        # Typical E*TRADE patterns include "12:03:23 EDT 09-19-2025"
        # Try a few known formats:
        # ISO with/without Z
        iso = ss
        if iso.endswith("Z"):
            iso = iso[:-1] + "+00:00"
        try:
            return _as_et(_dt.datetime.fromisoformat(iso))
        except Exception:
            pass

        # "HH:MM:SS EDT mm-dd-YYYY"
        try:
            parts = ss.split()
            if len(parts) == 4 and parts[1] in ("EST", "EDT"):
                # strip TZ token and parse naive, then localize to ET
                t, _, mdY = parts[0], parts[1], parts[2]
                dt = _dt.datetime.strptime(f"{t} {mdY}", "%H:%M:%S %m-%d-%Y")
                return _as_et(dt)
        except Exception:
            pass

        # Trim milliseconds if any
        try:
            tmp = ss
            if tmp.endswith(" ET"):
                tmp = tmp[:-3]
            if "." in tmp:
                base, frac = tmp.split(".", 1)
                i = 0
                while i < len(frac) and frac[i].isdigit():
                    i += 1
                tmp2 = base + (frac[i:] if i < len(frac) else "")
                return _as_et(_dt.datetime.fromisoformat(tmp2))
        except Exception:
            pass

        # Simple fallbacks
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
            try:
                return _as_et(_dt.datetime.strptime(ss, fmt))
            except Exception:
                pass

    return None


def _date_range(days: Optional[int], start_iso: Optional[str]) -> Tuple[_dt.datetime, _dt.datetime]:
    """
    Produces [start_dt, end_dt) in ET.
    """
    end_dt = _now_et()
    if start_iso:
        try:
            y, m, d = [int(x) for x in start_iso.split("-")]
            start_dt = _as_et(_dt.datetime(y, m, d))
        except Exception:
            start_dt = end_dt - _dt.timedelta(days=30)
    else:
        days = max(1, min(int(days or 30), 90))
        start_dt = end_dt - _dt.timedelta(days=days)
    return (start_dt, end_dt)


# ─────────────────────── Normalization / merge ───────────────────────

def _upper(val: Optional[str]) -> str:
    return (val or "").upper()

def _norm_trade(row: Dict[str, Any]) -> Dict[str, Any]:
    """
    Normalize to a common schema the rest of the app expects:
      symbol, side(BUY/SELL), qty, price, time(ISO), time_ms, source, id_key
      PLUS: action (dup of side), price_paid (filled on SELL after FIFO), pl, pl_pct
    """
    # symbol
    symbol = (
        row.get("symbol")
        or row.get("Symbol")
        or (row.get("Product") or {}).get("symbol")
        or row.get("symbolDescription")
        or ""
    )
    symbol = str(symbol).strip().upper()

    # qty
    qty_val = (
        row.get("qty") or row.get("quantity") or row.get("Quantity")
        or row.get("orderedQuantity") or row.get("filledQuantity")
    )
    try:
        qty = float(qty_val or 0)
    except Exception:
        qty = 0.0

    # price
    price_val = (
        row.get("price") or row.get("Price") or row.get("executionPrice")
        or row.get("executedPrice") or row.get("avgExecutionPrice")
        or row.get("pricePaid")
    )
    try:
        price = float(price_val or 0)
    except Exception:
        price = 0.0

    # time (various keys)
    t = (
        row.get("time")
        or row.get("transactionDate")
        or row.get("dateTime")
        or row.get("executedTime")
        or row.get("timeOfExecution")
        or row.get("orderTime")
        or row.get("tradeDate")
        or row.get("timeUTC")
    )
    dt = _parse_any_dt(t)
    time_iso = dt.isoformat() if dt else None
    time_ms = int(dt.timestamp() * 1000) if dt else None

    # side / action
    side_raw = _upper(row.get("side") or row.get("orderAction") or row.get("transactionType"))
    side_map = {
        "BUY": "BUY",
        "BOUGHT": "BUY",
        "BUY_TO_OPEN": "BUY",
        "BUY_TO_COVER": "BUY",
        "SELL": "SELL",
        "SOLD": "SELL",
        "SELL_TO_CLOSE": "SELL",
        "SELL_SHORT": "SELL",
    }
    side = side_map.get(side_raw, "BUY" if qty >= 0 else "SELL")  # last-resort guess

    src = row.get("_source") or "unknown"

    # de-dup key
    id_parts = [
        row.get("orderId") or row.get("orderNumber") or row.get("transactionId") or row.get("executionId") or "",
        symbol, f"{qty:g}", f"{price:.4f}", time_iso or str(time_ms or "")
    ]
    id_key = "|".join(str(p) for p in id_parts)

    return {
        "symbol": symbol,
        "side": side,
        "action": side,        # <= dashboard expects this too
        "qty": qty,
        "price": price,
        "time": time_iso,      # human / server-side table uses this
        "time_ms": time_ms,    # sorting
        "_source": src,
        "_id": id_key,

        # filled later for SELLs
        "price_paid": None,
        "amount": None,
        "pl": None,
        "pl_pct": None,

        "_raw": row,
    }


def _merge_dedup(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    seen = set()
    out: List[Dict[str, Any]] = []
    for r in rows:
        k = r.get("_id")
        if not k or k in seen:
            continue
        seen.add(k)
        out.append(r)
    # newest first
    out.sort(key=lambda x: (x.get("time_ms") or 0), reverse=True)
    return out


# ─────────────── Fetch executions with compat fallbacks ───────────────

def _fetch_executions(start_dt: _dt.datetime, end_dt: _dt.datetime, max_count: int = 800) -> List[Dict[str, Any]]:
    """
    Try, in order:
      1) et.list_executed_orders_between(start_dt, end_dt, page=1..)
      2) et.recent_executions_as_trades(count)
      3) et.list_executed_orders_recent(count)
    """
    out: List[Dict[str, Any]] = []

    # 1) Ideal: native between + paging
    if hasattr(et, "list_executed_orders_between"):
        page = 1
        while len(out) < max_count:
            batch = et.list_executed_orders_between(start_dt, end_dt, page=page)  # type: ignore[attr-defined]
            if not batch:
                break
            for b in batch:
                b["_source"] = "executions"
                out.append(_norm_trade(b))
            if len(batch) < 50:
                break
            page += 1
        return out

    # 2) recent_executions_as_trades
    if hasattr(et, "recent_executions_as_trades"):
        try:
            batch = et.recent_executions_as_trades(min(max_count, 1000))  # type: ignore[attr-defined]
            for b in (batch or []):
                b["_source"] = "executions_recent"
                nr = _norm_trade(b)
                dt = _parse_any_dt(nr.get("time"))
                if dt and start_dt <= dt < end_dt:
                    out.append(nr)
            return out
        except Exception:
            pass

    # 3) list_executed_orders_recent
    if hasattr(et, "list_executed_orders_recent"):
        try:
            batch = et.list_executed_orders_recent(min(max_count, 1000))  # type: ignore[attr-defined]
            for b in (batch or []):
                b["_source"] = "executions_recent_raw"
                nr = _norm_trade(b)
                dt = _parse_any_dt(nr.get("time"))
                if dt and start_dt <= dt < end_dt:
                    out.append(nr)
            return out
        except Exception:
            pass

    return out


# ───────────── Fetch transactions with compat fallbacks ─────────────

def _fetch_transactions(start_dt: _dt.datetime, end_dt: _dt.datetime, max_count: int = 800) -> List[Dict[str, Any]]:
    """
    Try, in order:
      1) et.list_transactions_between(start_date, end_date, marker=None) -> (rows, next_marker)
      2) et.list_transactions(start_date, end_date)
      3) et.account_transactions(start_date, end_date)
    Only BUY/SELL are returned (cash/divs ignored here).
    """
    out: List[Dict[str, Any]] = []
    sd, ed = start_dt.date(), end_dt.date()

    # 1) Between + marker
    if hasattr(et, "list_transactions_between"):
        marker = None
        while len(out) < max_count:
            try:
                batch, marker = et.list_transactions_between(sd, ed, marker=marker)  # type: ignore[attr-defined]
            except Exception:
                break
            if not batch:
                break
            for b in batch:
                ttype = _upper(b.get("transactionType"))
                if any(k in ttype for k in ("BUY", "SELL", "BOUGHT", "SOLD")):
                    b["_source"] = "transactions"
                    nr = _norm_trade(b)
                    dt = _parse_any_dt(nr.get("time"))
                    if dt and start_dt <= dt < end_dt:
                        out.append(nr)
            if not marker:
                break
        return out

    # 2) list_transactions
    if hasattr(et, "list_transactions"):
        try:
            step = _dt.timedelta(days=7)
            s = sd
            while s < ed:
                e = min(s + step, ed)
                batch = et.list_transactions(s, e) or []  # type: ignore[attr-defined]
                for b in batch:
                    ttype = _upper(b.get("transactionType"))
                    if any(k in ttype for k in ("BUY", "SELL", "BOUGHT", "SOLD")):
                        b["_source"] = "transactions_simple"
                        nr = _norm_trade(b)
                        dt = _parse_any_dt(nr.get("time"))
                        if dt and start_dt <= dt < end_dt:
                            out.append(nr)
                s = e
            return out
        except Exception:
            pass

    # 3) account_transactions
    if hasattr(et, "account_transactions"):
        try:
            step = _dt.timedelta(days=7)
            s = sd
            while s < ed:
                e = min(s + step, ed)
                batch = et.account_transactions(s, e) or []  # type: ignore[attr-defined]
                for b in batch:
                    ttype = _upper(b.get("transactionType"))
                    if any(k in ttype for k in ("BUY", "SELL", "BOUGHT", "SOLD")):
                        b["_source"] = "transactions_account"
                        nr = _norm_trade(b)
                        dt = _parse_any_dt(nr.get("time"))
                        if dt and start_dt <= dt < end_dt:
                            out.append(nr)
                s = e
            return out
        except Exception:
            pass

    return out


# ───────────────────── Realized P&L (FIFO) ─────────────────────

def _enrich_fifo_realized_pl(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Mutates a copy of rows to compute realized P&L ONLY on SELL rows.
    - Per-symbol FIFO lots.
    - price_paid on SELL = weighted avg cost of the units closed.
    - pl, pl_pct filled on SELL; BUYs remain None.
    """
    # Oldest -> newest for lot accounting
    ordered = sorted(rows, key=lambda r: (r.get("time_ms") or 0))

    lots: Dict[str, Deque[Tuple[float, float]]] = {}  # symbol -> deque of (qty_remaining, cost_price)

    out: List[Dict[str, Any]] = []
    for r in ordered:
        sym = r["symbol"]
        side = r["side"]
        qty = float(r["qty"] or 0)
        px  = float(r["price"] or 0)

        if sym not in lots:
            lots[sym] = deque()

        if side == "BUY":
            # Add a lot
            if qty > 0:
                lots[sym].append((qty, px))
            out.append(r)
            continue

        if side == "SELL":
            sell_qty = qty if qty > 0 else -qty  # normalize; most rows have positive qty
            basis_amt = 0.0
            basis_qty = 0.0

            # Consume lots
            while sell_qty > 0 and lots[sym]:
                lot_qty, lot_px = lots[sym][0]
                take = min(lot_qty, sell_qty)
                basis_amt += take * lot_px
                basis_qty += take
                lot_qty -= take
                sell_qty -= take
                if lot_qty <= 1e-9:
                    lots[sym].popleft()
                else:
                    lots[sym][0] = (lot_qty, lot_px)

            # If we exhausted lots (short sale or missing history), treat remaining as zero basis
            if sell_qty > 0:
                basis_qty += sell_qty
                # basis_amt += 0.0

            if basis_qty > 0:
                avg_basis = basis_amt / basis_qty
                realized = (px - avg_basis) * basis_qty
                r = dict(r)  # copy row to avoid side-effects
                r["price_paid"] = round(avg_basis, 4)
                r["amount"] = round(px * basis_qty, 4)
                r["pl"] = round(realized, 4)
                try:
                    r["pl_pct"] = round((px - avg_basis) / avg_basis * 100.0, 4) if avg_basis else None
                except Exception:
                    r["pl_pct"] = None
                out.append(r)
            else:
                # No basis to compute; still pass row through
                out.append(r)
            continue

        # Unknown side – pass through
        out.append(r)

    # Return newest first for the UI
    out.sort(key=lambda x: (x.get("time_ms") or 0), reverse=True)
    return out


# ────────────────────────── Public API ──────────────────────────

def load_trades_merged(days: int | None = None,
                       start_iso: str | None = None,
                       max_count: int = 800) -> List[Dict[str, Any]]:
    """
    Compute ET date range, fetch executions + transactions using whatever helpers exist,
    normalize, de-dup, compute FIFO realized P&L (SELL-only), newest -> oldest.
    """
    start_dt, end_dt = _date_range(days, start_iso)

    execs = _fetch_executions(start_dt, end_dt, max_count=max_count)
    txns  = _fetch_transactions(start_dt, end_dt, max_count=max_count)

    merged = _merge_dedup(execs + txns)

    # Compute SELL-only realized P&L and fill fields dashboard expects
    enriched = _enrich_fifo_realized_pl(merged)

    # Shape the final fields your /live/status serializer expects
    final_rows: List[Dict[str, Any]] = []
    for r in enriched[:max_count]:
        dt = _parse_any_dt(r.get("time"))
        final_rows.append({
            "symbol": r["symbol"],
            "action": r.get("action") or r.get("side"),
            "qty": r.get("qty"),
            "price": r.get("price"),
            "price_paid": r.get("price_paid"),
            "amount": r.get("amount"),
            "pl": r.get("pl"),
            "pl_pct": r.get("pl_pct"),
            "time": dt.strftime("%Y-%m-%d %H:%M:%S") if dt else None,          # legacy human string
            "time_utc": dt.isoformat() if dt else None,                        # used by UI
            "time_ms": r.get("time_ms"),
        })
    return final_rows
