# test_order_numeric.py
import json, traceback
from services import etrade_service as et

print("=== test_order_numeric.py starting ===")

symbol = "ALB"
qty     = 1
action  = "SELL"
price   = None

try:
    aid_key = et.account_id_key()
    aid_num = et.account_id()

    print(f"[test] account_id_key = {aid_key!r}")
    print(f"[test] account_id_num = {aid_num!r}")

    print("[test] doing PREVIEW…")
    preview = et.preview_equity_order(
        account_id_key=aid_key,   # preview still uses key (this always works)
        symbol=symbol,
        qty=qty,
        price=price,
        action=action,
        price_type="MARKET",
        order_term="GOOD_FOR_DAY",
        market_session="REGULAR",
    )

    print("[test] PREVIEW response:")
    print(json.dumps(preview, indent=2))

    print("\n[test] forcing PLACE using NUMERIC account ID…")

    try:
        placed = et._epost(   # direct low-level call
            f"/accounts/{aid_num}/orders/place.json",
            {
                "PlaceOrderRequest": {
                    "orderType": "EQ",
                    "clientOrderId": None,
                    "PreviewIds": [
                        {"previewId": preview["PreviewOrderResponse"]["PreviewIds"][0]["previewId"]}
                    ],
                    "Order": [
                        {
                            "orderTerm": "GOOD_FOR_DAY",
                            "priceType": "MARKET",
                            "marketSession": "REGULAR",
                            "allOrNone": False,
                            "Instrument": [
                                {
                                    "symbolDescription": preview["PreviewOrderResponse"]["Order"][0]["Instrument"][0]["symbolDescription"],
                                    "orderAction": action,
                                    "quantityType": "QUANTITY",
                                    "quantity": str(qty),
                                    "cancelQuantity": 0.0,
                                    "reserveOrder": True,
                                    "reserveQuantity": 0.0,
                                    "Product": {
                                        "symbol": symbol,
                                        "securityType": "EQ"
                                    },
                                }
                            ],
                        }
                    ],
                }
            }
        )

        print("[test] PLACE response (numeric ID):")
        print(json.dumps(placed, indent=2))

    except Exception as e:
        print("[test] ERROR using numeric account ID:")
        print(e)
        traceback.print_exc()

except Exception as outer:
    print("[test] FATAL error in script:")
    print(outer)
    traceback.print_exc()
