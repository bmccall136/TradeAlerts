def place_with_adaptive_variants(acct_key: str, symbol: str, qty: float, order_type: str, limit_price: float | None, max_attempts: int) -> None:
    order_type = (order_type or "MARKET").upper()
    price_type = "MARKET" if order_type == "MARKET" else "LIMIT"

    attempts = 0
    last_err: Exception | None = None

    while attempts < max_attempts:
        attempts += 1
        try:
            LOG.info("place_with_adaptive_variants attempt %s: %s qty=%s type=%s limit=%s", attempts, symbol, qty, order_type, limit_price)

            limit = None
            if price_type == "LIMIT" and limit_price is not None:
                limit = float(limit_price)

            preview = et.preview_equity_order(acct_key, symbol, int(qty), limit, action="SELL", price_type=price_type)
            et.place_equity_order(preview, qty=int(qty))

            try:
                _sym = (symbol or "").upper().strip()
                _act = "SELL"
                _q = float(qty)
                ex = _find_recent_exec(_sym, _act, _q, lookback_rows=80)
                if ex and ex.get("price") is not None:
                    t_iso = str(ex.get("time") or _ts_now_et_iso())
                    px = float(ex.get("price"))
                else:
                    t_iso = _ts_now_et_iso()
                    px = 0.0
                _log_trade_to_live_db(_sym, _act, _q, px, t_iso, pnl=None)
            except Exception:
                pass

            LOG.info("place_with_adaptive_variants success for %s", symbol)
            return
        except Exception as exc:  # noqa: BLE001
            last_err = exc
            msg = str(exc)

            if ("code': 1028" in msg) or ('code": 1028' in msg) or ("code': 1049" in msg) or ('code": 1049' in msg):
                LOG.warning("place_with_adaptive_variants: pending/duplicate for %s; stopping retries this loop. (%s)", symbol, msg)
                return

            if ("code': 1514" in msg) or ('code": 1514' in msg):
                LOG.error("place_with_adaptive_variants: E*TRADE code 1514 for %s; skipping. Error: %s", symbol, msg)
                return

            LOG.warning("place_with_adaptive_variants attempt %s failed for %s: %s", attempts, symbol, msg)
            time.sleep(1.0)

    raise RuntimeError(f"Failed to place order for {symbol}: {last_err}")

def main() -> None:
    LOG.info("sell_guard starting…")
    LOG.info("Using SELL_GUARD_SETTINGS=%s", SETTINGS_FILE)

    settings = load_settings()
    sg = settings.get("sell_guard", {}) or {}
    ai_enabled, ai_use_exits = get_ai_flags(settings)
    LOG.info("AI exits config: enabled=%s use_exits=%s", ai_enabled, ai_use_exits)

    cfg = SellGuardConfig.from_dict(sg)
    LOG.info("SellGuardConfig: %s", cfg)

    acct_key = account_id_key()
    LOG.info("account_id_key=%s", acct_key)

    armed_trail: Dict[str, float] = {}

    while True:
        loop_start = datetime.now(tz=UTC)

        try:
            if not within_session(loop_start, cfg):
                LOG.info("Outside market session %s-%s; sleeping %ss", cfg.market_open, cfg.market_close, cfg.interval_sec)
                time.sleep(cfg.interval_sec)
                continue

            positions_raw = fetch_positions()
            positions = parse_positions(positions_raw)

            # DBG positions parsed / hold timing (non-invasive)
            try:
                npos = len(positions) if positions else 0
                LOG.info("DBG positions parsed=%s max_hold=%sm", npos, getattr(cfg, 'max_hold_minutes', None))
                # Show timing for first few positions to verify date math
                for _i, _p in enumerate(positions[:5] if positions else []):
                    try:
                        age_min = float(getattr(_p, 'age_min', 0.0) or 0.0)
                    except Exception:
                        age_min = 0.0
                    try:
                        mh = float(getattr(cfg, 'max_hold_minutes', 0.0) or 0.0)
                    except Exception:
                        mh = 0.0
                    left_min = max(0.0, mh - age_min) if mh > 0 else 0.0
                    LOG.info("DBG %s qty=%s age_min=%.1f left_min=%.1f", getattr(_p, 'symbol', '?'), getattr(_p, 'qty', '?'), age_min, left_min)
            except Exception as _dbg_exc:
                LOG.debug("DBG positions heartbeat failed: %r", _dbg_exc)
            if not positions:
                LOG.info("No positions; sleeping %ss", cfg.interval_sec)
                time.sleep(cfg.interval_sec)
                continue

            open_orders = fetch_open_orders()

            open_sell_symbols: set[str] = set()
            for _o in (open_orders or []):
                try:
                    if not isinstance(_o, dict):
                        continue
                    _sym = (_o.get("symbol") or "").strip().upper()
                    if not _sym:
                        continue
                    _act = str(_o.get("orderAction") or _o.get("action") or "").upper()
                    _status = str(_o.get("status") or _o.get("orderStatus") or "").upper()
                    if "SELL" in _act and _status not in {"EXECUTED", "FILLED", "CANCELLED", "REJECTED"}:
                        open_sell_symbols.add(_sym)
                except Exception:
                    continue

            open_map: Dict[str, datetime] = {}
            for o in open_orders or []:
                try:
                    sym = (o.get("symbol") or "").strip().upper()
                    if not sym:
                        continue
                    ot = o.get("orderTime")
                    if not ot:
                        continue

                    dt: Optional[datetime] = None
                    if isinstance(ot, (int, float)):
                        dt = datetime.fromtimestamp(float(ot) / 1000.0, tz=UTC)
                    elif isinstance(ot, str):
                        s = ot.strip().replace("Z", "+00:00")
                        try:
                            dt = datetime.fromisoformat(s)
                        except Exception:
                            if s.isdigit():
                                val = int(s)
                                dt = datetime.fromtimestamp(val / 1000.0, tz=UTC) if val > 10**11 else datetime.fromtimestamp(val, tz=UTC)

                    if dt is None:
                        continue
                    opened_at = dt.astimezone(UTC)
                    if sym not in open_map or opened_at < open_map[sym]:
                        open_map[sym] = opened_at
                except Exception:
                    continue

            for p in positions:
                s = p.symbol
                qty = p.qty
                mv = p.mv
                entry_px = p.entry_price
                last_trade = p.last_trade

                has_open_sell = (s in open_sell_symbols)

                if s in cfg.blocklist:
                    continue
                if cfg.only_allow_symbol and s != cfg.only_allow_symbol:
                    continue
                if qty <= 0:
                    continue
                if not entry_px:
                    continue

                if mv and qty:
                    cur_px = mv / qty
                elif last_trade:
                    cur_px = last_trade
                else:
                    cur_px = entry_px or 0.0

                pl_pct = ((cur_px - entry_px) / entry_px) * 100.0

                opened = p.opened_at or open_map.get(s)

                hold_min = 0.0
                is_prior_day = False
                opened_src = "none"

                if opened:
                    opened_src = "position" if p.opened_at else "open_map"
                    if ETZ is not None:
                        opened_local = opened.astimezone(ETZ)
                        now_local = loop_start.astimezone(ETZ)
                    else:
                        opened_local = opened
                        now_local = loop_start

                    is_prior_day = opened_local.date() < now_local.date()

                    is_midnightish = (
                        opened_local.hour == 0
                        and opened_local.minute == 0
                        and opened_local.second < 5
                    )

                    if (not is_prior_day) and is_midnightish:
                        hold_min = 0.0
                        is_prior_day = False
                    else:
                        hold_sec = (loop_start - opened).total_seconds()
                        hold_min = max(0.0, hold_sec / 60.0)

                # ? ALWAYS emit an EVAL row so the sell_triggers CSV is created and stays live
                try:
                    emit_sell_event(
                        symbol=s,
                        event="EVAL",
                        action="HOLD",
                        reason="loop",
                        hold_min=hold_min,
                        qty=qty,
                        last_price=cur_px,
                        entry_price=entry_px,
                        pl_pct=pl_pct,
                        mode=cfg.mode,
                        details={
                            "is_prior_day": bool(is_prior_day),
                            "has_open_sell": bool(has_open_sell),
                            "opened_src": opened_src,
                        },
                    )
                except Exception:
                    pass

            loop_end = datetime.now(tz=UTC)
            elapsed = (loop_end - loop_start).total_seconds()
            sleep_for = max(1.0, cfg.interval_sec - elapsed)
            LOG.info("sleeping %.1fs", sleep_for)
            time.sleep(sleep_for)

        except KeyboardInterrupt:
            LOG.info("KeyboardInterrupt — exiting")
            break
        except Exception as e:
            LOG.error("Unexpected error in main loop: %s", e)
            time.sleep(cfg.interval_sec)

if __name__ == "__main__":
    main()
