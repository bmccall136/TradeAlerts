@dataclass
class PositionRow:
    symbol: str
    qty: float
    mv: float
    entry_price: float
    last_trade: float
    opened_at: datetime | None

def parse_positions(rows) -> List[PositionRow]:
    if isinstance(rows, dict):
        # --- unwrap E*TRADE wrapper payloads ---
        # Many builds return {'PortfolioResponse': {'AccountPortfolio': [...]}}
        if 'PortfolioResponse' in rows and isinstance(rows.get('PortfolioResponse'), dict):
            rows = rows.get('PortfolioResponse') or rows
        # --------------------------------------
        pr = rows.get("PortfolioResponse") or rows.get("portfolioResponse") or rows
        accounts = pr.get("AccountPortfolio") or pr.get("AccountPositions") or []
        if isinstance(accounts, dict):
            accounts = [accounts]

        items: List[Dict[str, Any]] = []
        for acct in accounts:
            pos_list = acct.get("Position") or acct.get("positions") or []
            if isinstance(pos_list, dict):
                pos_list = [pos_list]
            items.extend(pos_list)

    elif isinstance(rows, str):
        try:
            parsed = json.loads(rows)
            return parse_positions(parsed)
        except Exception:
            LOG.error("parse_positions: got string rows; JSON decode failed")
            return []
    else:
        try:
            items = list(rows or [])
        except TypeError:
            LOG.error("parse_positions: unsupported rows type %r", type(rows))
            return []

    holdings: List[PositionRow] = []

    for r in items:
        if not isinstance(r, dict):
            continue

        sym = str(r.get("symbol") or r.get("symbolDescription") or "").strip().upper()
        if not sym:
            continue

        qty = float(r.get("quantity") or 0)
        price_paid = float(r.get("pricePaid") or r.get("costPerShare") or 0)
        market_value = float(r.get("marketValue") or 0)

        try:
            last_trade = float(r.get("lastTrade") or r.get("price") or 0.0)
        except Exception:
            last_trade = 0.0

        opened_at = None
        ts = r.get("dateAcquired")
        if ts:
            try:
                opened_at = datetime.fromtimestamp(float(ts) / 1000.0, tz=UTC)
            except Exception:
                opened_at = None

        # DBG/logic: compute age_min from dateAcquired (epoch ms).0
        try:
            _ts = r.get('dateAcquired')
            if _ts:
                _now_ms = int(time.time() * 1000)
                _ts_ms = int(_ts)
                if _ts_ms < 10_000_000_000:
                    _ts_ms *= 1000
                age_min = max(0.0, (_now_ms - _ts_ms) / 60000.0)
        except Exception:
            age_min = 0.0

        holdings.append(
            PositionRow(
                age_min=age_min,
                symbol=sym,
                qty=qty,
                mv=market_value,
                entry_price=price_paid,
                last_trade=last_trade,
                opened_at=opened_at,
            )
        )
    # DBG postprocess age_min from opened_at/dateAcquired (safe; no constructor changes)

    try:

        now_ms = int(time.time() * 1000)

        for _p in holdings:

            _oa = getattr(_p, 'opened_at', None)

            if _oa is not None:

                try:

                    _ms = int(_oa.timestamp() * 1000)

                    _p.age_min = max(0.0, (now_ms - _ms) / 60000.0)

                    continue

                except Exception:

                    pass

    except Exception:

        pass

    return holdings

def within_session(now: datetime, cfg: SellGuardConfig) -> bool:
    if ETZ is not None:
        now_local = now.astimezone(ETZ)
    else:  # pragma: no cover
        now_local = now

    h, m = map(int, cfg.market_open.split(":", 1))
    open_dt = now_local.replace(hour=h, minute=m, second=0, microsecond=0)
    h, m = map(int, cfg.market_close.split(":", 1))
    close_dt = now_local.replace(hour=h, minute=m, second=0, microsecond=0)
    return open_dt <= now_local <= close_dt

