def _ts_now_et_iso() -> str:
    """
    Return ET timestamp ISO (seconds), e.g. 2026-01-21T09:50:07-05:00
    """
    if ETZ is not None:
        return datetime.now(tz=ETZ).replace(microsecond=0).isoformat()
    return datetime.now(tz=UTC).replace(microsecond=0).isoformat()

def _find_recent_exec(symbol: str, action: str, qty: float, lookback_rows: int = 60):
    """
    Best-effort: pull recent executed trades from E*TRADE and find a matching fill.
    Returns dict: {"time": <iso>, "price": <float>, "qty": <float>} or None.
    """
    symbol = (symbol or "").upper().strip()
    action = (action or "").upper().strip()

    try:
        fn = getattr(et, "recent_executions_as_trades", None)
        if not callable(fn):
            return None
        rows = fn(int(lookback_rows) or 60) or []
    except Exception:
        return None

    def _to_f(x):
        try:
            return float(x)
        except Exception:
            return None

    for r in rows:
        try:
            sym = str(r.get("symbol") or r.get("Symbol") or "").upper().strip()
            act = str(r.get("action") or r.get("side") or r.get("orderAction") or "").upper().strip()
            q = _to_f(r.get("qty") or r.get("quantity") or r.get("filledQuantity"))
            px = _to_f(r.get("price") or r.get("executionPrice") or r.get("avgExecutionPrice") or r.get("averageExecutionPrice"))
            t = r.get("time") or r.get("time_utc") or r.get("executedTime") or r.get("filledTime") or r.get("placedTime")

            if sym != symbol:
                continue
            if act and act != action:
                continue
            if q is None or px is None:
                continue
            try:
                if qty is not None and abs(float(q) - float(qty)) > 1e-6:
                    continue
            except Exception:
                pass

            return {"time": str(t), "price": float(px), "qty": float(q)}
        except Exception:
            continue

    return None

def _log_trade_to_live_db(symbol: str, action: str, qty: float, price: float, trade_time_iso: str, pnl=None) -> bool:
    """
    Writes into C:\\TradeAlerts\\live.db table 'trades' with schema:
      (trade_time TEXT, symbol TEXT, action TEXT, qty REAL, price REAL, pnl REAL)
    De-dupes on exact tuple match.
    """
    try:
        db = Path(r"C:\TradeAlerts\live.db")
        con = sqlite3.connect(str(db), timeout=5)
        cur = con.cursor()

        cur.execute("""
        CREATE TABLE IF NOT EXISTS trades (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          trade_time TEXT NOT NULL,
          symbol TEXT NOT NULL,
          action TEXT NOT NULL,
          qty REAL NOT NULL,
          price REAL NOT NULL,
          pnl REAL
        )
        """)

        cur.execute(
            "SELECT 1 FROM trades WHERE trade_time=? AND symbol=? AND action=? AND qty=? AND price=? LIMIT 1",
            (str(trade_time_iso), str(symbol), str(action), float(qty), float(price)),
        )
        if cur.fetchone():
            con.close()
            return False

        cur.execute(
            "INSERT INTO trades (trade_time, symbol, action, qty, price, pnl) VALUES (?,?,?,?,?,?)",
            (str(trade_time_iso), str(symbol), str(action), float(qty), float(price), pnl),
        )
        con.commit()
        con.close()
        return True
    except Exception:
        return False

def log_ai_decision(
    *,
    symbol: str,
    mode: str,
    qty: float,
    pl_pct: float,
    hold_min: float,
    action: str,
    confidence: int,
    reason_tags: list[str] | None = None,
    reason: str | None = None,
    has_bad_news: bool | None = None,
    headlines: list[str] | None = None,
    market_regime: str | None = None,
    **extra: Any,
) -> None:
    """Write a single JSON record for each AI exit decision.
    Must never raise.
    """
    try:
        record: Dict[str, Any] = {
            "ts": datetime.now(tz=UTC).isoformat(),
            "symbol": str(symbol or "").upper(),
            "mode": mode,
            "qty": float(qty or 0.0),
            "pl_pct": float(pl_pct or 0.0),
            "hold_min": float(hold_min or 0.0),
            "action": str(action or "HOLD").upper(),
            "confidence": int(confidence or 0),
            "reason_tags": reason_tags or [],
            "reason": reason or "",
            "has_bad_news": bool(has_bad_news) if has_bad_news is not None else False,
            "headlines": headlines or [],
            "market_regime": market_regime or "unknown",
        }
        for k, v in (extra or {}).items():
            if v is None:
                continue
            if isinstance(v, (str, int, float, bool)):
                record[k] = v
            else:
                record[k] = str(v)

        AI_LOG.info(json.dumps(record, ensure_ascii=False))
    except Exception as exc:  # pragma: no cover
        LOG.warning("Failed to log AI decision for %s: %s", symbol, exc)

