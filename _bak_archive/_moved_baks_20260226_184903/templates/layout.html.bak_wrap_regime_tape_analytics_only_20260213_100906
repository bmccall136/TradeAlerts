<div id="mm-regime-tape-wrap" style="margin:10px 14px 0 14px;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today 09:30?16:00 ET)</div>
