/* Daily Analytics (DB-driven)
   - Renders BUY (left) and SELL (right)
   - Each row links to Trade Review (symbol + ts)
*/

(function () {
  "use strict";

  function esc(s) {
    return String(s ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }
  function enc(x) { return encodeURIComponent(String(x ?? "")); }

  function getParam(name) {
    const u = new URL(window.location.href);
    return u.searchParams.get(name);
  }
  function setParam(name, value) {
    const u = new URL(window.location.href);
    u.searchParams.set(name, value);
    window.location.href = u.toString();
  }

  function tradeReviewHref(sym, ts) {
    // This matches your existing style: /trade_review?... (extra params are harmless)
    return `/trade_review?symbol=${enc(sym)}&ts=${enc(ts)}`;
  }

  function renderBuyTable(buys) {
    const head = `
      <table class="table table-sm table-dark table-striped ax-mini">
        <thead><tr>
          <th style="width:140px;">Time</th>
          <th style="width:90px;">Symbol</th>
          <th style="width:90px;" class="text-end">Qty</th>
          <th style="width:110px;" class="text-end">Price</th>
        </tr></thead>
        <tbody>`;
    const body = (buys || []).map(r => {
      const ts = r.ts || "";
      const sym = r.symbol || "";
      const href = tradeReviewHref(sym, ts);
      const qty = (r.qty ?? "");
      const price = (r.price ?? "");
      return `<tr>
        <td><a class="ax-link" href="${href}">${esc(ts).slice(11,19) || esc(ts)}</a></td>
        <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
        <td class="text-end">${esc(qty)}</td>
        <td class="text-end">${esc(price)}</td>
      </tr>`;
    }).join("");
    return head + body + `</tbody></table>`;
  }

  function renderSellTable(sells) {
    const head = `
      <table class="table table-sm table-dark table-striped ax-mini">
        <thead><tr>
          <th style="width:140px;">Time</th>
          <th style="width:90px;">Symbol</th>
          <th style="width:90px;" class="text-end">Qty</th>
          <th style="width:110px;" class="text-end">Gain</th>
          <th style="width:90px;" class="text-end">Gain%</th>
        </tr></thead>
        <tbody>`;
    const body = (sells || []).map(r => {
      const ts = r.ts || "";
      const sym = r.symbol || "";
      const href = tradeReviewHref(sym, ts);
      const qty = (r.qty ?? "");
      const gain = (r.gain ?? "");
      const gp = (r.gain_pct ?? "");
      return `<tr>
        <td><a class="ax-link" href="${href}">${esc(ts).slice(11,19) || esc(ts)}</a></td>
        <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
        <td class="text-end">${esc(qty)}</td>
        <td class="text-end">${esc(gain)}</td>
        <td class="text-end">${esc(gp)}</td>
      </tr>`;
    }).join("");
    return head + body + `</tbody></table>`;
  }

  async function loadDay(dateStr) {
    const buyCol = document.getElementById("ax-buy-col");
    const sellCol = document.getElementById("ax-sell-col");
    const dateEl = document.getElementById("ax-date");
    const errEl = document.getElementById("ax-errors");

    if (!buyCol || !sellCol) return;

    buyCol.innerHTML = `<div class="muted">loading…</div>`;
    sellCol.innerHTML = `<div class="muted">loading…</div>`;
    if (errEl) errEl.textContent = "";

    const url = `/api/analytics/day?date=${enc(dateStr)}&cb=${Date.now()}`;
    const res = await fetch(url, { cache: "no-store" });
    if (!res.ok) throw new Error(`HTTP ${res.status} from ${url}`);

    const d = await res.json();
    if (dateEl) dateEl.textContent = d.date || dateStr;

    buyCol.innerHTML = renderBuyTable(d.buys || []);
    sellCol.innerHTML = renderSellTable(d.sells || []);

    // If no buys, say it plainly (this helps debug DB logging)
    if ((d.buys || []).length === 0) {
      buyCol.insertAdjacentHTML("afterbegin",
        `<div class="muted" style="margin-bottom:8px;">No BUY rows found in DB for this date.</div>`);
    }
  }

  function boot() {
    const picker = document.getElementById("ax-date-picker");
    const initial = getParam("date") || (picker && picker.value) || "";
    if (picker && initial) picker.value = initial;

    if (picker) {
      picker.addEventListener("change", () => {
        const v = picker.value;
        if (v) setParam("date", v);
      });
    }

    const dateStr = initial || new Date().toISOString().slice(0, 10);
    loadDay(dateStr).catch(err => {
      const errEl = document.getElementById("ax-errors");
      if (errEl) errEl.textContent = String(err && err.message ? err.message : err);
      console.error("[AX] loadDay failed:", err);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
})();
