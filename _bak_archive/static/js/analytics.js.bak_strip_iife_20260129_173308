(() => {
﻿/* Daily Analytics (clean, crash-proof)
   - Matches template IDs:
     ax-date, ax-errors, ax-files, ax-today-trades, ax-yesterday
     chart-buy-mix, chart-sell-exits, chart-sell-hold, chart-sell-pl
*/

(function () {
  "use strict";

  const LOGP = "[Daily Analytics]";

  function $(id) { return document.getElementById(id); }
  
function shortTime(ts){
  // Accept ISO string like 2026-01-29T09:30:35.370491-05:00 -> return 09:30:35
  const s = String(ts || "");
  const m = s.match(/T(\d{2}:\d{2}:\d{2})/);
  return m ? m[1] : (s.slice(11, 19) || s);
}

function esc(s) { return ("" + (s ?? "")).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

  function listDomIds(tag) {
    try {
      const ids = Array.from(document.querySelectorAll("[id]")).map(e => e.id).filter(Boolean).sort();
      console.log(LOGP, "DOM ids (" + tag + "):", ids);
    } catch (e) {}
  }

  function setText(id, txt) {
    const el = $(id);
    if (!el) { console.warn(LOGP, "missing #" + id); return false; }
    el.textContent = txt ?? "";
    return true;
  }

  function setHtml(id, html) {
    const el = $(id);
    if (!el) { console.warn(LOGP, "missing #" + id); return false; }
    el.innerHTML = html ?? "";
    return true;
  }

  function toYMD(d) {
    const yy = d.getFullYear();
    const mm = String(d.getMonth()+1).padStart(2,"0");
    const dd = String(d.getDate()).padStart(2,"0");
    return `${yy}-${mm}-${dd}`;
  }

  function ymdYesterday(ymd) {
    // ymd = YYYY-MM-DD
    const m = (ymd || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return "";
    const d = new Date(Date.UTC(parseInt(m[1],10), parseInt(m[2],10)-1, parseInt(m[3],10), 12, 0, 0));
    d.setUTCDate(d.getUTCDate() - 1);
    return toYMD(new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), 12, 0, 0)));
  }

  function pick(obj, keys) {
    if (!obj) return "";
    for (const k of keys) {
      if (obj[k] != null && obj[k] !== "") return obj[k];
      const lk = (""+k).toLowerCase();
      if (obj[lk] != null && obj[lk] !== "") return obj[lk];
    }
    return "";
  }

  function countBy(rows, keyCandidates) {
    const m = new Map();
    for (const r of (rows || [])) {
      const v = (pick(r, keyCandidates) || "").toString().trim();
      if (!v) continue;
      m.set(v, (m.get(v) || 0) + 1);
    }
    const arr = Array.from(m.entries()).sort((a,b)=>b[1]-a[1]);
    return { labels: arr.map(x=>x[0]), values: arr.map(x=>x[1]) };
  }

  function bucketByTime5m(rows) {
    const m = new Map();
    for (const r of (rows || [])) {
      const t = (pick(r, ["time_et","time","timestamp","dt_et","datetime_et"]) || "").toString();
      const mm = t.match(/(\d{1,2}):(\d{2})/);
      if (!mm) continue;
      const hh = parseInt(mm[1],10);
      const mi = parseInt(mm[2],10);
      if (!Number.isFinite(hh) || !Number.isFinite(mi)) continue;
      const b = Math.floor(mi/5)*5;
      const label = String(hh).padStart(2,"0")+":"+String(b).padStart(2,"0");
      m.set(label, (m.get(label)||0)+1);
    }
    const labels = Array.from(m.keys()).sort();
    const values = labels.map(l => m.get(l) || 0);
    return { labels, values };
  }

  function makeTableHtml(buys, sells) {
  // Restored UX: BUY column (left) + SELL column (right), each row links to Trade Review.
  // We prefer /trade_review with symbol + ts_et; if your route uses different params it will ignore extras safely.
  function enc(x){ return encodeURIComponent(String(x || "")); }

  function tradeHref(sym, ts){
    // Primary guess (most common in your project): /trade_review?symbol=...&ts=...
    return `/trade_review?symbol=${enc(sym)}&ts=${enc(ts)}`;
  }

  function buyTable(rows){
    if (!rows || !rows.length) return `<div class="ax-muted">No buys</div>`;
    const head = `<table class="ax-trade-table"><thead><tr>
      <th style="width:86px;">Time</th><th>Symbol</th><th style="width:86px; text-align:right;">Price</th>
    </tr></thead><tbody>`;
    const body = rows.slice(0, 200).map(r => {
      const ts = r.ts_et || "";
      const sym = r.symbol || "";
      const price = r.price || "";
      const href = tradeHref(sym, ts);
      return `<tr>
        <td><a class="ax-link" href="${href}">${esc(shortTime(ts))}</a></td>
        <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
        <td style="text-align:right;"><a class="ax-link" href="${href}">${esc(price)}</a></td>
      </tr>`;
    }).join("");
    return head + body + `</tbody></table>`;
  }

  function sellTable(rows){
    if (!rows || !rows.length) return `<div class="ax-muted">No sells</div>`;
    const head = `<table class="ax-trade-table"><thead><tr>
      <th style="width:86px;">Time</th><th>Symbol</th><th>Reason</th>
    </tr></thead><tbody>`;
    const body = rows.slice(0, 200).map(r => {
      const ts = r.ts_et || "";
      const sym = r.symbol || "";
      const reason = r.reason || "";
      const href = tradeHref(sym, ts);
      return `<tr>
        <td><a class="ax-link" href="${href}">${esc(shortTime(ts))}</a></td>
        <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
        <td><a class="ax-link" href="${href}">${esc(reason)}</a></td>
      </tr>`;
    }).join("");
    return head + body + `</tbody></table>`;
  }

  // If the HTML has ax-buy-col/ax-sell-col, render directly into them.
  const buyCol = document.getElementById("ax-buy-col");
  const sellCol = document.getElementById("ax-sell-col");
  if (buyCol && sellCol) {
    buyCol.innerHTML = buyTable(buys || []);
    sellCol.innerHTML = sellTable(sells || []);
    return ""; // nothing for legacy single-div usage
  }

  // Fallback (older HTML): still return a single combined view
  return `<div>${buyTable(buys||[])}</div><div style="margin-top:10px;">${sellTable(sells||[])}</div>`;


  // ---------------------------------------------------------------------------
  // AX BOOTSTRAP (guaranteed render)
  // If previous edits removed the page init, this ensures Analytics always loads.
  // ---------------------------------------------------------------------------
  if (!window.__AX_BOOTED__) {
    window.__AX_BOOTED__ = true;

    async function axBoot() {
      try {
        const now = Date.now();
        const url = `/api/analytics/today?_=ax_${now}`;

        const r = await fetch(url, { cache: "no-store" });
        const d = await r.json();

        // Date chip
        const dateEl = document.getElementById("ax-date");
        if (dateEl) dateEl.textContent = (d.date_et || d.date || "");

        // Clear errors block
        const errEl = document.getElementById("ax-errors");
        if (errEl) errEl.textContent = "";

        // Today trades (columns)
        try {
          // makeTableHtml() already renders into ax-buy-col/ax-sell-col when present
          makeTableHtml(d.buys || [], d.sells || []);
        } catch (e) {
          console.error("[AX] makeTableHtml failed:", e);
        }

        // If your file has other renderers, call them only if they exist
        try { if (typeof renderBuyMix === "function") renderBuyMix(d); } catch (e) {}
        try { if (typeof renderSellCharts === "function") renderSellCharts(d); } catch (e) {}
        try { if (typeof renderSellReasons === "function") renderSellReasons(d); } catch (e) {}

        console.log("[AX] boot OK", { buys: (d.buys||[]).length, sells: (d.sells||[]).length, date: d.date_et });
      } catch (e) {
        console.error("[AX] boot failed:", e);
        const errEl = document.getElementById("ax-errors");
        if (errEl) errEl.textContent = String(e);
      }
    }

    document.addEventListener("DOMContentLoaded", axBoot, { once: true });
  }

}
