}
.ax-regime-seg{
  height:100%;
}
.ax-regime-hours{
  display:flex;
  justify-content:space-between;
  width: 360px;
  color:#e8e8e8;
  opacity:.85;
  font-weight:700;
  padding: 0 2px;
  user-select:none;
}
.ax-regime-note{
  text-align:center;
  font-size:12px;
  color:#9aa0a6;
  margin-top:2px;
