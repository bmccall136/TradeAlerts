<script>
(function(){
  function pad2(n){ return String(n).padStart(2,'0'); }
  function fmtDate(d){
    return d.getFullYear() + "-" + pad2(d.getMonth()+1) + "-" + pad2(d.getDate());
  }
  function setUrlDate(dateStr){
    if (!dateStr) return;
    const u = new URL(window.location.href);
    u.searchParams.set("date", dateStr);
    window.location.href = u.toString();
  }

  const yBtn = document.getElementById("ax-yesterday");
  const pick = document.getElementById("ax-datepick");
  const go   = document.getElementById("ax-datego");

  // Yesterday button -> ?date=YYYY-MM-DD
  if (yBtn){
    const yd = new Date();
    yd.setDate(yd.getDate() - 1);
    yBtn.href = (function(){
      const u = new URL(window.location.href);
      u.searchParams.set("date", fmtDate(yd));
      return u.toString();
    })();
  }

  // Go button uses picker value
  if (go){
    go.addEventListener("click", function(e){
      e.preventDefault();
      setUrlDate(pick ? pick.value : "");
    });
  }

  // Optional: hitting Enter on date picker triggers Go
  if (pick){
    pick.addEventListener("keydown", function(e){
      if (e.key === "Enter") setUrlDate(pick.value);
    });
  }
})();

// Live button highlight logic
(function(){
  const liveBtn = document.getElementById("ax-live");
  if (!liveBtn) return;

  const u = new URL(window.location.href);
  const cur = (u.searchParams.get("date") || "").trim();

  const pad2 = (n) => String(n).padStart(2,'0');
  const now = new Date();
  const today = now.getFullYear() + "-" + pad2(now.getMonth()+1) + "-" + pad2(now.getDate());

  liveBtn.href = "/analytics"; // no date param = today
  const onToday = (!cur) || (cur === today);
  const canJump = !onToday;

  liveBtn.classList.remove("btn-outline-secondary","btn-outline-warning");
  liveBtn.classList.add(canJump ? "btn-outline-warning" : "btn-outline-secondary");
})();

// Regime strip renderer
(function(){
  const strip = document.getElementById("ax-regime-strip");
  const note  = document.getElementById("ax-regime-note");
  if (!strip) return;

  const u = new URL(window.location.href);
  const dateArg = (u.searchParams.get("date") || "").trim();
  const apiUrl = "/api/market_regime_timeline" + (dateArg ? ("?date=" + encodeURIComponent(dateArg)) : "");

  const COLORS = {
    "TREND": "#00c853",
    "CHOP":  "#ffd600",
    "DEAD":  "#ff5252",
    "":      "#000000",
    null:    "#000000"
  };

  function showNote(msg){
    if (!note) return;
    note.style.display = "block";
    note.textContent = msg;
  }

  function clearStrip(){
    strip.innerHTML = "";
  }

  // buckets => compress contiguous regimes into segments
  function buildSegments(buckets){
    const segs = [];
    let cur = null;
    for (const b of buckets){
      const r = (b && b.r) ? String(b.r).toUpperCase() : "";
      if (!cur || cur.r !== r){
        cur = { r, n: 1 };
        segs.push(cur);
      } else {
        cur.n += 1;
      }
    }
    return segs;
  }

  function renderSegments(segs){
    clearStrip();
    const total = segs.reduce((a,s)=>a+s.n,0) || 1;

    for (const s of segs){
      const d = document.createElement("div");
      d.className = "ax-regime-seg";
      d.style.width = (100 * (s.n/total)).toFixed(3) + "%";
      d.style.background = COLORS[s.r] || "#000";
      strip.appendChild(d);
    }
  }

  fetch(apiUrl, {cache:"no-store"})
    .then(r => r.ok ? r.json() : Promise.reject(new Error("HTTP " + r.status)))
    .then(j => {
      const buckets = Array.isArray(j.buckets) ? j.buckets : [];
      if (!buckets.length){
        // render empty strip
        renderSegments([{r:"", n:1}]);
        showNote("No regime samples for this date yet.");
        return;
      }
      const segs = buildSegments(buckets);
      renderSegments(segs);
    })
    .catch(err => {
      renderSegments([{r:"", n:1}]);
      showNote("Regime timeline unavailable (" + err.message + ")");
    });
})();
</script>

