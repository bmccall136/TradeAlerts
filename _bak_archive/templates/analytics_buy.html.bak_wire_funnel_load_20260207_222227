@'
{% extends "layout.html" %}
{% block content %}
<style>
  /* --- Buy Analytics: make Source/Bucket selects look like true dropdowns --- */
  .mm-select {
    -webkit-appearance: menulist;
    -moz-appearance: menulist;
    appearance: menulist;
    background: #0f1118;
    border: 1px solid #222531;
    color: #eaeaea;
    border-radius: 10px;
    padding: 8px 12px;
    min-width: 190px;
    line-height: 1.1;
  }
  .mm-select:focus { outline: none; border-color: #f0d000; box-shadow: 0 0 0 2px rgba(240,208,0,.15); }

  .mm-card { background:#0f1118; border:1px solid #222531; border-radius:10px; }
  .mm-muted { opacity:.82; }
  .mm-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .mm-title { font-size:22px; font-weight:800; margin:18px 0 10px 0; }
  .mm-sub { margin:0 0 12px 0; opacity:.9; }
  .mm-controls { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .mm-table { width:100%; border-collapse:collapse; }
  .mm-table th, .mm-table td { padding:10px 10px; border-bottom:1px solid #222531; }
  .mm-table th { text-align:left; opacity:.9; font-weight:800; }
  .mm-pill { display:inline-block; padding:2px 8px; border:1px solid #262a38; border-radius:999px; background:#0b0d14; }
  .mm-note { font-size:12px; opacity:.82; margin-top:8px; }
  select, button {
    background:#0b0d14; color:#e9edf6;
    border:1px solid #262a38; border-radius:8px;
    padding:6px 10px;
  }
  button { cursor:pointer; }
  button.primary { background:#f5d400; color:#121212; border-color:#f5d400; font-weight:800; }
</style>

<div id="settings-page" class="container-fluid" style="max-width:1100px;margin-left:auto;margin-right:auto;">

  <div class="mm-row">
    <div>
      <div class="mm-title">Buy Analytics</div>
      <p class="mm-sub mm-muted">
        Fires are <b>pre-gate</b> and count even if later rejected by required/strict. Use this to spot dead/noisy signals.
      </p>
    </div>

    <div class="mm-controls">
      <span class="mm-muted">Source</span>
      <select id="sourceSel" class="mm-select">
        <option value="pregate" selected>Pre-gate Fires</option>
        <option value="candidate">Candidate Fires</option>
      </select>
      <span class="mm-muted">Bucket</span>
      <select id="bucketSel" class="mm-select">
        <option value="today">TODAY</option>
        <option value="7d" selected>7D</option>
        <option value="30d">30D</option>
        <option value="all">ALL</option>
      </select>
      <button id="refreshBtn">Refresh</button>
      <a href="/analytics" class="mm-pill">Back to Analytics</a>
    </div>
  </div>

  <div class="card mm-card">
    <div class="card-body">
      <div class="mm-row" style="margin-bottom:10px;">
        
  <div id="funnelCard" class="mm-card" style="margin: 14px 0 14px 0; padding: 14px 16px; display:none;">
    <div class="mm-row" style="margin-bottom:10px;">
      <div>
        <div style="font-size:18px; font-weight:700;">Candidate Funnel</div>
        <div class="mm-muted" style="margin-top:2px;">
          Candidates are from triggers_*.csv (post-required gate). Strict-pass uses strict_buy_signals.
        </div>
      </div>
      <div class="mm-muted" id="funnelMeta" style="text-align:right;"></div>
    </div>

    <div style="display:grid; grid-template-columns: repeat(5, minmax(160px, 1fr)); gap:10px;">
      <div class="mm-card" style="padding:12px 12px;">
        <div class="mm-muted">Candidates</div>
        <div id="fCand" style="font-size:22px; font-weight:800; margin-top:4px;">?</div>
      </div>
      <div class="mm-card" style="padding:12px 12px;">
        <div class="mm-muted">Required-pass</div>
        <div id="fReq" style="font-size:22px; font-weight:800; margin-top:4px;">?</div>
      </div>
      <div class="mm-card" style="padding:12px 12px;">
        <div class="mm-muted">Strict-pass</div>
        <div id="fStrict" style="font-size:22px; font-weight:800; margin-top:4px;">?</div>
      </div>
      <div class="mm-card" style="padding:12px 12px;">
        <div class="mm-muted">Buyable</div>
        <div id="fBuyable" style="font-size:22px; font-weight:800; margin-top:4px;">?</div>
      </div>
      <div class="mm-card" style="padding:12px 12px;">
        <div class="mm-muted">Bought</div>
        <div id="fBought" style="font-size:22px; font-weight:800; margin-top:4px;">?</div>
      </div>
    </div>
  </div>

<div style="font-size:18px;font-weight:800;">Signal Fires</div>
        <div class="mm-muted" id="metaText"></div>
      </div>

      <div style="overflow:auto;">
        <table class="mm-table">
          <thead>
            <tr>
              <th style="min-width:220px;">Indicator</th>
              <th style="min-width:120px;">Fires</th>
              <th style="min-width:140px;">Share</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>

      <div class="mm-note">
        Next upgrades (when you want): candidate-only fires, candidate→buy funnel, combos, hour-of-day heatmap.
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const $ = (id)=>document.getElementById(id);

  function pct(n, d){
    if (!d) return "0%";
    return (100 * (n/d)).toFixed(1) + "%";
  }

  function esc(s){
    return String(s ?? "").replace(/[&<>"]/g, c => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"
    }[c]));
  }

  
async function loadFunnel(bucket) {
  try {
    const r = await fetch(`/api/analytics/buy_funnel?bucket=${encodeURIComponent(bucket)}`, {cache:'no-store'});
    const j = await r.json();
    if (!j || !j.ok) return;
    const fmtInt = (n) => (n==null ? '?' : Number(n).toLocaleString());
    document.getElementById('fCand').textContent    = fmtInt(j.candidates);
    document.getElementById('fReq').textContent     = fmtInt(j.required_pass);
    document.getElementById('fStrict').textContent  = fmtInt(j.strict_pass);
    document.getElementById('fBuyable').textContent = fmtInt(j.buyable);
    document.getElementById('fBought').textContent  = fmtInt(j.bought);
    document.getElementById('funnelMeta').textContent = `Bucket: ${j.bucket}  ?  Strict>=${j.strict_n}`;
  } catch(e) {}
}

function syncFunnelVisibility() {
  try {
    const sel = document.getElementById('sourceSel');
    const source = (sel && sel.value) ? sel.value : 'pregate';
    const el = document.getElementById('funnelCard');
    if (!el) return;
    el.style.display = (source === 'candidate') ? '' : 'none';
  } catch(e) {}
}


async function load(){
    const bucket = $("bucketSel").value || "7d";
    $("metaText").textContent = "Loading…";
    $("rows").innerHTML = "";

        const source = (document.getElementById('sourceSel')?.value || 'pregate');
    if (typeof syncFunnelVisibility === 'function') syncFunnelVisibility();
    if (source === 'candidate') { await loadFunnel(bucket); }

    const endpoint = (source === 'candidate') ? '/api/analytics/candidate_fires' : '/api/analytics/fires';
    const r = await fetch(`${endpoint}?bucket=${encodeURIComponent(bucket)}`, {cache:"no-store"});
    const j = await r.json();
    if (!j || !j.ok){
      $("metaText").textContent = "Load failed.";
      return;
    }

    const items = j.items || [];
    const total = j.total || 0;

    $("metaText").textContent = `Rows: ${total} • Bucket: ${j.bucket || bucket}`;

    if (!items.length){
      $("rows").innerHTML = `<tr><td colspan="3" class="mm-muted">No data in this bucket.</td></tr>`;
      return;
    }

    const frag = [];
    for (const it of items){
      const ind = esc(it.indicator);
      const n = Number(it.n || 0);
      frag.push(`
        <tr>
          <td><b>${ind}</b></td>
          <td>${n.toLocaleString()}</td>
          <td>${pct(n, total)}</td>
        </tr>
      `);
    }
    $("rows").innerHTML = frag.join("");
  }

  document.addEventListener("DOMContentLoaded", ()=>{
    $("refreshBtn").addEventListener("click", load);
    $("bucketSel").addEventListener("change", load);
    $("sourceSel").addEventListener("change", load);
    load();
  });
})();
</script>
{% endblock %}
'@ | Set-Content -Encoding UTF8 C:\TradeAlerts\templates\analytics_buy.html
