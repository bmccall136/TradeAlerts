<style>
/* Scope EVERYTHING to Sell Regime only */
<div id="mm-sell-regime-buckets" style="display:flex;align-items:center;justify-content:space-between;margin:8px 0 14px 0;">
  <div style="font-size:12px;opacity:.75;">Bucket</div>
  <div style="display:flex;gap:8px;align-items:center;">
    <a class="mm-ax-bucket-btn" data-bucket="today" href="?bucket=today">Today</a>
    <a class="mm-ax-bucket-btn" data-bucket="7d" href="?bucket=7d">7D</a>
    <a class="mm-ax-bucket-btn" data-bucket="30d" href="?bucket=30d">30D</a>
    <a class="mm-ax-bucket-btn" data-bucket="all" href="?bucket=all">All</a>
  </div>
</div>
#mm-sell-regime-root a.mm-ax-bucket-btn,
#mm-sell-regime-root button.mm-btn {
  background: #1e1e1e;
  color: #ccc;
  border: 1px solid #333;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 13px;
  cursor: pointer;
  transition: all .15s ease;
}

/* Hover */
#mm-sell-regime-root a.mm-ax-bucket-btn:hover,
#mm-sell-regime-root button.mm-btn:hover {
  border-color: #f5c542;
  color: #f5c542;
}

/* Active (yellow) */
#mm-sell-regime-root a.mm-ax-bucket-btn.is-active,
#mm-sell-regime-root button.mm-btn.is-active {
  background: #f5c542;
  color: #111;
  border-color: #f5c542;
  font-weight: 600;
}
</style>

<script>
(function(){
  const root = document.getElementById("mm-sell-regime-root");
  if(!root) return;

  const params = new URLSearchParams(window.location.search);
  const bucket = (params.get("bucket") || "today").toLowerCase();

  const btns = root.querySelectorAll("a.mm-ax-bucket-btn, button.mm-btn");

  btns.forEach(btn => {
    const val =
      (btn.getAttribute("data-bucket") ||
       btn.textContent ||
       "").trim().toLowerCase();

    if(val.includes(bucket)){
      btn.classList.add("is-active");
    } else {
      btn.classList.remove("is-active");
    }
  });
})();
</script>

