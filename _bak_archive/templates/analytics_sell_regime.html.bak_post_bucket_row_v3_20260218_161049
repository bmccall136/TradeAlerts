<script>

  // MM_FETCH_JSON_V1: safe fetch wrapper (prevents JSON.parse crashes on HTML/500)
  async function mmFetchJson(url) {
    const res = await fetch(url, { cache: "no-store" });
    const ct = (res.headers.get("content-type") || "").toLowerCase();
    if (!res.ok) {
      const txt = await res.text();
      throw new Error(`HTTP ${res.status} ${res.statusText}\n${txt.slice(0, 1200)}`);
    }
    if (!ct.includes("application/json")) {
      const txt = await res.text();
      throw new Error(`Expected JSON but got: ${ct}\n${txt.slice(0, 1200)}`);
    }
    return await res.json();
  }


function mmNormBucket(b){
  if(!b) return "today";
  const s=String(b).trim();
  const u=s.toUpperCase();
  if(u==="TODAY") return "today";
  if(u==="7D") return "7d";
  if(u==="30D") return "30d";
  if(u==="ALL") return "all";
  return s.toLowerCase();
}
function tagClass(r){
  const x=(r||"").toUpperCase();
  if(x==="CHOP") return "tag chop";
  if(x==="TREND") return "tag trend";
  if(x==="DEAD") return "tag dead";
  return "tag";
}
function fmt(n){ try { return Number(n).toLocaleString(); } catch(e){ return String(n); } }
async function load(){
  const b = mmNormBucket(document.getElementById("bucket").value);
  const url = `/api/analytics/sell_regime?bucket=${encodeURIComponent(b)}`;
  const err = document.getElementById("err");
  err.style.display="none"; err.textContent="";
  const rows = document.getElementById("rows");
  rows.innerHTML = "";

  let j=null;
  try{
    const r = await fetch(url, {cache:"no-store"});
    j = await r.json();
  }catch(e){
    err.style.display="block";
    err.textContent = `Fetch failed: ${e}`;
    return;
  }
  if(!j || !j.ok){
    err.style.display="block";
    err.textContent = (j && j.error) ? j.error : "Unknown error";
    return;
  }

  const by = j.by_regime || [];

    // NEW: outcomes + exit reasons
    try {
      const o = await loadSellOutcomes(bucket);
      renderOutcomesTable(document.getElementById('mm-outcomes-body'), o.by_regime || []);
    } catch (e) {
      document.getElementById('mm-outcomes-body').innerHTML = `<div class="muted">Outcomes error: ${e}</div>`;
    }

    try {
      const x = await loadSellExits(bucket);
      renderExitsTable(document.getElementById('mm-exits-body'), x.by_regime || []);
    } catch (e) {
      document.getElementById('mm-exits-body').innerHTML = `<div class="muted">Exits error: endpoint missing (404) ? disabled until API is added</div>`;
    }
  const total = by.reduce((a,x)=>a + (Number(x.count)||Number(x.total)||0), 0);
document.getElementById("kTotal").textContent = fmt(total);
  document.getElementById("kSince").textContent = j.since_ts_utc ? `since_ts_utc: ${j.since_ts_utc}` : "";

  const top = [...by].sort((a,b)=>(Number(b.count)||0)-(Number(a.count)||0))[0];
  document.getElementById("kTop").textContent = top ? (top.regime||"?") : "?";
  document.getElementById("kTop2").textContent = top ? `count=${fmt(top.count)} avg_conf=${(top.avg_conf ?? "?")}` : "?";

  for(const x of by){
    const c = Number(x.count)||0;
    const share = total ? (100*c/total) : 0;
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><span class="${tagClass(x.regime)}">${x.regime||""}</span></td>
      <td style="text-align:right">${fmt(c)}</td>
      <td style="text-align:right">${(x.avg_conf ?? "?")}</td>
      <td style="text-align:right">${share.toFixed(1)}%</td>
    `;
    rows.appendChild(tr);
  }
}
document.getElementById("bucket").addEventListener("change", load);
load();


  async function loadSellOutcomes(bucket) {
    const res = await fetch(`/api/analytics/sell_regime_outcomes?bucket=${encodeURIComponent(bucket)}`);
    return res.json();
  }
  async function loadSellExits(bucket) {
    const res = await fetch(`/api/analytics/sell_regime_exits/*MM_DISABLED_404*/?bucket=${encodeURIComponent(bucket)}`);
    return res.json();
  }


  function renderOutcomesTable(el, rows) {
    if (!rows || !rows.length) { el.innerHTML = '<div class="muted">No outcome rows.</div>'; return; }
    const tr = rows.map(r => `
      <tr>
        <td><span class="pill">${r.regime}</span></td>
        <td class="num">${r.count}</td>
        <td class="num">${r.win_rate}%</td>
        <td class="num">${r.sum_gain}</td>
        <td class="num">${r.avg_gain ?? ''}</td>
        <td class="num">${r.median_gain ?? ''}</td>
        <td class="num">${r.median_hold_min ?? ''}</td>
      </tr>
    `).join('');
    el.innerHTML = `
      <table class="mm-table">
        <thead>
          <tr>
            <th>Regime</th><th class="num">N</th><th class="num">Win%</th><th class="num">? P/L</th>
            <th class="num">Avg</th><th class="num">Median</th><th class="num">Med Hold (min)</th>
          </tr>
        </thead>
        <tbody>${tr}</tbody>
      </table>`;
  }

  function renderExitsTable(el, rows) {
    if (!rows || !rows.length) { el.innerHTML = '<div class="muted">No exit rows.</div>'; return; }
    const tr = rows.map(r => {
      const top = (r.events || []).slice(0, 8).map(e => `${e.event}(${e.count})`).join(', ');
      return `
        <tr>
          <td><span class="pill">${r.regime}</span></td>
          <td class="num">${r.total}</td>
          <td class="num">${r.avg_conf ?? ''}</td>
          <td>${top}</td>
        </tr>`;
    }).join('');
    el.innerHTML = `
      <table class="mm-table">
        <thead><tr><th>Regime</th><th class="num">Events</th><th class="num">Avg Conf</th><th>Top exit events</th></tr></thead>
        <tbody>${tr}</tbody>
      </table>`;
  }

</script>

  <div class="mm-card mm-regime-outcomes">
