  </div>

  <div class="mt-3 small text-secondary" id="ax-files"></div>
</div>

<script>
(function(){
  function pad2(n){ return String(n).padStart(2,'0'); }
  function fmtDate(d){
    return d.getFullYear() + "-" + pad2(d.getMonth()+1) + "-" + pad2(d.getDate());
  }
  function setUrlDate(dateStr){
    if (!dateStr) return;
    const u = new URL(window.location.href);
    u.searchParams.set("date", dateStr);
    window.location.href = u.toString();
  }

  const yBtn = document.getElementById("ax-yesterday");
  const pick = document.getElementById("ax-datepick");
  const go   = document.getElementById("ax-datego");

  if (yBtn){
    const yd = new Date();
    yd.setDate(yd.getDate() - 1);
    yBtn.href = (function(){
      const u = new URL(window.location.href);
      u.searchParams.set("date", fmtDate(yd));
      return u.toString();
    })();
  }

  if (go){
    go.addEventListener("click", function(e){
      e.preventDefault();
      setUrlDate(pick ? pick.value : "");
    });
  }

  if (pick){
    pick.addEventListener("keydown", function(e){
      if (e.key === "Enter") setUrlDate(pick.value);
    });
  }
})();

(function(){
  const liveBtn = document.getElementById("ax-live");
  if (!liveBtn) return;

  const u = new URL(window.location.href);
  const cur = (u.searchParams.get("date") || "").trim();

  const pad2 = (n) => String(n).padStart(2,'0');
  const now = new Date();
  const today = now.getFullYear() + "-" + pad2(now.getMonth()+1) + "-" + pad2(now.getDate());

  liveBtn.href = "/analytics";
  const onToday = (!cur) || (cur === today);
  const canJump = !onToday;

  liveBtn.classList.remove("btn-outline-secondary","btn-outline-warning");
  liveBtn.classList.add(canJump ? "btn-outline-warning" : "btn-outline-secondary");
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<!-- MM_DAILY_LOADING_FIX_V1 -->
<script>
(function(){
  function showErr(msg){
    try{
      var el=document.getElementById('ax-errors');
      if(el){ el.style.display='block'; el.textContent=msg; }
    }catch(e){}
  }
  window.addEventListener('error', function(ev){
    var m = (ev && ev.message) ? ev.message : 'Unknown JS error';
    showErr('Daily Analytics JS error: ' + m);
  });
  window.addEventListener('unhandledrejection', function(ev){
    var m = (ev && ev.reason) ? (ev.reason.message || String(ev.reason)) : 'Unknown promise rejection';
    showErr('Daily Analytics promise error: ' + m);
  });

  document.addEventListener('DOMContentLoaded', function(){
    try{
      if (typeof window.loadDaily === 'function') { window.loadDaily(); return; }
      if (window.MM && typeof window.MM.loadDaily === 'function') { window.MM.loadDaily(); return; }
      showErr('Daily Analytics: loadDaily() not found (analytics.js not loaded or not exporting).');
    }catch(e){
      showErr('Daily Analytics bootstrap failed: ' + (e.message || String(e)));
    }
  });
})();
</script>

<script src="/static/js/analytics.js?v={{ (config.get('BUILD_ID') or '') }}"></script>

