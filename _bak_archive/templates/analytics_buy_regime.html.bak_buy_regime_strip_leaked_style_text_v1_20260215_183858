<script>
async function mmFetchJson(url){
  const r = await fetch(url, {cache:"no-store"});
  const ct = (r.headers.get("content-type")||"").toLowerCase();
  if(!r.ok){
    const txt = await r.text();
    throw new Error("HTTP " + r.status + " " + (txt||"").slice(0,600));
  }
  if(ct.includes("application/json")) return await r.json();
  const txt = await r.text();
  throw new Error("Non-JSON: " + (txt||"").slice(0,600));
}

function fmtPct(x){
  if(!isFinite(x)) return "";
  return (x*100).toFixed(1) + "%";
}
function tagClass(reg){
  reg=(reg||"").toLowerCase();
  if(reg==="chop") return "tag chop";
  if(reg==="trend") return "tag trend";
  if(reg==="dead") return "tag dead";
  return "tag";
}

async function loadBucket(){
  const b = (document.getElementById("bucket").value || "today").toLowerCase();
  const errEl = document.getElementById("err");
  const tbody = document.getElementById("tbody");
  errEl.textContent = "";
  tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">Loading…</td></tr>';

  try{
    const j = await mmFetchJson("/api/analytics/buy_regime?bucket=" + encodeURIComponent(b));
    const rows = j.rows || [];
    const total = rows.reduce((a,r)=>a+(+r.count||0),0);

    document.getElementById("k-total").textContent = String(total);
    document.getElementById("k-top").textContent = (j.top_regime || "—");

    if(!rows.length){
      tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">No rows.</td></tr>';
      return;
    }

    tbody.innerHTML = "";
    rows.forEach(r=>{
      const tr = document.createElement("tr");
      const reg = (r.regime||"").toUpperCase();
      const share = total ? ((+r.count||0)/total) : 0;
      tr.innerHTML = `
        <td><span class="${tagClass(reg)}">${reg || "UNKNOWN"}</span></td>
        <td>${(+r.count||0).toLocaleString()}</td>
        <td>${(r.avg_conf==null) ? "" : (+r.avg_conf).toFixed(0)}</td>
        <td>${fmtPct(share)}</td>
      `;
      tbody.appendChild(tr);
    });
  }catch(e){
    errEl.textContent = String(e && e.message ? e.message : e);
    tbody.innerHTML = '<tr><td colspan="4" class="mm-muted">Error.</td></tr>';
  }
}

async function loadOutcomes(){
  const b = (document.getElementById("bucket").value || "today").toLowerCase();
  const out = document.getElementById("outcomes");
  out.textContent = "Loading…";
  try{
    const j = await mmFetchJson("/api/analytics/buy_regime_outcomes?bucket=" + encodeURIComponent(b));
    out.textContent = (j && j.summary) ? j.summary : "OK";
  }catch(e){
    out.textContent = "Outcomes error: " + String(e && e.message ? e.message : e);
  }
}

document.getElementById("bucket").addEventListener("change", ()=>{
  loadBucket();
  loadOutcomes();
});

loadBucket();
loadOutcomes();
</script>

