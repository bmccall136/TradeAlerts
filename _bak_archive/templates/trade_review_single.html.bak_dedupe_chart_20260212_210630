
<style>

/* ---- TRV UI POLISH ---- */
.mm-triggers {
  max-height: 420px;
  overflow-y: auto;
  padding-right: 8px;
}
.mm-group {
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 10px;
  margin: 10px 0;
  background: rgba(255,255,255,.02);
}
.mm-group-hdr {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding: 8px 10px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  font-weight: 700;
}
.mm-group-hdr .mm-badge {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.14);
  opacity: .9;
}
.mm-row {
  padding: 8px 10px;
  border-top: 1px solid rgba(255,255,255,.06);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  font-size: 12px;
  line-height: 1.35;
}
.mm-row:first-child { border-top: 0; }
.mm-row .mm-line1 { display:flex; gap:10px; flex-wrap:wrap; }
.mm-row .mm-time { opacity:.85; min-width: 80px; }
.mm-row .mm-px { font-weight: 800; }
.mm-row .mm-sig { opacity:.92; }
.mm-anchor {
  border-left: 4px solid #f7c843;
  background: rgba(247,200,67,.10);
  box-shadow: 0 0 0 1px rgba(247,200,67,.18) inset;
}
.mm-anchor .mm-anchor-badge {
  margin-left:auto;
  font-weight: 900;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(247,200,67,.18);
  border: 1px solid rgba(247,200,67,.28);
}
/* ---- END TRV UI POLISH ---- */
/* --- Trade Review chart fit fix --- */
.trade-chart-img{
  width: 100% !important;
  height: auto !important;
  display: block !important;
}
.trade-chart-wrap{
  overflow: visible !important;   /* prevent cropping */
}
</style>

﻿{% extends "layout.html" %}
{% block content %}

<div class="tr-wrap">
  <div class="tr-head">
    <div class="tr-title">Trade Review — {{ trade.symbol }}</div>
    <div class="tr-sub">
      <span>Buy: {{ trade.open_date }} @ {{ '%.2f'|format(trade.price_paid or 0) }}</span>
      <span class="sep">|</span>
      <span>Sell: {{ trade.close_date }} @ {{ '%.2f'|format(trade.price_sold or 0) }}</span>
      <span class="sep">|</span>
      <span class="{{ 'win' if is_win else 'loss' }}">
        P&L: {{ '%.2f'|format(trade.gain or 0) }} ({{ '%.2f'|format((trade.gain_pct or 0)) }}%)
      </span>
      <span class="sep">|</span>
      <span>Qty: {{ trade.qty }}</span>
    </div>
    <div class="tr-src">
    </div>
  </div>

  <div class="trade-chart-wrap tr-chart-wrap">
    <img class="tr-chart trade-chart-img"
         src="/chart_img/{{ symbol }}{% if ts %}?ts={{ ts|urlencode }}{% endif %}"
         alt="Trade chart {{ trade.symbol }}{% if name %} ? {{ name }}{% endif %}">

  <!-- --- Inline Trade Review chart (BUY/SELL marked) --- -->
  <div class="trade-chart-wrap tr-chart-wrap">
    <img class="tr-chart trade-chart-img"
         src="/trade_review/chart?symbol={{ trade.symbol|urlencode }}&name={{ (name or trade.name or '')|urlencode }}&buy_ts={{ trade.buy_time|urlencode }}&sell_ts={{ trade.sell_time|urlencode }}{% if ts %}&ts={{ ts|urlencode }}&v={{ ts|urlencode }}{% endif %}"
         alt="Trade chart {{ symbol }}{% if name %} - {{ name }}{% endif %}">
  </div>
  <!-- --- end chart --- -->

    <div class="tr-legend">
      <span class="pill buy">BUY</span>
      <span class="pill sell">SELL</span>
      <span class="pill {{ 'win' if is_win else 'loss' }}">SHADED = time at risk</span>
    </div>
  </div>

  <div class="tr-grid">
    <section class="tr-col">
      <h3>Buy Triggers</h3>
{% if buy_groups %}
<div class="mm-triggers">
  {% for g in buy_groups %}
  <div class="mm-group">
    <div class="mm-group-hdr">
      <div>{{ g.label }}</div>
      <div class="mm-badge">{{ g.count }} row{{ 's' if g.count != 1 else '' }}{% if g.has_anchor %} ? anchor{% endif %}</div>
    </div>
    {% for r in g.rows %}
      <div class="mm-row{% if r._is_anchor %} mm-anchor{% endif %}">
        <div class="mm-line1">
          <div class="mm-time">{{ r.time_et or r.ts_et or '' }}</div>
          <div class="mm-px">{% if r.price %}${{ '%.2f'|format((r.price|float)) }}{% endif %}</div>
          <div class="mm-sig">{{ r.signals_pretty or '' }}</div>
          {% if r._is_anchor %}<div class="mm-anchor-badge">ANCHOR</div>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% elif buy_triggers %}
<div class="mm-triggers">
  {% for r in buy_triggers %}
    <div class="mm-row">
      <div class="mm-line1">
        <div class="mm-time">{{ r.time_et or r.ts_et or '' }}</div>
        <div class="mm-px">{% if r.price %}${{ '%.2f'|format((r.price|float)) }}{% endif %}</div>
        <div class="mm-sig">{{ r.signals_pretty or '' }}</div>
      </div>
    </div>
  {% endfor %}
</div>
{% else %}
<div class="mm-muted">No buy triggers found.</div>
{% endif %}
<h3>Sell Triggers</h3>
{% if sell_groups %}
<div class="mm-triggers">
  {% for g in sell_groups %}
  <div class="mm-group">
    <div class="mm-group-hdr">
      <div>{{ g.label }}</div>
      <div class="mm-badge">{{ g.count }} row{{ 's' if g.count != 1 else '' }}{% if g.has_anchor %} ? anchor{% endif %}</div>
    </div>
    {% for r in g.rows %}
      <div class="mm-row{% if r._is_anchor %} mm-anchor{% endif %}">
        <div class="mm-line1">
          <div class="mm-time">{{ r.time_et or r.ts_et or '' }}</div>
          <div class="mm-px">{% if r.price %}${{ '%.2f'|format((r.price|float)) }}{% endif %}</div>
          <div class="mm-sig">{{ r.signals_pretty or '' }}</div>
          {% if r._is_anchor %}<div class="mm-anchor-badge">ANCHOR</div>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% elif sell_triggers %}
<div class="mm-triggers">
  {% for r in sell_triggers %}
    <div class="mm-row">
      <div class="mm-line1">
        <div class="mm-time">{{ r.time_et or r.ts_et or '' }}</div>
        <div class="mm-px">{% if r.price %}${{ '%.2f'|format((r.price|float)) }}{% endif %}</div>
        <div class="mm-sig">{{ r.signals_pretty or '' }}</div>
      </div>
    </div>
  {% endfor %}
</div>
{% else %}
<div class="mm-muted">No sell triggers found.</div>
{% endif %}

{% endblock %}
