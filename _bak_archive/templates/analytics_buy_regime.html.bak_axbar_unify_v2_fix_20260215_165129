{% extends "layout.html" %}
{% block content %}

<!-- MM_ANALYTICS_REGIME_TAPE_V1 -->
<div id="mm-ax-tape-wrap" style="margin:10px 14px 18px 14px;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:0 0 6px 2px;">
    <div style="font-size:12px;opacity:.75;">Regime tape (today)</div>
    <div id="mm-ax-tape-meta" style="font-size:12px;opacity:.70;"></div>
    <div id="mm-ax-tape-debug" style="margin-top:4px;font-size:12px;opacity:.92;color:#ffcc00;"></div>
  </div>

  <div style="position:relative;">
    <div id="mm-ax-ticks" style="position:absolute;left:0;top:-16px;right:0;height:14px;font-size:11px;opacity:.65;pointer-events:none;"></div>
    <div id="mm-ax-tape"
         style="height:14px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.10);
                background:rgba(255,255,255,.04);">
    </div>
    <div id="mm-ax-ticklines" style="position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;"></div>
  </div>
</div>

<script>
/* MM_ANALYTICS_TAPE_SCRIPT_CLEAN_V1 */
(function(){
  const el = document.getElementById("mm-ax-tape");
  const ticksEl = document.getElementById("mm-ax-ticks");
  const linesEl = document.getElementById("mm-ax-ticklines");
  const metaEl = document.getElementById("mm-ax-tape-meta");
  const dbgEl  = document.getElementById("mm-ax-tape-debug");
  if (!el || !ticksEl || !linesEl) return;

  function dbg(msg){
    try{
      if(!dbgEl) return;
      const u = new URL(window.location.href);
      const on = (u.searchParams.get("tape_debug") || "").trim() === "1";
      dbgEl.textContent = on ? msg : "";
    }catch(e){}
  }

  function colorFor(reg){
    reg = (reg||"").toUpperCase();
    if (reg === "TREND") return "rgba(0, 200, 120, .95)";
    if (reg === "CHOP")  return "rgba(240, 200, 0, .95)";
    if (reg === "DEAD")  return "rgba(220, 60, 60, .95)";
    return "rgba(160,160,160,.35)";
  }

  function buildBins(openTs, closeTs){
    const bins = [];
    const start = openTs - (openTs % 300);
    const end   = closeTs - (closeTs % 300);
    for (let t = start; t <= end; t += 300) bins.push(t);
    return bins;
  }

  function carryForward(points, bins){
    const map = new Map();
    (points||[]).forEach(p => {
      const t = (p.ts_utc||0);
      const bt = t - (t % 300);
      map.set(bt, { regime: p.regime, conf: p.conf });
    });

    let last = null;
    const segs = [];
    for (const b of bins){
      if (map.has(b)) last = map.get(b);
      segs.push({ ts:b, regime: last?.regime || "UNKNOWN", conf: (last?.conf ?? null) });
    }
    return segs;
  }

  function render(segs, openTs, closeTs){
    el.innerHTML = "";
    ticksEl.innerHTML = "";
    linesEl.innerHTML = "";
    if (metaEl) metaEl.textContent = "";
    if (!segs || !segs.length){ dbg("no segs"); return; }

    const nowTs = Math.floor(Date.now()/1000);
    const paintUntil = Math.max(openTs, Math.min(closeTs, nowTs));

    let n = 0;
    for (let i=0; i<segs.length; i++){
      if (segs[i].ts <= paintUntil) n = i+1;
      else break;
    }
    if (n === 0) n = 1;

    const w = 100 / segs.length;
    let html = "";
    for (let i=0; i<n; i++){
      const s = segs[i];
      html += `<div style="float:left;height:100%;width:${w}%;background:${colorFor(s.regime)}"></div>`;
    }
    el.innerHTML = html + '<div style="clear:both"></div>';

    const mk = [
      { ts: openTs,               label:"9:30"  },
      { ts: openTs + 60*60,       label:"10:30" },
      { ts: openTs + 150*60,      label:"12"    },
      { ts: openTs + 270*60,      label:"2"     },
      { ts: closeTs,              label:"4"     },
    ];

    let tHtml = "";
    let lHtml = "";
    for (const t of mk){
      if (t.ts < openTs || t.ts > closeTs) continue;
      const pct = ((t.ts - openTs) / (closeTs - openTs)) * 100;
      tHtml += `<div style="position:absolute;left:calc(${pct}% - 14px);top:0;width:28px;text-align:center;">${t.label}</div>`;
      lHtml += `<div style="position:absolute;left:${pct}%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.10)"></div>`;
    }
    ticksEl.innerHTML = tHtml;
    linesEl.innerHTML = lHtml;

    const prog = Math.max(0, Math.min(1, (paintUntil - openTs) / (closeTs - openTs)));
    if (metaEl) metaEl.textContent = `progress: ${(prog*100).toFixed(0)}%`;
  }

  async function tick(){
    try{
      const res = await (function(){
        const u0 = new URL(window.location.href);
        const d0 = (u0.searchParams.get("date") || "").trim();
        const api = d0 ? ("/api/market_regime_timeline?date=" + encodeURIComponent(d0))
                       : "/api/market_regime_timeline?bucket=today";
        return fetch(api, { cache:"no-store" });
      })();
      if (!res.ok){ dbg("api not ok"); return; }
      const j = await res.json();
      const pts = (j.points && j.points.length) ? j.points : (j.buckets || []);
      const win = j.window || {};
      const since = win.since_ts_utc || 0;
      if (!since){ dbg("no window.since_ts_utc"); return; }

      const openTs  = since + (9*3600) + (30*60);
      const closeTs = since + (16*3600);

      const bins = buildBins(openTs, closeTs);
      const segs = carryForward(pts, bins);

      dbg(`pts=${pts.length} bins=${bins.length} segs=${segs.length} open=${openTs} close=${closeTs}`);
      render(segs, openTs, closeTs);
    }catch(e){
      dbg("tick err: " + (e && e.message ? e.message : String(e)));
    }
  }

  tick();
  setInterval(tick, 60*1000);
})();
</script>

{% from "_analytics_toolbar.html" import mmAnalyticsToolbar %}

{% set controls_html %}
  <select id="bucket" class="mm-select" title="Bucket">
    <option value="today">Today</option>
    <option value="7d">7D</option>
    <option value="30d">30D</option>
    <option value="all">ALL</option>
  </select>
{% endset %}

<style>
  .mm-wrap{max-width:1400px;margin:0 auto;padding:16px}
  .mm-title{font-size:22px;font-weight:700}
  .mm-sub{opacity:.8;font-size:13px}
  .mm-card{border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:14px;background:rgba(255,255,255,.03)}
  .mm-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
  .mm-col{flex:1 1 420px}
  .mm-kpi{display:flex;gap:10px;align-items:baseline}
  .mm-kpi .v{font-size:28px;font-weight:800}
  .mm-kpi .l{opacity:.75;font-size:12px}
  table{width:100%;border-collapse:collapse;margin-top:10px}
  th,td{padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;font-size:13px}
  .tag{display:inline-flex;align-items:center;padding:2px 8px;border-radius:999px;font-size:12px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.04)}
  .tag.chop{border-color:rgba(255,200,0,.35)}
  .tag.trend{border-color:rgba(0,200,120,.35)}
  .tag.dead{border-color:rgba(200,200,200,.25)}
  .mm-muted{opacity:.75}
  .mm-small{font-size:12px;opacity:.8}
  .mm-error{white-space:pre-wrap;color:#ffb3b3}
  .mm-select{border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.2);color:inherit;border-radius:10px;padding:8px 10px}
</style>

<div class="mm-wrap">
  {{ mmAnalyticsToolbar("Buy Regime", "Counts by market regime from /api/analytics/buy_regime", controls_html) }}

  <div class="mm-row">
    <div class="mm-col">
      <div class="mm-card">
        <div class="mm-kpi"><div class="v" id="kTotal">?</div><div class="l">Total events in bucket</div></div>
        <div class="mm-small mm-muted" id="kSince">?</div>
      </div>
    </div>
    <div class="mm-col">
      <div class="mm-card">
        <div class="mm-kpi"><div class="v" id="kTop">?</div><div class="l">Top regime</div></div>
        <div class="mm-small mm-muted" id="kTop2">?</div>
      </div>
    </div>
  </div>

  <div class="mm-row">
    <div class="mm-col" style="flex:1 1 100%">
      <div class="mm-card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <div style="font-weight:700">By Regime</div>
          <div class="mm-small mm-muted">Shows count + avg confidence (if present)</div>
        </div>
        <div id="err" class="mm-error" style="display:none;margin-top:10px"></div>
        <table>
          <thead>
            <tr>
              <th>Regime</th>
              <th style="text-align:right">Count</th>
              <th style="text-align:right">Avg Conf</th>
              <th style="text-align:right">Share</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="mm-card mm-regime-outcomes" style="margin-top:12px;">
    <div class="mm-card-title" style="font-weight:800;margin-bottom:8px;">Entry-regime outcomes (realized)</div>
    <div class="muted" style="margin-bottom:10px;opacity:.8;">
      Uses realized_trades mapped to position_opened mapped to nearest buy_events regime near opened time.
    </div>
    <div id="mm-buy-outcomes-body" class="mm-card-body muted">Loading…</div>
  </div>
</div>

<script>
function mmNormBucket(b){
  if(!b) return "today";
  const s=String(b).trim();
  const u=s.toUpperCase();
  if(u==="TODAY") return "today";
  if(u==="7D") return "7d";
  if(u==="30D") return "30d";
  if(u==="ALL") return "all";
  return s.toLowerCase();
}
function tagClass(r){
  const x=(r||"").toUpperCase();
  if(x==="CHOP") return "tag chop";
  if(x==="TREND") return "tag trend";
  if(x==="DEAD") return "tag dead";
  return "tag";
}
function fmt(n){ try { return Number(n).toLocaleString(); } catch(e){ return String(n); } }

async function loadBuyOutcomes(bucket) {
  const res = await fetch(`/api/analytics/buy_regime_outcomes?bucket=${encodeURIComponent(bucket)}`, {cache:'no-store'});
  return res.json();
}
function renderBuyOutcomesTable(el, rows) {
  if (!rows || !rows.length) { el.innerHTML = '<div class="muted">No outcome rows.</div>'; return; }
  const tr = rows.map(r => `
    <tr>
      <td><span class="tag">${r.regime}</span></td>
      <td style="text-align:right">${r.count}</td>
      <td style="text-align:right">${r.win_rate}%</td>
      <td style="text-align:right">${r.sum_gain}</td>
      <td style="text-align:right">${r.avg_gain ?? ''}</td>
      <td style="text-align:right">${r.median_gain ?? ''}</td>
      <td style="text-align:right">${r.median_hold_min ?? ''}</td>
    </tr>
  `).join('');
  el.innerHTML = `
    <table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr>
          <th>Regime</th><th style="text-align:right">N</th><th style="text-align:right">Win%</th><th style="text-align:right">Σ P/L</th>
          <th style="text-align:right">Avg</th><th style="text-align:right">Median</th><th style="text-align:right">Med Hold (min)</th>
        </tr>
      </thead>
      <tbody>${tr}</tbody>
    </table>`;
}

async function load(){
  const b = mmNormBucket(document.getElementById("bucket").value);
  const url = `/api/analytics/buy_regime?bucket=${encodeURIComponent(b)}`;
  const err = document.getElementById("err");
  err.style.display="none"; err.textContent="";
  const rows = document.getElementById("rows");
  rows.innerHTML = "";

  let j=null;
  try{
    const r = await fetch(url, {cache:"no-store"});
    j = await r.json();
  }catch(e){
    err.style.display="block";
    err.textContent = `Fetch failed: ${e}`;
    return;
  }
  if(!j || !j.ok){
    err.style.display="block";
    err.textContent = (j && j.error) ? j.error : "Unknown error";
    return;
  }

  const by = j.by_regime || [];
  const total = by.reduce((a,x)=>a + (Number(x.count)||0), 0);
  document.getElementById("kTotal").textContent = fmt(total);
  document.getElementById("kSince").textContent = j.since_ts_utc ? `since_ts_utc: ${j.since_ts_utc}` : "";

  const top = [...by].sort((a,b)=>(Number(b.count)||0)-(Number(a.count)||0))[0];
  document.getElementById("kTop").textContent = top ? (top.regime||"?") : "?";
  document.getElementById("kTop2").textContent = top ? `count=${fmt(top.count)} avg_conf=${(top.avg_conf ?? "?")}` : "?";

  for(const x of by){
    const c = Number(x.count)||0;
    const share = total ? (100*c/total) : 0;
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><span class="${tagClass(x.regime)}">${x.regime||""}</span></td>
      <td style="text-align:right">${fmt(c)}</td>
      <td style="text-align:right">${(x.avg_conf ?? "?")}</td>
      <td style="text-align:right">${share.toFixed(1)}%</td>
    `;
    rows.appendChild(tr);
  }

  try{
    const o = await loadBuyOutcomes(b);
    renderBuyOutcomesTable(document.getElementById('mm-buy-outcomes-body'), (o && o.by_regime) ? o.by_regime : []);
  }catch(e){
    document.getElementById('mm-buy-outcomes-body').innerHTML = `<div class="muted">Outcomes error: ${e}</div>`;
  }
}

document.getElementById("bucket").addEventListener("change", load);
load();
</script>

{% endblock %}
