  <!-- Live mode toggle: Day Trader / Swing Trader -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const group = document.getElementById('live-mode-toggle');
      if (!group) return;

      const buttons = group.querySelectorAll('[data-mode]');

      function applyMode(mode) {
        const upper = (mode || '').toUpperCase();
        buttons.forEach(btn => {
          const m = (btn.dataset.mode || '').toUpperCase();
          const isActive = (m === upper);

          if (isActive) {
            btn.classList.add('btn-warning');
            btn.classList.remove('btn-outline-warning', 'btn-outline-secondary');
          } else {
            btn.classList.add('btn-outline-warning');
            btn.classList.remove('btn-warning');
          }
        });
      }

      async function fetchMode() {
        try {
          const resp = await fetch('/live/mode');
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          const data = await resp.json();
          applyMode(data.mode || 'DAY');
        } catch (err) {
          console.error('[live-mode] fetch failed:', err);
          applyMode('DAY');
        }
      }

      async function setMode(mode) {
        // Optimistic update
        applyMode(mode);
        try {
          const resp = await fetch('/live/mode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode })
          });
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          const data = await resp.json();
          applyMode(data.mode || mode);
        } catch (err) {
          console.error('[live-mode] set failed:', err);
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', function (ev) {
          ev.preventDefault();
          const mode = this.dataset.mode;
          if (mode) setMode(mode);
        });
      });

      // Initial sync from server
      fetchMode();
    });
  </script>
	<script>
	  (function () {
		document.addEventListener('DOMContentLoaded', function () {
		  const aiToggle = document.getElementById("ai-enabled-toggle");
		  if (!aiToggle) return;

		  const badge = document.getElementById("maxInsideBadge");

		  function applyGlow() {
			if (!badge) return;
			badge.classList.toggle("max-ai-glow", !!aiToggle.checked);
		  }

		  // Set initial state on load
		  applyGlow();

		  // When user clicks the AI Advisor checkbox, push state to backend
		  aiToggle.addEventListener("change", () => {
			const enabled = aiToggle.checked;

			// Optimistic UI: glow immediately
			applyGlow();

			fetch("/live/ai_toggle", {
			  method: "POST",
			  headers: { "Content-Type": "application/json" },
			  body: JSON.stringify({ enabled })
			}).catch(() => {
			  // On error, revert checkbox + glow so UI doesn't lie
			  aiToggle.checked = !enabled;
			  applyGlow();
			});
		  });
		});
	  })();
	</script>



<!-- $$Machine Market Regime badge (SPY) -->
<style>
  #mm-regime-wrap{ display:flex; justify-content:center; width:100%; margin:10px 0 6px; }
#mm-regime {
    display:inline-flex; align-items:center; gap:8px;
    padding:4px 8px; border-radius:999px;
    border:1px solid #2a2d3b; background:#0f1118;
    font-size:12px; line-height:1; opacity:.92;
    margin-left:10px;
    white-space:nowrap;
  }
  #mm-regime .dot { width:8px; height:8px; border-radius:50%; display:inline-block; }
  #mm-regime[data-reg="TREND"] .dot { background:#2ecc71; }
  #mm-regime[data-reg="CHOP"]  .dot { background:#f1c40f; }
  #mm-regime[data-reg="DEAD"]  .dot { background:#e74c3c; }
  #mm-regime[data-reg="UNKNOWN"] .dot { background:#8e8e8e; }
  #mm-regime .muted { opacity:.75; }
</style>

<script>
(function(){
  function $(id){ return document.getElementById(id); }
  function setBadge(j){
    var b = $("mm-regime");
    if(!b) return;
    var label = (j && j.label) ? String(j.label) : "UNKNOWN";
    var conf  = (j && typeof j.confidence==="number") ? j.confidence : (j && j.confidence) ? parseInt(j.confidence,10) : 0;
    var asof  = (j && j.asof_et) ? String(j.asof_et) : "";
    var reason= (j && j.reason) ? String(j.reason) : "";
    b.setAttribute("data-reg", label);
    b.title = reason + (asof ? (" | asof " + asof) : "");
    $("mm-regime-label").textContent = label;
    $("mm-regime-conf").textContent  = conf ? (conf + "%") : "";
  }
  async function tick(){
    try{
      var r = await fetch("/api/market_regime", {cache:"no-store"});
      var j = await r.json();
      setBadge(j);
    }catch(e){
      setBadge({label:"UNKNOWN", confidence:0, reason:String(e)});
    }
  }
  document.addEventListener("DOMContentLoaded", function(){
    tick();
    setInterval(tick, 60000);
  });
})();
</script>

