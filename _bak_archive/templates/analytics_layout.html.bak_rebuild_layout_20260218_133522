{% extends "layout.html" %}

{% block analytics_tape %}
  {% block mm_analytics_tape_inner %}{% endblock %}
{% endblock %}

{% block content %}
<style>
  /* ---- MM_ANALYTICS_LAYOUT_V1 ---- */
  .mm-ax-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .mm-ax-card {
    background: rgba(20, 22, 28, 0.78);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  }
  .ax-date-input {
    background: rgba(0,0,0,0.35);
    color: #e8e8e8;
    border: 1px solid rgba(255,255,255,0.20);
    border-radius: 8px;
    height: 30px;
    padding: 2px 8px;
    min-width: 155px;
  }
  .ax-date-input::-webkit-calendar-picker-indicator {
    filter: invert(1);
    opacity: .9;
  }
  .ax-toolbar a.btn { white-space: nowrap; }
</style>

<div class="container-fluid py-3">
  <div class="mm-ax-container">
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <img src="/static/Max.png" style="height:36px;width:36px;border-radius:8px;" alt="Max"/>
        <div>
          <div class="h4 mb-0">{{ mm_page_title | default("Analytics") }}</div>
          <div class="text-secondary small">{{ mm_page_subtitle | default("Today") }}</div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-2 flex-wrap ax-toolbar">
        <a class="btn btn-sm btn-outline-info" href="/analytics">Daily</a>
        <a class="btn btn-sm btn-outline-info" href="/analytics/buy">Buy Analytics</a>
        <a class="btn btn-sm btn-outline-info" href="/analytics/sell">Sell Analytics</a>
        <a class="btn btn-sm btn-outline-info" href="/analytics/buy_regime">Buy Regime</a>
        <a class="btn btn-sm btn-outline-info" href="/analytics/sell_regime">Sell Regime</a>

      <div class="ax-date-wrap d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-warning" id="ax-yesterday" href="#">Yesterday</a>

        <input type="date"
               class="ax-date-input"
               id="ax-datepick"
               value="{{ request.args.get('date','') }}"
               aria-label="Select date" />

        <a class="btn btn-sm btn-outline-warning" id="ax-datego" href="#">Go</a>
      </div>

      <a class="btn btn-sm btn-outline-secondary" id="ax-live" href="/analytics">Live</a>
      </div>
    </div>

    {% block analytics_body %}{% endblock %}
  </div>
</div>
{% endblock %}
