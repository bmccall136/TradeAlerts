{# templates/layout.html #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
	<title>$$Machine</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%92%B0%3C/text%3E%3C/svg%3E">

  <!-- 1) Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- 2) Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <!-- 3) App CSS -->
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />

  {% block head %}{% endblock %}
</head>
<body class="black-bg text-light">
  <strong id="mm-regime-label">UNKNOWN</strong>
  </span>



  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black py-2 position-relative">
    <div class="container-fluid">

	<!-- Left: primary nav -->
	<div class="d-flex align-items-center mb-3 gap-3">

	  <div id="live-mode-toggle" class="btn-group btn-group-sm" role="group" aria-label="Trade mode">
		<button type="button" class="btn btn-outline-warning" data-mode="DAY">Day Trader</button>
		<button type="button" class="btn btn-outline-secondary" data-mode="SWING">Swing Trader</button>
	  </div>

	  <div class="ai-toggle">
		<label class="ai-toggle-label d-flex align-items-center mb-0">
		  <input type="checkbox" id="ai-enabled-toggle" class="me-2">
		  <span class="me-1">AI Advisor</span>
		  <span class="ai-emoji">🤖</span>
		</label>
	  </div>

	  <a class="btn btn-sm btn-outline-warning btn-fixed"
		 href="/settings/buy" title="Settings"><i class="bi bi-gear-fill"></i> Settings
	  </a>

	</div>

	<div class="trade-alerts-title position-absolute top-50 start-50 translate-middle text-center">
	  <b>$$Machine</b>
	  <img id="maxInsideBadge" class="ms-2 mm-gear"
		   src="{{ url_for('static', filename='Max.png') }}"
		   alt="Max">
	</div>

      <!-- Right: actions -->
		<div class="d-flex align-items-center gap-2 ms-auto">
		<a class="btn btn-sm btn-outline-warning btn-fixed ms-2"
		   href="/live" title="Dashboard">
		  📟 Dashboard
		</a>
		<!-- Dashboard -->
		<a class="btn btn-sm btn-outline-warning btn-fixed ms-2"
		   href="/analytics" title="Daily Analytics">
		  📊 Analytics
		</a>
        <!-- Checkpoint -->
        <form action="{{ url_for('run_checkpoint') }}" method="get" class="m-0">
          <button class="btn btn-small btn-checkpoint">
		  ✅ Checkpoint</button>
        </form>
        <!-- Reconnect API -->
        <a class="btn btn-sm btn-outline-warning btn-fixed"
           href="{{ url_for('etrade_reconnect') }}">
          🔁 Reconnect API
        </a>
      </div>

    </div>
  </nav>
<div id="mm-regime-wrap" style="display:flex; justify-content:center; margin:10px 0 0 0;">
  <div id="mm-regime-badge" style="
       display:inline-flex; align-items:center; gap:10px;
       padding:6px 12px; border-radius:999px;
       background:#12141b; border:1px solid #222531;
       font-size:14px; color:#e8e8e8;">
    <span id="mm-regime-dot" style="width:8px; height:8px; border-radius:50%; background:#666; display:inline-block;"></span>
    <span style="opacity:.85;">Regime:</span>
    <strong id="mm-regime-label">UNKNOWN</strong>
    <span id="mm-regime-conf" style="opacity:.85;"></span>
  </div>
</div>


<div id="mm-regime-wrap">
  <span id="mm-regime" data-reg="UNKNOWN">
    <span class="dot"></span>
    <strong id="mm-regime-label">UNKNOWN</strong>
    <span class="muted" id="mm-regime-conf"></span>
  </span>
</div>



  <!-- MAIN -->
  <main class="container py-4">
    {% block content %}{% endblock %}
  </main>

  <!-- Bootstrap JS -->
  <script>
(function(){
  function mmSetRegimeUI(j){
    try{
      var label = (j && (j.label || j.regime || j.market_regime_label)) ? String(j.label || j.regime || j.market_regime_label) : "UNKNOWN";
      var conf  = (j && (j.confidence != null)) ? Number(j.confidence) : (j && (j.market_regime_confidence != null) ? Number(j.market_regime_confidence) : null);

      var elLabel = document.getElementById("mm-regime-label");
      var elConf  = document.getElementById("mm-regime-conf");
      var elDot   = document.getElementById("mm-regime-dot");
      if (!elLabel) return;

      elLabel.textContent = label.toUpperCase();
      elConf.textContent  = (conf == null || isNaN(conf)) ? "" : (" " + Math.round(conf*100) + "%");

      var color = "#666";
      if (label.toUpperCase() === "TREND") color = "#22c55e";
      else if (label.toUpperCase() === "CHOP") color = "#f59e0b";
      else if (label.toUpperCase() === "DEAD") color = "#ef4444";
      if (elDot) elDot.style.background = color;
    }catch(e){}
  }

  async function mmFetchRegime(){
    try{
      const r = await fetch("/api/market_regime", {cache:"no-store"});
      if(!r.ok) return;
      const j = await r.json();
      mmSetRegimeUI(j);
    }catch(e){}
  }

  function mmStart(){
    mmFetchRegime();
    setInterval(mmFetchRegime, 60000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mmStart);
  } else {
    mmStart();
  }
})();
</script>

</body>
</html>
