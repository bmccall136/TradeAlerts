# sell_direct_place.py
# Generic version of our direct place flow: preview via wrapper, then POST to numeric account path.
# Usage examples (run from C:\TradeAlerts):
#   python .\sell_direct_place.py --symbol CZR --sell --market --debug
#   python .\sell_direct_place.py --symbol CCL --sell --limit 28.45
#   python .\sell_direct_place.py --symbol NCLH --sell 10 --force --limit 24.30
#   python .\sell_direct_place.py --symbol CNP --sell --offset 0.02           (sells at BID - 0.02)

import sys, argparse, json, os, time
from typing import Any

HERE = os.path.abspath(os.path.dirname(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from services import etrade_service as et

def j(x: Any) -> str:
    try: return json.dumps(x, indent=2, sort_keys=True, default=str)
    except Exception: return str(x)

def f(x, d=0.0):
    try: return float(x)
    except Exception: return d

def get_acct_key() -> str:
    if hasattr(et, "get_account_id_key"):
        try:
            k = et.get_account_id_key()
            if k: return str(k)
        except Exception:
            pass
    if hasattr(et, "account_id_key"):
        k = getattr(et, "account_id_key")
        if k: return str(k)
    raise RuntimeError("Could not determine account_id_key")

def available_to_sell(acct_key: str, symbol: str) -> float:
    if hasattr(et, "available_to_sell"):
        try:
            return f(et.available_to_sell(acct_key, symbol), 0.0)
        except Exception:
            pass
    return 0.0

def best_bid(symbol: str) -> float:
    # Try fast wrapper quote, then full get_quote
    try:
        q = et.fetch_etrade_quote(symbol)
        if isinstance(q, dict):
            for src in (q, q.get("All") or {}):
                for k in ("bid","bidPrice","bestBid"):
                    if k in src: return f(src[k], 0.0)
    except Exception:
        pass
    try:
        g = et.get_quote(symbol)
        if isinstance(g, dict):
            qr = g.get("QuoteResponse") or {}
            qd = qr.get("QuoteData")
            if isinstance(qd, list) and qd:
                qd = qd[0]
            if isinstance(qd, dict):
                allsec = qd.get("All") or {}
                for k in ("bid","bidPrice","bestBid"):
                    if k in allsec: return f(allsec[k], 0.0)
    except Exception:
        pass
    return 0.0

# --- Helpers to build several safe place variants ----------------------------
# --- helpers --------------------------------------------------------------

def mk_limit_px(sym: str, tick: float = None) -> float:
    """
    Marketable LIMIT for a SELL: bid - tick (default 0.01), rounded to 2 decimals.
    Falls back to 0.01 if bid unknown.
    """
    bid = best_bid(sym)
    t = tick if tick is not None else 0.01
    base = bid if bid and bid > 0 else 0.01
    return float(max(0.01, round(base - t, 2)))

import time

def mk_client_id(sym: str) -> str:
    """
    E*TRADE often limits clientOrderId to <= 20 ASCII alphanumerics.
    Use SYMBOL + base36 timestamp, strip non-alnum, <= 20 chars.
    """
    ts = int(time.time() * 1000)
    base36 = ""
    n = ts
    chars = "0123456789abcdefghijklmnopqrstuvwxyz"
    while n:
        n, r = divmod(n, 36)
        base36 = chars[r] + base36
    # e.g., "CZR" + "k4n2y" -> "CZRk4n2y"
    coid = (sym.upper() + base36)[0:20]
    # ensure alnum only
    return "".join(ch for ch in coid if ch.isalnum())

def _mk_variants(prev_body: dict, sym: str, qty: int) -> list[tuple[str, dict]]:
    """Return [(name, PlaceOrderRequest-body), ...] constructed from preview."""
    pr = (prev_body or {}).get("PreviewOrderResponse") or {}
    pid = int(((pr.get("PreviewIds") or [{}])[0]).get("previewId"))

    ord_base = {
        "Instrument": [{
            "Product": {"securityType": "EQ", "symbol": sym},
            "orderAction": "SELL",
            "quantityType": "QUANTITY",
            "quantity": int(qty),
        }],
        "orderTerm": "GOOD_FOR_DAY",
    }

    # 1) LIMIT first (order-level marketSession) — tends to be accepted when MARKET flakes
    v_limit_orderlvl = {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": mk_client_id(sym),
            "PreviewIds": [{"previewId": pid}],
            "Order": [dict(ord_base, **{
                "priceType": "LIMIT",
                "limitPrice": mk_limit_px(sym),
                "marketSession": "REGULAR",
                # Being explicit often helps validators:
                "allOrNone": False,
                "egQual": "EG_QUAL_NOT_IN_FORCE",
            })],
        }
    }

    # 2) MARKET fallback (top-level marketSession) — alternate placement of session
    v_market_toplvl = {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": mk_client_id(sym),
            "PreviewIds": [{"previewId": pid}],
            "marketSession": "REGULAR",
            "Order": [dict(ord_base, **{
                "priceType": "MARKET",
            })],
        }
    }

    return [
        ("limit-orderlvl",  v_limit_orderlvl),
        ("market-toplvl",   v_market_toplvl),
    ]

def build_place_body_from_preview(prev: dict, qty_override: int | None = None):
    """
    Compatibility shim for older call sites that expect (acct_num, place_body)
    built directly from the preview. Uses the new _extract_core/_mk_min_order.
    """
    try:
        (_acct_num, symbol, action, qty, qty_type, price_type, limit_price,
         order_term, market_sess, _sym_desc, pid_int, _pid_str) = _extract_core(prev, qty_override)
    except Exception as e:
        raise RuntimeError(f"preview parse failed: {e}")

    order = _mk_min_order(
        symbol=symbol,
        action=action,
        qty=qty,
        qty_type=qty_type,
        price_type=price_type,
        order_term=order_term,
        limit_price=limit_price,
        market_session=market_sess,
    )

    place_body = {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "PreviewIds": [{"previewId": pid_int}],
            "Order": [order],
        }
    }
    return _acct_num, place_body

def _mk_min_order(symbol, action, qty, qty_type, price_type, order_term, limit_price, market_session):
    o = {
        "orderTerm": order_term,
        "priceType": price_type,
        "Instrument": [{
            "Product": {"securityType": "EQ", "symbol": symbol},
            "orderAction": action,
            "quantityType": qty_type,
            "quantity": int(qty),
        }],
    }
    if market_session:
        o["marketSession"] = market_session
    if price_type == "LIMIT":
        o["limitPrice"] = float(limit_price)
    return o

def _extract_core(prev: dict, qty_override: int|None):
    pr = (prev or {}).get("PreviewOrderResponse") or {}
    acct_num = str(pr.get("accountId") or "").strip()
    if not acct_num: raise RuntimeError("preview missing numeric accountId")
    orders = pr.get("Order") or []
    if not orders: raise RuntimeError("preview missing Order[]")
    o0 = orders[0]
    instrs = o0.get("Instrument") or []
    if not instrs: raise RuntimeError("preview missing Instrument[]")
    i0 = instrs[0]
    prod = i0.get("Product") or {}
    symbol = str(prod.get("symbol") or "").strip()
    if not symbol: raise RuntimeError("preview missing Product.symbol")

    qty = int(qty_override if qty_override is not None else i0.get("quantity") or 0)
    if qty <= 0: raise RuntimeError("invalid quantity for place")

    price_type   = o0.get("priceType") or "MARKET"
    limit_price  = o0.get("limitPrice") or None
    order_term   = o0.get("orderTerm") or "GOOD_FOR_DAY"
    market_sess  = o0.get("marketSession") or "REGULAR"
    qty_type     = i0.get("quantityType") or "QUANTITY"
    action       = i0.get("orderAction") or "SELL"
    sym_desc     = i0.get("symbolDescription") or ""

    pid = pr.get("previewId")
    if not pid:
        pids = pr.get("PreviewIds") or pr.get("previewIds") or []
        if isinstance(pids, list) and pids and isinstance(pids[0], dict):
            pid = pids[0].get("previewId") or pids[0].get("id")
    if not pid: raise RuntimeError("previewId not found in preview")
    pid_int = int(pid)
    pid_str = str(pid_int)

    return (acct_num, symbol, action, qty, qty_type, price_type, limit_price,
            order_term, market_sess, sym_desc, pid_int, pid_str)




def _place_variants(prev: dict, qty_override: int|None=None, force_price_type: str|None=None, force_limit: float|None=None):
    """
    Yield a few minimal-but-different bodies known to satisfy various E*TRADE environments.
    We try:
      A) No marketSession, clientOrderId present, previewId=int
      B) No marketSession, clientOrderId present, previewId=string
      C) marketSession present, clientOrderId present, previewId=string
      D) marketSession present, NO clientOrderId, previewId=string
      E) marketSession present, clientOrderId present, previewId=string, add allOrNone:false + symbolDescription
    """
    (acct_num, symbol, action, qty, qty_type, price_type, limit_price,
     order_term, market_sess, sym_desc, pid_int, pid_str) = _extract_core(prev, qty_override)

    if force_price_type:
        price_type = force_price_type
    if force_limit is not None:
        limit_price = force_limit

    coid = f"man-{symbol.lower()}-{int(time.time()*1000)}"

    # Build orders
    base_no_sess = _mk_min_order(symbol, action, qty, qty_type, price_type, order_term, limit_price, market_session=None)
    base_with_sess = _mk_min_order(symbol, action, qty, qty_type, price_type, order_term, limit_price, market_session=market_sess)

    # A) no marketSession, pid=int
    yield acct_num, {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": coid,
            "PreviewIds": [{"previewId": pid_int}],
            "Order": [base_no_sess],
        }
    }

    # B) no marketSession, pid=str
    yield acct_num, {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": coid,
            "PreviewIds": [{"previewId": pid_str}],
            "Order": [base_no_sess],
        }
    }

    # C) with marketSession, pid=str
    yield acct_num, {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": coid,
            "PreviewIds": [{"previewId": pid_str}],
            "Order": [base_with_sess],
        }
    }

    # D) with marketSession, NO clientOrderId, pid=str
    yield acct_num, {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "PreviewIds": [{"previewId": pid_str}],
            "Order": [base_with_sess],
        }
    }

    # E) with marketSession + extras some stacks require
    order_e = json.loads(json.dumps(base_with_sess))
    order_e["allOrNone"] = False
    # add symbolDescription (harmless if present)
    try:
        order_e["Instrument"][0]["symbolDescription"] = sym_desc or symbol
    except Exception:
        pass
    yield acct_num, {
        "PlaceOrderRequest": {
            "orderType": "EQ",
            "clientOrderId": coid,
            "PreviewIds": [{"previewId": pid_str}],
            "Order": [order_e],
        }
    }

def _fresh_preview(acct_key, sym, qty, price_type, limit_or_none):
    return et.preview_equity_order(
        acct_key, sym, qty, (limit_or_none if price_type=="LIMIT" else None),
        action="SELL", price_type=price_type,
        order_term="GOOD_FOR_DAY", market_session="REGULAR"
    )

# --- Replace your old do_place/retry block with this --------------------------
def do_place_with_adaptive_variants(acct_key, sym, qty, price_type, limit_or_none, debug=False) -> bool:
    """
    Re-preview before each variant to keep previewId ultra-fresh, then try 3-5 variants.
    """
    key_path = f"/accounts/{acct_key}/orders/place.json"
    max_outer = 4  # overall tries with fresh preview
    variant_limit = 5

    for outer in range(1, max_outer+1):
        if debug:
            print(f"[DBG] outer attempt {outer}: refreshing preview")
        prev = _fresh_preview(acct_key, sym, qty, price_type, limit_or_none)

        tried = 0
        for acct_num, body in _place_variants(prev, qty_override=qty, force_price_type=price_type, force_limit=limit_or_none):
            tried += 1
            if tried > variant_limit:
                break
            try:
                if debug:
                    print(f"[DBG] trying variant {tried}: POST {key_path}")
                    print(j(body))
                resp = et._epost(key_path, body)
                if debug:
                    print("[SELL] placed OK")
                    print(j(resp))
                return True
            except Exception as e:
                msg = str(e)
                if debug:
                    print(f"[DBG] variant {tried} failed: {msg}")
                # Short sleep between variants
                time.sleep(0.4)

        # small backoff between outer cycles
        time.sleep(1.2 * outer)

    return False

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--symbol", required=True, help="Ticker to sell (e.g., CCL)")
    ap.add_argument("--sell", nargs="?", const="__AUTO__", help="sell all available if omitted")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--limit", type=float)
    ap.add_argument("--offset", type=float, default=0.02)
    ap.add_argument("--market", action="store_true")
    ap.add_argument("--debug", action="store_true")
    ap.add_argument("--wrapper-only", action="store_true")

    args = ap.parse_args()

    sym = args.symbol.upper().strip()
    acct_key = get_acct_key()
    print("[INFO] account_id_key:", acct_key)
    avail = available_to_sell(acct_key, sym)
    print(f"[POS] {sym}: available_to_sell={avail}")

    if args.sell is None:
        return

    qty = avail if args.sell == "__AUTO__" else f(args.sell, -1)
    if qty <= 0:
        print("[SELL] Aborting: qty <= 0"); return
    if qty > avail:
        if args.force:
            print(f"[SELL] Requested {qty} > available {avail}; clamping.")
            qty = avail
        else:
            print(f"[SELL] Requested {qty} exceeds available {avail}. Use --force or cancel reserving orders."); return
    qty = int(qty)
    if qty <= 0:
        print("[SELL] Fractional only; route likely disallows fractional sells."); return

    # Price selection
    if args.market:
        pt = "MARKET"; price = None
        print("[QUOTE] using MARKET")
    elif args.limit and args.limit > 0:
        pt = "LIMIT"; price = float(args.limit)
        print(f"[QUOTE] using manual --limit {price:.2f}")
    else:
        bid = best_bid(sym)
        if bid <= 0:
            print("[QUOTE] Could not get a valid BID; use --market or --limit."); return
        pt = "LIMIT"; price = max(0.01, bid - args.offset)
        print(f"[QUOTE] {sym} BID={bid:.2f} -> limit={price:.2f} (offset {args.offset:.2f})")

    # Preview with your wrapper (works)
    try:
        prev = et.preview_equity_order(
            acct_key, sym, qty, price,
            action="SELL", price_type=pt, order_term="GOOD_FOR_DAY", market_session="REGULAR"
        )
    except Exception as e:
        print("[PREVIEW] failed:", e); return
    print("[PREVIEW] ok")
    if args.debug: print(j(prev))

    # Build numeric-account place body and POST directly
    # Build numeric-account place body and POST directly
    try:
        acct_num, place_body = build_place_body_from_preview(prev)
    except Exception as e:
        print("[SELL] could not build place body:", e); return

    # ---- PLACE (direct) ---------------------------------------------------------
    key_path = f"/accounts/{acct_key}/orders/place.json"
    num_path = f"/accounts/{acct_num}/orders/place.json"

    if args.debug:
        print("[DBG] primary place path (key):", key_path)
        print("[DBG] fallback place path (num):", num_path)
        print("[DBG] place body (initial from preview):")
        print(j(place_body))

    MAX_OUTER = 4   # refresh preview up to 4 times
    MAX_INNER = 2   # try key path then numeric path for each variant

    key_path = f"/accounts/{acct_key}/orders/place.json"

    def try_post(path: str, body: dict, label: str) -> tuple[bool, str]:
        try:
            if args.debug:
                print(f"[DBG] {label}: POST {path}\n{j(body)}")
            resp = et._epost(path, body)
            print(f"[SELL] placed via {label}")
            if args.debug:
                print(j(resp))
            return True, ""
        except Exception as e:
            return False, str(e)

    placed = False
    MAX_ROUNDS = 4

    for round_ in range(1, MAX_ROUNDS + 1):
        if args.debug:
            print(f"[DBG] outer attempt {round_}: refreshing preview")
        prev = et.preview_equity_order(
            acct_key, sym, qty, None,
            action="SELL", price_type="MARKET",
            order_term="GOOD_FOR_DAY", market_session="REGULAR"
        )

        variants = _mk_variants(prev, sym, qty)

        venue_error = False
        for vname, vbody in variants:
            ok, err = try_post(key_path, vbody, vname)
            if ok:
                placed = True
                break
            if args.debug:
                print(f"[DBG] {vname} failed:", err)
            if (" 500:" in err) or ("'code': 100" in err) or ('\"code\": 100' in err):
                venue_error = True
        if placed:
            break
        if not venue_error:
            break

    if not placed:
        print("[SELL] failed: all adaptive variants exhausted")
        raise SystemExit(1)

        def v_market_order(order_level_ms: bool):
            body = {
                "PlaceOrderRequest": {
                    "orderType": "EQ",
                    "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                    "PreviewIds": [{"previewId": pid}],
                    "Order": [dict(ord0, **{
                        "orderTerm": "GOOD_FOR_DAY",
                        "priceType": "MARKET",
                    })],
                }
            }
            if order_level_ms:
                body["PlaceOrderRequest"]["Order"][0]["marketSession"] = "REGULAR"
            else:
                body["PlaceOrderRequest"]["marketSession"] = "REGULAR"  # top-level
            return body

        # NEW: build a marketable LIMIT using current bid (with a penny slop)
        last, bid, _ = last_bid_mid(sym)
        tick = CFG.get("normalize_tick", 0.01) or 0.01
        limit_px = max(0.01, round((bid or last or 0.01) - tick, 2))  # safe guard

        v_limit_order_orderlvl = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "PreviewIds": [{"previewId": pid}],
                "Order": [dict(ord0, **{
                    "orderTerm": "GOOD_FOR_DAY",
                    "priceType": "LIMIT",
                    "limitPrice": float(limit_px),
                    "marketSession": "REGULAR",
                })],
            }
        }

        v_limit_order_toplvl = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "PreviewIds": [{"previewId": pid}],
                "marketSession": "REGULAR",
                "Order": [dict(ord0, **{
                    "orderTerm": "GOOD_FOR_DAY",
                    "priceType": "LIMIT",
                    "limitPrice": float(limit_px),
                })],
            }
        }

        variants = [
            ("market-orderlvl", v_market_order(True)),   # you already tried variants like this
            ("market-toplvl",   v_market_order(False)),  # and this — keep 1 of them
            ("limit-orderlvl",  v_limit_order_orderlvl), # NEW: LIMIT w/ order-level marketSession
            ("limit-toplvl",    v_limit_order_toplvl),   # NEW: LIMIT w/ top-level marketSession
        ]

        # 2) Top-level marketSession, remove from order
        ord2 = dict(ord0, **{
            "orderTerm": "GOOD_FOR_DAY",
            "priceType": "MARKET",
        })
        ord2.pop("marketSession", None)
        v2 = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "marketSession": "REGULAR",
                "PreviewIds": [{"previewId": pid}],
                "Order": [ord2],
            }
        }

        # 3) Verbose mirror of preview Order with REGULAR explicitly
        #    (includes allOrNone, egQual, etc.) — tends to appease stricter validators
        ord3 = (pr.get("Order") or [{}])[0]
        # ensure Instrument minimal correctness
        instr = (ord3.get("Instrument") or [{}])[0]
        product = (instr.get("Product") or {})
        ord3_fixed = {
            "Instrument": [{
                "Product": {"securityType": "EQ", "symbol": product.get("symbol", sym)},
                "orderAction": instr.get("orderAction", "SELL"),
                "quantityType": instr.get("quantityType", "QUANTITY"),
                "quantity": instr.get("quantity", 1),
            }],
            "orderTerm": ord3.get("orderTerm", "GOOD_FOR_DAY"),
            "priceType": ord3.get("priceType", "MARKET"),
            "marketSession": "REGULAR",
            "allOrNone": bool(ord3.get("allOrNone", False)),
            "egQual": ord3.get("egQual", "EG_QUAL_NOT_IN_FORCE"),
        }
        v3 = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "PreviewIds": [{"previewId": pid}],
                "Order": [ord3_fixed],
            }
        }
        # 4) Singular PreviewId (not array), order-level marketSession
        v4 = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "PreviewId": int(pid),  # singular
                "Order": [dict(ord0, **{
                    "orderTerm": "GOOD_FOR_DAY",
                    "priceType": "MARKET",
                    "marketSession": "REGULAR",
                })],
            }
        }

        # 5) Lowercase previewIds array (some stacks want this!)
        v5 = {
            "PlaceOrderRequest": {
                "orderType": "EQ",
                "clientOrderId": f"man-{sym.lower()}-{int(time.time()*1000)}",
                "previewIds": [{"previewId": int(pid)}],  # lowercase key
                "Order": [dict(ord0, **{
                    "orderTerm": "GOOD_FOR_DAY",
                    "priceType": "MARKET",
                    "marketSession": "REGULAR",
                })],
            }
        }

        return [
            ("order-level", v1),
            ("top-level",  v2),
            ("verbose",    v3),
            ("singular-pid", v4),
            ("lowercase-pids", v5),
        ]

        return [("order-level", v1), ("top-level", v2), ("verbose", v3)]

    placed = False
    for outer in range(1, MAX_OUTER + 1):
        if args.debug: print(f"[DBG] outer attempt {outer}: refreshing preview")
        # refresh previewId each round
        prev = et.preview_equity_order(
            acct_key, sym, qty, None,  # MARKET
            action="SELL", price_type="MARKET",
            order_term="GOOD_FOR_DAY", market_session="REGULAR"
        )
        acct_num, place_body = build_place_body_from_preview(prev)  # for printing & base order
        variants = _mk_variants(place_body)

        for vname, vbody in variants:
            for attempt in range(1, MAX_INNER + 1):
                path = key_path if attempt == 1 else num_path
                label = f"{vname} / {'key' if attempt==1 else 'num'} path"
                if args.debug:
                    print(f"[DBG] trying {vname}: POST {path}\n{j(vbody)}")
                ok, err = _try_post(path, vbody, label)
                if ok:
                    placed = True
                    break
                if args.debug:
                    print(f"[DBG] {vname} failed on {'key' if attempt==1 else 'num'} path: {err}")

            if placed:
                break
        if placed:
            break

    if not placed:
        print("[SELL] failed: all adaptive variants exhausted")
        raise SystemExit(1)

    # ---- WRAPPER FALLBACK(S) ----------------------------------------------------
    def try_wrapper_place(prev_obj: dict) -> bool:
        """Try several likely signatures for et.place_equity_order."""
        if not hasattr(et, "place_equity_order"):
            if args.debug: print("[DBG] no et.place_equity_order found")
            return False

        # fresh preview body for the wrapper as well
        try:
            _acct_num, _body = build_place_body_from_preview(prev_obj)
        except Exception as e:
            print("[SELL] build_place_body_from_preview (wrapper) failed:", e)
            return False

        # Helper to attempt a call and report signature issues cleanly
        def _attempt(label, fn):
            try:
                resp = fn()
                print(f"[SELL] placed via wrapper ({label})")
                if args.debug: print(j(resp))
                return True
            except TypeError as te:
                if args.debug:
                    print(f"[DBG] wrapper signature '{label}' not accepted: {te}")
                return False
            except Exception as e:
                print(f"[SELL] wrapper '{label}' failed:", e)
                return False

        # 1) dict-only (most SDKs accept a PlaceOrderRequest-style dict)
        if _attempt("dict-only", lambda: et.place_equity_order(_body)):
            return True

        # 2) acct + dict
        if _attempt("acct+dict", lambda: et.place_equity_order(acct_key, _body)):
            return True

        # 3) positional “full” (if SDK happens to have this old shape)
        try:
            pid = int(prev_obj["PreviewOrderResponse"]["PreviewIds"][0]["previewId"])
        except Exception:
            pid = None
        limit_for_wrapper = price if (pt == "LIMIT") else None

        if _attempt(
            "positional-full",
            lambda: et.place_equity_order(
                acct_key, sym, qty, limit_for_wrapper, "SELL", pt, "GOOD_FOR_DAY", "REGULAR", pid
            )
        ):
            return True

        if _attempt(
            "positional-no-pid",
            lambda: et.place_equity_order(
                acct_key, sym, qty, limit_for_wrapper, "SELL", pt, "GOOD_FOR_DAY", "REGULAR"
            )
        ):
            return True

        if _attempt(
            "positional-short",
            lambda: et.place_equity_order(acct_key, sym, qty, limit_for_wrapper, "SELL", pt)
        ):
            return True

        print("[SELL] wrapper variants exhausted")
        return False

    # If user wants wrapper-only, skip direct placement
    if args.wrapper_only:
        if try_wrapper_place(prev):
            raise SystemExit(0)
        print("[SELL] failed: wrapper-only mode could not place")
        raise SystemExit(1)

    # Normal flow: try direct place with retries, then wrapper variants
    if do_place_with_retry():
        raise SystemExit(0)

    if try_wrapper_place(prev):
        raise SystemExit(0)

    print("[SELL] failed: all attempts exhausted")
    raise SystemExit(1)

# -----------------------------------------------------------------------------
if __name__ == "__main__":
    main()
