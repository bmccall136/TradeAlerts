# tools/dump_etrade.py
import json, sys
from datetime import datetime, timedelta

from services.etrade_service import (
    _eget,                 # raw GET wrapper
    _primary_account_id,   # account id key
    get_account_summary,
    get_positions,
    get_recent_trades_and_realized,
)

def dump(path, **params):
    """GET a raw endpoint and return JSON (or text fallback)."""
    r = _eget(path, params or {})
    try:
        return r.json()
    except Exception:
        return {"text": r.text, "url": r.url, "status": r.status_code}

def main():
    aid = _primary_account_id()

    # date window for “everything”
    end = datetime.utcnow()
    start = end - timedelta(days=30)
    ymd  = lambda d: d.strftime("%Y-%m-%d")

    out = {
        "when_utc": end.isoformat(),
        "account_id_key": aid,
        "balances": get_account_summary(),
        "positions": get_positions(),
        "orders_all": dump(f"/accounts/{aid}/orders.json",
                           fromDate=ymd(start), toDate=ymd(end), status="ALL", count=200),
        "orders_executed": dump(f"/accounts/{aid}/orders.json",
                                fromDate=ymd(start), toDate=ymd(end), status="EXECUTED", count=200),
        "transactions": dump(f"/accounts/{aid}/transactions.json",
                             startDate=ymd(start), endDate=ymd(end), count=500),
        "gainloss_closed": dump(f"/accounts/{aid}/gainloss/closedpositions.json",
                                startDate=ymd(start), endDate=ymd(end)),
    }

    trades, realized = get_recent_trades_and_realized(days=30)
    out["recent_trades"] = trades
    out["realized_pnl_sum"] = realized

    json.dump(out, sys.stdout, indent=2)
    print()  # newline

if __name__ == "__main__":
    main()
