    Compatibility wrapper.

    Supports BOTH:
      A) legacy float buckets: {"today": 1.23, "week": 4.56, "month": 7.89, "all": 9.99}
      B) rich buckets: {"day":{"pnl":..,"pct":..}, "week":{...}, "month":{...}, "all":{...}}
    Returns legacy-shaped:
      {"pnl": {"today": <float>, "week": <float>, "month": <float>, "all": <float>}}
    """
    # 1) Prefer the service helper (your canonical DB path)
    try:
        buckets = realized_buckets_from_live_db_db(str(db_path))

        def _as_float(v) -> float:
            if v is None:
                return 0.0
            if isinstance(v, dict):
                return float(v.get("pnl", 0.0) or 0.0)
            return float(v)

        # Shape B (day/week/month/all as dicts)
        if isinstance(buckets, dict) and any(isinstance(x, dict) for x in buckets.values()):
            return {
                "pnl": {
                    "today": _as_float(buckets.get("day", buckets.get("today"))),
                    "week":  _as_float(buckets.get("week")),
                    "month": _as_float(buckets.get("month")),
                    "all":   _as_float(buckets.get("all")),
                }
            }

        # Shape A (legacy floats)
        if isinstance(buckets, dict):
            return {
                "pnl": {
                    "today": _as_float(buckets.get("today", buckets.get("day"))),
                    "week":  _as_float(buckets.get("week")),
                    "month": _as_float(buckets.get("month")),
                    "all":   _as_float(buckets.get("all")),
                }
            }
    except Exception as exc:
        log.warning(
            "realized_buckets_from_live_db: realized_service failed, falling back to DB: %s",
            exc,
        )

    # 2) Fallback: direct SQLite read (robust action handling)
    conn = sqlite3.connect(str(db_path))
    conn.row_factory = sqlite3.Row
    try:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT close_date, gain
            FROM realized_trades
            WHERE symbol <> 'TEST'
              AND (
                    action IS NULL
                    OR TRIM(action) = ''
                    OR UPPER(action) IN ('SELL','SOLD')
                  )
            ORDER BY close_date DESC
            """
        )
        rows = cur.fetchall()
    finally:
        conn.close()

    # Bucket calc (same logic you validated)
    now = datetime.now()
    today0 = now.replace(hour=0, minute=0, second=0, microsecond=0)
    week0 = today0 - timedelta(days=today0.weekday())
    month0 = today0.replace(day=1)

    day = week = month = all_ = 0.0
    for r in rows:
        if not r["close_date"]:
            continue
        d = datetime.fromisoformat(str(r["close_date"]).replace("T", " "))
        g = float(r["gain"] or 0.0)
        all_ += g
        if d >= month0:
            month += g
        if d >= week0:
            week += g
        if d >= today0:
            day += g

    return {"pnl": {"today": day, "week": week, "month": month, "all": all_}}

def _enrich_trades_from_realized(trades: list[dict]) -> list[dict]:
    """
    For SELL trades that have price_paid == 0 (or missing), patch them using
    realized_trades from live.db so Recent Trades shows correct Price Paid and P&L.

    Matching strategy:
      - key = (symbol, close_date truncated to seconds)
      - use trade['time_utc'] or trade['time'] for the timestamp
    """
    if not trades:
        return trades

    # Build an index of realized_trades keyed by (SYMBOL, CLOSE_TS)
    try:
        conn = sqlite3.connect(str(LIVE_DB))
        cur = conn.cursor()
        cur.execute(
            """
            SELECT
                symbol,
                close_date,
                qty,
                cost_share,
                total_cost,
                gain
            FROM realized_trades
            """
        )
        realized_index: dict[tuple[str, str], dict] = {}

        def _norm_ts(s: str | None) -> str:
            if not s:
                return ""
            s = str(s).replace("T", " ")
            return s[:19]  # "YYYY-MM-DD HH:MM:SS"

        for sym, close_date, qty, cost_share, total_cost, gain in cur.fetchall():
            key = (str(sym or "").upper(), _norm_ts(close_date))
            realized_index[key] = {
                "qty": float(qty or 0.0),
                "cost_share": float(cost_share or 0.0),
                "total_cost": float(total_cost or 0.0),
                "gain": float(gain or 0.0),
            }

        conn.close()
    except Exception as exc:
        log.error("_enrich_trades_from_realized: failed to read realized_trades: %s", exc)
        return trades

    def _norm_ts_trade(t: dict) -> str:
        ts = t.get("time_utc") or t.get("time") or ""
        ts = str(ts).replace("T", " ")
        return ts[:19]

    enriched: list[dict] = []

    for t in trades:
        action = (t.get("action") or t.get("side") or "").upper()
        if action != "SELL":
            enriched.append(t)
            continue

        price_paid = t.get("price_paid")
        # Only patch clearly bogus values
        if price_paid not in (None, 0, 0.0):
            enriched.append(t)
            continue

        sym = (t.get("symbol") or "").upper()
        if not sym:
            enriched.append(t)
            continue

        key = (sym, _norm_ts_trade(t))
        r = realized_index.get(key)
        if not r:
            enriched.append(t)
            continue

        qty = t.get("qty")
        try:
            qty_f = float(qty or r["qty"] or 0.0)
        except Exception:
            qty_f = float(r["qty"] or 0.0)

        cost_share = r["cost_share"]
        total_cost = r["total_cost"] or (cost_share * qty_f)
        gain = r["gain"]

        if qty_f <= 0 or cost_share <= 0:
            enriched.append(t)
            continue

        pl = gain
        pl_pct = (pl / total_cost * 100.0) if total_cost > 0 else 0.0

        t2 = dict(t)
        t2["price_paid"] = round(cost_share, 4)
        t2["pl"] = round(pl, 2)
        t2["pl_pct"] = round(pl_pct, 2)
        enriched.append(t2)

    return enriched

from typing import Any

def normalize_positions_payload(raw):

    """
    Normalize E*TRADE PortfolioResponse payload into a list of dicts your dashboard can use.

    Output rows contain (at least):
      symbol, name, qty, price_paid, last_price, day_pl, day_pl_pct,
      total_pl, total_pl_pct, prior_close, opened_utc, value

    This function is defensive:
      - accepts dict payloads OR list payloads
      - accepts already-normalized rows and passes them through
    """
    if not raw:
        return []

    # If someone already passed a list of normalized rows, pass through.
    if isinstance(raw, list):
        # If these already look normalized, return as-is.
        if raw and isinstance(raw[0], dict) and ("symbol" in raw[0] or "qty" in raw[0]):
            return raw
        # Otherwise, treat list items as Position dicts.
        positions = [p for p in raw if isinstance(p, dict)]
    elif isinstance(raw, dict):
        pr = raw.get("PortfolioResponse") or raw.get("portfolioResponse") or raw
        acct_list = pr.get("AccountPortfolio") or pr.get("accountPortfolio") or []
        positions = []
        for acct in acct_list if isinstance(acct_list, list) else []:
            pos_list = acct.get("Position") or acct.get("position") or []
            if isinstance(pos_list, list):
                positions.extend([p for p in pos_list if isinstance(p, dict)])
    else:
        return []

    out = []
    for p in positions:
        # Already-normalized?
        if "symbol" in p and ("qty" in p or "quantity" in p):
            out.append(p)
            continue

        prod = p.get("Product") or {}
        quick = p.get("Quick") or {}

        symbol = (
            prod.get("symbol")
            or (prod.get("productId") or {}).get("symbol")
            or p.get("symbol")
            or p.get("symbolDescription")
        )
        if not symbol:
            continue

        qty = p.get("quantity")
        try:
            qty = float(qty) if qty is not None else 0.0
        except Exception:
            qty = 0.0

        # Cost / paid
        price_paid = p.get("pricePaid")
        if price_paid is None:
            price_paid = p.get("costPerShare")
        try:
            price_paid = float(price_paid) if price_paid is not None else 0.0
        except Exception:
            price_paid = 0.0

        # Last price: prefer Quick.lastTrade, else derive from marketValue/qty
        last_price = quick.get("lastTrade")
        if last_price is None:
            mv = p.get("marketValue")
            try:
                mv = float(mv) if mv is not None else None
            except Exception:
                mv = None
            if mv is not None and qty:
                last_price = mv / qty
        try:
            last_price = float(last_price) if last_price is not None else 0.0
        except Exception:
            last_price = 0.0

        # P&L fields
        day_pl = p.get("daysGain")
        day_pl_pct = p.get("daysGainPct")
        total_pl = p.get("totalGain")
        total_pl_pct = p.get("totalGainPct")

        def _f(x):
            try:
                return float(x) if x is not None else 0.0
            except Exception:
                return 0.0

        day_pl = _f(day_pl)
        day_pl_pct = _f(day_pl_pct)
        total_pl = _f(total_pl)
        total_pl_pct = _f(total_pl_pct)

        prior_close = _f(p.get("adjPrevClose"))

        # Opened: E*TRADE gives ms epoch in dateAcquired
        opened_utc = None
        da = p.get("dateAcquired")
        try:
            if da is not None:
                da = int(da)
                # dateAcquired is ms since epoch
                opened_utc = da / 1000.0
        except Exception:
            opened_utc = None

        value = _f(p.get("marketValue"))

        name = p.get("symbolDescription") or symbol

        out.append(
            {
                "symbol": symbol,
                "name": name,
                "qty": qty,
                "price_paid": price_paid,
                "last_price": last_price,
                "day_pl": day_pl,
                "day_pl_pct": day_pl_pct,
                "total_pl": total_pl,
                "total_pl_pct": total_pl_pct,
                "prior_close": prior_close,
                "opened_utc": opened_utc,  # float epoch seconds, or None
                "value": value,
                # Keep raw around in case you want to inspect in /live/data?debug=1
                "_raw": p,
            }
        )

    return out

def _sync_realized_from_trades(trades: list, db_path: str) -> None:
    """
    Mirror realized SELL rows into live.db.realized_trades.

    Fixes:
      - Never reference 'gain' before assignment.
      - Use correct realized dollars from trade dict (pnl/pl/gain), NOT price.
      - Do not skip sells just because price_paid is missing (that created gaps/poison).
      - If realized_trades has proceeds/total_cost/cost_share/etc, populate when possible.
    """
    if not trades:
        return

    import sqlite3
    import re
    import logging

    LOG = logging.getLogger("dashboard.realized_sync")

    def _f(x, default=None):
        try:
            if x is None or x == "":
                return default
            return float(x)
        except Exception:
            return default

    def _s(x):
        return (str(x).strip() if x is not None else "")

    rows = []
    for t in trades:
        if not isinstance(t, dict):
            continue

        act = _s(t.get("action") or t.get("side") or "").upper()
        if act != "SELL":
            continue

        sym = _s(t.get("symbol")).upper()
        if not sym:
            continue

        close_date = _s(
            t.get("trade_time")
            or t.get("time")
            or t.get("timestamp")
            or t.get("time_et")
            or t.get("time_utc")
        )
        if not close_date:
            continue

        # Normalize timestamps for SQLite bucketing:
        cd = close_date.replace("T", " ").strip()
        cd = re.sub(r"(Z|[+-]\d{2}:\d{2})$", "", cd).strip()
        cd = re.sub(r"\.\d+$", "", cd).strip()
        close_date = cd

        qty = _f(t.get("qty") or t.get("quantity"), None)
        if qty is None or qty <= 0:
            continue

        price_sold = _f(t.get("price") or t.get("price_sold"), None)
        price_sold_db = (price_sold if (price_sold is not None and price_sold > 0) else None)

        # cost basis per share if available
        cost_share = _f(t.get("price_paid") or t.get("cost_share") or t.get("costPerShare"), None)

        # Prefer authoritative realized dollars from the trade record
        gain = _f(t.get("pnl"), None)
        if gain is None:
            gain = _f(t.get("pl"), None)
        if gain is None:
            gain = _f(t.get("gain"), None)

        # If no explicit realized dollars, compute from price_sold - cost_share when possible
        proceeds = None
        total_cost = None
        if price_sold_db is not None:
            proceeds = price_sold_db * qty
        if cost_share is not None:
            total_cost = cost_share * qty
        if gain is None and (proceeds is not None and total_cost is not None):
            gain = proceeds - total_cost

        # If STILL no gain, skip (we won't invent)
        if gain is None:
            continue

        # open_date is not reliably available here; for bucketing, using close_date is fine.
        open_date = _s(t.get("open_date") or t.get("opened") or "") or close_date

        # Pack a dict so we can insert only columns that exist.
        rows.append({
            "symbol": sym,
            "action": "SELL",
            "qty": float(qty),
            "open_date": open_date,
            "close_date": close_date,
            "gain": float(gain),
            "price_sold": (float(price_sold_db) if price_sold_db is not None else None),
            "cost_share": (float(cost_share) if cost_share is not None else None),
            "proceeds": (float(proceeds) if proceeds is not None else None),
            "total_cost": (float(total_cost) if total_cost is not None else None),
        })

    if not rows:
        return

    try:
        con = sqlite3.connect(db_path)
        cur = con.cursor()

        # If table doesn't exist, create a minimal compatible one.
        cur.execute("""
            CREATE TABLE IF NOT EXISTS realized_trades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                symbol TEXT,
                action TEXT NOT NULL,
                qty REAL,
                open_date TEXT,
                close_date TEXT,
                gain REAL,
                price_sold REAL
            )
        """)

        cols = [r[1] for r in cur.execute("PRAGMA table_info(realized_trades)").fetchall()]
        colset = set(cols)

        # Insert only columns that exist in THIS DB.
        wanted = [
            "symbol","action","qty","open_date","close_date",
            "gain","price_sold",
            # optional extended columns (if present)
            "cost_share","proceeds","total_cost",
            "price_paid","price_share","price_sold"
        ]
        insert_cols = [c for c in wanted if c in colset]
        if not insert_cols:
            LOG.warning("realized_sync: realized_trades exists but has no usable columns? cols=%s", cols)
            con.close()
            return

        # De-dupe using whatever columns exist (prefer close_date+qty+gain+price_sold)
        dedupe_cols = [c for c in ["symbol","action","close_date","qty","gain","price_sold"] if c in colset]
        if not dedupe_cols:
            dedupe_cols = [c for c in ["symbol","action","close_date"] if c in colset]

        def exists_row(vals: dict) -> bool:
            where = []
            args = []
            for c in dedupe_cols:
                if c == "price_sold" and vals.get(c) is None:
                    where.append("price_sold IS NULL")
                else:
                    where.append(f"{c}=?")
                    args.append(vals.get(c))
            q = "SELECT 1 FROM realized_trades WHERE " + " AND ".join(where) + " LIMIT 1"
            return cur.execute(q, args).fetchone() is not None

        ins = 0
        for r in rows:
            # Map some synonym columns if present
            if "price_paid" in colset and r.get("cost_share") is not None:
                r["price_paid"] = r["cost_share"]
            if "price_share" in colset and r.get("cost_share") is not None:
                r["price_share"] = r["cost_share"]

            if exists_row(r):
                continue

            qcols = ", ".join(insert_cols)
            ph = ", ".join(["?"] * len(insert_cols))
            q = f"INSERT INTO realized_trades ({qcols}) VALUES ({ph})"
            cur.execute(q, [r.get(c) for c in insert_cols])
            ins += 1

        con.commit()
        con.close()

        if ins:
            LOG.info("realized_sync: inserted %d realized rows into %s", ins, db_path)

    except Exception as exc:
        try:
            LOG.exception("realized_sync failed: %s", exc)
        except Exception:
            pass
        return
def _positions_rows_from_any(raw: Any) -> list[dict]:
    """
    Coerce whatever we got back (None / dict / list) into normalized position rows.

    Accepts:
      - None -> []
      - dict (E*TRADE PortfolioResponse JSON) -> normalize_positions_payload(dict)
      - list of dict rows already normalized -> returned as-is
      - list containing a single dict payload -> normalized
    """
    if raw is None:
        return []

    # If we already have normalized rows, just return them
    if isinstance(raw, list):
        if not raw:
            return []

        # list of normalized dict rows?
        if all(isinstance(x, dict) and ("symbol" in x) for x in raw):
            # Heuristic: if it looks like a PortfolioResponse wrapper, normalize instead
            # (Some code paths may wrap payloads in a list)
            if len(raw) == 1 and isinstance(raw[0], dict) and (
                "PortfolioResponse" in raw[0] or "AccountPortfolio" in raw[0]
            ):
                return normalize_positions_payload(raw[0])
            return raw

        # list but not dict rows -> treat as empty
        if len(raw) == 1 and isinstance(raw[0], dict):
            return normalize_positions_payload(raw[0])
        return []

    if isinstance(raw, dict):
        return normalize_positions_payload(raw)

    return []

def _build_holdings_from_positions(rows: list[dict]) -> tuple[list[dict], float]:
    """
    Build holdings list + positions_value.

    IMPORTANT:
      - positions_value must match broker NAV math as closely as possible.
      - Some PortfolioResponse rows can have market value but no usable symbol
        (cash sweep / MMF / odd instruments). We count them in positions_value
        even if we don't display them as a holding row.
      - Prefer broker-provided market value when present; fall back to qty*last.
    """
    holdings: list[dict] = []
    positions_value = 0.0

    def _mv(r: dict) -> float:
        # try many common shapes/keys
        for k in (
            "market_value", "marketValue",
            "position_value", "positionValue",
            "current_value", "currentValue",
            "value", "Value",
        ):
            v = r.get(k)
            if v is not None:
                try:
                    return float(v)
                except Exception:
                    pass
        return 0.0

    for r in (rows or []):
        sym = str(r.get("symbol") or "").upper().strip()
        qty = _safe_float(r.get("qty"), 0.0)
        last = _safe_float(r.get("last_price"), 0.0)
        price_paid = _safe_float(r.get("price_paid"), 0.0)

        mv = _mv(r)

        # If there is no symbol, don't display it in holdings, but DO count value if present.
        if not sym:
            if mv > 0:
                positions_value += float(round(mv, 2))
            continue

        # Guard: if qty/last are missing but mv exists, still count it.
        if mv > 0:
            value = float(round(mv, 2))
        else:
            if qty <= 0 or last <= 0:
                continue
            value = float(round(qty * last, 2))

        positions_value += value

        total_pl = float(round((last - price_paid) * qty, 2)) if (qty > 0 and last > 0 and price_paid > 0) else 0.0
        total_pl_pct = float(round(((last / price_paid) - 1.0) * 100.0, 2)) if (price_paid > 0 and last > 0) else 0.0

        holdings.append(
            {
                "symbol": sym,
                "name": r.get("name") or "",
                "opened_et": r.get("opened_et") or "",
                "last_price": float(round(last, 4)) if last else 0.0,
                "qty": qty,
                "price_paid": float(round(price_paid, 4)) if price_paid else 0.0,
                "day_pl": _safe_float(r.get("day_pl"), 0.0),
                "day_pl_pct": _safe_float(r.get("day_pl_pct"), 0.0),
                "total_pl": total_pl,
                "total_pl_pct": total_pl_pct,
                "value": value,
                "has_news": bool(r.get("has_news", False)),
            }
        )

    return holdings, float(round(positions_value, 2))

