import sqlite3
from pathlib import Path

# Path to your simulation database (adjust as needed)
SIM_DB_PATH = Path.home() / ".tradealerts" / "sim.db"


def setup_simulation_db():
    """
    Create (or reset) the simulation SQLite database.
    Ensures `positions` and `cash` tables exist and seeds the cash row.
    """
    # make sure the parent directory exists
    SIM_DB_PATH.parent.mkdir(parents=True, exist_ok=True)

    conn = sqlite3.connect(str(SIM_DB_PATH))
    cur = conn.cursor()

    # positions table: symbol, qty, avg_price
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS positions (
            symbol    TEXT    PRIMARY KEY,
            qty       INTEGER NOT NULL,
            avg_price REAL    NOT NULL
        )
        """
    )

    # cash table: single row (id=1) holding current balance
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS cash (
            id      INTEGER PRIMARY KEY CHECK(id = 1),
            balance REAL    NOT NULL
        )
        """
    )

    # seed a cash row if missing
    cur.execute(
        """
        INSERT OR IGNORE INTO cash (id, balance)
        VALUES (1, 0.0)
        """
    )

    conn.commit()
    conn.close()


if __name__ == "__main__":
    # useful standalone script
    setup_simulation_db()
    print(f"Initialized simulation DB at {SIM_DB_PATH}")
