from __future__ import annotations

import csv
import os
import sqlite3
from datetime import datetime
from pathlib import Path

# --- Config ---
BASE_DIR = Path(__file__).resolve().parent
DB_PATH = BASE_DIR / "live.db"        # your existing live DB
EXPORT_DIR = BASE_DIR / "exports"     # folder to hold CSVs
TABLE_NAME = "ai_advisor_events"      # planned AIAdvisor log table


def main() -> None:
    print("=== AIAdvisor → CSV export starting ===")

    if not DB_PATH.exists():
        print(f"[FATAL] DB not found: {DB_PATH}")
        return

    EXPORT_DIR.mkdir(exist_ok=True)

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    out_path = EXPORT_DIR / f"ai_advisor_events_{ts}.csv"

    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    try:
        cur = conn.cursor()

        # Check table exists
        cur.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name=?;",
            (TABLE_NAME,),
        )
        row = cur.fetchone()
        if not row:
            print(f"[ERROR] Table '{TABLE_NAME}' does not exist in {DB_PATH}")
            return

        # Pull everything (tweak ORDER BY as needed)
        cur.execute(f"SELECT * FROM {TABLE_NAME} ORDER BY ts_et ASC;")
        rows = cur.fetchall()

        if not rows:
            print("[INFO] No rows to export.")
            return

        fieldnames = rows[0].keys()

        with out_path.open("w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames)
            writer.writeheader()
            for r in rows:
                writer.writerow(dict(r))

        print(f"[OK] Exported {len(rows)} rows to {out_path}")

    finally:
        conn.close()
        print("=== AIAdvisor → CSV export done ===")


if __name__ == "__main__":
    main()
