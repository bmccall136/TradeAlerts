#!/usr/bin/env python3
import sqlite3
from pathlib import Path
import os

# 1) Point to the DB file you want to (re)create:
ALERTS_DB = Path(__file__).parent / 'alerts.db'

def init_alerts_db():
    """Create the alerts table if it doesn't already exist."""
    conn = sqlite3.connect(str(ALERTS_DB))
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS alerts (
            symbol       TEXT PRIMARY KEY,
            name         TEXT,
            price        REAL,
            time         TEXT,
            trigger      TEXT,
            alert_type   TEXT,
            vwap         REAL,
            vwap_diff    REAL,
            qty          INTEGER,
            buy          BOOLEAN
        )
    """)
    conn.commit()
    conn.close()

if __name__ == '__main__':
    # Delete old DB if present (optional)
    if ALERTS_DB.exists():
        os.remove(ALERTS_DB)
        print("Deleted existing alerts.db")
    # Create fresh one
    init_alerts_db()
    print("Created alerts.db with table 'alerts'.")
