@app.route("/live/status")
@always_json
def live_status():
    """
    JSON feed for the Live UI.

    Query params:
      - start=YYYY-MM-DD  : earliest trade date (for table)
      - days=N            : fallback lookback
      - max=N             : max trades
      - debug=1           : include raw payloads
    """
    from flask import request, current_app
    from services import etrade_service as et
    from services.trade_source import load_trades_merged

    debug = request.args.get("debug", "0") == "1"
    debug_raw = {}

    # ---------- 1. ACCOUNT SUMMARY (NAV + BUYING POWER) ----------
    acct_summary_raw = {}
    etrade_ok = False
    try:
        # Your wrapper; adjust if it's called get_balances()
        acct_summary_raw = et.get_account_summary() or {}
        etrade_ok = True
    except Exception as e:
        current_app.logger.exception("account summary error: %s", e)

    raw_ui = acct_summary_raw.get("raw") or acct_summary_raw or {}
    if debug:
        debug_raw["acct_summary_raw"] = acct_summary_raw

    comp = (raw_ui.get("Computed") or
            raw_ui.get("Balance") or
            raw_ui.get("BalanceDetail") or {})

    # NAV: pull straight from E*TRADE if present
    nav = _safe_float(
        comp.get("netAccountValue")
        or raw_ui.get("netAccountValue")
        or comp.get("realTimeValue")
        or raw_ui.get("accountBalance")
        or 0.0
    )

    # Buying Power: cash available for investing
    buying_power = _safe_float(
        comp.get("cashAvailableForInvestment")
        or comp.get("cashBuyingPower")
        or raw_ui.get("cashAvailableForInvestment")
        or raw_ui.get("cashBuyingPower")
        or 0.0
    )

    # ---------- 2. POSITIONS -> HOLDINGS + POSITIONS VALUE ----------
    holdings = []
    positions_value = 0.0

    try:
        raw_positions = et.get_positions() or {}
        if debug:
            debug_raw["positions_raw"] = raw_positions

        # MUST populate day_pl/day_pl_pct from Quick.todayGainLoss / todayGainLossPct
        pos_rows = _normalize_positions_payload(raw_positions)
        holdings, positions_value = _build_holdings_from_positions(pos_rows)
    except Exception as e:
        current_app.logger.exception("positions error: %s", e)

    positions_value = _safe_float(positions_value)

    # If NAV missing, approximate; otherwise trust E*TRADE.
    if nav <= 0:
        nav = positions_value + buying_power

    nav = round(nav, 2)
    buying_power = round(buying_power, 2)
    positions_value = round(positions_value, 2)

    # ---------- 3. ACCOUNT OBJECT FOR UI ----------
    account = {
        "account_id": (
            acct_summary_raw.get("account_id")
            or raw_ui.get("accountId")
        ),
        "account_key": (
            acct_summary_raw.get("account_key")
            or raw_ui.get("accountIdKey")
            or raw_ui.get("accountKey")
        ),
        "account_type": (
            acct_summary_raw.get("account_type")
            or raw_ui.get("accountType")
        ),
        "account_type_display": (
            acct_summary_raw.get("account_type_display")
            or raw_ui.get("accountMode")
        ),
        "nav": nav,
        "available_funds": buying_power,
    }

    # ---------- 4. UNREALIZED & DAY P&L (CENTER TILE + HOLDINGS) ----------
    total_cost = 0.0
    day_unreal = 0.0

    for h in holdings:
        qty = _safe_float(h.get("qty"), 0.0)
        paid = _safe_float(h.get("price_paid"), 0.0)
        total_cost += qty * paid
        day_unreal += _safe_float(h.get("day_pl"), 0.0)

    unrealized_pnl = positions_value - total_cost if total_cost > 0 else 0.0
    unrealized_pnl_pct = (unrealized_pnl / total_cost * 100.0) if total_cost > 0 else 0.0

    # Day P&L straight from holdings (sum of todayGainLoss)
    day_unrealized_pnl = day_unreal
    day_unrealized_pnl_pct = (day_unrealized_pnl / nav * 100.0) if nav > 0 else 0.0

    # ---------- 5. REALIZED P&L BUCKETS (RIGHT TILE) ----------
    realized_obj = realized_buckets_from_live_db(LIVE_DB) or {}

    # ---------- 6. TRADES TABLE ----------
    start = (request.args.get("start") or "").strip()
    days = request.args.get("days", type=int)
    max_count = request.args.get("max", default=5000, type=int)

    trades = load_trades_merged(
        days=days,
        start_iso=start,
        max_count=max_count,
    ) or []

    # ---------- 7. SINCE-START BLURB (NAV-BASED) ----------
    START_CASH = START_CASH_BASELINE
    START_DATE = START_DATE_BASELINE

    since_pnl = nav - START_CASH
    since_pct = (since_pnl / START_CASH * 100.0) if START_CASH > 0 else 0.0

    about = {
        "start_cash": START_CASH,
        "start_date": START_DATE,
        "since_pnl": round(since_pnl, 2),
        "since_pct": round(since_pct, 2),
    }

    # ---------- 8. METRICS / VALUE FOR TILES ----------
    metrics = {
        # Left tile
        "net_account_value": nav,
        "buying_power": buying_power,
        "positions_value": positions_value,

        # Center tile (use these for Day P&L)
        "day_unrealized_pnl": round(day_unrealized_pnl, 2),
        "day_unrealized_pnl_pct": round(day_unrealized_pnl_pct, 2),

        # Also expose plain unrealized if you want it elsewhere
        "unrealized_pnl": round(unrealized_pnl, 2),
        "unrealized_pnl_pct": round(unrealized_pnl_pct, 2),

        # Right tile
        "realized_buckets": realized_obj,

        # Blurb
        "total_gain_nav": round(since_pnl, 2),
        "total_gain_nav_pct": round(since_pct, 2),
    }

    value_obj = {
        "net_account_value": nav,
        "buying_power": buying_power,
        "positions_value": positions_value,
        "value": nav,
    }

    # ---------- 9. AUTH / STATUS ----------
    needs_reconnect = bool(
        getattr(et, "need_oauth", False)
        or os.path.exists(str(NEED_AUTH_FLAG))
    )

    payload = {
        "ok": True,
        "etrade_ok": etrade_ok,
        "needs_reconnect": needs_reconnect,
        "account": account,
        "value": value_obj,
        "metrics": metrics,
        "holdings": holdings,
        "realized": realized_obj,
        "trades": trades,
        "about": about,
    }

    if debug:
        payload["debug_raw"] = debug_raw

    return payload

