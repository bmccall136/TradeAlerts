def _etrade_log_wrap() -> None:
    """Sync NEED_AUTH_FLAG with et.need_oauth if the wrapper exposes it."""
    try:
        if getattr(et, "need_oauth", False):
            NEED_AUTH_FLAG.write_text("1", encoding="utf-8")
