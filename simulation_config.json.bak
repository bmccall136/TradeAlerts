{
  // ─── Core toggles ───────────────────────────
  "sma_on": true,
  "rsi_on": true,
  "macd_on": true,
  "bb_on": true,
  "vol_on": true,
  "vwap_on": true,
  "news_on": false,

  // ─── Core params ────────────────────────────
  "sma_length": 20,
  "rsi_len": 14,
  "rsi_overbought": 70,
  "rsi_oversold": 30,
  "macd_fast": 12,
  "macd_slow": 26,
  "macd_signal": 9,
  "bb_length": 20,
  "bb_std": 2.0,
  "vol_multiplier": 1.0,
  "vwap_threshold": 0.0,

  // ─── Indicator toggles ──────────────────────
  "rsi_slope_on": true,
  "macd_hist_on": true,
  "bb_breakout_on": true,
  "price_sma_on": true,

  // ─── Your 4 new filters ─────────────────────
  "atr_on": true,
  "atr_threshold": 1.4,    // ATR14 ≥ 1.4

  "atr_pct_on": true,
  "atr_pct": 0.7,          // ATR % ≥ 0.7 %

  "range_on": true,
  "range_pct": 1.2,        // Range % ≥ 1.2 %

  "gap_on": true,
  "gap_pct": 1.0,          // Gap % ≥ 1.0 %

  // ─── Risk & run control ─────────────────────
  "single_entry_only": true,
  "use_trailing_stop": true,
  "trailing_stop_pct": 0.05,
  "sell_after_days": 1,

  "stop_loss_pct": 3.0,
  "take_profit_pct": 7.0,

  // ─── Sizing & misc ─────────────────────────
  "starting_cash": 1000,
  "max_per_trade": 200,
  "pause_when_market_closed": false,
  "nuke_db": false
}
