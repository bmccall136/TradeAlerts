
.ax-settings {
  max-width: 1200px;
  margin: 0 auto;
  padding: 18px;
}

.ax-settings h1 {
  margin: 0 0 10px 0;
}

.ax-topbar {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin: 10px 0 14px 0;
}

.ax-topbar .ax-spacer { flex: 1; }

.ax-select, .ax-input, textarea.ax-raw {
  background: #0b0b0b;
  color: #eaeaea;
  border: 1px solid #333;
  border-radius: 8px;
  padding: 8px 10px;
}

.ax-btn {
  background: #111;
  color: #ffe900;
  border: 1px solid #ffe900;
  border-radius: 10px;
  padding: 8px 12px;
  cursor: pointer;
}

.ax-btn:hover { filter: brightness(1.1); }

.ax-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

@media (max-width: 980px){
  .ax-grid { grid-template-columns: 1fr; }
}

.ax-card {
  border: 1px solid #2a2a2a;
  border-radius: 12px;
  padding: 12px;
  background: rgba(255,255,255,0.03);
}

.ax-row {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.ax-row:last-child { border-bottom: 0; }

.ax-lab {
  color: #cfcfcf;
  font-weight: 600;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.ax-note { color: #888; font-size: 12px; }

.ax-msg {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  display: none;
}

.ax-ok  { border: 1px solid #2c7; color: #cfc; background: rgba(34,204,119,0.08); }
.ax-bad { border: 1px solid #f66; color: #fcc; background: rgba(255,102,102,0.08); }

textarea.ax-raw {
  width: 100%;
  min-height: 420px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 12px;
  line-height: 1.35;
  resize: vertical;
}


/* === Settings BUY/SELL toggle (inserted 20260131_144739) === */
.mm-settings-toggle {
  display: flex;
  gap: 10px;
  justify-content: center;
  align-items: center;
  margin: 10px 0 18px 0;
}

.mm-toggle-btn {
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid #ffe900;
  border-radius: 8px;
  color: #ffe900;
  text-decoration: none;
  font-weight: 600;
  background: rgba(0,0,0,0.25);
}

.mm-toggle-btn:hover {
  text-decoration: none;
  filter: brightness(1.1);
}

.mm-toggle-btn.is-active {
  background: #ffe900;
  color: #000;
}

/* Hide raw JSON debug blocks (keep code safe while iterating) */
#raw-json, #settings-raw, pre#raw-json, pre#settings-raw, .raw-json {
  display: none !important;
}
