/* Daily Analytics - DB driven (live.db)
   - BUYS: buy_cooldowns.last_buy_utc (UTC -> ET -> date filter server-side)
   - SELLS: realized_trades.close_date (ET/naive)
   - Each row links to Trade Review
*/

(function () {
  "use strict";

  function qs(id) { return document.getElementById(id); }

  function esc(s) {
    return String(s ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function enc(x) { return encodeURIComponent(String(x ?? "")); }

  function tradeHref(sym, ts_et) {
    // Send both common params; dashboard can ignore extras safely.
    // If your trade_review route wants different param names, we can adapt after we confirm it.
    return `/trade_review?symbol=${enc(sym)}&ts=${enc(ts_et)}`;
  }

  function showError(msg) {
    const box = qs("ax-errors");
    if (!box) return;
    box.innerHTML = `<div class="alert alert-warning py-2 mb-0">${esc(msg)}</div>`;
  }

  function renderTable(targetId, rows, kind) {
    const target = qs(targetId);
    if (!target) return;

    if (!rows || !rows.length) {
      target.innerHTML = `<div class="text-secondary">No ${kind} for this day.</div>`;
      return;
    }

    let head = "";
    if (kind === "buys") {
      head = `<thead><tr>
        <th style="width:160px;">Time (ET)</th>
        <th style="width:110px;">Symbol</th>
        <th>Reason</th>
      </tr></thead>`;
    } else {
      head = `<thead><tr>
        <th style="width:160px;">Time (ET)</th>
        <th style="width:110px;">Symbol</th>
        <th style="width:90px;">Qty</th>
        <th style="width:120px;">Gain</th>
      </tr></thead>`;
    }

    const body = rows.map(r => {
      const sym = r.symbol || "";
      const ts  = r.ts_et || "";
      const href = tradeHref(sym, ts);

      if (kind === "buys") {
        const reason = r.reason || "";
        return `<tr>
          <td><a class="ax-link" href="${href}">${esc(ts)}</a></td>
          <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
          <td><a class="ax-link" href="${href}">${esc(reason)}</a></td>
        </tr>`;
      } else {
        const qty = (r.qty ?? "");
        const gain = (r.gain ?? "");
        return `<tr>
          <td><a class="ax-link" href="${href}">${esc(ts)}</a></td>
          <td><a class="ax-link" href="${href}">${esc(sym)}</a></td>
          <td class="text-center">${esc(qty)}</td>
          <td class="text-end">${esc(gain)}</td>
        </tr>`;
      }
    }).join("");

    target.innerHTML = `<table class="table table-sm table-dark table-striped align-middle mb-0">
      ${head}
      <tbody>${body}</tbody>
    </table>`;
  }

  async function loadDay(dayParam) {
    const url = dayParam ? `/api/analytics/day?day=${enc(dayParam)}` : `/api/analytics/day`;
    const res = await fetch(url, { cache: "no-store" });
    if (!res.ok) throw new Error(`API ${url} -> ${res.status}`);
    return await res.json();
  }

  async function boot() {
    try {
      const params = new URLSearchParams(location.search);
      const day = params.get("day") || "";

      const data = await loadDay(day);

      if (qs("ax-date")) qs("ax-date").textContent = data.date_et || "—";
      if (qs("ax-files")) qs("ax-files").textContent = data.source || "";

      const buys = data.buys || [];
      const sells = data.sells || [];

      if (qs("ax-buy-count")) qs("ax-buy-count").textContent = String(buys.length);
      if (qs("ax-sell-count")) qs("ax-sell-count").textContent = String(sells.length);

      renderTable("ax-buy-col", buys, "buys");
      renderTable("ax-sell-col", sells, "sells");

      const btn = qs("ax-refresh");
      if (btn) btn.onclick = () => location.reload();

    } catch (e) {
      console.error("[analytics] boot failed:", e);
      showError(`Analytics failed: ${e.message || e}`);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
})();
