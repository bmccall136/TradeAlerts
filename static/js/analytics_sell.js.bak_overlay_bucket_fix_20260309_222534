/* analytics_sell.js (final)
   - safe fetch (handles non-JSON/500 HTML)
   - removes "Loading ?" by always rendering either data or a clear error
*/
(function(){
  const errBox = document.getElementById('mm-sell-err');

  function showErr(msg){
    if(!errBox) return;
    errBox.style.display = 'block';
    errBox.textContent = msg || 'Unknown error';
  }
  function clearErr(){
    if(!errBox) return;
    errBox.style.display = 'none';
    errBox.textContent = '';
  }

  async function fetchJsonSafe(url){
    const r = await fetch(url, {cache:'no-store'});
    const ct = (r.headers.get('content-type') || '').toLowerCase();
    const txt = await r.text();
    if(!r.ok){
      throw new Error(`HTTP ${r.status}\n${txt.slice(0,2000)}`);
    }
    if(ct.includes('application/json')){
      try { return JSON.parse(txt); }
      catch(e){ throw new Error(`JSON parse failed\n${txt.slice(0,2000)}`); }
    }
    throw new Error(`Non-JSON response\n${txt.slice(0,2000)}`);
  }

  function escapeHtml(s){
    return (s||'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
  }

  function asPairs(obj){
    if(!obj || typeof obj !== 'object') return [];
    if(Array.isArray(obj)){
      return obj.map(x=>{
        if(x && typeof x === 'object'){
          const k = x.key ?? x.k ?? x.name ?? x.reason ?? x.outcome ?? '';
          const v = x.value ?? x.v ?? x.count ?? x.ct ?? x.n ?? '';
          return [String(k), v];
        }
        return [String(x), ''];
      });
    }
    return Object.keys(obj).map(k => [k, obj[k]]);
  }

  function renderTableInto(el, pairs){
    if(!el) return;
    if(!pairs || !pairs.length){
      el.innerHTML = '<div class="text-secondary small">No data in this bucket.</div>';
      return;
    }
    const rows = pairs
      .sort((a,b)=> (Number(b[1])||0) - (Number(a[1])||0))
      .map(([k,v]) => `<tr><td class="k">${escapeHtml(k)}</td><td class="v">${escapeHtml(String(v))}</td></tr>`)
      .join('');
    el.innerHTML = `<table class="mm-t"><tbody>${rows}</tbody></table>`;
  }

  function setLoading(id, on){
    const el = document.getElementById(id);
    if(el) el.style.display = on ? 'block' : 'none';
  }

  function getParam(name){
    try { return (new URL(window.location.href)).searchParams.get(name) || ''; }
    catch(e){ return ''; }
  }
  function setParam(name, value){
    try{
      const u = new URL(window.location.href);
      if(value) u.searchParams.set(name, value);
      else u.searchParams.delete(name);
      window.history.replaceState({}, '', u.toString());
    }catch(e){}
  }

  function normalizeBucket(b){
    b = (b || 'today').toLowerCase();
    if(b === 'tod') b = 'today';
    if(b === '7') b = '7d';
    if(b === '30') b = '30d';
    return b;
  }

  async function loadSell(bucket){
    clearErr();

    setLoading('mm-exit-loading', true);
    setLoading('mm-outcome-loading', true);
    setLoading('mm-hold-loading', true);

    const date = getParam('date');
    const qs = new URLSearchParams();
    if(bucket) qs.set('bucket', bucket);
    if(date) qs.set('date', date);

    const url = '/api/analytics/sell?' + qs.toString();

    try{
      const j = await fetchJsonSafe(url);

      const reasons  = j.exit_reasons || j.reasons || j.reason_counts || (j.counts && j.counts.exit_reasons) || {};
      const outcomes = j.execution_outcomes || j.outcomes || j.outcome_counts || (j.counts && j.counts.execution_outcomes) || {};
      const holds    = j.hold_buckets || j.hold_time_buckets || j.holds || (j.counts && j.counts.hold_buckets) || {};

      renderTableInto(document.getElementById('mm-exit-box'), asPairs(reasons));
      renderTableInto(document.getElementById('mm-outcome-box'), asPairs(outcomes));
      renderTableInto(document.getElementById('mm-hold-box'), asPairs(holds));
    }catch(e){
      showErr(String(e && e.message ? e.message : e));
      renderTableInto(document.getElementById('mm-exit-box'), []);
      renderTableInto(document.getElementById('mm-outcome-box'), []);
      renderTableInto(document.getElementById('mm-hold-box'), []);
    }finally{
      setLoading('mm-exit-loading', false);
      setLoading('mm-outcome-loading', false);
      setLoading('mm-hold-loading', false);
    }
  }

  const sel = document.getElementById('mm-sell-bucket');
  const initial = normalizeBucket(getParam('bucket') || (sel ? sel.value : 'today'));
  if(sel){
    sel.value = initial;
    sel.addEventListener('change', ()=>{
      const b = normalizeBucket(sel.value);
      setParam('bucket', b);
      loadSell(b);
    });
  }
  loadSell(initial);

  window.addEventListener('error', (ev)=>{
    try{ showErr('JS error: ' + (ev.message || ev.error || 'unknown')); }catch(e){}
  });
  window.addEventListener('unhandledrejection', (ev)=>{
    try{ showErr('Promise rejection: ' + (ev.reason && ev.reason.message ? ev.reason.message : String(ev.reason))); }catch(e){}
  });
})();


/* --- MM_SELL_HOURLY_UI_V3_START --- */
function mmSellBucketValue() {
  try {
    const el = document.querySelector('#bucket, #sellBucket, select[name="bucket"]');
    let v = ((el && el.value) || '').trim().toLowerCase();
    if (!v) v = '30d';
    return v;
  } catch (_) {
    return '30d';
  }
}
function mmNum(v, d=0){ const n=Number(v); return Number.isFinite(n)?n:d; }
function mmFmtHourET(h){ const n=parseInt(h,10); return Number.isFinite(n)?String(n).padStart(2,'0')+':00':String(h); }

function mmSellRenderBars(rows){
  const host=document.getElementById('mm-sell-hour-bars');
  if(!host) return;
  host.innerHTML='';

  const vals=(rows||[]).map(r=>mmNum(r.win_rate,0));
  const maxv=Math.max(0,...vals);

  if(maxv <= 0){
    host.style.height='36px';
    host.style.padding='0';
    host.style.margin='6px 0 8px 0';
    host.innerHTML='<div style="opacity:.72;font-size:12px;">Chart hidden: all current sell win rates are 0.0% in this dataset.</div>';
    return;
  }

  host.style.height='150px';
  host.style.padding='8px 4px 4px 4px';
  host.style.margin='10px 0 10px 0';

  (rows||[]).forEach(r=>{
    const winRate=mmNum(r.win_rate,0);
    const avg=mmNum(r.avg_pnl,0);

    const wrap=document.createElement('div');
    wrap.style.display='flex';
    wrap.style.flexDirection='column';
    wrap.style.alignItems='center';
    wrap.style.justifyContent='flex-end';
    wrap.style.gap='6px';
    wrap.style.minWidth='56px';

    const top=document.createElement('div');
    top.style.fontSize='11px';
    top.style.opacity='.88';
    top.textContent=`${winRate.toFixed(1)}%`;

    const bar=document.createElement('div');
    bar.style.width='38px';
    bar.style.height=`${Math.max(10,Math.round((winRate/maxv)*120))}px`;
    bar.style.borderRadius='7px 7px 0 0';
    bar.style.background=avg>=0?'#f4c20d':'#19c2ff';
    bar.style.boxShadow='0 0 0 1px rgba(255,255,255,.08) inset';

    const bot=document.createElement('div');
    bot.style.fontSize='11px';
    bot.style.opacity='.92';
    bot.style.textAlign='center';
    bot.innerHTML=`${mmFmtHourET(r.hour_et)}<br><span style="opacity:.7">n=${mmNum(r.trades,0)}</span>`;

    wrap.appendChild(top); wrap.appendChild(bar); wrap.appendChild(bot);
    host.appendChild(wrap);
  });
}

function mmSellRenderTable(rows){
  const tb=document.getElementById('mm-sell-hour-tbody');
  if(!tb) return;
  tb.innerHTML='';
  (rows||[]).forEach(r=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`
      <td>${mmFmtHourET(r.hour_et)}</td>
      <td>${mmNum(r.trades,0)}</td>
      <td>${mmNum(r.wins,0)}</td>
      <td>${mmNum(r.losses,0)}</td>
      <td>${mmNum(r.win_rate,0).toFixed(1)}%</td>
      <td>${mmNum(r.avg_pnl,0).toFixed(2)}</td>
      <td>${mmNum(r.net_pnl,0).toFixed(2)}</td>
    `;
    tb.appendChild(tr);
  });
}

async function mmLoadSellHourStats(){
  try{
    const bucket=mmSellBucketValue();
    const sub=document.getElementById('mm-sell-hour-sub');
    const bl=document.getElementById('mm-sell-hour-bucket-label');
    const tb=document.getElementById('mm-sell-hour-tbody');
    const bars=document.getElementById('mm-sell-hour-bars');
    if(bl) bl.textContent=String(bucket).toUpperCase();
    if(sub) sub.textContent='';

    if(!tb || !bars) return;

    const res=await fetch(`/api/analytics/sell?bucket=${encodeURIComponent(bucket)}&v=${Date.now()}`, {cache:'no-store'});
    const j=await res.json();
    const rows=Array.isArray(j && j.sell_hours) ? j.sell_hours : [];

    if(!rows.length){
      tb.innerHTML=`<tr><td colspan="7" style="opacity:.7;">No sell hour data in this bucket.</td></tr>`;
      bars.innerHTML=`<div style="opacity:.7;font-size:12px;">No chart data in this bucket.</div>`;
      return;
    }

    mmSellRenderBars(rows);
    mmSellRenderTable(rows);
  }catch(e){
    const tb=document.getElementById('mm-sell-hour-tbody');
    const bars=document.getElementById('mm-sell-hour-bars');
    if(tb) tb.innerHTML=`<tr><td colspan="7" style="color:#ff8a8a;">Sell hour load failed: ${String(e)}</td></tr>`;
    if(bars) bars.innerHTML='';
  }
}

(function(){
  const _orig=window.loadSellAnalytics;
  window.loadSellAnalytics=async function(...args){
    let out;
    if(typeof _orig==='function') out=await _orig.apply(this,args);
    try{ await mmLoadSellHourStats(); }catch(_){}
    return out;
  };

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(()=>{ try{ mmLoadSellHourStats(); }catch(_){} }, 200);
    const sel=document.querySelector('#bucket, #sellBucket, select[name="bucket"]');
    if(sel && !sel.dataset.mmSellHourBound){
      sel.dataset.mmSellHourBound='1';
      sel.addEventListener('change', ()=>setTimeout(()=>{ try{ mmLoadSellHourStats(); }catch(_){} }, 75));
    }
  });
})();
/* --- MM_SELL_HOURLY_UI_V3_END --- */


/* --- MM_SELL_HEATMAP_UI_V1_START --- */
function mmEsc(s){
  return String(s == null ? '' : s)
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;');
}

function mmSellHeatColor(n, maxv){
  const v = Math.max(0, Number(n) || 0);
  const m = Math.max(1, Number(maxv) || 1);
  const a = Math.min(0.92, 0.10 + (v / m) * 0.82);
  return `rgba(244,194,13,${a})`;
}

function mmBuildSellHeatmap(rows){
  const thead = document.getElementById('mm-sell-heatmap-thead');
  const tbody = document.getElementById('mm-sell-heatmap-tbody');
  const sub   = document.getElementById('mm-sell-heatmap-sub');
  const bl    = document.getElementById('mm-sell-heatmap-bucket-label');
  const bucket = (typeof mmSellBucketValue === 'function') ? mmSellBucketValue() : '30d';

  if (bl) bl.textContent = String(bucket).toUpperCase();
  if (!thead || !tbody) return;

  const all = Array.isArray(rows) ? rows : [];
  const cleaned = all
    .filter(r => r && r.reason && String(r.reason).trim() !== '' && String(r.reason).toLowerCase() !== 'loop')
    .map(r => ({
      reason: String(r.reason),
      hour_et: parseInt(r.hour_et, 10),
      events: Number(r.events || 0)
    }))
    .filter(r => Number.isFinite(r.hour_et) && Number.isFinite(r.events));

  if (!cleaned.length){
    thead.innerHTML = '';
    tbody.innerHTML = '<tr><td class="mm-muted">No reason × hour data in this bucket.</td></tr>';
    if (sub) sub.textContent = 'Reason heatmap excludes noisy "loop" rows.';
    return;
  }

  const hours = [...new Set(cleaned.map(r => r.hour_et))].sort((a,b)=>a-b);
  const reasons = [...new Set(cleaned.map(r => r.reason))]
    .sort((a,b) => {
      const at = cleaned.filter(x => x.reason === a).reduce((s,x)=>s+x.events,0);
      const bt = cleaned.filter(x => x.reason === b).reduce((s,x)=>s+x.events,0);
      return bt - at || a.localeCompare(b);
    });

  const grid = new Map();
  let maxv = 0;
  for (const r of cleaned){
    const k = `${r.reason}__${r.hour_et}`;
    grid.set(k, r.events);
    if (r.events > maxv) maxv = r.events;
  }

  thead.innerHTML =
    '<tr><th style="min-width:180px;">Reason</th>' +
    hours.map(h => `<th style="min-width:72px;">${String(h).padStart(2,'0')}:00</th>`).join('') +
    '<th style="min-width:84px;">Total</th></tr>';

  tbody.innerHTML = reasons.map(reason => {
    let total = 0;
    const tds = hours.map(h => {
      const v = grid.get(`${reason}__${h}`) || 0;
      total += v;
      const bg = v > 0 ? mmSellHeatColor(v, maxv) : 'rgba(255,255,255,0.03)';
      const fg = v > 0 ? '#111' : 'rgba(255,255,255,0.72)';
      return `<td style="text-align:center;background:${bg};color:${fg};font-weight:700;border-radius:6px;">${v}</td>`;
    }).join('');
    return `<tr><td>${mmEsc(reason)}</td>${tds}<td style="font-weight:800;">${total}</td></tr>`;
  }).join('');

  if (sub) sub.textContent = 'Higher counts glow brighter. Excludes noisy "loop" rows.';
}

const _mmLoadSellHourStats_orig = (typeof mmLoadSellHourStats === 'function') ? mmLoadSellHourStats : null;
if (_mmLoadSellHourStats_orig){
  mmLoadSellHourStats = async function(...args){
    const out = await _mmLoadSellHourStats_orig.apply(this, args);
    try{
      const bucket = (typeof mmSellBucketValue === 'function') ? mmSellBucketValue() : '30d';
      const res = await fetch(`/api/analytics/sell?bucket=${encodeURIComponent(bucket)}&v=${Date.now()}`, {cache:'no-store'});
      const j = await res.json();
      mmBuildSellHeatmap(Array.isArray(j && j.reason_hours) ? j.reason_hours : []);
    }catch(e){
      const tbody = document.getElementById('mm-sell-heatmap-tbody');
      if (tbody) tbody.innerHTML = `<tr><td class="mm-muted">Heatmap load failed: ${mmEsc(String(e))}</td></tr>`;
    }
    return out;
  };
}
/* --- MM_SELL_HEATMAP_UI_V1_END --- */



/* MM_FORCE_SELL_HEATMAP_OVERRIDE_V1_START */
(function(){
  const MARK = "MM_FORCE_SELL_HEATMAP_OVERRIDE_V1";

  function q(id){ return document.getElementById(id); }
  function esc(s){
    return String(s ?? '').replace(/[&<>"']/g, m => (
      {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]
    ));
  }
  function bucketLabel(v){
    v = String(v || 'today').toLowerCase();
    if (v === '7d') return '7D';
    if (v === '30d') return '30D';
    if (v === 'all') return 'ALL';
    return 'TODAY';
  }
  function findBucketValue(){
    const ids = ['mm-sell-bucket','sell-bucket','bucket','ax-bucket'];
    for (const id of ids){
      const el = q(id);
      if (el && el.value) return String(el.value).toLowerCase();
    }
    const sel = document.querySelector('select');
    if (sel && sel.value) return String(sel.value).toLowerCase();
    return 'today';
  }
  function findDateValue(){
    const ids = ['ax-datepick','date','mm-date'];
    for (const id of ids){
      const el = q(id);
      if (el && el.value) return String(el.value);
    }
    return '';
  }
  function syncBucketLabels(){
    const lbl = bucketLabel(findBucketValue());
    ['mm-sell-heatmap-bucket-label','mm-sell-hour-bucket-label'].forEach(id => {
      const el = q(id);
      if (el) el.textContent = lbl;
    });
  }
  function normHour(v){
    const n = Number(v);
    if (!isFinite(n)) return String(v ?? '');
    return String(n).padStart(2,'0') + ':00';
  }
  function alphaFor(val, max){
    if (!max || val <= 0) return 0.05;
    const a = 0.10 + 0.65 * (val / max);
    return Math.max(0.05, Math.min(0.75, a));
  }
  function bgFor(val, max){
    if (!val) return 'rgba(255,255,255,.03)';
    return 'rgba(255,193,7,' + alphaFor(val, max).toFixed(3) + ')';
  }
  function parseReasonHours(data){
    let rows = [];
    if (Array.isArray(data?.reason_hours)) rows = data.reason_hours;
    else if (Array.isArray(data?.data?.reason_hours)) rows = data.data.reason_hours;
    else if (data?.reason_hours && typeof data.reason_hours === 'object'){
      for (const [reason, arr] of Object.entries(data.reason_hours)){
        if (Array.isArray(arr)){
          for (const r of arr) rows.push(Object.assign({}, r, { reason: r.reason ?? reason }));
        } else if (arr && typeof arr === 'object'){
          for (const [hour, events] of Object.entries(arr)) rows.push({ reason, hour_et: hour, events });
        }
      }
    }
    return rows.map(r => ({
      reason: String(r.reason ?? r.exit_reason ?? r.label ?? r.name ?? '').trim(),
      hour: String(r.hour ?? r.hour_et ?? r.hr ?? '').trim(),
      count: Number(r.count ?? r.events ?? r.trades ?? r.total ?? r.n ?? 0)
    }));
  }

  function renderHeatmap(data){
    const card = q('mm-sell-heatmap-card');
    const head = q('mm-sell-heatmap-head');
    const body = q('mm-sell-heatmap-body');
    const sub  = q('mm-sell-heatmap-sub');
    if (!card || !head || !body) return;

    syncBucketLabels();

    const rows = parseReasonHours(data)
      .filter(r => r.reason)
      .filter(r => !/^loop$/i.test(r.reason))
      .filter(r => !/^\s*loop\s*:/i.test(r.reason))
      .filter(r => !/noisy\s*loop/i.test(r.reason));

    if (!rows.length){
      card.style.display = '';
      head.innerHTML = '<tr><th style="text-align:left;padding-left:6px;">Reason</th><th>No data</th></tr>';
      body.innerHTML = '<tr><td class="mm-rowlabel">No non-loop sell reasons</td><td class="mm-zero"></td></tr>';
      if (sub) sub.textContent = 'No non-loop reason/hour rows in this bucket.';
      return;
    }

    const hours = Array.from(new Set(rows.map(r => Number(r.hour)))).filter(Number.isFinite).sort((a,b)=>a-b);
    const reasons = Array.from(new Set(rows.map(r => r.reason))).sort((a,b)=>a.localeCompare(b));

    const grid = {};
    let max = 0;
    let total = 0;
    for (const r of rows){
      const key = r.reason + '|' + Number(r.hour);
      grid[key] = (grid[key] || 0) + (Number.isFinite(r.count) ? r.count : 0);
      total += (Number.isFinite(r.count) ? r.count : 0);
      if (grid[key] > max) max = grid[key];
    }

    head.innerHTML =
      '<tr><th style="text-align:left;padding-left:6px;">Reason</th>' +
      hours.map(h => '<th>' + esc(normHour(h)) + '</th>').join('') +
      '</tr>';

    body.innerHTML = reasons.map(reason => {
      const tds = hours.map(h => {
        const v = Number(grid[reason + '|' + h] || 0);
        const cls = v ? '' : 'mm-zero';
        return '<td class="' + cls + '" style="background:' + bgFor(v, max) + ';" title="' +
               esc(reason + ' @ ' + normHour(h) + ': ' + v) + '">' + (v ? String(v) : '') + '</td>';
      }).join('');
      return '<tr><td class="mm-rowlabel">' + esc(reason) + '</td>' + tds + '</tr>';
    }).join('');

    if (sub) sub.textContent = 'Filled sell counts by exit reason and hour (' + total + ' events, ' + reasons.length + ' reasons)';
    card.style.display = '';
  }

  async function loadHeatmap(){
    const bucket = encodeURIComponent(findBucketValue());
    const date = encodeURIComponent(findDateValue());
    const url = '/api/analytics/sell?bucket=' + bucket + (date ? '&date=' + date : '') + '&v=' + Date.now();

    try{
      const res = await fetch(url, { cache: 'no-store' });
      const txt = await res.text();
      let data = {};
      try { data = JSON.parse(txt); } catch(e) { data = {}; }
      renderHeatmap(data);
    } catch(err){
      const body = q('mm-sell-heatmap-body');
      const sub  = q('mm-sell-heatmap-sub');
      if (body) body.innerHTML = '<tr><td class="mm-muted">Heatmap load failed.</td></tr>';
      if (sub) sub.textContent = 'Failed to load heatmap.';
    }
  }

  function bind(){
    if (window.__mm_sell_heatmap_override_bound__) return;
    window.__mm_sell_heatmap_override_bound__ = true;

    syncBucketLabels();
    loadHeatmap();

    const ids = ['mm-sell-bucket','sell-bucket','bucket','ax-bucket','ax-datepick','ax-datego'];
    ids.forEach(id => {
      const el = q(id);
      if (!el) return;
      el.addEventListener('change', () => { syncBucketLabels(); setTimeout(loadHeatmap, 25); });
      el.addEventListener('click',   () => { syncBucketLabels(); setTimeout(loadHeatmap, 25); });
    });

    document.addEventListener('change', (ev) => {
      const t = ev.target;
      if (t && t.tagName === 'SELECT'){
        syncBucketLabels();
        setTimeout(loadHeatmap, 25);
      }
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind);
  } else {
    bind();
  }
})();
/* MM_FORCE_SELL_HEATMAP_OVERRIDE_V1_END */
