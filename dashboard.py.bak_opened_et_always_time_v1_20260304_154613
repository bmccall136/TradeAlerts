        "reasons": [],
        "outcomes": [],
        "hold_buckets": [],
    }

    try:
        import sqlite3
        db_path = _mm_live_db_path()
        con = sqlite3.connect(db_path)
        con.row_factory = sqlite3.Row
        cur = con.cursor()

        # Reasons: sell_events.reason where event='FILLED'
        try:
            rows = cur.execute("""
                SELECT COALESCE(reason,'(none)') AS reason, COUNT(1) AS ct
                FROM sell_events
                WHERE ts_utc >= ? AND event='FILLED'
                GROUP BY COALESCE(reason,'(none)')
                ORDER BY ct DESC
            """, (since_ts_utc,)).fetchall()
            out["reasons"] = [{"reason": r["reason"], "ct": int(r["ct"])} for r in rows]
        except Exception as e:
            out["reasons_error"] = str(e)

        # Outcomes: all sell_events.event counts
        try:
            rows = cur.execute("""
                SELECT COALESCE(event,'(none)') AS event, COUNT(1) AS ct
                FROM sell_events
                WHERE ts_utc >= ?
                GROUP BY COALESCE(event,'(none)')
                ORDER BY ct DESC
            """, (since_ts_utc,)).fetchall()
            out["outcomes"] = [{"event": r["event"], "ct": int(r["ct"])} for r in rows]
        except Exception as e:
            out["outcomes_error"] = str(e)

        # Hold buckets: use hold_bucket if present, else placeholder
        try:
            rows = cur.execute("""
                SELECT COALESCE(hold_bucket,'(none)') AS bucket, COUNT(1) AS ct
                FROM sell_events
                WHERE ts_utc >= ? AND event='FILLED'
                GROUP BY COALESCE(hold_bucket,'(none)')
                ORDER BY ct DESC
            """, (since_ts_utc,)).fetchall()
            out["hold_buckets"] = [{"bucket": r["bucket"], "ct": int(r["ct"])} for r in rows]
        except Exception as e:
            out["hold_buckets_error"] = str(e)

        con.close()
    except Exception as e:
        out["ok"] = False
        out["error"] = str(e)

    return _mm_jsonify(out), 200

