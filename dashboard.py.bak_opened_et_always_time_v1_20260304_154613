def _mm_hydrate_holdings_opened_from_db(holdings, live_db_path=None):
    """
    Overwrite holdings[*].opened_ts_utc + holdings[*].opened_et from live.db position_opened.
    This fixes E*TRADE dateAcquired midnight artifacts in the Live holdings table.
    Safe: never raises.
    """
    try:
        import sqlite3
        import datetime as _dt
        try:
            from zoneinfo import ZoneInfo as _ZoneInfo
            _ET = _ZoneInfo("America/New_York")
        except Exception:
            _ET = None

        if not isinstance(holdings, list) or not holdings:
            return holdings

        # Resolve DB path
        dbp = live_db_path
        if not dbp:
            try:
                dbp = globals().get("LIVE_DB") or globals().get("DB_PATH")
            except Exception:
                dbp = None
        if not dbp:
            dbp = r"C:\TradeAlerts\live.db"

        # Load mapping
        mm_map = {}
        con = None
        try:
            con = sqlite3.connect(str(dbp), timeout=5)
            cur = con.cursor()
            for sym, ts in cur.execute(
                "SELECT symbol, opened_ts_utc FROM position_opened WHERE opened_ts_utc IS NOT NULL"
            ):
                if sym:
                    mm_map[str(sym).upper()] = int(ts)
        finally:
            try:
                if con:
                    con.close()
            except Exception:
                pass
        # Fallback: if position_opened missing for a symbol, backfill from live.db trades BUY time
        try:
            con = sqlite3.connect(str(dbp), timeout=5)
            cur = con.cursor()

            def _parse_trade_time_to_ts_utc(s):
                if not s:
                    return None
                t = str(s).strip().replace("T", " ").split(".")[0]
                try:
                    dt = _dt.datetime.fromisoformat(t)
                except Exception:
                    return None
                # trades are usually stored as naive ET; assume ET if naive
                if dt.tzinfo is None:
                    if _ET is not None:
                        dt = dt.replace(tzinfo=_ET)
                # convert to UTC epoch
                try:
                    return int(dt.astimezone(_dt.timezone.utc).timestamp())
                except Exception:
                    return None

            # Gather symbols we need
            needed = set()
            for h in holdings:
                if isinstance(h, dict):
                    sym = str(h.get("symbol") or h.get("Symbol") or "").upper().strip()
                    if sym and sym not in mm_map:
                        needed.add(sym)

            if needed:
                for sym in sorted(needed):
                    row = cur.execute(
                        "SELECT trade_time FROM trades WHERE symbol=? AND UPPER(action)='BUY' ORDER BY trade_time DESC, id DESC LIMIT 1",
                        (sym,),
                    ).fetchone()
                    if not row:
                        continue
                    ts_utc = _parse_trade_time_to_ts_utc(row[0])
                    if not ts_utc:
                        continue

                    # Write to position_opened so future requests hydrate cleanly
                    try:
                        cur.execute(
                            "INSERT OR REPLACE INTO position_opened(symbol, opened_ts_utc) VALUES (?, ?)",
                            (sym, int(ts_utc)),
                        )
                        mm_map[sym] = int(ts_utc)
                    except Exception:
                        pass

                try:
                    con.commit()
                except Exception:
                    pass

        except Exception:
            pass
        finally:
            try:
                con.close()
            except Exception:
                pass
        # Apply to holdings
        for h in holdings:
            if not isinstance(h, dict):
                continue
            sym = str(h.get("symbol") or h.get("Symbol") or "").upper().strip()
            if not sym:
                continue
            ts = mm_map.get(sym)
            if not ts:
                continue

            # Preserve whatever was there (often midnight-ish)
            if "opened_et_epoch" not in h and "opened_et" in h:
                h["opened_et_epoch"] = h.get("opened_et")

            h["opened_ts_utc"] = int(ts)
            try:
                dtu = _dt.datetime.fromtimestamp(int(ts), tz=_dt.timezone.utc)
                dte = dtu.astimezone(_ET) if _ET is not None else dtu
                h["opened_et"] = dte.strftime("%m/%d/%Y, %I:%M %p")
            except Exception:
                h["opened_et"] = str(ts)

        return holdings

    except Exception:
        return holdings
