# MM_LOG_REGIME_SAMPLE_V1
def mm_log_regime_sample(ts_utc: int, regime: str, conf: int, reason: str):
    """
    Write regime sample into live.db.market_regime_samples (deduped in 5-min buckets).
    Schema: (id INTEGER PK, ts_utc INTEGER, regime TEXT, conf INTEGER, reason TEXT)
    """
    try:
        ts_utc = int(ts_utc) - (int(ts_utc) % 300)  # 5-min bucket
        import sqlite3
        # LIVE_DB is already used elsewhere; fall back if not present
        db_path = globals().get("LIVE_DB") or globals().get("DB_PATH") or r"C:\TradeAlerts\live.db"
        con = sqlite3.connect(db_path, timeout=0.5)
        try:
            con.execute("PRAGMA busy_timeout=500")
        except Exception:
            pass

        con.execute("""
          CREATE TABLE IF NOT EXISTS market_regime_samples (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts_utc INTEGER NOT NULL,
            regime TEXT NOT NULL,
            conf INTEGER NOT NULL,
            reason TEXT
          )
        """)

        # Ensure uniqueness by ts_utc bucket (best effort)
        try:
            con.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_mrs_ts ON market_regime_samples(ts_utc)")
        except Exception:
            pass

        con.execute(
            "INSERT OR IGNORE INTO market_regime_samples(ts_utc, regime, conf, reason) VALUES (?, ?, ?, ?)",
            (int(ts_utc), str(regime), int(conf), str(reason or "")),
        )
        con.commit()
        con.close()
    except Exception:
        # Never break API response due to logger
        return

