                dt = datetime.fromisoformat(s.replace('Z', '+00:00'))
                if dt.tzinfo is None:
                    if _ET is not None:
                        try:
                            dt = dt.replace(tzinfo=_ET)
                        except Exception:
                            try:
                                dt = _ET.localize(dt)
                            except Exception:
                                dt = dt.replace(tzinfo=timezone.utc)
                    else:
                        dt = dt.replace(tzinfo=timezone.utc)
                return int(dt.astimezone(timezone.utc).timestamp())
            except Exception:
                return None

        def _epoch_to_et_str(ep):
            try:
                ep = int(ep)
            except Exception:
                return ''
            try:
                dt = datetime.fromtimestamp(ep, tz=timezone.utc)
                if _ET is not None:
                    dt = dt.astimezone(_ET)
                return dt.strftime('%Y-%m-%d %H:%M:%S')
            except Exception:
                return ''

        con = sqlite3.connect(LIVE_DB)
        con.row_factory = sqlite3.Row
        cur = con.cursor()

        try:
            buys = cur.execute(
                "SELECT id as trade_id, symbol, name, price, qty, ts_utc FROM trades "
                "WHERE UPPER(COALESCE(action,'')) IN ('BUY','BOT','BUY_FILLED','BUY_EXECUTED') "
                "ORDER BY id DESC LIMIT 40"
            ).fetchall()
            sells = cur.execute(
                "SELECT id as trade_id, symbol, name, price, qty, ts_utc FROM trades "
                "WHERE UPPER(COALESCE(action,'')) IN ('SELL','SOLD','SELL_FILLED','SELL_EXECUTED') "
                "ORDER BY id DESC LIMIT 40"
            ).fetchall()

            def _fmt_side(rows, side):
                out_rows = []
                for r in rows:
                    d = _row_to_dict(r) or {}
                    d['side'] = side
                    tsiso = d.get('ts_utc')
                    if tsiso:
                        ep = _to_epoch(tsiso)
                        d['time_et'] = _epoch_to_et_str(ep) if ep else str(tsiso)
                    else:
                        d['time_et'] = ''
                    out_rows.append(d)
                return out_rows

            out['buys'] = _fmt_side(buys, 'BUY')
            out['sells'] = _fmt_side(sells, 'SELL')
            out['meta']['buy_ct'] = len(out['buys'])
            out['meta']['sell_ct'] = len(out['sells'])
        except Exception as e:
            out['errors'].append('list query failed: ' + str(e))

        trade_id = _rq.args.get('trade_id', type=int)
        symbol_q = (_rq.args.get('symbol') or '').strip().upper()
        win = _rq.args.get('win_secs', type=int) or 900

        if trade_id or symbol_q:
            trade = None
            if trade_id:
                trade = cur.execute("SELECT * FROM trades WHERE id=?", (int(trade_id),)).fetchone()
            elif symbol_q:
                trade = cur.execute("SELECT * FROM trades WHERE UPPER(symbol)=? ORDER BY id DESC LIMIT 1", (symbol_q,)).fetchone()

            trade_d = _row_to_dict(trade) or {}
            sym = (trade_d.get('symbol') or symbol_q or '').upper().strip()
            act = (trade_d.get('action') or '').upper().strip()

            buy_row = None
            if sym:
                if act in ('BUY','BOT','BUY_FILLED','BUY_EXECUTED'):
                    buy_row = trade
                else:
                    buy_row = cur.execute(
                        "SELECT * FROM trades WHERE UPPER(symbol)=? AND UPPER(COALESCE(action,'')) IN ('BUY','BOT','BUY_FILLED','BUY_EXECUTED') "
                        "ORDER BY id DESC LIMIT 1",
                        (sym,)
                    ).fetchone()

            buy_d = _row_to_dict(buy_row) or {}
            buy_ts_epoch = _to_epoch(buy_d.get('ts_utc') or buy_d.get('ts') or buy_d.get('timestamp'))

            out['meta'].update({
                'symbol': sym,
                'anchor_trade_id': (buy_d.get('id') or buy_d.get('trade_id') or None),
                'anchor_buy_ts_utc_epoch': buy_ts_epoch,
                'anchor_buy_time_et': _epoch_to_et_str(buy_ts_epoch) if buy_ts_epoch else '',
                'anchor_buy_price': buy_d.get('price') or buy_d.get('fill_price') or buy_d.get('avg_price'),
                'anchor_qty': buy_d.get('qty') or buy_d.get('quantity'),
                'win_secs': win,
            })

            if sym and buy_ts_epoch:
                lo = int(buy_ts_epoch) - int(win)
                hi = int(buy_ts_epoch) + int(win)
                try:
                    rows = cur.execute(
                        "SELECT * FROM trigger_fires WHERE UPPER(symbol)=? AND COALESCE(ts_utc,0) BETWEEN ? AND ? ORDER BY COALESCE(ts_utc,0) ASC",
                        (sym, lo, hi)
                    ).fetchall()
                    out['buy_triggers'] = []
                    for r in rows:
                        d = _row_to_dict(r) or {}
                        # V1E2: always compute time_et from ts_utc (ignore DB time_et)
                        _ts = d.get('ts_utc')
                        try:
                            _ts_ep = int(_ts) if _ts is not None else None
                        except Exception:
