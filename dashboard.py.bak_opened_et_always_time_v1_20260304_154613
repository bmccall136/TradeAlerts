def _mm_regime_agg_by_regime(con, table_name: str, since_ts_utc: int):
    """
    Returns list of dicts: [{regime, count, avg_conf}]
    Expects columns: ts_utc, regime, regime_conf (optional).
    """
    cur = con.cursor()

    # schema sniff
    cols = {r[1] for r in cur.execute(f"PRAGMA table_info({table_name})").fetchall()}
    if "ts_utc" not in cols or "regime" not in cols:
        return []

    conf_expr = "AVG(regime_conf)" if "regime_conf" in cols else "NULL"
    sql = f"""
      SELECT regime,
             COUNT(*) AS ct,
             {conf_expr} AS avg_conf
      FROM {table_name}
      WHERE ts_utc >= ?
        AND regime IS NOT NULL
        AND TRIM(regime) <> ''
      GROUP BY regime
      ORDER BY ct DESC
    """
    out = []
    for regime, ct, avg_conf in cur.execute(sql, (int(since_ts_utc),)).fetchall():
        out.append({
            "regime": str(regime),
            "count": int(ct or 0),
            "avg_conf": (None if avg_conf is None else int(round(float(avg_conf)))),
        })
    return out


