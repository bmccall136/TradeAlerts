def _tz_naive_dt(x):
    """
    Convert x to pandas datetime and strip timezone if present.
    Works for tz-aware Series/Index and tz-naive inputs.
    """
    try:
        import pandas as pd
        x = pd.to_datetime(x, errors="coerce")
    except Exception:
        return x
    # Series dt accessor (Series)
    try:
        if hasattr(x, "dt") and getattr(x.dt, "tz", None) is not None:
            x = x.dt.tz_localize(None)
    except Exception:
        pass
    # DatetimeIndex (Index)
    try:
        if getattr(x, "tz", None) is not None:
            x = x.tz_localize(None)
    except Exception:
        pass
    return x


