                        d['time_et'] = _epoch_to_et_str(_ts_ep) if _ts_ep else (d.get('time_et') or '')
                        out['buy_triggers'].append(d)
                except Exception as e:
                    out['errors'].append('buy_triggers query failed: ' + str(e))

        con.close()
    except Exception as e:
        out['errors'].append('api_trade_review exception: ' + str(e))
