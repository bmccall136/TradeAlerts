def _mm_bucket_since_epoch( bucket: str = "today") -> int:
    bucket = (request.args.get('bucket') or 'today').strip().lower()
    if bucket in ('7d','7day','7days'): bucket = '7d'
    elif bucket in ('30d','30day','30days'): bucket = '30d'
    elif bucket in ('all',): bucket = 'all'
    elif bucket in ('today','tod','t'): bucket = 'today'
    """
    Bucket start as UTC epoch, but anchored to America/New_York midnight.
    Fixes the ~7pm ET "today becomes tomorrow" UTC flip.
    """
    import datetime as dt
    from zoneinfo import ZoneInfo

    b = (bucket or "").strip().lower()
    if b in ("", "all", "*"):
        return 0

    et = ZoneInfo("America/New_York")
    utc = ZoneInfo("UTC")

    now_et = dt.datetime.now(et)

    def sod(x: dt.datetime) -> dt.datetime:
        return x.replace(hour=0, minute=0, second=0, microsecond=0)

    if b == "today":
        start_et = sod(now_et)
    elif b in ("7d", "7"):
        start_et = sod(now_et - dt.timedelta(days=7))
    elif b in ("30d", "30"):
        start_et = sod(now_et - dt.timedelta(days=30))
    else:
        # best-effort: treat like Nd
        try:
            n = int(b.rstrip("d"))
            start_et = sod(now_et - dt.timedelta(days=n))
        except Exception:
            start_et = sod(now_et)

    return int(start_et.astimezone(utc).timestamp())

